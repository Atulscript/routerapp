---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import AdBanner from '../components/AdBanner.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "Free Networking & Router Tools | IP Lookup, WiFi QR, Password Generator | 19216811.page";
const description = "Suite of free online router and networking utilities. Find your public IP address, generate WiFi QR codes, create strong passwords, and troubleshoot local gateway connections.";

const toolsList = [
  {
    title: 'What Is My IP Address?',
    description: 'Instantly detect your public IPv4/IPv6 address, internet service provider, and local default gateway.',
    icon: '🌐',
    url: `${base}/what-is-my-ip`,
    badge: 'Popular'
  },
  {
    title: 'WiFi QR Code Generator',
    description: 'Generate a printable QR code so friends and guests can scan with their phone camera to connect without typing passwords.',
    icon: '📶',
    url: `${base}/wifi-qr-generator`,
    badge: 'New'
  },
  {
    title: 'Strong Password Generator',
    description: 'Generate high-entropy, cryptographically secure passwords for router administration dashboards and WiFi networks.',
    icon: '🛡️',
    url: `${base}/password-generator`,
    badge: 'Security'
  },
  {
    title: 'Default Router Passwords List',
    description: 'Search and copy factory default passwords and usernames for over 20+ major router manufacturers.',
    icon: '🔑',
    url: `${base}/default-passwords`,
    badge: 'Database'
  }
];
---

<BaseLayout title={title} description={description}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6 sm:space-y-8">
    
    <!-- Search Bar -->
    <div>
      <SearchBar />
    </div>

    <!-- Header -->
    <header class="text-center max-w-xl mx-auto">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-md-primary-container text-md-on-primary-container text-[11px] font-bold uppercase mb-2 border border-md-primary/20">
        🛠️ Web Utilities
      </div>
      <h1 class="text-2xl sm:text-4xl font-black text-md-on-surface tracking-tight mb-2">
        Networking Tools
      </h1>
      <p class="text-xs sm:text-sm text-md-on-surface-variant">
        Free, browser-based network configuration and diagnostic utilities with zero server data storage.
      </p>
    </header>

    <AdBanner format="leaderboard" />

    <!-- Tools Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
      {toolsList.map(tool => (
        <a 
          href={tool.url}
          class="m3-card-compact p-4 sm:p-5 flex flex-col justify-between group hover:border-md-primary transition-all"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-10 h-10 rounded-m3-md bg-md-primary-container/40 border border-md-primary/20 flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
                {tool.icon}
              </span>
              <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-m3-full bg-md-secondary-container text-md-on-secondary-container">
                {tool.badge}
              </span>
            </div>

            <h3 class="text-base font-bold text-md-on-surface group-hover:text-md-primary transition-colors mb-1.5">
              {tool.title}
            </h3>

            <p class="text-xs text-md-on-surface-variant leading-relaxed">
              {tool.description}
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-md-surface-variant/40 flex items-center justify-between text-xs font-bold text-md-primary">
            <span>Launch Tool</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>

    <AdBanner format="horizontal" />

    <!-- Human SEO Overview Section -->
    <section class="m3-card-compact space-y-4">
      <h2 class="text-xl font-bold text-md-on-surface">Why Use 19216811.page Network Utilities?</h2>
      <p class="text-xs text-md-on-surface-variant leading-relaxed">
        Our suite of networking utilities is built for speed, privacy, and simplicity. Whether you are setting up a new home Wi-Fi network, troubleshooting broadband connectivity, or generating secure passwords, our tools run entirely in your local browser:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs pt-1">
        <div class="p-3.5 rounded-m3-md bg-md-surface-container-low border border-md-outline-variant/30 space-y-1">
          <span class="text-lg">🛡️</span>
          <strong class="text-md-on-surface block font-bold text-xs">Zero Server Logging</strong>
          <p class="text-[11px] text-md-on-surface-variant leading-relaxed">
            Your generated passwords and Wi-Fi QR credentials never leave your browser window. Zero tracking, 100% private.
          </p>
        </div>

        <div class="p-3.5 rounded-m3-md bg-md-surface-container-low border border-md-outline-variant/30 space-y-1">
          <span class="text-lg">⚡</span>
          <strong class="text-md-on-surface block font-bold text-xs">Instant Diagnostics</strong>
          <p class="text-[11px] text-md-on-surface-variant leading-relaxed">
            Real-time IP detection and subnet matching help you identify your local router gateway within milliseconds.
          </p>
        </div>

        <div class="p-3.5 rounded-m3-md bg-md-surface-container-low border border-md-outline-variant/30 space-y-1">
          <span class="text-lg">📱</span>
          <strong class="text-md-on-surface block font-bold text-xs">Fully Mobile Responsive</strong>
          <p class="text-[11px] text-md-on-surface-variant leading-relaxed">
            All tools work seamlessly on iPhone, iPad, Android devices, macOS, and Windows without needing app downloads.
          </p>
        </div>
      </div>
    </section>

    <!-- Interlinking 2-Column Grid -->
    <div>
      <RelatedLinksGrid />
    </div>

  </div>
</BaseLayout>
