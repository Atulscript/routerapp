---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';
import AdBanner from '../components/AdBanner.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "Download Time Calculator - File Transfer Speed & ETA | RouterSync.com";
const description = "Calculate file download and upload times based on your broadband internet speed. Features presets for 50GB to 150GB games, 4K movies, and real-world TCP packet overhead.";
const keywords = [
  "download time calculator",
  "file download speed calculator",
  "how long to download 100gb",
  "bandwidth speed calculator",
  "mbps to mb/s converter",
  "game download time calculator",
  "upload time calculator",
  "internet transfer time"
];

const siteUrl = "https://atulscript.github.io/routerapp";

const popularPresets = [
  { label: 'GTA VI / Warzone (150 GB)', size: 150, unit: 'GB', icon: '🎮' },
  { label: 'AAA Game (100 GB)', size: 100, unit: 'GB', icon: '🕹️' },
  { label: '4K UHD Movie (50 GB)', size: 50, unit: 'GB', icon: '🎬' },
  { label: '1080p Movie (5 GB)', size: 5, unit: 'GB', icon: '🍿' },
  { label: 'Windows 11 ISO (6.5 GB)', size: 6.5, unit: 'GB', icon: '💻' },
  { label: 'macOS Installer (13 GB)', size: 13, unit: 'GB', icon: '🍏' }
];

const speedPresets = [
  { label: '25 Mbps', speed: 25 },
  { label: '50 Mbps', speed: 50 },
  { label: '100 Mbps', speed: 100 },
  { label: '300 Mbps', speed: 300 },
  { label: '500 Mbps', speed: 500 },
  { label: '1 Gbps (Gigabit)', speed: 1000 },
  { label: '2.5 Gbps', speed: 2500 }
];

const schema = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
      { "@type": "ListItem", "position": 2, "name": "Tools", "item": `${siteUrl}/tools` },
      { "@type": "ListItem", "position": 3, "name": "Download Calculator", "item": `${siteUrl}/download-calculator` }
    ]
  },
  {
    "@type": "WebApplication",
    "name": "Download Time Calculator",
    "url": `${siteUrl}/download-calculator`,
    "applicationCategory": "NetworkingApplication",
    "operatingSystem": "All",
    "description": description
  },
  {
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Why is my download speed in MB/s slower than my ISP's Mbps rating?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Internet Service Providers advertise speed in Megabits per second (Mbps, with a lowercase 'b'), whereas browsers and game launchers display download speeds in MegaBytes per second (MB/s, with an uppercase 'B'). Since there are 8 bits in 1 Byte, a 100 Mbps broadband plan delivers a theoretical maximum download speed of 12.5 MB/s."
        }
      },
      {
        "@type": "Question",
        "name": "What is network protocol overhead?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "TCP/IP, Ethernet frame headers, Wi-Fi encryption packets, and packet acknowledgments consume approximately 8% to 12% of total transmitted bandwidth. Factoring in a 10% realistic overhead provides an accurate ETA for real-world broadband connections."
        }
      },
      {
        "@type": "Question",
        "name": "How long does it take to download a 100 GB game on a 100 Mbps connection?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "On a 100 Mbps connection with realistic 10% TCP protocol overhead (effective rate of ~11.25 MB/s), downloading a 100 GB game takes approximately 2 hours, 28 minutes."
        }
      }
    ]
  }
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  schema={schema}
  ogType="website"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-10 font-sans">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 text-xs text-[#5f6368] dark:text-[#9aa0a6] font-medium">
      <a href={`${base}/`} class="hover:text-blue-600 dark:hover:text-cyan-400 transition-colors">Home</a>
      <span>/</span>
      <a href={`${base}/tools`} class="hover:text-blue-600 dark:hover:text-cyan-400 transition-colors">Tools</a>
      <span>/</span>
      <span class="text-[#202124] dark:text-[#e8eaed] font-medium truncate">Download Time Calculator</span>
    </nav>

    <!-- Header -->
    <header class="space-y-3 border-b border-[#e8eaed] dark:border-[#3c4043] pb-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 text-xs font-bold border border-emerald-200 dark:border-emerald-900/60 shadow-2xs">
        <span>⏱️</span>
        File Transfer & Bandwidth Time Estimator
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-[#202124] dark:text-white tracking-tight">
        Download Time Calculator
      </h1>
      <p class="text-sm sm:text-base text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed max-w-2xl">
        Calculate the exact time required to download or upload games, 4K video, backups, and operating system installers based on your internet connection speed.
      </p>
    </header>

    <!-- Calculator Card -->
    <div class="g-card p-6 sm:p-8 space-y-6 shadow-sm">
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        
        <!-- File Size Column -->
        <div class="space-y-3">
          <label for="file-size" class="block text-xs sm:text-sm font-bold text-[#202124] dark:text-white uppercase tracking-wider">
            File / Game Size:
          </label>
          <div class="flex gap-2">
            <input
              type="number"
              id="file-size"
              value="50"
              min="0.1"
              step="any"
              class="w-full h-12 px-3 font-mono text-base font-bold bg-[#f8fafd] dark:bg-[#1e293b] text-[#202124] dark:text-white border-2 border-[#dadce0] dark:border-[#475569] rounded-xl focus:border-blue-600 outline-none"
            />
            <select
              id="file-unit"
              class="h-12 px-3 rounded-xl bg-[#f8fafd] dark:bg-[#1e293b] border-2 border-[#dadce0] dark:border-[#475569] font-bold text-xs text-[#202124] dark:text-white outline-none focus:border-blue-600"
            >
              <option value="MB">MB</option>
              <option value="GB" selected>GB</option>
              <option value="TB">TB</option>
            </select>
          </div>

          <!-- Quick File Presets -->
          <div class="space-y-1.5 pt-1">
            <span class="text-[11px] font-bold text-gray-500 dark:text-gray-400 uppercase">Popular Presets:</span>
            <div class="flex flex-wrap gap-1.5">
              {popularPresets.map(p => (
                <button
                  type="button"
                  data-size={p.size}
                  data-unit={p.unit}
                  class="preset-file-btn px-2 py-1 rounded-lg text-xs bg-gray-100 dark:bg-gray-800 hover:bg-blue-50 dark:hover:bg-blue-950/50 hover:text-blue-600 text-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-700 transition-all flex items-center gap-1"
                >
                  <span>{p.icon}</span>
                  <span>{p.label}</span>
                </button>
              ))}
            </div>
          </div>
        </div>

        <!-- Connection Speed Column -->
        <div class="space-y-3">
          <label for="speed-val" class="block text-xs sm:text-sm font-bold text-[#202124] dark:text-white uppercase tracking-wider">
            Internet Connection Speed:
          </label>
          <div class="flex gap-2">
            <input
              type="number"
              id="speed-val"
              value="100"
              min="1"
              step="any"
              class="w-full h-12 px-3 font-mono text-base font-bold bg-[#f8fafd] dark:bg-[#1e293b] text-[#202124] dark:text-white border-2 border-[#dadce0] dark:border-[#475569] rounded-xl focus:border-blue-600 outline-none"
            />
            <select
              id="speed-unit"
              class="h-12 px-3 rounded-xl bg-[#f8fafd] dark:bg-[#1e293b] border-2 border-[#dadce0] dark:border-[#475569] font-bold text-xs text-[#202124] dark:text-white outline-none focus:border-blue-600"
            >
              <option value="Kbps">Kbps</option>
              <option value="Mbps" selected>Mbps</option>
              <option value="Gbps">Gbps</option>
            </select>
          </div>

          <!-- Quick Speed Presets -->
          <div class="space-y-1.5 pt-1">
            <span class="text-[11px] font-bold text-gray-500 dark:text-gray-400 uppercase">Common Broadband Speeds:</span>
            <div class="flex flex-wrap gap-1.5">
              {speedPresets.map(s => (
                <button
                  type="button"
                  data-speed={s.speed}
                  class="preset-speed-btn px-2 py-1 rounded-lg text-xs bg-gray-100 dark:bg-gray-800 hover:bg-blue-50 dark:hover:bg-blue-950/50 hover:text-blue-600 text-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-700 transition-all font-mono"
                >
                  {s.label}
                </button>
              ))}
            </div>
          </div>
        </div>

      </div>

      <!-- Protocol Overhead Slider -->
      <div class="p-4 rounded-xl bg-gray-50 dark:bg-[#1e293b]/60 border border-gray-200 dark:border-gray-700 space-y-2">
        <div class="flex items-center justify-between text-xs">
          <span class="font-bold text-[#202124] dark:text-white">Real-world TCP/IP Protocol Overhead:</span>
          <span id="overhead-label" class="font-mono font-bold text-blue-600 dark:text-cyan-400">10% (Realistic Broadband)</span>
        </div>
        <input
          type="range"
          id="overhead-slider"
          min="0"
          max="25"
          value="10"
          class="w-full accent-blue-600 dark:accent-cyan-400 cursor-pointer"
        />
        <p class="text-[11px] text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed">
          Accounts for packet headers, TCP acknowledgments, and wireless signal variance. Set to 0% for theoretical wire speed.
        </p>
      </div>

      <!-- Result Banner -->
      <div class="p-6 rounded-2xl bg-gradient-to-br from-blue-600 via-indigo-600 to-cyan-600 text-white shadow-lg space-y-4">
        <div class="flex items-center justify-between border-b border-white/20 pb-3">
          <span class="text-xs uppercase font-bold tracking-wider text-cyan-200">Estimated Download Completion Time:</span>
          <span class="text-xs bg-white/20 px-2.5 py-0.5 rounded-full font-medium" id="transfer-rate">Rate: 11.25 MB/s</span>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-baseline gap-2">
          <div id="result-time" class="text-3xl sm:text-5xl font-black tracking-tight font-sans">
            1 hr 14 mins
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-2 text-center text-xs">
          <div class="p-2 rounded-xl bg-white/10 backdrop-blur-xs">
            <div class="text-white/70 text-[10px] uppercase">Days</div>
            <div id="stat-days" class="font-bold text-base">0</div>
          </div>
          <div class="p-2 rounded-xl bg-white/10 backdrop-blur-xs">
            <div class="text-white/70 text-[10px] uppercase">Hours</div>
            <div id="stat-hours" class="font-bold text-base">1</div>
          </div>
          <div class="p-2 rounded-xl bg-white/10 backdrop-blur-xs">
            <div class="text-white/70 text-[10px] uppercase">Minutes</div>
            <div id="stat-minutes" class="font-bold text-base">14</div>
          </div>
          <div class="p-2 rounded-xl bg-white/10 backdrop-blur-xs">
            <div class="text-white/70 text-[10px] uppercase">Seconds</div>
            <div id="stat-seconds" class="font-bold text-base">05</div>
          </div>
        </div>
      </div>

    </div>

    <!-- Comparative Matrix Table -->
    <div class="g-card p-6 sm:p-8 space-y-4">
      <h2 class="text-lg sm:text-xl font-bold text-[#202124] dark:text-white tracking-tight">
        How Fast Would This File Download on Other Plans?
      </h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse font-sans">
          <thead>
            <tr class="border-b border-[#dadce0] dark:border-[#3c4043] bg-gray-50 dark:bg-gray-800/50">
              <th class="p-3 font-bold text-[#202124] dark:text-white">Broadband Plan</th>
              <th class="p-3 font-bold text-[#202124] dark:text-white">Effective Speed (MB/s)</th>
              <th class="p-3 font-bold text-[#202124] dark:text-white">Download Time</th>
            </tr>
          </thead>
          <tbody id="matrix-tbody" class="divide-y divide-[#e8eaed] dark:divide-[#3c4043]">
          </tbody>
        </table>
      </div>
    </div>

    <!-- Ad Space -->
    <AdBanner slot="between-sections" format="horizontal" />

    <!-- Educational Guide Content -->
    <div class="space-y-6 text-xs sm:text-sm text-[#3c4043] dark:text-[#e8eaed] leading-relaxed g-card p-6 sm:p-8">
      <section class="space-y-3">
        <h2 class="text-base sm:text-lg font-bold text-[#202124] dark:text-white">
          Why Does 100 Mbps Only Download at 12.5 MB/s? (Bits vs Bytes Explained)
        </h2>
        <p>
          The number one confusion with internet speeds is the difference between a <strong>bit (b)</strong> and a <strong>Byte (B)</strong>:
        </p>
        <ul class="list-disc pl-5 space-y-1.5">
          <li><strong>1 Byte = 8 bits</strong>.</li>
          <li>ISPs always market speeds in <strong>Megabits per second (Mbps)</strong> because the number is 8 times higher and looks faster.</li>
          <li>Files, hard drives, Steam, and browsers measure sizes in <strong>MegaBytes (MB)</strong> and <strong>GigaBytes (GB)</strong>.</li>
          <li>To find your real download rate, divide your ISP speed by 8. A 100 Mbps connection gives a maximum theoretical speed of <code class="font-mono bg-gray-100 dark:bg-gray-800 px-1 py-0.5 rounded">100 &divide; 8 = 12.5 MB/s</code>.</li>
        </ul>
      </section>
    </div>

    <!-- Related Links -->
    <RelatedLinksGrid />

  </div>

  <script is:inline>
    const sizeInput = document.getElementById('file-size');
    const unitSelect = document.getElementById('file-unit');
    const speedInput = document.getElementById('speed-val');
    const speedUnitSelect = document.getElementById('speed-unit');
    const overheadSlider = document.getElementById('overhead-slider');
    const overheadLabel = document.getElementById('overhead-label');

    const resultTime = document.getElementById('result-time');
    const transferRate = document.getElementById('transfer-rate');
    const statDays = document.getElementById('stat-days');
    const statHours = document.getElementById('stat-hours');
    const statMinutes = document.getElementById('stat-minutes');
    const statSeconds = document.getElementById('stat-seconds');
    const matrixTbody = document.getElementById('matrix-tbody');

    function calculate() {
      const sizeVal = parseFloat(sizeInput.value) || 0;
      const sizeUnit = unitSelect.value;
      const speedVal = parseFloat(speedInput.value) || 0;
      const speedUnit = speedUnitSelect.value;
      const overheadPercent = parseFloat(overheadSlider.value) || 0;

      overheadLabel.textContent = `${overheadPercent}% ${overheadPercent === 0 ? '(Theoretical Wire Speed)' : '(Realistic Overhead)'}`;

      // Convert file size to MegaBytes (MB)
      let sizeInMB = sizeVal;
      if (sizeUnit === 'GB') sizeInMB = sizeVal * 1024;
      if (sizeUnit === 'TB') sizeInMB = sizeVal * 1024 * 1024;

      // Convert speed to Megabits per second (Mbps)
      let speedInMbps = speedVal;
      if (speedUnit === 'Kbps') speedInMbps = speedVal / 1000;
      if (speedUnit === 'Gbps') speedInMbps = speedVal * 1000;

      // Calculate effective speed in MB/s factoring overhead
      const overheadFactor = 1 - (overheadPercent / 100);
      const effectiveMBps = (speedInMbps / 8) * overheadFactor;

      transferRate.textContent = `Effective Rate: ${effectiveMBps.toFixed(2)} MB/s`;

      if (effectiveMBps <= 0 || sizeInMB <= 0) {
        resultTime.textContent = '0 seconds';
        statDays.textContent = '0';
        statHours.textContent = '0';
        statMinutes.textContent = '0';
        statSeconds.textContent = '0';
        return;
      }

      const totalSeconds = Math.round(sizeInMB / effectiveMBps);

      const days = Math.floor(totalSeconds / 86400);
      const hours = Math.floor((totalSeconds % 86400) / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;

      statDays.textContent = days;
      statHours.textContent = hours;
      statMinutes.textContent = minutes;
      statSeconds.textContent = seconds;

      let displayStr = '';
      if (days > 0) displayStr += `${days}d `;
      if (hours > 0 || days > 0) displayStr += `${hours}h `;
      displayStr += `${minutes}m ${seconds}s`;
      resultTime.textContent = displayStr;

      // Update comparative matrix table
      const comparisonSpeeds = [25, 50, 100, 300, 500, 1000, 2500];
      matrixTbody.innerHTML = '';
      comparisonSpeeds.forEach(spd => {
        const rate = (spd / 8) * overheadFactor;
        const secs = Math.round(sizeInMB / rate);
        const d = Math.floor(secs / 86400);
        const h = Math.floor((secs % 86400) / 3600);
        const m = Math.floor((secs % 3600) / 60);
        const s = secs % 60;

        let str = '';
        if (d > 0) str += `${d}d `;
        if (h > 0 || d > 0) str += `${h}h `;
        str += `${m}m ${s}s`;

        const row = document.createElement('tr');
        row.className = 'hover:bg-gray-50 dark:hover:bg-gray-800/30 transition-colors';
        row.innerHTML = `
          <td class="p-3 font-bold text-[#202124] dark:text-white font-mono">${spd >= 1000 ? (spd/1000) + ' Gbps' : spd + ' Mbps'}</td>
          <td class="p-3 text-gray-500 dark:text-gray-400 font-mono">${rate.toFixed(2)} MB/s</td>
          <td class="p-3 font-bold text-blue-600 dark:text-cyan-400">${str}</td>
        `;
        matrixTbody.appendChild(row);
      });
    }

    sizeInput.addEventListener('input', calculate);
    unitSelect.addEventListener('change', calculate);
    speedInput.addEventListener('input', calculate);
    speedUnitSelect.addEventListener('change', calculate);
    overheadSlider.addEventListener('input', calculate);

    document.querySelectorAll('.preset-file-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        sizeInput.value = btn.getAttribute('data-size');
        unitSelect.value = btn.getAttribute('data-unit');
        calculate();
      });
    });

    document.querySelectorAll('.preset-speed-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        speedInput.value = btn.getAttribute('data-speed');
        speedUnitSelect.value = 'Mbps';
        calculate();
      });
    });

    calculate();
  </script>
</BaseLayout>

