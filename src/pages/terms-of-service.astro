---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "Terms of Service & Usage Agreement | 19216811.page";
const description = "Terms of Service and user agreement for accessing router guides, default password archives, and online networking utilities on 19216811.page.";
const keywords = [
  "terms of service",
  "user agreement",
  "terms of use",
  "conditions of use",
  "router directory legal"
];

const siteUrl = "https://atulscript.github.io/routerapp";

const schema = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Terms of Service",
        "item": `${siteUrl}/terms-of-service`
      }
    ]
  },
  {
    "@type": "WebPage",
    "name": "19216811.page Terms of Service",
    "url": `${siteUrl}/terms-of-service`,
    "description": description
  }
];
---

<BaseLayout 
  title={title} 
  description={description} 
  keywords={keywords}
  schema={schema}
  ogType="website"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-8 font-sans">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 text-xs text-[#80868b] font-medium">
      <a href={`${base}/`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
      <span>/</span>
      <span class="text-[#202124] dark:text-[#e8eaed] font-semibold truncate">Terms of Service</span>
    </nav>

    <!-- Header -->
    <header class="space-y-2 border-b border-slate-200/80 dark:border-slate-800 pb-6">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-50 dark:bg-sky-950/40 text-brand-700 dark:text-brand-300 text-xs font-bold uppercase border border-sky-200/50 dark:border-sky-800/50 shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
        Legal & Compliance
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#202124] dark:text-white tracking-tight">
        Terms of Service
      </h1>
      <p class="text-xs sm:text-sm text-[#5f6368] dark:text-[#9aa0a6]">
        Last Updated & Effective: <strong>September 7, 2026</strong>
      </p>
    </header>

    <!-- Content Box -->
    <div class="space-y-6 text-xs sm:text-sm text-[#3c4043] dark:text-[#bdc1c6] leading-relaxed bg-white dark:bg-[#292a2d] rounded-2xl p-6 sm:p-8 border border-[#dadce0] dark:border-[#3c4043] shadow-card transition-colors">
      
      <section class="space-y-2">
        <h2 class="text-base sm:text-lg font-bold text-[#202124] dark:text-white">1. Acceptance of Terms</h2>
        <p>
          By accessing and using <strong>19216811.page</strong>, you accept and agree to be bound by these Terms of Service. If you do not agree to these terms, you must discontinue use of the website immediately.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-base sm:text-lg font-bold text-[#202124] dark:text-white">2. Educational & Reference Purpose Only</h2>
        <p>
          19216811.page is an independent technical resource providing reference guides, default gateway IP documentation, and security best practices for private networking under RFC 1918 standards.
        </p>
        <p>
          All information is provided for educational and diagnostic purposes. We do not provide hardware warranty, firmware flashing services, or direct technical support on behalf of any manufacturer.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-base sm:text-lg font-bold text-[#202124] dark:text-white">3. Trademark & Brand Disclaimer</h2>
        <p>
          All manufacturer names, brand trademarks, logos, and model identifiers (e.g., TP-Link, Netgear, ASUS, D-Link, Cisco, Linksys, JioFiber, Airtel Xstream, etc.) mentioned on this site are the property of their respective trademark holders. Reference to these brands does not imply endorsement, affiliation, sponsorship, or certification by any manufacturer.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-base sm:text-lg font-bold text-[#202124] dark:text-white">4. Limitation of Liability</h2>
        <p>
          In no event shall 19216811.page, its authors, or operators be liable for any direct, indirect, incidental, consequential, or punitive damages arising from the use or inability to use the information, utilities, or external links provided on this website. Users are responsible for safeguarding their own router passwords and network security configurations.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-base sm:text-lg font-bold text-[#202124] dark:text-white">5. Modifications to Terms</h2>
        <p>
          We reserve the right to revise these Terms of Service at any time without prior notice. Continued use of the website after changes are posted constitutes your acceptance of the modified terms.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-base sm:text-lg font-bold text-[#202124] dark:text-white">6. Governing Law</h2>
        <p>
          These terms and conditions are governed by and construed in accordance with applicable global standard internet protocols and regulations.
        </p>
      </section>

    </div>

    <!-- Related Links -->
    <RelatedLinksGrid />

  </div>
</BaseLayout>
