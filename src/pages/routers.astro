---
import BaseLayout from '../layouts/BaseLayout.astro';
import RouterLookupTable from '../components/RouterLookupTable.astro';
import RouterModelsTable from '../components/RouterModelsTable.astro';
import AdBanner from '../components/AdBanner.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';
import { BRANDS, ROUTER_MODELS, formatModelTitle } from '../lib/data-loader';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "Router Hardware Models & Specs Database | RouterSync.com";
const description = "Search and filter over 500+ wireless router hardware models. Find factory default IP gateways, protocols, usernames, passwords, and firmware specs.";
const keywords = [
  "router models database",
  "router hardware specs",
  "wifi router list",
  "router default logins",
  "router password database",
  "wireless router hardware",
  "modem default credentials"
];

const siteUrl = "https://atulscript.github.io/routerapp";

const allModels = ROUTER_MODELS.length > 0 ? ROUTER_MODELS : BRANDS.flatMap(b => 
  b.models.map(m => ({
    brand: b.name,
    brandSlug: b.slug,
    model: m.model,
    slug: (m as any).slug || '',
    protocol: m.protocol || 'HTTP',
    ip: m.ip,
    username: m.username,
    password: m.password,
    wifiStandard: '',
    category: ''
  }))
);


const schema = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Router Models",
        "item": `${siteUrl}/routers`
      }
    ]
  },
  {
    "@type": "ItemList",
    "name": "Wireless Router Hardware Database",
    "description": "Comprehensive specifications and default credentials for wireless routers.",
    "numberOfItems": allModels.length,
    "itemListElement": allModels.slice(0, 30).map((item, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": `${item.brand} ${item.model} (${item.ip} - ${item.username})`
    }))
  },
  {
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Why do some router models require setting a password on first login?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Recent cybersecurity regulations (such as California SB-327 and UK PSTI Act) prohibit manufacturers from shipping routers with generic universal passwords like 'admin'. Modern models prompt the user to set a unique admin password upon initial setup."
        }
      },
      {
        "@type": "Question",
        "name": "What should I do if my exact router model is not listed?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Try the most common gateway IPs for your manufacturer (such as 192.168.1.1 or 192.168.0.1) with 'admin' / 'admin' or check the physical barcode sticker located underneath your device."
        }
      },
      {
        "@type": "Question",
        "name": "Can I upgrade my router's firmware through the IP gateway?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, once logged into your router's admin portal, navigate to System Tools or Administration -> Firmware Upgrade to install the latest security patches from the manufacturer."
        }
      }
    ]
  }
];
---

<BaseLayout 
  title={title} 
  description={description} 
  keywords={keywords}
  schema={schema}
  ogType="website"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 text-xs text-ink-muted font-medium" aria-label="Breadcrumb">
      <a href={`${base}/`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
      <span>/</span>
      <span class="text-ink font-semibold truncate">Router Models</span>
    </nav>

    <!-- Header -->
    <header class="text-center max-w-xl mx-auto">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-muted text-ink-muted text-[11px] font-bold uppercase mb-2 border border-line">
        📟 Hardware Catalog
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-ink tracking-tight mb-2">
        Router Models Database
      </h1>
      <p class="text-sm sm:text-base text-ink-muted">
        Lookup default credentials for {allModels.length} router models across {BRANDS.length} manufacturers with protocol specifications.
      </p>
    </header>

    <AdBanner format="leaderboard" />

    <!-- Quick path: pick a brand and see its models -->
    <section class="bg-surface rounded-2xl p-4 sm:p-6 border border-line shadow-card space-y-3 transition-colors">
      <div>
        <h2 class="text-base font-bold text-ink">Find your router by brand</h2>
        <p class="text-sm text-ink-muted">Pick a manufacturer to see its models and factory logins.</p>
      </div>
      <RouterLookupTable />
    </section>

    <AdBanner format="horizontal" />

    <!-- Full database: search and filter across every model -->
    <section class="space-y-3">
      <div>
        <h2 class="text-base font-bold text-ink">Every router model</h2>
        <p class="text-sm text-ink-muted">
          Search all {allModels.length} models by name, gateway IP, username or password, or narrow them with the filters.
        </p>
      </div>
      <RouterModelsTable />
    </section>

    <!-- Practical Hardware Guide Section -->
    <section class="bg-surface rounded-2xl p-4 sm:p-6 border border-line shadow-card space-y-3 transition-colors">
      <h2 class="text-base font-bold text-ink">How Model Numbers Affect Default Credentials</h2>
      <p class="text-sm text-ink-muted leading-relaxed">
        Manufacturers often update factory credentials across firmware generations. For example, older TP-Link units default to <code class="px-1 py-0.5 rounded bg-slate-200 dark:bg-slate-700 text-slate-900 dark:text-slate-200 font-mono">admin/admin</code>, while newer Archer AX WiFi 6 routers require you to establish a secure administrator password upon first connection.
      </p>
    </section>

    <!-- Interlinking 2-Column Grid -->
    <div>
      <RelatedLinksGrid />
    </div>

    <!-- FAQ Accordion (Positioned Strictly Just Above Footer) -->
    <section class="bg-surface rounded-2xl p-5 sm:p-6 border border-line shadow-card space-y-4">
      <div class="flex items-center gap-2 border-b border-line pb-3">
        <span class="text-lg">❓</span>
        <div>
          <h2 class="text-base sm:text-lg font-bold text-ink">
            Router Models & Hardware FAQs
          </h2>
          <p class="text-sm text-ink-muted">
            Hardware specifications, factory defaults, and setup answers
          </p>
        </div>
      </div>

      <div class="space-y-3">
        <details class="group border border-line rounded-xl p-4 open:bg-slate-50/60 dark:open:bg-[#292a2d]/60 hover:border-slate-300 dark:hover:border-slate-700 transition-colors">
          <summary class="font-bold text-ink cursor-pointer list-none flex justify-between items-center text-xs sm:text-sm">
            <span class="flex items-center gap-2">
              <span class="text-accent font-black">Q.</span>
              Why do some router models require setting a password on first login?
            </span>
            <span class="text-ink-muted group-open:rotate-180 group-open:text-brand-600 dark:group-open:text-brand-400 transition-transform text-xs flex-shrink-0 ml-2">▼</span>
          </summary>
          <p class="text-sm text-ink-muted mt-2.5 leading-relaxed border-t border-line-subtle pt-2.5">
            Recent cybersecurity regulations (such as California SB-327 and UK PSTI Act) prohibit manufacturers from shipping routers with generic universal passwords like 'admin'. Modern models prompt the user to set a unique admin password upon initial setup.
          </p>
        </details>

        <details class="group border border-line rounded-xl p-4 open:bg-slate-50/60 dark:open:bg-[#292a2d]/60 hover:border-slate-300 dark:hover:border-slate-700 transition-colors">
          <summary class="font-bold text-ink cursor-pointer list-none flex justify-between items-center text-xs sm:text-sm">
            <span class="flex items-center gap-2">
              <span class="text-accent font-black">Q.</span>
              What should I do if my exact router model is not listed?
            </span>
            <span class="text-ink-muted group-open:rotate-180 group-open:text-brand-600 dark:group-open:text-brand-400 transition-transform text-xs flex-shrink-0 ml-2">▼</span>
          </summary>
          <p class="text-sm text-ink-muted mt-2.5 leading-relaxed border-t border-line-subtle pt-2.5">
            Try the most common gateway IPs for your manufacturer (such as 192.168.1.1 or 192.168.0.1) with 'admin' / 'admin' or check the physical barcode sticker located underneath your device.
          </p>
        </details>

        <details class="group border border-line rounded-xl p-4 open:bg-slate-50/60 dark:open:bg-[#292a2d]/60 hover:border-slate-300 dark:hover:border-slate-700 transition-colors">
          <summary class="font-bold text-ink cursor-pointer list-none flex justify-between items-center text-xs sm:text-sm">
            <span class="flex items-center gap-2">
              <span class="text-accent font-black">Q.</span>
              Can I upgrade my router's firmware through the IP gateway?
            </span>
            <span class="text-ink-muted group-open:rotate-180 group-open:text-brand-600 dark:group-open:text-brand-400 transition-transform text-xs flex-shrink-0 ml-2">▼</span>
          </summary>
          <p class="text-sm text-ink-muted mt-2.5 leading-relaxed border-t border-line-subtle pt-2.5">
            Yes, once logged into your router's admin portal, navigate to System Tools or Administration -&gt; Firmware Upgrade to install the latest security patches from the manufacturer.
          </p>
        </details>
      </div>
    </section>

  </div>
</BaseLayout>
