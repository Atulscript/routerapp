---
import BaseLayout from '../layouts/BaseLayout.astro';
import RouterLookupTable from '../components/RouterLookupTable.astro';
import AdBanner from '../components/AdBanner.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';
import { BRANDS } from '../lib/data-loader';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "Router Hardware Models & Specs Database | 19216811.page";
const description = "Search and filter over 100+ wireless router hardware models. Find factory default IP gateways, protocols, usernames, passwords, and firmware specs.";
const keywords = [
  "router models database",
  "router hardware specs",
  "wifi router list",
  "router default logins",
  "router password database",
  "wireless router hardware",
  "modem default credentials"
];

const siteUrl = "https://atulscript.github.io/routerapp";

const allModels = BRANDS.flatMap(b => 
  b.models.map(m => ({
    brand: b.name,
    brandSlug: b.slug,
    model: m.model,
    protocol: m.protocol || 'HTTP',
    ip: m.ip,
    username: m.username,
    password: m.password
  }))
);

const schema = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Router Models",
        "item": `${siteUrl}/routers`
      }
    ]
  },
  {
    "@type": "ItemList",
    "name": "Wireless Router Hardware Database",
    "description": "Comprehensive specifications and default credentials for wireless routers.",
    "numberOfItems": allModels.length,
    "itemListElement": allModels.slice(0, 30).map((item, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": `${item.brand} ${item.model} (${item.ip} - ${item.username})`
    }))
  }
];
---

<BaseLayout 
  title={title} 
  description={description} 
  keywords={keywords}
  schema={schema}
  ogType="website"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 text-xs text-slate-400 font-medium">
      <a href={`${base}/`} class="hover:text-slate-900 transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-800 font-semibold truncate">Router Models</span>
    </nav>

    <!-- Header -->
    <header class="text-center max-w-xl mx-auto">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 text-slate-700 text-[11px] font-bold uppercase mb-2 border border-slate-200">
        📟 Hardware Catalog
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-2">
        Router Models Database
      </h1>
      <p class="text-xs sm:text-sm text-slate-600">
        Lookup default credentials for {allModels.length} router models across {BRANDS.length} manufacturers with protocol specifications.
      </p>
    </header>

    <AdBanner format="leaderboard" />

    <!-- Interactive Lookup Component -->
    <div class="bg-white rounded-2xl p-4 sm:p-6 border border-slate-200/90 shadow-card">
      <RouterLookupTable />
    </div>

    <AdBanner format="horizontal" />

    <!-- Master Models Table with Instant Filter -->
    <section class="bg-white rounded-2xl p-4 sm:p-6 border border-slate-200/90 shadow-card space-y-3.5">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div>
          <h2 class="text-base font-bold text-slate-900">Complete Master Hardware List</h2>
          <p class="text-xs text-slate-500">Filter by typing any model, brand, or IP address</p>
        </div>
        <input 
          type="text" 
          id="model-filter-input" 
          placeholder="Filter models (e.g. Archer, AX)..." 
          class="w-full sm:w-60 px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:border-brand-500 focus:bg-white outline-none"
        />
      </div>

      <div class="overflow-x-auto rounded-xl border border-slate-200/90 max-h-96 overflow-y-auto custom-scrollbar">
        <table class="w-full text-left text-xs text-slate-800" id="all-models-master-table">
          <thead class="sticky top-0 bg-slate-900 font-semibold uppercase tracking-wider text-[11px] text-white z-10 shadow-2xs">
            <tr>
              <th class="py-2.5 px-3">Brand</th>
              <th class="py-2.5 px-3">Model</th>
              <th class="py-2.5 px-3">Default IP</th>
              <th class="py-2.5 px-3">Protocol</th>
              <th class="py-2.5 px-3">Username</th>
              <th class="py-2.5 px-3 text-right">Password</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 font-mono text-xs" id="master-table-body">
            {allModels.map(item => {
              const ipSlug = item.ip === '192.168.1.1' ? '' : item.ip.replace(/\./g, '-');
              const ipUrl = ipSlug === '' ? `${base}/` : `${base}/${ipSlug}`;
              return (
                <tr class="hover:bg-sky-50/70 master-row">
                  <td class="py-2 px-3 font-bold font-sans text-slate-900">
                    <a href={`${base}/${item.brandSlug}`} class="text-brand-700 hover:text-brand-900 hover:underline">
                      {item.brand}
                    </a>
                  </td>
                  <td class="py-2 px-3 font-sans font-medium text-slate-800">{item.model}</td>
                  <td class="py-2 px-3 font-bold">
                    <div class="inline-flex items-center gap-1">
                      <a href={ipUrl} class="text-brand-600 hover:underline">
                        {item.ip}
                      </a>
                      <a href={`http://${item.ip}`} target="_blank" rel="noopener noreferrer" class="text-[10px] text-slate-400 hover:text-brand-600">
                        ↗
                      </a>
                    </div>
                  </td>
                  <td class="py-2 px-3 text-slate-500 text-[11px]">{item.protocol}</td>
                  <td class="py-2 px-3 text-slate-700">{item.username}</td>
                  <td class="py-2 px-3 font-bold text-slate-900 text-right">{item.password}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Practical Hardware Guide Section -->
    <section class="bg-white rounded-2xl p-4 sm:p-6 border border-slate-200/90 shadow-card space-y-3">
      <h2 class="text-base font-bold text-slate-900">How Model Numbers Affect Default Credentials</h2>
      <p class="text-xs text-slate-600 leading-relaxed">
        Manufacturers often update factory credentials across firmware generations. For example, older TP-Link units default to <code>admin/admin</code>, while newer Archer AX WiFi 6 routers require you to establish a secure administrator password upon first connection.
      </p>
    </section>

    <!-- Interlinking 2-Column Grid -->
    <div>
      <RelatedLinksGrid />
    </div>

  </div>
</BaseLayout>

<script>
  const filterInput = document.getElementById('model-filter-input') as HTMLInputElement;
  const rows = document.querySelectorAll('.master-row');

  filterInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase();
    rows.forEach((row) => {
      const text = (row as HTMLElement).innerText.toLowerCase();
      (row as HTMLElement).style.display = text.includes(query) ? '' : 'none';
    });
  });
</script>
