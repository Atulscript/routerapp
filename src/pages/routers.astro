---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import RouterLookupTable from '../components/RouterLookupTable.astro';
import AdBanner from '../components/AdBanner.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';
import { BRANDS } from '../lib/data-loader';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "Router Hardware & Models Database | Default Logins & Protocols | 19216811.page";
const description = "Search and filter router hardware models across all manufacturers. Find factory default IP addresses, protocols, usernames, and passwords.";

const allModels = BRANDS.flatMap(b => 
  b.models.map(m => ({
    brand: b.name,
    brandSlug: b.slug,
    model: m.model,
    protocol: m.protocol || 'HTTP',
    ip: m.ip,
    username: m.username,
    password: m.password
  }))
);
---

<BaseLayout title={title} description={description}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6 sm:space-y-8">
    
    <!-- Search Bar -->
    <div>
      <SearchBar />
    </div>

    <!-- Header -->
    <header class="text-center max-w-xl mx-auto">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-md-primary-container text-md-on-primary-container text-[11px] font-bold uppercase mb-2 border border-md-primary/20">
        📟 Hardware Catalog
      </div>
      <h1 class="text-2xl sm:text-4xl font-black text-md-on-surface tracking-tight mb-2">
        Router Models Database
      </h1>
      <p class="text-xs sm:text-sm text-md-on-surface-variant">
        Lookup default credentials for {allModels.length} router models across {BRANDS.length} manufacturers with protocol specifications.
      </p>
    </header>

    <AdBanner format="leaderboard" />

    <!-- Interactive Lookup Component -->
    <div>
      <RouterLookupTable />
    </div>

    <AdBanner format="horizontal" />

    <!-- Master Models Table with Instant Filter -->
    <section class="m3-card-compact space-y-4">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div>
          <h2 class="text-lg font-bold text-md-on-surface">Complete Master Hardware List</h2>
          <p class="text-xs text-md-on-surface-variant">Filter by typing any model, brand, or IP address</p>
        </div>
        <input 
          type="text" 
          id="model-filter-input" 
          placeholder="Filter models (e.g. Archer, AX)..." 
          class="w-full sm:w-64 px-3 py-1.5 bg-md-surface-container-low border border-md-outline-variant/60 rounded-m3-md text-xs font-semibold focus:border-md-primary focus:bg-white outline-none"
        />
      </div>

      <div class="overflow-x-auto rounded-m3-md border border-md-outline-variant/40 max-h-96 overflow-y-auto custom-scrollbar">
        <table class="w-full text-left text-xs text-md-on-surface" id="all-models-master-table">
          <thead class="sticky top-0 bg-md-surface-container-high font-bold uppercase tracking-wider text-[11px] text-md-on-surface-variant border-b border-md-outline-variant/40 z-10 shadow-2xs">
            <tr>
              <th class="p-2.5">Brand</th>
              <th class="p-2.5">Model</th>
              <th class="p-2.5">Default IP</th>
              <th class="p-2.5">Protocol</th>
              <th class="p-2.5">Username</th>
              <th class="p-2.5">Password</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-md-outline-variant/20 font-mono text-xs" id="master-table-body">
            {allModels.map(item => (
              <tr class="hover:bg-md-surface-container-low master-row">
                <td class="p-2.5 font-bold font-sans text-md-on-surface">{item.brand}</td>
                <td class="p-2.5 font-sans font-medium text-md-on-surface">{item.model}</td>
                <td class="p-2.5 text-md-primary font-bold">{item.ip}</td>
                <td class="p-2.5 text-md-on-surface-variant text-[11px]">{item.protocol}</td>
                <td class="p-2.5">{item.username}</td>
                <td class="p-2.5 font-bold text-md-on-surface">{item.password}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Practical Hardware Guide Section -->
    <section class="m3-card-compact space-y-3">
      <h2 class="text-base font-bold text-md-on-surface">How Model Numbers Affect Default Credentials</h2>
      <p class="text-xs text-md-on-surface-variant leading-relaxed">
        Manufacturers often update factory credentials across firmware generations. For example, older TP-Link units default to <code>admin/admin</code>, while newer Archer AX WiFi 6 routers require you to establish a secure administrator password upon first connection.
      </p>
    </section>

    <!-- Interlinking 2-Column Grid -->
    <div>
      <RelatedLinksGrid />
    </div>

  </div>
</BaseLayout>

<script>
  const filterInput = document.getElementById('model-filter-input') as HTMLInputElement;
  const rows = document.querySelectorAll('.master-row');

  filterInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase();
    rows.forEach((row) => {
      const text = (row as HTMLElement).innerText.toLowerCase();
      (row as HTMLElement).style.display = text.includes(query) ? '' : 'none';
    });
  });
</script>
