---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdBanner from '../components/AdBanner.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "Free Wi-Fi QR Code Generator (WPA/WPA2/WPA3) | 19216811.page";
const description = "Generate printable and scannable QR codes for instant Wi-Fi network sharing. Secure client-side generation supporting WPA, WPA2, WPA3, and Hidden SSIDs.";
const keywords = [
  "wifi qr code generator",
  "create wifi qr code",
  "qr code for wifi password",
  "scan to connect wifi",
  "wpa3 qr code",
  "free wifi qr generator",
  "print wifi qr code"
];

const siteUrl = "https://atulscript.github.io/routerapp";

const schema = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Network Tools",
        "item": `${siteUrl}/tools`
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Wi-Fi QR Generator",
        "item": `${siteUrl}/wifi-qr-generator`
      }
    ]
  },
  {
    "@type": "WebApplication",
    "name": "Free Wi-Fi QR Code Generator",
    "url": `${siteUrl}/wifi-qr-generator`,
    "description": description,
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "All",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  },
  {
    "@type": "HowTo",
    "name": "How to Create and Use a Wi-Fi QR Code",
    "description": "Steps to generate a scannable Wi-Fi QR code for guests to connect without entering passwords.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Enter Network Name",
        "text": "Type your exact Wi-Fi SSID name into the Network Name field.",
        "url": `${siteUrl}/wifi-qr-generator#ssid-input`
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Enter Password and Encryption",
        "text": "Choose your security mode (WPA/WPA2/WPA3) and enter your wireless security key.",
        "url": `${siteUrl}/wifi-qr-generator#wifi-pass-input`
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Scan with Phone Camera",
        "text": "Point your iPhone or Android camera at the generated QR code and tap Join Network.",
        "url": `${siteUrl}/wifi-qr-generator#qr-output`
      }
    ]
  },
  {
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is it safe to generate Wi-Fi QR codes online?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. The Wi-Fi QR code generation uses client-side parameter encoding. Your network SSID and password are never uploaded, logged, or stored on our servers."
        }
      },
      {
        "@type": "Question",
        "name": "Do iPhone and Android cameras support connecting via QR code natively?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, both iOS (iPhone camera) and modern Android devices have built-in QR scanner support in their default camera apps. Pointing the camera at the code triggers a prompt to join the Wi-Fi network."
        }
      },
      {
        "@type": "Question",
        "name": "What encryption type should I choose for modern routers?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Most routers use WPA2 or WPA3-Personal. Selecting WPA / WPA2 / WPA3 will work across 99% of contemporary wireless access points."
        }
      }
    ]
  }
];
---

<BaseLayout 
  title={title} 
  description={description} 
  keywords={keywords}
  schema={schema}
  ogType="website"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 text-xs text-slate-400 font-medium">
      <a href={`${base}/`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold truncate">WiFi QR Generator</span>
    </nav>

    <!-- Header -->
    <header class="text-center max-w-xl mx-auto">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 text-xs font-bold uppercase mb-2 border border-emerald-200/50 dark:border-emerald-800/50 shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        📶 Wireless Utility Tool
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-2">
        WiFi QR Code Generator
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
        Create a scannable QR code for your WiFi network so guests can connect instantly without typing passwords.
      </p>
    </header>

    <AdBanner format="leaderboard" />

    <!-- Generator Interface -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 bg-white dark:bg-slate-900 rounded-2xl p-6 sm:p-8 border border-slate-200/90 dark:border-slate-800 shadow-card transition-colors">
      
      <!-- Controls (7 cols) -->
      <div class="md:col-span-7 space-y-3.5">
        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1">
            Network Name (SSID) *
          </label>
          <input 
            type="text" 
            id="ssid-input" 
            placeholder="e.g. MyHome_WiFi_5G" 
            class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border border-slate-300/80 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white text-xs font-semibold focus:border-brand-500 focus:bg-white dark:focus:bg-slate-750 focus:ring-2 focus:ring-brand-500/15 outline-none"
            value="HomeNetwork_5G"
          />
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1">
            WiFi Password *
          </label>
          <input 
            type="text" 
            id="password-input" 
            placeholder="Enter your WiFi password" 
            class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border border-slate-300/80 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white text-xs font-mono focus:border-brand-500 focus:bg-white dark:focus:bg-slate-750 focus:ring-2 focus:ring-brand-500/15 outline-none"
            value="SuperSecretPassword123"
          />
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1">
            Security Encryption
          </label>
          <select 
            id="encryption-select" 
            class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border border-slate-300/80 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white text-xs font-semibold focus:border-brand-500 focus:bg-white dark:focus:bg-slate-750 outline-none cursor-pointer"
          >
            <option value="WPA">WPA / WPA2 / WPA3 (Standard)</option>
            <option value="WEP">WEP (Older routers)</option>
            <option value="nopass">None (Open Network)</option>
          </select>
        </div>

        <div class="flex items-center gap-2 pt-0.5">
          <input type="checkbox" id="hidden-check" class="w-3.5 h-3.5 rounded text-slate-900 dark:text-brand-500 border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 cursor-pointer" />
          <label for="hidden-check" class="text-[11px] font-medium text-slate-600 dark:text-slate-400 cursor-pointer">
            Hidden network (SSID not broadcasted)
          </label>
        </div>

        <button 
          id="generate-btn" 
          type="button"
          class="w-full py-2.5 px-4 rounded-xl bg-slate-900 dark:bg-brand-600 hover:bg-slate-800 dark:hover:bg-brand-500 text-white font-semibold text-xs shadow-xs transition-all active:scale-[0.99] cursor-pointer"
        >
          Generate WiFi QR Code
        </button>
      </div>

      <!-- Preview (5 cols) -->
      <div class="md:col-span-5 flex flex-col items-center justify-center p-4 bg-slate-50 dark:bg-slate-800/60 rounded-xl border border-slate-100 dark:border-slate-800 text-center">
        <div class="p-3 bg-white rounded-xl border border-slate-200 dark:border-slate-700 shadow-2xs mb-2.5">
          <img 
            id="qr-image" 
            src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=WIFI:S:HomeNetwork_5G;T:WPA;P:SuperSecretPassword123;;" 
            alt="Generated WiFi QR Code" 
            class="w-36 h-36 object-contain"
          />
        </div>
        <div class="text-[11px] font-mono text-slate-700 dark:text-slate-300 font-bold truncate max-w-[180px]" id="preview-ssid">
          SSID: HomeNetwork_5G
        </div>
        <p class="text-[10px] text-slate-400 dark:text-slate-500 mt-0.5">Scan with iPhone Camera or Google Lens</p>
      </div>

    </div>

    <AdBanner format="horizontal" />

    <!-- Instructions / Guide -->
    <section class="bg-white dark:bg-slate-900 rounded-2xl p-4 sm:p-6 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-3 transition-colors">
      <h2 class="text-base font-bold text-slate-900 dark:text-white">How to Connect to WiFi Using a QR Code</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-slate-600 dark:text-slate-300">
        <div class="p-3 bg-slate-50 dark:bg-slate-800/60 rounded-xl border border-slate-100 dark:border-slate-800">
          <strong class="text-slate-900 dark:text-white block font-semibold mb-1">📱 iPhone & iPad (iOS)</strong>
          Open your standard Camera app and point it at the QR code. Tap the yellow <strong>"Join [Network]"</strong> banner that appears on screen.
        </div>
        <div class="p-3 bg-slate-50 dark:bg-slate-800/60 rounded-xl border border-slate-100 dark:border-slate-800">
          <strong class="text-slate-900 dark:text-white block font-semibold mb-1">🤖 Android Devices</strong>
          Open your Camera or Google Lens app and focus on the code. Tap <strong>"Connect to Network"</strong> to join automatically.
        </div>
      </div>
    </section>

    <!-- Interlinking 2-Column Grid -->
    <div>
      <RelatedLinksGrid />
    </div>

    <!-- FAQ Accordion (Positioned Just Above Footer) -->
    <section class="bg-white dark:bg-slate-900 rounded-2xl p-5 sm:p-6 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-4">
      <h2 class="text-lg font-bold text-slate-900 dark:text-white">WiFi QR Code FAQs</h2>
      <div class="divide-y divide-slate-100 dark:divide-slate-800 text-xs">
        <div class="py-3">
          <strong class="text-slate-900 dark:text-slate-100 text-xs block font-semibold mb-1">Is it safe to generate Wi-Fi QR codes online?</strong>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            Yes. The Wi-Fi QR code generation uses client-side parameter encoding. Your network SSID and password are never uploaded, logged, or stored on our servers.
          </p>
        </div>
        <div class="py-3">
          <strong class="text-slate-900 dark:text-slate-100 text-xs block font-semibold mb-1">Do iPhone and Android cameras support connecting via QR code natively?</strong>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            Yes, both iOS (iPhone camera) and modern Android devices have built-in QR scanner support in their default camera apps. Pointing the camera at the code triggers a prompt to join the Wi-Fi network.
          </p>
        </div>
        <div class="py-3">
          <strong class="text-slate-900 dark:text-slate-100 text-xs block font-semibold mb-1">What encryption type should I choose for modern routers?</strong>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            Most routers use WPA2 or WPA3-Personal. Selecting WPA / WPA2 / WPA3 will work across 99% of contemporary wireless access points.
          </p>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  function updateQrCode() {
    const ssid = (document.getElementById('ssid-input') as HTMLInputElement)?.value.trim() || '';
    const pass = (document.getElementById('password-input') as HTMLInputElement)?.value.trim() || '';
    const enc = (document.getElementById('encryption-select') as HTMLSelectElement)?.value || 'WPA';
    const isHidden = (document.getElementById('hidden-check') as HTMLInputElement)?.checked ? 'H:true;' : '';

    const qrData = `WIFI:S:${ssid};T:${enc};P:${pass};${isHidden};`;
    const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=${encodeURIComponent(qrData)}`;

    const qrImg = document.getElementById('qr-image') as HTMLImageElement;
    const previewSsid = document.getElementById('preview-ssid');

    if (qrImg) qrImg.src = qrUrl;
    if (previewSsid) previewSsid.innerText = `SSID: ${ssid}`;
  }

  document.getElementById('generate-btn')?.addEventListener('click', updateQrCode);
  document.getElementById('ssid-input')?.addEventListener('input', updateQrCode);
  document.getElementById('password-input')?.addEventListener('input', updateQrCode);
  document.getElementById('encryption-select')?.addEventListener('change', updateQrCode);
  document.getElementById('hidden-check')?.addEventListener('change', updateQrCode);
</script>
