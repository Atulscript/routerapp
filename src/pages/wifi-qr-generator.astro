---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdBanner from '../components/AdBanner.astro';
import SearchBar from '../components/SearchBar.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "Free WiFi QR Code Generator | Connect Without Password Typing | 19216811.page";
const description = "Generate a customized WiFi QR code to easily share your home or office wireless network. Guests can scan with iPhone or Android camera to connect instantly.";
---

<BaseLayout title={title} description={description}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6">
    
    <!-- Search Bar -->
    <div>
      <SearchBar />
    </div>

    <!-- Header -->
    <header class="text-center max-w-xl mx-auto">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-[11px] font-bold uppercase mb-2 border border-emerald-200">
        📶 Wireless Utility Tool
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-2">
        WiFi QR Code Generator
      </h1>
      <p class="text-xs sm:text-sm text-slate-600">
        Create a scannable QR code for your WiFi network so guests can connect instantly without typing passwords.
      </p>
    </header>

    <AdBanner format="leaderboard" />

    <!-- Generator Interface -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5 bg-white rounded-2xl p-5 sm:p-7 border border-slate-200/90 shadow-card">
      
      <!-- Controls (7 cols) -->
      <div class="md:col-span-7 space-y-3.5">
        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">
            Network Name (SSID) *
          </label>
          <input 
            type="text" 
            id="ssid-input" 
            placeholder="e.g. MyHome_WiFi_5G" 
            class="w-full px-3 py-2 bg-slate-50 border border-slate-300/80 rounded-xl text-slate-900 text-xs font-semibold focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-500/15 outline-none"
            value="HomeNetwork_5G"
          />
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">
            WiFi Password *
          </label>
          <input 
            type="text" 
            id="password-input" 
            placeholder="Enter your WiFi password" 
            class="w-full px-3 py-2 bg-slate-50 border border-slate-300/80 rounded-xl text-slate-900 text-xs font-mono focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-500/15 outline-none"
            value="SuperSecretPassword123"
          />
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">
            Security Encryption
          </label>
          <select 
            id="encryption-select" 
            class="w-full px-3 py-2 bg-slate-50 border border-slate-300/80 rounded-xl text-slate-900 text-xs font-semibold focus:border-brand-500 focus:bg-white outline-none cursor-pointer"
          >
            <option value="WPA">WPA / WPA2 / WPA3 (Standard)</option>
            <option value="WEP">WEP (Older routers)</option>
            <option value="nopass">None (Open Network)</option>
          </select>
        </div>

        <div class="flex items-center gap-2 pt-0.5">
          <input type="checkbox" id="hidden-check" class="w-3.5 h-3.5 rounded text-slate-900 border-slate-300 cursor-pointer" />
          <label for="hidden-check" class="text-[11px] font-medium text-slate-600 cursor-pointer">
            Hidden network (SSID not broadcasted)
          </label>
        </div>

        <button 
          id="generate-btn" 
          type="button"
          class="w-full py-2.5 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs shadow-xs transition-all active:scale-[0.99]"
        >
          Generate WiFi QR Code
        </button>
      </div>

      <!-- Preview (5 cols) -->
      <div class="md:col-span-5 flex flex-col items-center justify-center p-4 bg-slate-50 rounded-xl border border-slate-100 text-center">
        <div class="p-3 bg-white rounded-xl border border-slate-200 shadow-2xs mb-2.5">
          <img 
            id="qr-image" 
            src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=WIFI:S:HomeNetwork_5G;T:WPA;P:SuperSecretPassword123;;" 
            alt="Generated WiFi QR Code" 
            class="w-36 h-36 object-contain"
          />
        </div>
        <div class="text-[11px] font-mono text-slate-700 font-bold truncate max-w-[180px]" id="preview-ssid">
          SSID: HomeNetwork_5G
        </div>
        <p class="text-[10px] text-slate-400 mt-0.5">Scan with iPhone Camera or Google Lens</p>
      </div>

    </div>

    <AdBanner format="horizontal" />

    <!-- Instructions / Guide -->
    <section class="bg-white rounded-2xl p-4 sm:p-6 border border-slate-200/90 shadow-card space-y-3">
      <h2 class="text-base font-bold text-slate-900">How to Connect to WiFi Using a QR Code</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-slate-600">
        <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
          <strong class="text-slate-900 block font-semibold mb-1">📱 iPhone & iPad (iOS)</strong>
          Open your standard Camera app and point it at the QR code. Tap the yellow <strong>"Join [Network]"</strong> banner that appears on screen.
        </div>
        <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
          <strong class="text-slate-900 block font-semibold mb-1">🤖 Android Devices</strong>
          Open your Camera or Google Lens app and focus on the code. Tap <strong>"Connect to Network"</strong> to join automatically.
        </div>
      </div>
    </section>

    <!-- Interlinking 2-Column Grid -->
    <div>
      <RelatedLinksGrid />
    </div>

  </div>
</BaseLayout>

<script>
  function updateQrCode() {
    const ssid = (document.getElementById('ssid-input') as HTMLInputElement)?.value.trim() || '';
    const pass = (document.getElementById('password-input') as HTMLInputElement)?.value.trim() || '';
    const enc = (document.getElementById('encryption-select') as HTMLSelectElement)?.value || 'WPA';
    const isHidden = (document.getElementById('hidden-check') as HTMLInputElement)?.checked ? 'H:true;' : '';

    const qrData = `WIFI:S:${ssid};T:${enc};P:${pass};${isHidden};`;
    const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=${encodeURIComponent(qrData)}`;

    const qrImg = document.getElementById('qr-image') as HTMLImageElement;
    const previewSsid = document.getElementById('preview-ssid');

    if (qrImg) qrImg.src = qrUrl;
    if (previewSsid) previewSsid.innerText = `SSID: ${ssid}`;
  }

  document.getElementById('generate-btn')?.addEventListener('click', updateQrCode);
  document.getElementById('ssid-input')?.addEventListener('input', updateQrCode);
  document.getElementById('password-input')?.addEventListener('input', updateQrCode);
  document.getElementById('encryption-select')?.addEventListener('change', updateQrCode);
  document.getElementById('hidden-check')?.addEventListener('change', updateQrCode);
</script>
