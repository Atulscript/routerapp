---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdBanner from '../components/AdBanner.astro';
import SearchBar from '../components/SearchBar.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "Free WiFi QR Code Generator | Connect Without Password Typing";
const description = "Generate a customized WiFi QR code to easily share your home or office wireless network. Guests can scan with iPhone or Android camera to connect instantly.";
---

<BaseLayout title={title} description={description}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    
    <!-- Search Bar -->
    <div class="mb-8">
      <SearchBar />
    </div>

    <!-- Header -->
    <header class="text-center max-w-2xl mx-auto mb-8">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-xs font-bold uppercase mb-3 border border-emerald-200">
        📶 Wireless Utility Tool
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
        WiFi QR Code Generator
      </h1>
      <p class="text-sm sm:text-base text-slate-600">
        Create a scannable QR code for your WiFi network so friends and guests can connect instantly without typing complicated passwords.
      </p>
    </header>

    <AdBanner format="leaderboard" />

    <!-- Generator Interface -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-xl shadow-slate-100 my-8">
      
      <!-- Controls (7 cols) -->
      <div class="md:col-span-7 space-y-5">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Network Name (SSID) *
          </label>
          <input 
            type="text" 
            id="ssid-input" 
            placeholder="e.g. MyHome_WiFi_5G" 
            class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 text-sm font-semibold focus:border-sky-600 focus:bg-white focus:ring-2 focus:ring-sky-500/20 outline-none"
            value="HomeNetwork_5G"
          />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            WiFi Password *
          </label>
          <input 
            type="text" 
            id="password-input" 
            placeholder="Enter your WiFi password" 
            class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 text-sm font-mono focus:border-sky-600 focus:bg-white focus:ring-2 focus:ring-sky-500/20 outline-none"
            value="SuperSecretPassword123"
          />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Security Encryption
          </label>
          <select 
            id="encryption-select" 
            class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 text-sm font-semibold focus:border-sky-600 focus:bg-white focus:ring-2 focus:ring-sky-500/20 outline-none cursor-pointer"
          >
            <option value="WPA">WPA / WPA2 / WPA3 (Default for most routers)</option>
            <option value="WEP">WEP (Older routers)</option>
            <option value="nopass">None (Open Network)</option>
          </select>
        </div>

        <div class="flex items-center gap-2 pt-2">
          <input type="checkbox" id="hidden-check" class="w-4 h-4 rounded text-sky-600 focus:ring-sky-500 border-slate-300 cursor-pointer" />
          <label for="hidden-check" class="text-xs font-medium text-slate-700 cursor-pointer">
            This is a hidden network (SSID not broadcasted)
          </label>
        </div>

        <button 
          id="generate-btn" 
          class="w-full py-3.5 px-6 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-bold text-sm shadow-md shadow-sky-500/20 transition-all hover:scale-[1.01] active:scale-[0.99]"
        >
          Generate WiFi QR Code
        </button>
      </div>

      <!-- Preview (5 cols) -->
      <div class="md:col-span-5 flex flex-col items-center justify-center p-6 bg-slate-50 rounded-2xl border border-slate-200 text-center">
        <div class="p-4 bg-white rounded-2xl border border-slate-200 shadow-sm mb-4">
          <img 
            id="qr-image" 
            src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=WIFI:S:HomeNetwork_5G;T:WPA;P:SuperSecretPassword123;;" 
            alt="WiFi QR Code"
            class="w-48 h-48 rounded-lg"
          />
        </div>
        <p class="text-xs text-slate-500 mb-3 font-medium">Scan with your smartphone camera to connect</p>
        <button 
          id="print-btn" 
          class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-bold shadow-sm transition-all"
        >
          🖨️ Print WiFi Card
        </button>
      </div>

    </div>

    <AdBanner format="horizontal" />

    <!-- SEO Content Section -->
    <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm space-y-6 mt-10">
      <h2 class="text-2xl font-bold text-slate-900">How Does WiFi QR Code Sharing Work?</h2>
      <p class="text-sm text-slate-600 leading-relaxed">
        When smartphones scan a standardized WiFi QR code format (<code class="font-mono text-xs bg-slate-100 p-1 rounded">WIFI:S:&lt;SSID&gt;;T:&lt;Security&gt;;P:&lt;Password&gt;;;</code>), iOS (iPhone) and Android recognize the network credentials automatically and display a single-tap <em>"Join Network"</em> prompt.
      </p>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2 text-xs">
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
          <strong class="text-slate-900 block mb-1">🔒 100% Client-Side Safe</strong>
          Your WiFi password is never stored on external servers.
        </div>
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
          <strong class="text-slate-900 block mb-1">📱 Works on iOS & Android</strong>
          Native support in standard Camera apps.
        </div>
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
          <strong class="text-slate-900 block mb-1">⚡ Instant Connection</strong>
          No need to read out 20-character passwords to visitors.
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  function updateQr() {
    const ssid = (document.getElementById('ssid-input') as HTMLInputElement)?.value || '';
    const password = (document.getElementById('password-input') as HTMLInputElement)?.value || '';
    const encryption = (document.getElementById('encryption-select') as HTMLSelectElement)?.value || 'WPA';
    const isHidden = (document.getElementById('hidden-check') as HTMLInputElement)?.checked;

    const qrData = `WIFI:S:${ssid};T:${encryption};P:${password};${isHidden ? 'H:true;' : ''};`;
    const encoded = encodeURIComponent(qrData);
    const img = document.getElementById('qr-image') as HTMLImageElement;
    if (img) {
      img.src = `https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=${encoded}`;
    }
  }

  document.getElementById('generate-btn')?.addEventListener('click', updateQr);
  document.getElementById('ssid-input')?.addEventListener('input', updateQr);
  document.getElementById('password-input')?.addEventListener('input', updateQr);
  document.getElementById('encryption-select')?.addEventListener('change', updateQr);
  document.getElementById('hidden-check')?.addEventListener('change', updateQr);

  document.getElementById('print-btn')?.addEventListener('click', () => {
    window.print();
  });
</script>
