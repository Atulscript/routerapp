---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import RouterLookupTable from '../components/RouterLookupTable.astro';
import RouterGuideCard from '../components/RouterGuideCard.astro';
import BrandCard from '../components/BrandCard.astro';
import IspCard from '../components/IspCard.astro';
import AdBanner from '../components/AdBanner.astro';
import { GATEWAY_IPS, BRANDS, ISPS } from '../lib/data-loader';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "192.168.1.1 Router Login, Admin Setup & Passwords | 19216811.page";
const description = "19216811.page: Access your router admin panel at 192.168.1.1. Default usernames, passwords, WiFi setup guides, and troubleshooting for TP-Link, Netgear, ASUS, JioFiber, and Airtel.";

const currentIp = GATEWAY_IPS.find(i => i.ip === '192.168.1.1') || GATEWAY_IPS[0];
const otherIps = GATEWAY_IPS.filter(i => i.ip !== '192.168.1.1');

// Rich Schema.org markup (TechArticle + FAQPage)
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "19216811.page",
      "url": "https://atulscript.github.io/routerapp",
      "description": description
    },
    {
      "@type": "TechArticle",
      "headline": title,
      "description": description,
      "url": "https://atulscript.github.io/routerapp",
      "author": {
        "@type": "Organization",
        "name": "19216811.page Network Research"
      },
      "articleBody": currentIp.steps.join(' ')
    },
    {
      "@type": "FAQPage",
      "mainEntity": currentIp.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  
  <!-- Modern Sleek Hero Section -->
  <section class="relative bg-gradient-to-b from-white via-slate-50 to-slate-100/60 py-6 sm:py-10 border-b border-slate-200/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      
      <!-- Minimalist Status Pill -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-slate-200/90 text-slate-700 text-xs font-semibold tracking-tight mb-3 shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>19216811.page</span>
        <span class="text-slate-300">|</span>
        <span class="text-slate-500 font-normal">Default Router Gateway Portal</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight mb-2 font-sans">
        192.168.1.1 <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-600 to-sky-600">Router Admin Login</span>
      </h1>
      
      <p class="text-xs sm:text-sm text-slate-600 max-w-lg mx-auto mb-5 leading-relaxed">
        Access your wireless router and modem dashboard at <strong>http://192.168.1.1</strong>. Lookup default factory passwords, configure Wi-Fi security, and fix connection errors.
      </p>

      <!-- Primary 192.168.1.1 Clean Command Card -->
      <div class="bg-white rounded-2xl p-4 sm:p-5 text-slate-900 shadow-card border border-slate-200/90 max-w-xl mx-auto mb-4 text-left">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400 block">Default Gateway Address</span>
            <div class="text-2xl sm:text-3xl font-mono font-extrabold mt-0.5 tracking-tight text-slate-900">
              192.168.1.1
            </div>
            <div class="mt-2 flex flex-wrap gap-1.5 text-xs font-mono">
              <span class="bg-slate-100 px-2.5 py-0.5 rounded-md text-slate-700 font-medium">User: <strong>admin</strong></span>
              <span class="bg-slate-100 px-2.5 py-0.5 rounded-md text-slate-700 font-medium">Pass: <strong>admin / password</strong></span>
            </div>
          </div>
          
          <a 
            href="http://192.168.1.1" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold whitespace-nowrap shadow-xs hover:shadow-sm transition-all active:scale-95 w-full sm:w-auto"
          >
            <span>Open 192.168.1.1</span>
            <span class="text-sky-300">↗</span>
          </a>
        </div>
      </div>

      <!-- Spotlight Search Bar -->
      <div class="max-w-xl mx-auto">
        <SearchBar />
      </div>

      <!-- Common Gateways Quick Links -->
      <div class="mt-3 flex flex-wrap items-center justify-center gap-1.5 text-xs">
        <span class="text-slate-400 font-medium text-[11px]">Other Gateways:</span>
        {otherIps.map(item => (
          <a 
            href={`${base}/${item.slug}`} 
            class="px-2.5 py-0.5 rounded-full bg-white border border-slate-200/80 text-slate-700 text-[11px] font-mono font-semibold hover:border-brand-500 hover:text-brand-600 transition-colors shadow-2xs"
          >
            {item.ip}
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- Leaderboard Ad Slot -->
  <div class="max-w-5xl mx-auto px-4 pt-4">
    <AdBanner format="leaderboard" />
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 space-y-8">
    
    <!-- 1. Interactive Brand & Model Password Table -->
    <section class="bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-6 shadow-card">
      <div class="max-w-2xl mb-2">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-sky-50 border border-sky-200 text-brand-700 text-[10px] font-bold uppercase tracking-wider">
          🔑 Brand Password Database
        </div>
        <h2 class="text-lg sm:text-xl font-extrabold text-slate-900 tracking-tight mt-1.5">
          Find Default Passwords by Router Brand
        </h2>
        <p class="text-xs text-slate-500 mt-0.5 leading-relaxed">
          Select your manufacturer to view default factory credentials, management IP, and protocol.
        </p>
      </div>

      <RouterLookupTable />
    </section>

    <!-- In-Content Ad Slot -->
    <AdBanner format="horizontal" />

    <!-- 2. Router Login & Support Two-Box Guide -->
    <RouterGuideCard 
      entityName="Wireless" 
      ipAddress="192.168.1.1" 
      brandName="TP-Link, Netgear, ASUS, D-Link" 
    />

    <!-- 3. Popular Router Brands That Use 192.168.1.1 -->
    <section>
      <div class="flex items-center justify-between mb-3.5">
        <div>
          <h2 class="text-lg font-bold text-slate-900 tracking-tight">Popular Router Brands</h2>
          <p class="text-xs text-slate-500">Default passwords and setup tutorials by manufacturer</p>
        </div>
        <a href={`${base}/brands`} class="text-xs font-semibold text-brand-600 hover:underline flex items-center gap-1">
          <span>All Brands</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {BRANDS.slice(0, 9).map(item => (
          <BrandCard data={item} />
        ))}
      </div>
    </section>

    <!-- 4. ISP Fiber ONT Configuration Section -->
    <section>
      <div class="flex items-center justify-between mb-3.5">
        <div>
          <h2 class="text-lg font-bold text-slate-900 tracking-tight">ISP Fiber Gateway Guides</h2>
          <p class="text-xs text-slate-500">Dedicated configuration guides for JioFiber, Airtel Xstream, BSNL, and ACT</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {ISPS.map(item => (
          <IspCard data={item} />
        ))}
      </div>
    </section>

    <!-- 5. Network Security & Router Hardening -->
    <section class="bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-6 shadow-card space-y-3.5">
      <div>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 text-[10px] font-bold uppercase tracking-wider">
          🛡️ Security Best Practices
        </span>
        <h2 class="text-lg font-bold text-slate-900 tracking-tight mt-1">
          Essential Security Steps After Logging into 192.168.1.1
        </h2>
        <p class="text-xs text-slate-500 mt-0.5 leading-relaxed">
          Follow these key security best practices to protect your network from unauthorized access:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 pt-1">
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
          <span class="text-base">🔒</span>
          <h3 class="font-bold text-xs text-slate-900">1. Change Factory Passwords</h3>
          <p class="text-[11px] text-slate-600 leading-relaxed">
            Never leave <code class="font-mono bg-white px-1 py-0.5 rounded border text-[10px]">admin/admin</code> active. Set a custom 16+ character passphrase under Administration.
          </p>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
          <span class="text-base">📶</span>
          <h3 class="font-bold text-xs text-slate-900">2. Upgrade to WPA3 / WPA2-AES</h3>
          <p class="text-[11px] text-slate-600 leading-relaxed">
            Avoid outdated WEP or TKIP modes. Use WPA3-Personal or WPA2-PSK (AES) for strong encryption.
          </p>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
          <span class="text-base">🚫</span>
          <h3 class="font-bold text-xs text-slate-900">3. Disable WPS & Remote WAN</h3>
          <p class="text-[11px] text-slate-600 leading-relaxed">
            Disable Wi-Fi Protected Setup (WPS PIN) and turn off Remote WAN Management to prevent external access.
          </p>
        </div>
      </div>
    </section>

    <!-- Quick Diagnostic: Finding Router IP on Any OS -->
    <section class="bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-6 shadow-card space-y-3.5">
      <div>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 text-[10px] font-bold uppercase tracking-wider">
          🔍 Quick Diagnostic
        </span>
        <h2 class="text-lg font-bold text-slate-900 tracking-tight mt-1">
          How to Find Your Default Gateway IP Address
        </h2>
        <p class="text-xs text-slate-500 mt-0.5 leading-relaxed">
          Your device automatically receives your router's default gateway address when connected:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 text-xs">
        <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
          <strong class="text-slate-900 font-bold block text-xs">💻 Windows</strong>
          <p class="text-slate-600 leading-relaxed text-[11px]">
            Press <kbd class="px-1 py-0.5 bg-white border rounded font-mono text-[9px]">Win + R</kbd>, run <code class="font-mono bg-white px-1 py-0.5 rounded text-[10px]">cmd</code>, type <code class="font-mono bg-white px-1 py-0.5 rounded font-bold text-brand-700 text-[10px]">ipconfig</code>. Check <strong>Default Gateway</strong>.
          </p>
        </div>

        <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
          <strong class="text-slate-900 font-bold block text-xs">🍎 macOS</strong>
          <p class="text-slate-600 leading-relaxed text-[11px]">
            Open <strong>System Settings</strong> → <strong>Wi-Fi</strong> → click <strong>Details</strong> → <strong>TCP/IP</strong>. Check <strong>Router</strong>.
          </p>
        </div>

        <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
          <strong class="text-slate-900 font-bold block text-xs">📱 iPhone / iOS</strong>
          <p class="text-slate-600 leading-relaxed text-[11px]">
            Open <strong>Settings</strong> → <strong>Wi-Fi</strong> → tap <span class="font-bold font-mono">ⓘ</span> next to Wi-Fi. Scroll to <strong>Router</strong>.
          </p>
        </div>

        <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
          <strong class="text-slate-900 font-bold block text-xs">🤖 Android</strong>
          <p class="text-slate-600 leading-relaxed text-[11px]">
            Go to <strong>Settings</strong> → <strong>Wi-Fi</strong> → tap ⚙️ gear icon → <strong>Advanced</strong> to view <strong>Gateway</strong>.
          </p>
        </div>
      </div>
    </section>

    <!-- 6. Typo Warning Alert Box -->
    <section class="bg-amber-50/70 rounded-2xl p-4 sm:p-5 border border-amber-200/80 shadow-2xs">
      <div class="max-w-3xl">
        <div class="flex items-center gap-1.5 text-amber-900 font-bold text-sm mb-1">
          <span>⚠️</span> Avoid Common IP Typos (192.168.l.l vs 192.168.1.1)
        </div>
        <p class="text-xs text-amber-800 leading-relaxed mb-2.5">
          IP addresses consist strictly of numbers. Typing letters like "l" (lowercase L) or "o" (letter O) will trigger a web search error:
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs font-mono font-bold">
          <div class="bg-white/95 p-2 rounded-lg border border-amber-200 flex flex-col shadow-2xs text-[11px]">
            <span class="text-red-500 line-through">192.168.l.l</span>
            <span class="text-emerald-700 font-bold">✓ 192.168.1.1</span>
          </div>
          <div class="bg-white/95 p-2 rounded-lg border border-amber-200 flex flex-col shadow-2xs text-[11px]">
            <span class="text-red-500 line-through">192.168.o.1</span>
            <span class="text-emerald-700 font-bold">✓ 192.168.0.1</span>
          </div>
          <div class="bg-white/95 p-2 rounded-lg border border-amber-200 flex flex-col shadow-2xs text-[11px]">
            <span class="text-red-500 line-through">19216811</span>
            <span class="text-emerald-700 font-bold">✓ 192.168.1.1</span>
          </div>
          <div class="bg-white/95 p-2 rounded-lg border border-amber-200 flex flex-col shadow-2xs text-[11px]">
            <span class="text-red-500 line-through">http 192.168 1.1</span>
            <span class="text-emerald-700 font-bold">✓ 192.168.1.1</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. 192.168.1.1 Troubleshooting & FAQ Section -->
    <section class="bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-6 shadow-card space-y-3.5">
      <div>
        <h2 class="text-lg font-bold text-slate-900 tracking-tight">
          Frequently Asked Questions & Troubleshooting
        </h2>
        <p class="text-xs text-slate-500 mt-0.5">
          Solutions for unreachable admin portals, IP address conflicts, and forgotten credentials
        </p>
      </div>

      <div class="space-y-2">
        {currentIp.faqs.map(faq => (
          <details class="group border border-slate-200/80 rounded-xl p-3.5 open:bg-slate-50/50 transition-colors">
            <summary class="font-bold text-slate-900 cursor-pointer list-none flex justify-between items-center text-xs sm:text-sm">
              {faq.question}
              <span class="text-slate-400 group-open:rotate-180 transition-transform text-xs">▼</span>
            </summary>
            <p class="text-xs text-slate-600 mt-2 leading-relaxed border-t border-slate-100 pt-2">
              {faq.answer}
            </p>
          </details>
        ))}

        <details class="group border border-slate-200/80 rounded-xl p-3.5 open:bg-slate-50/50 transition-colors">
          <summary class="font-bold text-slate-900 cursor-pointer list-none flex justify-between items-center text-xs sm:text-sm">
            How do I change the DNS servers on 192.168.1.1 for faster speeds?
            <span class="text-slate-400 group-open:rotate-180 transition-transform text-xs">▼</span>
          </summary>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed border-t border-slate-100 pt-2">
            In your router's <strong>DHCP / LAN Settings</strong>, set Primary DNS to <code class="font-mono bg-white px-1 py-0.5 rounded border">1.1.1.1</code> (Cloudflare) or <code class="font-mono bg-white px-1 py-0.5 rounded border">8.8.8.8</code> (Google), and Secondary DNS to <code class="font-mono bg-white px-1 py-0.5 rounded border">1.0.0.1</code> or <code class="font-mono bg-white px-1 py-0.5 rounded border">8.8.4.4</code>.
          </p>
        </details>
      </div>
    </section>

  </div>
</BaseLayout>
