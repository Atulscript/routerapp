---
import BaseLayout from '../layouts/BaseLayout.astro';
import RouterLookupTable from '../components/RouterLookupTable.astro';
import BrandCard from '../components/BrandCard.astro';
import AdBanner from '../components/AdBanner.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';
import RouterChecker from '../components/RouterChecker.astro';
import LoginStepper from '../components/LoginStepper.astro';
import { GATEWAY_IPS, BRANDS, ISPS, ROUTER_MODELS, formatModelTitle, getBrandsByPopularity, getBrandSlug } from '../lib/data-loader';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "192.168.1.1 Router Admin Login, Passwords & Setup Guide | 19216811.page";
const description = "Access 192.168.1.1 router admin dashboard. Verified factory usernames, default passwords, Wi-Fi setup guides, and troubleshooting for TP-Link, Netgear, ASUS, JioFiber & Airtel.";
const keywords = [
  "192.168.1.1",
  "192.168.1.1 login",
  "192.168.1.1 admin",
  "router admin login",
  "default router password",
  "192.168.0.1",
  "router setup",
  "tp link router login",
  "netgear default password",
  "asus router admin",
  "default gateway ip",
  "wifi password change"
];

const currentIp = GATEWAY_IPS.find(i => i.ip === '192.168.1.1') || GATEWAY_IPS[0];
const otherIps = GATEWAY_IPS.filter(i => i.ip !== '192.168.1.1');
// Brands with the most models in the database, e.g. TP-Link, Netgear, ASUS.
const popularBrands = getBrandsByPopularity().slice(0, 8);



// Comprehensive JSON-LD structured data graph
const schema = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://atulscript.github.io/routerapp/"
      }
    ]
  },
  {
    "@type": "HowTo",
    "name": "How to log in to your router at 192.168.1.1",
    "description": "Connect to the router, open 192.168.1.1, sign in with the default login and secure the network.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Connect to your router", "text": "Join the router's Wi-Fi network or plug a cable into one of its LAN ports. Turn off VPN and mobile data." },
      { "@type": "HowToStep", "position": 2, "name": "Open 192.168.1.1 in a browser", "text": "Type http://192.168.1.1 in the address bar, not in a search box. If it does not load, check the gateway address on your device." },
      { "@type": "HowToStep", "position": 3, "name": "Sign in with the default login", "text": "Enter the default username and password, usually admin / admin or admin / password, or the unique password printed on the router sticker." },
      { "@type": "HowToStep", "position": 4, "name": "Secure your network", "text": "Change the admin password, set a strong Wi-Fi password with WPA3 or WPA2, install firmware updates and turn off WPS and remote management." }
    ]
  },
  {
    "@type": "TechArticle",
    "headline": title,
    "description": description,
    "url": "https://atulscript.github.io/routerapp/",
    "author": {
      "@type": "Organization",
      "name": "19216811.page Network Research"
    },
    "articleBody": currentIp.steps.join(' ')
  },
  {
    "@type": "FAQPage",
    "mainEntity": currentIp.faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  }
];
---

<BaseLayout 
  title={title} 
  description={description} 
  keywords={keywords}
  schema={schema}
  ogType="website"
>
  
  <!-- ========================================================= -->
  <!-- 1. GOOGLE HERO & LIVE INTERACTIVE SEARCH SECTION -->
  <!-- ========================================================= -->
  <section class="relative pt-8 sm:pt-12 pb-10 sm:pb-14 border-b border-[#dadce0] dark:border-[#3c4043] bg-gradient-to-b from-white via-[#f8fafd] to-white dark:from-[#202124] dark:via-[#292a2d]/40 dark:to-[#202124]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
      
      <!-- Google Brand Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white dark:bg-[#303134] border border-[#dadce0] dark:border-[#5f6368] text-xs font-medium mb-5 shadow-2xs">
        <div class="flex items-center gap-1">
          <span class="w-2.5 h-2.5 rounded-full bg-[#4285f4]"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#ea4335]"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#fbbc05]"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#34a853]"></span>
        </div>
        <span class="font-bold text-[#202124] dark:text-[#e8eaed]">Universal Router Gateway Directory</span>
        <span class="text-[#dadce0] dark:text-[#5f6368]">|</span>
        <span class="text-[#5f6368] dark:text-[#9aa0a6]">{ROUTER_MODELS.length} router models</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#202124] dark:text-white tracking-tight mb-3 font-sans leading-tight">
        Universal Router Admin & <span class="text-[#1a73e8] dark:text-[#8ab4f8]">Network Directory</span>
      </h1>
      
      <p class="text-sm sm:text-base text-[#5f6368] dark:text-[#9aa0a6] max-w-2xl mx-auto mb-7 leading-relaxed">
        Find factory default passwords for {ROUTER_MODELS.length} router models, access <strong class="text-[#202124] dark:text-white font-mono">192.168.1.1</strong> & <strong class="text-[#202124] dark:text-white font-mono">192.168.0.1</strong> gateways, and run network diagnostics.
      </p>

      <!-- Google Material 3 Hero Search Bar with Live Instant Autocomplete -->
      <div class="relative max-w-xl mx-auto mb-7 text-left" id="hero-search-wrapper">
        <div class="g-search-bar px-4 py-3">
          <div class="text-[#5f6368] dark:text-[#9aa0a6] mr-3 flex items-center">
            <svg class="w-5 h-5 text-[#1a73e8] dark:text-[#8ab4f8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <input 
            type="text" 
            id="hero-search-input" 
            placeholder="Search any router model, brand, IP, or tool (e.g. Archer, Netgear, 192.168.1.1)..." 
            class="w-full h-11 bg-transparent text-base sm:text-sm text-[#202124] dark:text-white placeholder-[#5f6368] dark:placeholder-[#9aa0a6] outline-none font-medium"
            autocomplete="off"
            spellcheck="false"
          />
          <button 
            id="hero-search-clear" 
            type="button" 
            class="hidden text-[#5f6368] hover:text-[#202124] dark:hover:text-white text-sm font-bold ml-2"
          >
            ✕
          </button>
        </div>

        <!-- Live Hero Search Results Dropdown -->
        <div 
          id="hero-search-results" 
          class="absolute left-0 right-0 top-full mt-2 bg-white dark:bg-[#292a2d] rounded-2xl sm:rounded-3xl shadow-card-hover border border-[#dadce0] dark:border-[#3c4043] overflow-hidden hidden z-50 max-h-96 overflow-y-auto divide-y divide-[#f1f3f4] dark:divide-[#3c4043] custom-scrollbar animate-fade-in"
        >
          <div id="hero-results-list"></div>
        </div>
      </div>

      <!-- Quick Search Chips -->
      <div class="flex flex-wrap items-center justify-center gap-1.5 text-xs text-[#5f6368] dark:text-[#9aa0a6] mb-8">
        <span class="font-medium mr-1 text-[11px] uppercase tracking-wider text-[#5f6368]">Popular:</span>
        <button type="button" class="hero-chip g-chip text-[11px]" data-query="192.168.1.1">192.168.1.1</button>
        <button type="button" class="hero-chip g-chip text-[11px]" data-query="192.168.0.1">192.168.0.1</button>
        <button type="button" class="hero-chip g-chip text-[11px]" data-query="TP-Link">TP-Link</button>
        <button type="button" class="hero-chip g-chip text-[11px]" data-query="Netgear">Netgear</button>
        <button type="button" class="hero-chip g-chip text-[11px]" data-query="ASUS">ASUS</button>
        <button type="button" class="hero-chip g-chip text-[11px]" data-query="Ubiquiti">Ubiquiti</button>
        <button type="button" class="hero-chip g-chip text-[11px]" data-query="Speed Test">⚡ Speed Test</button>
      </div>

      <!-- ========================================================= -->
      <!-- QUICK ANSWER + LIVE ROUTER CHECKER -->
      <!-- ========================================================= -->
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-4 text-left items-stretch">
      <div class="g-onebox lg:col-span-3 flex flex-col" id="onebox-container">
        
        <!-- Gateway Switcher Tab Bar -->
        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-3 mb-4 border-b border-[#e8eaed] dark:border-[#3c4043]">
          <span class="text-[11px] uppercase font-bold text-[#5f6368] dark:text-[#9aa0a6] mr-1 flex-shrink-0">Gateway:</span>
          {GATEWAY_IPS.slice(0, 6).map((item, idx) => (
            <button 
              type="button" 
              class={`gateway-tab px-3 py-1 rounded-full text-xs font-mono font-bold transition-all flex-shrink-0 cursor-pointer ${idx === 0 ? 'bg-[#e8f0fe] dark:bg-[#1a3a60] text-[#1a73e8] dark:text-[#8ab4f8] border border-[#d2e3fc] dark:border-[#1a73e8]' : 'bg-white dark:bg-[#303134] text-[#5f6368] dark:text-[#e8eaed] border border-[#dadce0] dark:border-[#5f6368] hover:bg-[#f1f3f4] dark:hover:bg-[#3c4043]'}`}
              data-ip={item.ip}
              data-user={item.defaultUser}
              data-pass={item.defaultPass}
              data-desc={item.description}
              data-brands={item.commonBrands.slice(0, 4).join(', ')}
              data-brand-links={JSON.stringify(item.commonBrands.slice(0, 8).map(name => ({ name, slug: getBrandSlug(name) })).filter(b => b.slug))}
              data-slug={item.slug}
            >
              {item.ip}
            </button>
          ))}
        </div>

        <!-- Dynamic Control Card Area -->
        <div class="space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[#e8eaed] dark:border-[#3c4043] pb-4">
            <div>
              <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-[#e6f4ea] dark:bg-[#133e24] text-[#34a853] dark:text-[#81c995] border border-[#ceead6] dark:border-[#34a853] mb-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#34a853] animate-pulse"></span>
                Active Gateway Control Panel
              </div>
              <div class="text-2xl sm:text-3xl font-mono font-bold text-[#202124] dark:text-white tracking-tight" id="onebox-ip-display">
                192.168.1.1
              </div>
              <div class="text-xs text-[#5f6368] dark:text-[#9aa0a6] mt-0.5" id="onebox-brands-display">
                Default for TP-Link, Netgear, ASUS, Linksys, Cisco
              </div>
            </div>

            <a 
              href="http://192.168.1.1" 
              id="onebox-launch-btn"
              target="_blank" 
              rel="noopener noreferrer"
              class="g-btn-primary w-full sm:w-auto text-center"
            >
              <span id="onebox-launch-text">Open http://192.168.1.1</span>
              <span class="text-xs">↗</span>
            </a>
          </div>

          <!-- Credentials Row -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="p-3.5 rounded-2xl bg-[#f8fafd] dark:bg-[#202124] border border-[#e8eaed] dark:border-[#3c4043] flex items-center justify-between">
              <div>
                <div class="text-xs font-bold uppercase tracking-wider text-[#5f6368] dark:text-[#9aa0a6]">Default User</div>
                <div class="text-sm font-mono font-bold text-[#202124] dark:text-white mt-0.5" id="onebox-user-display">admin</div>
              </div>
              <button 
                type="button" 
                id="onebox-copy-user-btn"
                class="copy-btn g-copy-btn"
                data-copy="admin"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg><span>Copy</span>
              </button>
            </div>

            <div class="p-3.5 rounded-2xl bg-[#f8fafd] dark:bg-[#202124] border border-[#e8eaed] dark:border-[#3c4043] flex items-center justify-between">
              <div>
                <div class="text-xs font-bold uppercase tracking-wider text-[#5f6368] dark:text-[#9aa0a6]">Default Password</div>
                <div class="text-sm font-mono font-bold text-[#202124] dark:text-white mt-0.5" id="onebox-pass-display">admin / password</div>
              </div>
              <button 
                type="button" 
                id="onebox-copy-pass-btn"
                class="copy-btn g-copy-btn"
                data-copy="admin"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg><span>Copy</span>
              </button>
            </div>
          </div>

          <div class="pt-4 mt-auto border-t border-[#e8eaed] dark:border-[#3c4043]">
            <div class="text-xs font-bold uppercase tracking-wider text-[#5f6368] dark:text-[#9aa0a6] mb-2">
              Brands using this address
            </div>
            <div class="flex flex-wrap gap-1.5" id="onebox-brand-links"></div>
          </div>
        </div>

      </div>

      <RouterChecker class="lg:col-span-2" limit={4} />
      </div>

    </div>
  </section>

  <!-- Top Leaderboard Ad Slot -->
  <AdBanner format="leaderboard" />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-9">

    <!-- ========================================================= -->
    <!-- 2. GOOGLE MATERIAL 3 DIAGNOSTIC TOOLS GRID -->
    <!-- ========================================================= -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-[#e8f0fe] dark:bg-[#1a3a60] text-[#1a73e8] dark:text-[#8ab4f8] text-xs font-bold mb-1">
            ⚡ Web Utilities
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-[#202124] dark:text-white tracking-tight">
            Network Diagnostics & Web Tools
          </h2>
          <p class="text-sm text-[#5f6368] dark:text-[#9aa0a6] mt-0.5">
            Instant browser utilities for latency testing, IP subnetting, and Wi-Fi QR generation
          </p>
        </div>
        <a href={`${base}/tools`} class="g-btn-outlined text-xs font-bold">
          <span>All Tools</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <!-- Speed Test Tool Card (Google Blue) -->
        <a href={`${base}/speed-test`} class="g-card p-5 flex flex-col justify-between group">
          <div class="space-y-3">
            <div class="w-11 h-11 rounded-2xl bg-[#e8f0fe] dark:bg-[#1a3a60] text-[#1a73e8] dark:text-[#8ab4f8] flex items-center justify-center text-xl font-bold shadow-2xs group-hover:scale-105 transition-transform">
              ⚡
            </div>
            <div>
              <h3 class="font-bold text-sm text-[#202124] dark:text-white group-hover:text-[#1a73e8] dark:group-hover:text-[#8ab4f8] transition-colors">
                Internet Speed Test
              </h3>
              <p class="text-sm text-[#5f6368] dark:text-[#9aa0a6] mt-1 leading-relaxed">
                Test download, upload speed, latency, and ping jitter in real time.
              </p>
            </div>
          </div>
          <div class="pt-3.5 border-t border-[#e8eaed] dark:border-[#3c4043] text-xs font-bold text-[#1a73e8] dark:text-[#8ab4f8] flex items-center justify-between">
            <span>Run Benchmark</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>

        <!-- Subnet Calculator Tool Card (Google Green) -->
        <a href={`${base}/subnet-calculator`} class="g-card p-5 flex flex-col justify-between group">
          <div class="space-y-3">
            <div class="w-11 h-11 rounded-2xl bg-[#e6f4ea] dark:bg-[#133e24] text-[#34a853] dark:text-[#81c995] flex items-center justify-center text-xl font-bold shadow-2xs group-hover:scale-105 transition-transform">
              🧮
            </div>
            <div>
              <h3 class="font-bold text-sm text-[#202124] dark:text-white group-hover:text-[#34a853] dark:group-hover:text-[#81c995] transition-colors">
                CIDR Subnet Calculator
              </h3>
              <p class="text-sm text-[#5f6368] dark:text-[#9aa0a6] mt-1 leading-relaxed">
                Calculate usable IPv4 host ranges, broadcast, netmask, and binary bits.
              </p>
            </div>
          </div>
          <div class="pt-3.5 border-t border-[#e8eaed] dark:border-[#3c4043] text-xs font-bold text-[#34a853] dark:text-[#81c995] flex items-center justify-between">
            <span>Calculate Subnet</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>

        <!-- What Is My IP Card (Google Yellow) -->
        <a href={`${base}/what-is-my-ip`} class="g-card p-5 flex flex-col justify-between group">
          <div class="space-y-3">
            <div class="w-11 h-11 rounded-2xl bg-[#fef7e0] dark:bg-[#4d3800] text-[#f9ab00] dark:text-[#fdd663] flex items-center justify-center text-xl font-bold shadow-2xs group-hover:scale-105 transition-transform">
              🌐
            </div>
            <div>
              <h3 class="font-bold text-sm text-[#202124] dark:text-white group-hover:text-[#f9ab00] dark:group-hover:text-[#fdd663] transition-colors">
                What Is My IP Address?
              </h3>
              <p class="text-sm text-[#5f6368] dark:text-[#9aa0a6] mt-1 leading-relaxed">
                Detect your public IPv4, IPv6, ISP provider, and default gateway address.
              </p>
            </div>
          </div>
          <div class="pt-3.5 border-t border-[#e8eaed] dark:border-[#3c4043] text-xs font-bold text-[#f9ab00] dark:text-[#fdd663] flex items-center justify-between">
            <span>Check IP Info</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>

        <!-- WiFi QR Code Generator (Google Red) -->
        <a href={`${base}/wifi-qr-generator`} class="g-card p-5 flex flex-col justify-between group">
          <div class="space-y-3">
            <div class="w-11 h-11 rounded-2xl bg-[#fce8e6] dark:bg-[#4c1d1a] text-[#ea4335] dark:text-[#f28b82] flex items-center justify-center text-xl font-bold shadow-2xs group-hover:scale-105 transition-transform">
              📱
            </div>
            <div>
              <h3 class="font-bold text-sm text-[#202124] dark:text-white group-hover:text-[#ea4335] dark:group-hover:text-[#f28b82] transition-colors">
                Wi-Fi QR Generator
              </h3>
              <p class="text-sm text-[#5f6368] dark:text-[#9aa0a6] mt-1 leading-relaxed">
                Generate printable QR codes for guests to connect instantly without typing keys.
              </p>
            </div>
          </div>
          <div class="pt-3.5 border-t border-[#e8eaed] dark:border-[#3c4043] text-xs font-bold text-[#ea4335] dark:text-[#f28b82] flex items-center justify-between">
            <span>Generate QR</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>

      </div>
    </section>

    <!-- ========================================================= -->
    <!-- 3. TOP ROUTER BRANDS SHOWCASE (GOOGLE STORE STYLE) -->
    <!-- ========================================================= -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-[#e6f4ea] dark:bg-[#133e24] text-[#34a853] dark:text-[#81c995] text-xs font-bold mb-1">
            🏷️ Hardware Manufacturers
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-[#202124] dark:text-white tracking-tight">
            Popular Router Brands & Defaults
          </h2>
          <p class="text-sm text-[#5f6368] dark:text-[#9aa0a6] mt-0.5">
            Explore setup guides and factory login credentials for leading network hardware
          </p>
        </div>
        <a href={`${base}/brands`} class="g-btn-outlined text-xs font-bold">
          <span>All Brands ({BRANDS.length})</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
        {popularBrands.map(brand => (
          <BrandCard data={brand} />
        ))}
      </div>
    </section>

    <!-- ========================================================= -->
    <!-- 4. MASTER HARDWARE CATALOG & LOOKUP TABLE -->
    <!-- ========================================================= -->
    <section class="g-card p-5 sm:p-7 space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#e8eaed] dark:border-[#3c4043] pb-4">
        <div>
          <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-[#fef7e0] dark:bg-[#4d3800] text-[#f9ab00] dark:text-[#fdd663] text-xs font-bold mb-1">
            📟 Master Database
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-[#202124] dark:text-white tracking-tight">
            Router Models & Password Finder
          </h2>
          <p class="text-sm text-[#5f6368] dark:text-[#9aa0a6] mt-0.5">
            Search {ROUTER_MODELS.length} home, mesh, gaming and business routers
          </p>
        </div>
        <a href={`${base}/routers`} class="g-btn-secondary w-fit text-xs font-bold">
          <span>View All Models</span>
          <span>→</span>
        </a>
      </div>

      <RouterLookupTable />
    </section>

    <!-- Mid In-Content Ad Banner -->
    <AdBanner format="horizontal" />

    <LoginStepper ip="192.168.1.1" user={currentIp.defaultUser} pass={currentIp.defaultPass} />

    <!-- Cross-Directory Interlinking Network (Before FAQ) -->
    <RelatedLinksGrid currentSlug="192-168-1-1" />

    <!-- ========================================================= -->
    <!-- 7. GOOGLE SEARCH STYLE FAQ ACCORDION (JUST ABOVE FOOTER) -->
    <!-- ========================================================= -->
    <section class="g-card p-5 sm:p-7 space-y-4">
      <div class="flex items-center gap-2 border-b border-[#e8eaed] dark:border-[#3c4043] pb-3">
        <span class="text-lg">❓</span>
        <div>
          <h2 class="text-base sm:text-lg font-bold text-[#202124] dark:text-white">
            Frequently Asked Questions & Answers
          </h2>
          <p class="text-sm text-[#5f6368] dark:text-[#9aa0a6]">
            Troubleshooting solutions for unreachable portals and forgotten credentials
          </p>
        </div>
      </div>

      <div class="space-y-3">
        {currentIp.faqs.map(faq => (
          <details class="group border border-[#dadce0] dark:border-[#3c4043] rounded-2xl p-4 open:bg-[#f8fafd] dark:open:bg-[#303134]/50 hover:border-[#bdc1c6] dark:hover:border-[#5f6368] transition-colors">
            <summary class="font-bold text-[#202124] dark:text-white cursor-pointer list-none flex justify-between items-center text-xs sm:text-sm">
              <span class="flex items-center gap-2">
                <span class="text-[#1a73e8] dark:text-[#8ab4f8] font-bold">Q.</span>
                {faq.question}
              </span>
              <span class="text-[#9aa0a6] group-open:rotate-180 group-open:text-[#1a73e8] dark:group-open:text-[#8ab4f8] transition-transform text-xs flex-shrink-0 ml-2">▼</span>
            </summary>
            <p class="text-sm text-[#5f6368] dark:text-[#bdc1c6] mt-2.5 leading-relaxed border-t border-[#e8eaed] dark:border-[#3c4043] pt-2.5">
              {faq.answer}
            </p>
          </details>
        ))}

        <details class="group border border-[#dadce0] dark:border-[#3c4043] rounded-2xl p-4 open:bg-[#f8fafd] dark:open:bg-[#303134]/50 hover:border-[#bdc1c6] dark:hover:border-[#5f6368] transition-colors">
          <summary class="font-bold text-[#202124] dark:text-white cursor-pointer list-none flex justify-between items-center text-xs sm:text-sm">
            <span class="flex items-center gap-2">
              <span class="text-[#1a73e8] dark:text-[#8ab4f8] font-bold">Q.</span>
              How do I change the DNS servers on 192.168.1.1 for faster speeds?
            </span>
            <span class="text-[#9aa0a6] group-open:rotate-180 group-open:text-[#1a73e8] dark:group-open:text-[#8ab4f8] transition-transform text-xs flex-shrink-0 ml-2">▼</span>
          </summary>
          <p class="text-sm text-[#5f6368] dark:text-[#bdc1c6] mt-2.5 leading-relaxed border-t border-[#e8eaed] dark:border-[#3c4043] pt-2.5">
            In your router's <strong>DHCP / LAN Settings</strong>, set Primary DNS to <code class="font-mono bg-white dark:bg-[#202124] px-1.5 py-0.5 rounded border border-[#dadce0] dark:border-[#5f6368] font-bold text-[#1a73e8] dark:text-[#8ab4f8]">1.1.1.1</code> (Cloudflare) or <code class="font-mono bg-white dark:bg-[#202124] px-1.5 py-0.5 rounded border border-[#dadce0] dark:border-[#5f6368] font-bold text-[#1a73e8] dark:text-[#8ab4f8]">8.8.8.8</code> (Google), and Secondary DNS to <code class="font-mono bg-white dark:bg-[#202124] px-1.5 py-0.5 rounded border border-[#dadce0] dark:border-[#5f6368] font-bold text-[#1a73e8] dark:text-[#8ab4f8]">1.0.0.1</code> or <code class="font-mono bg-white dark:bg-[#202124] px-1.5 py-0.5 rounded border border-[#dadce0] dark:border-[#5f6368] font-bold text-[#1a73e8] dark:text-[#8ab4f8]">8.8.4.4</code>.
          </p>
        </details>
      </div>
    </section>

  </div>
</BaseLayout>

<script define:vars={{ indexUrl: `${base}/search-index.json` }}>
  // Dynamic Gateway Tab Switcher for Google Knowledge OneBox
  const tabs = document.querySelectorAll('.gateway-tab');
  const ipDisplay = document.getElementById('onebox-ip-display');
  const brandsDisplay = document.getElementById('onebox-brands-display');
  const launchBtn = document.getElementById('onebox-launch-btn');
  const launchText = document.getElementById('onebox-launch-text');
  const userDisplay = document.getElementById('onebox-user-display');
  const passDisplay = document.getElementById('onebox-pass-display');
  const copyUserBtn = document.getElementById('onebox-copy-user-btn');
  const copyPassBtn = document.getElementById('onebox-copy-pass-btn');

  const brandLinksBox = document.getElementById('onebox-brand-links');
  const base = document.body.dataset.base || '';

  function renderBrandLinks(tab) {
    if (!brandLinksBox) return;
    let links = [];
    try { links = JSON.parse(tab.getAttribute('data-brand-links') || '[]'); } catch {}
    brandLinksBox.innerHTML = links
      .map(b => `<a href="${base}/${b.slug}" class="g-chip text-xs">${b.name.replace(/[<>&"]/g, '')}</a>`)
      .join('');
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => {
        t.classList.remove('bg-[#e8f0fe]', 'dark:bg-[#1a3a60]', 'text-[#1a73e8]', 'dark:text-[#8ab4f8]', 'border-[#d2e3fc]', 'dark:border-[#1a73e8]');
        t.classList.add('bg-white', 'dark:bg-[#303134]', 'text-[#5f6368]', 'dark:text-[#e8eaed]', 'border-[#dadce0]', 'dark:border-[#5f6368]');
      });
      tab.classList.remove('bg-white', 'dark:bg-[#303134]', 'text-[#5f6368]', 'dark:text-[#e8eaed]', 'border-[#dadce0]', 'dark:border-[#5f6368]');
      tab.classList.add('bg-[#e8f0fe]', 'dark:bg-[#1a3a60]', 'text-[#1a73e8]', 'dark:text-[#8ab4f8]', 'border-[#d2e3fc]', 'dark:border-[#1a73e8]');

      const ip = tab.getAttribute('data-ip') || '192.168.1.1';
      const user = tab.getAttribute('data-user') || 'admin';
      const pass = tab.getAttribute('data-pass') || 'admin';
      const brands = tab.getAttribute('data-brands') || '';

      if (ipDisplay) ipDisplay.textContent = ip;
      if (brandsDisplay) brandsDisplay.textContent = `Default for ${brands}`;
      if (launchBtn) launchBtn.setAttribute('href', `http://${ip}`);
      if (launchText) launchText.textContent = `Open http://${ip}`;
      if (userDisplay) userDisplay.textContent = user;
      if (passDisplay) passDisplay.textContent = pass;
      if (copyUserBtn) copyUserBtn.setAttribute('data-copy', user);
      if (copyPassBtn) copyPassBtn.setAttribute('data-copy', pass);
      renderBrandLinks(tab);
    });
  });

  if (tabs.length) renderBrandLinks(tabs[0]);

  // Hero Live Search Autocomplete
  const heroInput = document.getElementById('hero-search-input');
  const heroResults = document.getElementById('hero-search-results');
  const heroList = document.getElementById('hero-results-list');
  const heroClear = document.getElementById('hero-search-clear');
  const heroChips = document.querySelectorAll('.hero-chip');

  let heroIndex = null;
  let heroLoading = null;
  const loadHeroIndex = () => heroLoading ??= fetch(indexUrl).then(r => r.json()).then(d => (heroIndex = d)).catch(() => (heroIndex = []));
  const escapeHtml = (s) => s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  async function renderHeroSearch(query) {
    const q = query.trim();
    if (!q) {
      heroResults?.classList.add('hidden');
      heroClear?.classList.add('hidden');
      return;
    }
    heroClear?.classList.remove('hidden');
    if (!heroIndex) {
      await loadHeroIndex();
      if (heroInput && heroInput.value.trim() !== q) return;
    }

    const terms = q.toLowerCase().split(/\s+/);
    const matches = heroIndex
      .filter(item => terms.every(t => `${item.title} ${item.k}`.toLowerCase().includes(t)))
      .sort((a, b) => (a.title.toLowerCase().startsWith(terms[0]) ? 0 : 1) - (b.title.toLowerCase().startsWith(terms[0]) ? 0 : 1) || a.title.length - b.title.length)
      .slice(0, 6);

    if (heroList) {
      heroList.innerHTML = matches.length
        ? matches.map(item => `
          <a href="${item.url}" class="flex items-center justify-between gap-3 px-4 py-3 hover:bg-[#f8fafd] dark:hover:bg-[#303134] transition-colors text-left group">
            <span class="min-w-0">
              <span class="flex items-center gap-2 text-sm font-medium text-[#202124] dark:text-white group-hover:text-[#1a73e8] dark:group-hover:text-[#8ab4f8]">
                <span class="truncate">${escapeHtml(item.title)}</span>
                <span class="flex-shrink-0 text-[11px] px-2 py-0.5 rounded-full bg-[#f1f3f4] dark:bg-[#3c4043] text-[#5f6368] dark:text-[#e8eaed]">${item.category}</span>
              </span>
              <span class="block text-xs text-[#5f6368] dark:text-[#9aa0a6] truncate">${escapeHtml(item.subtitle)}</span>
            </span>
            <span class="text-[#1a73e8] dark:text-[#8ab4f8]" aria-hidden="true">→</span>
          </a>`).join('')
        : `<p class="px-4 py-3 text-sm text-center text-[#5f6368] dark:text-[#9aa0a6]">No results for “${escapeHtml(q)}”. Try an IP like 192.168.0.1 or a brand name.</p>`;
    }
    heroResults?.classList.remove('hidden');
  }

  heroInput?.addEventListener('focus', () => loadHeroIndex());

  heroInput?.addEventListener('input', (e) => {
    renderHeroSearch(e.target.value);
  });

  heroClear?.addEventListener('click', () => {
    if (heroInput) heroInput.value = '';
    renderHeroSearch('');
  });

  heroChips.forEach(chip => {
    chip.addEventListener('click', () => {
      const q = chip.getAttribute('data-query') || '';
      if (heroInput) {
        heroInput.value = q;
        renderHeroSearch(q);
      }
    });
  });

  document.addEventListener('click', (e) => {
    if (!document.getElementById('hero-search-wrapper')?.contains(e.target)) {
      heroResults?.classList.add('hidden');
    }
  });
</script>
