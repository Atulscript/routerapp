---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import RouterLookupTable from '../components/RouterLookupTable.astro';
import RouterGuideCard from '../components/RouterGuideCard.astro';
import BrandCard from '../components/BrandCard.astro';
import IspCard from '../components/IspCard.astro';
import AdBanner from '../components/AdBanner.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';
import { GATEWAY_IPS, BRANDS, ISPS, ROUTER_MODELS } from '../lib/data-loader';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "192.168.1.1 Router Admin Login, Passwords & Setup Guide | 19216811.page";
const description = "Access 192.168.1.1 router admin dashboard. Verified factory usernames, default passwords, Wi-Fi setup guides, and troubleshooting for TP-Link, Netgear, ASUS, JioFiber & Airtel.";
const keywords = [
  "192.168.1.1",
  "192.168.1.1 login",
  "192.168.1.1 admin",
  "router admin login",
  "default router password",
  "192.168.0.1",
  "router setup",
  "tp link router login",
  "netgear default password",
  "asus router admin",
  "default gateway ip",
  "wifi password change"
];

const currentIp = GATEWAY_IPS.find(i => i.ip === '192.168.1.1') || GATEWAY_IPS[0];
const otherIps = GATEWAY_IPS.filter(i => i.ip !== '192.168.1.1');

// Comprehensive JSON-LD structured data graph (HowTo + FAQPage + Breadcrumbs)
const schema = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://atulscript.github.io/routerapp/"
      }
    ]
  },
  {
    "@type": "HowTo",
    "name": "How to Log In to 192.168.1.1 Router Admin Panel",
    "description": "Step-by-step guide to connect, access, and log into your wireless router admin dashboard at 192.168.1.1.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Connect to Router Network",
        "text": "Connect your PC, smartphone, or laptop to your router via Ethernet cable or Wi-Fi network.",
        "url": "https://atulscript.github.io/routerapp/#step-1"
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Open Web Browser",
        "text": "Launch your preferred web browser such as Google Chrome, Firefox, Safari, or Microsoft Edge.",
        "url": "https://atulscript.github.io/routerapp/#step-2"
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Navigate to 192.168.1.1",
        "text": "Type http://192.168.1.1 into the browser address bar and press Enter.",
        "url": "https://atulscript.github.io/routerapp/#step-3"
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Enter Admin Credentials",
        "text": "Enter your router default username (e.g., admin) and password (e.g., admin, password, or blank), then click Login.",
        "url": "https://atulscript.github.io/routerapp/#step-4"
      }
    ]
  },
  {
    "@type": "TechArticle",
    "headline": title,
    "description": description,
    "url": "https://atulscript.github.io/routerapp/",
    "author": {
      "@type": "Organization",
      "name": "19216811.page Network Research"
    },
    "articleBody": currentIp.steps.join(' ')
  },
  {
    "@type": "FAQPage",
    "mainEntity": currentIp.faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  }
];
---

<BaseLayout 
  title={title} 
  description={description} 
  keywords={keywords}
  schema={schema}
  ogType="website"
>
  
  <!-- ========================================================= -->
  <!-- 1. GOOGLE-STYLE HERO & KNOWLEDGE ONEBOX SECTION -->
  <!-- ========================================================= -->
  <section class="relative pt-6 sm:pt-10 pb-8 sm:pb-12 border-b border-[#e8eaed] dark:border-[#3c4043] bg-gradient-to-b from-white via-[#f8fafd] to-white dark:from-[#202124] dark:via-[#292a2d]/40 dark:to-[#202124]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      
      <!-- Google Brand Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white dark:bg-[#303134] border border-[#dadce0] dark:border-[#5f6368] text-xs font-medium mb-5 shadow-2xs">
        <div class="flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-[#4285f4]"></span>
          <span class="w-2 h-2 rounded-full bg-[#ea4335]"></span>
          <span class="w-2 h-2 rounded-full bg-[#fbbc05]"></span>
          <span class="w-2 h-2 rounded-full bg-[#34a853]"></span>
        </div>
        <span class="font-bold text-[#202124] dark:text-[#e8eaed]">Universal Router Gateway Directory</span>
        <span class="text-[#dadce0] dark:text-[#5f6368]">|</span>
        <span class="text-[#5f6368] dark:text-[#9aa0a6]">400+ Models Indexed</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#202124] dark:text-white tracking-tight mb-3 font-sans leading-tight">
        192.168.1.1 <span class="text-[#1a73e8] dark:text-[#8ab4f8]">Router Admin Login</span>
      </h1>
      
      <p class="text-xs sm:text-sm text-[#5f6368] dark:text-[#9aa0a6] max-w-xl mx-auto mb-7 leading-relaxed">
        Instant access to your wireless router gateway dashboard at <strong class="text-[#202124] dark:text-white font-mono">http://192.168.1.1</strong>. Lookup default factory passwords, configure Wi-Fi security, and fix connection errors.
      </p>

      <!-- Google Knowledge OneBox (Rich Answer Card for 192.168.1.1) -->
      <div class="g-onebox max-w-xl mx-auto mb-6 text-left">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-[#e8eaed] dark:border-[#3c4043] pb-4">
          <div>
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-[#e8f0fe] dark:bg-[#1a3a60] text-[#1a73e8] dark:text-[#8ab4f8] border border-[#d2e3fc] dark:border-[#1a73e8] mb-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#34a853] animate-pulse"></span>
              Verified Local Gateway IP
            </div>
            <div class="text-2xl sm:text-3xl font-mono font-bold text-[#202124] dark:text-white tracking-tight">
              192.168.1.1
            </div>
            <div class="text-xs text-[#5f6368] dark:text-[#9aa0a6] mt-0.5">
              Default for TP-Link, Netgear, ASUS, Linksys, Cisco, Zyxel
            </div>
          </div>

          <a 
            href="http://192.168.1.1" 
            target="_blank" 
            rel="noopener noreferrer"
            class="g-btn-primary w-full sm:w-auto text-center"
          >
            <span>Open Dashboard</span>
            <span class="text-xs">↗</span>
          </a>
        </div>

        <!-- Default Credentials Row with Instant Copy -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4">
          <div class="p-3 rounded-xl bg-[#f8fafd] dark:bg-[#202124] border border-[#e8eaed] dark:border-[#3c4043] flex items-center justify-between">
            <div>
              <div class="text-[10px] font-bold uppercase tracking-wider text-[#5f6368] dark:text-[#9aa0a6]">Default User</div>
              <div class="text-sm font-mono font-bold text-[#202124] dark:text-white mt-0.5">admin</div>
            </div>
            <button 
              type="button" 
              class="copy-btn text-[11px] font-bold px-3 py-1 rounded-full bg-white dark:bg-[#303134] border border-[#dadce0] dark:border-[#5f6368] text-[#3c4043] dark:text-[#e8eaed] hover:bg-[#f1f3f4] dark:hover:bg-[#3c4043] transition-all cursor-pointer shadow-2xs"
              data-copy="admin"
            >
              📋 Copy
            </button>
          </div>

          <div class="p-3 rounded-xl bg-[#f8fafd] dark:bg-[#202124] border border-[#e8eaed] dark:border-[#3c4043] flex items-center justify-between">
            <div>
              <div class="text-[10px] font-bold uppercase tracking-wider text-[#5f6368] dark:text-[#9aa0a6]">Default Password</div>
              <div class="text-sm font-mono font-bold text-[#202124] dark:text-white mt-0.5">admin / password</div>
            </div>
            <button 
              type="button" 
              class="copy-btn text-[11px] font-bold px-3 py-1 rounded-full bg-white dark:bg-[#303134] border border-[#dadce0] dark:border-[#5f6368] text-[#3c4043] dark:text-[#e8eaed] hover:bg-[#f1f3f4] dark:hover:bg-[#3c4043] transition-all cursor-pointer shadow-2xs"
              data-copy="admin"
            >
              📋 Copy
            </button>
          </div>
        </div>
      </div>

      <!-- Quick IP Gateway Chips -->
      <div class="flex flex-wrap items-center justify-center gap-1.5 text-xs text-[#5f6368] dark:text-[#9aa0a6]">
        <span class="font-medium mr-1">Other Common Gateways:</span>
        {otherIps.slice(0, 5).map(ip => (
          <a 
            href={`${base}/${ip.slug}`}
            class="g-chip font-mono text-[11px]"
          >
            {ip.ip}
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- Top Leaderboard Ad Slot -->
  <AdBanner format="leaderboard" />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-8">

    <!-- ========================================================= -->
    <!-- 2. GOOGLE MATERIAL 3 DIAGNOSTIC TOOLS GRID -->
    <!-- ========================================================= -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg sm:text-xl font-bold text-[#202124] dark:text-white tracking-tight">
            Network Diagnostics & Utilities
          </h2>
          <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] mt-0.5">
            Free online tools for bandwidth testing, IP subnetting, and Wi-Fi sharing
          </p>
        </div>
        <a href={`${base}/tools`} class="text-xs font-bold text-[#1a73e8] dark:text-[#8ab4f8] hover:underline flex items-center gap-1">
          <span>All Tools</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
        
        <!-- Speed Test Tool Card -->
        <a href={`${base}/speed-test`} class="g-card p-4 flex flex-col justify-between group">
          <div class="space-y-2.5">
            <div class="w-10 h-10 rounded-2xl bg-[#e8f0fe] dark:bg-[#1a3a60] text-[#1a73e8] dark:text-[#8ab4f8] flex items-center justify-center text-lg font-bold">
              ⚡
            </div>
            <div>
              <h3 class="font-bold text-sm text-[#202124] dark:text-white group-hover:text-[#1a73e8] dark:group-hover:text-[#8ab4f8] transition-colors">
                Internet Speed Test
              </h3>
              <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] mt-1 leading-relaxed">
                Test real-time download, upload bandwidth, jitter, and latency.
              </p>
            </div>
          </div>
          <div class="pt-3 border-t border-[#e8eaed] dark:border-[#3c4043] text-xs font-medium text-[#1a73e8] dark:text-[#8ab4f8] flex items-center justify-between">
            <span>Run Benchmark</span>
            <span>→</span>
          </div>
        </a>

        <!-- Subnet Calculator Tool Card -->
        <a href={`${base}/subnet-calculator`} class="g-card p-4 flex flex-col justify-between group">
          <div class="space-y-2.5">
            <div class="w-10 h-10 rounded-2xl bg-[#e6f4ea] dark:bg-[#133e24] text-[#34a853] dark:text-[#81c995] flex items-center justify-center text-lg font-bold">
              🧮
            </div>
            <div>
              <h3 class="font-bold text-sm text-[#202124] dark:text-white group-hover:text-[#1a73e8] dark:group-hover:text-[#8ab4f8] transition-colors">
                CIDR Subnet Calculator
              </h3>
              <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] mt-1 leading-relaxed">
                Calculate usable IP host ranges, broadcast, and wildcard masks.
              </p>
            </div>
          </div>
          <div class="pt-3 border-t border-[#e8eaed] dark:border-[#3c4043] text-xs font-medium text-[#34a853] dark:text-[#81c995] flex items-center justify-between">
            <span>Calculate Subnet</span>
            <span>→</span>
          </div>
        </a>

        <!-- What Is My IP Card -->
        <a href={`${base}/what-is-my-ip`} class="g-card p-4 flex flex-col justify-between group">
          <div class="space-y-2.5">
            <div class="w-10 h-10 rounded-2xl bg-[#fef7e0] dark:bg-[#4d3800] text-[#f9ab00] dark:text-[#fdd663] flex items-center justify-center text-lg font-bold">
              🌐
            </div>
            <div>
              <h3 class="font-bold text-sm text-[#202124] dark:text-white group-hover:text-[#1a73e8] dark:group-hover:text-[#8ab4f8] transition-colors">
                What Is My IP Address?
              </h3>
              <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] mt-1 leading-relaxed">
                Detect your public IPv4, IPv6, ISP provider, and gateway IP.
              </p>
            </div>
          </div>
          <div class="pt-3 border-t border-[#e8eaed] dark:border-[#3c4043] text-xs font-medium text-[#f9ab00] dark:text-[#fdd663] flex items-center justify-between">
            <span>Check IP Info</span>
            <span>→</span>
          </div>
        </a>

        <!-- WiFi QR Code Generator -->
        <a href={`${base}/wifi-qr-generator`} class="g-card p-4 flex flex-col justify-between group">
          <div class="space-y-2.5">
            <div class="w-10 h-10 rounded-2xl bg-[#fce8e6] dark:bg-[#4c1d1a] text-[#ea4335] dark:text-[#f28b82] flex items-center justify-center text-lg font-bold">
              📱
            </div>
            <div>
              <h3 class="font-bold text-sm text-[#202124] dark:text-white group-hover:text-[#1a73e8] dark:group-hover:text-[#8ab4f8] transition-colors">
                Wi-Fi QR Generator
              </h3>
              <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] mt-1 leading-relaxed">
                Generate printable QR codes to connect phones without passwords.
              </p>
            </div>
          </div>
          <div class="pt-3 border-t border-[#e8eaed] dark:border-[#3c4043] text-xs font-medium text-[#ea4335] dark:text-[#f28b82] flex items-center justify-between">
            <span>Generate QR</span>
            <span>→</span>
          </div>
        </a>

      </div>
    </section>

    <!-- ========================================================= -->
    <!-- 3. INTERACTIVE ROUTER HARDWARE DIRECTORY -->
    <!-- ========================================================= -->
    <section class="g-card p-5 sm:p-7 space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#e8eaed] dark:border-[#3c4043] pb-4">
        <div>
          <h2 class="text-lg sm:text-xl font-bold text-[#202124] dark:text-white flex items-center gap-2">
            <span>📟</span>
            Router Hardware Models & Default Password Finder
          </h2>
          <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] mt-0.5">
            Instant search across 400+ consumer, gaming, mesh, and enterprise gateways
          </p>
        </div>
        <a href={`${base}/routers`} class="g-btn-secondary w-fit text-xs font-bold">
          <span>View All Models</span>
          <span>→</span>
        </a>
      </div>

      <RouterLookupTable />
    </section>

    <!-- Mid In-Content Ad Banner -->
    <AdBanner format="horizontal" />

    <!-- ========================================================= -->
    <!-- 4. GOOGLE HELP CENTER STYLE 4-STEP WALKTHROUGH -->
    <!-- ========================================================= -->
    <section class="g-card p-5 sm:p-7 space-y-5">
      <div class="border-b border-[#e8eaed] dark:border-[#3c4043] pb-4">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#e8f0fe] dark:bg-[#1a3a60] text-[#1a73e8] dark:text-[#8ab4f8] text-xs font-bold mb-2">
          📖 Setup Guide
        </div>
        <h2 class="text-lg sm:text-xl font-bold text-[#202124] dark:text-white tracking-tight">
          How to Log In to 192.168.1.1 Router Admin Panel
        </h2>
        <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] mt-1">
          Follow these 4 simple steps to connect and manage your router dashboard
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Step 1 (Google Blue) -->
        <div class="p-4 rounded-2xl bg-[#f8fafd] dark:bg-[#202124] border border-[#e8eaed] dark:border-[#3c4043] space-y-2">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-[#1a73e8] text-white flex items-center justify-center text-xs font-bold shadow-xs">
              1
            </span>
            <h3 class="text-sm font-bold text-[#202124] dark:text-white">Connect Device to Router</h3>
          </div>
          <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed pl-11">
            Connect your PC, smartphone, or laptop using an Ethernet cable (recommended) or via your router's default wireless SSID.
          </p>
        </div>

        <!-- Step 2 (Google Green) -->
        <div class="p-4 rounded-2xl bg-[#f8fafd] dark:bg-[#202124] border border-[#e8eaed] dark:border-[#3c4043] space-y-2">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-[#34a853] text-white flex items-center justify-center text-xs font-bold shadow-xs">
              2
            </span>
            <h3 class="text-sm font-bold text-[#202124] dark:text-white">Open Web Browser</h3>
          </div>
          <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed pl-11">
            Open Chrome, Safari, Edge, or Firefox, type <code class="px-1.5 py-0.5 rounded bg-white dark:bg-[#303134] border border-[#dadce0] dark:border-[#5f6368] font-mono text-xs font-bold text-[#1a73e8] dark:text-[#8ab4f8]">http://192.168.1.1</code> in the URL bar, and press Enter.
          </p>
        </div>

        <!-- Step 3 (Google Yellow) -->
        <div class="p-4 rounded-2xl bg-[#f8fafd] dark:bg-[#202124] border border-[#e8eaed] dark:border-[#3c4043] space-y-2">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-[#f9ab00] text-white flex items-center justify-center text-xs font-bold shadow-xs">
              3
            </span>
            <h3 class="text-sm font-bold text-[#202124] dark:text-white">Enter Default Credentials</h3>
          </div>
          <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed pl-11">
            Enter username <strong class="text-[#202124] dark:text-white font-mono">admin</strong> and password <strong class="text-[#202124] dark:text-white font-mono">admin</strong> or <strong class="text-[#202124] dark:text-white font-mono">password</strong> on the login screen.
          </p>
        </div>

        <!-- Step 4 (Google Red) -->
        <div class="p-4 rounded-2xl bg-[#f8fafd] dark:bg-[#202124] border border-[#e8eaed] dark:border-[#3c4043] space-y-2">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-[#ea4335] text-white flex items-center justify-center text-xs font-bold shadow-xs">
              4
            </span>
            <h3 class="text-sm font-bold text-[#202124] dark:text-white">Configure & Harden Security</h3>
          </div>
          <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed pl-11">
            Navigate to Wireless Settings to change default Wi-Fi passwords, enable WPA3/WPA2 encryption, and change master admin credentials.
          </p>
        </div>
      </div>
    </section>

    <!-- ========================================================= -->
    <!-- 5. GOOGLE "DID YOU MEAN?" TYPO PITFALL CARD -->
    <!-- ========================================================= -->
    <section class="p-5 sm:p-6 rounded-2xl sm:rounded-3xl bg-[#fef7e0] dark:bg-[#332a00]/40 border border-[#fbbc04]/60 dark:border-[#fbbc04]/30 space-y-3">
      <div class="flex items-center gap-2 text-[#b06000] dark:text-[#fdd663] font-bold text-sm sm:text-base">
        <span>⚠️</span>
        <span>Common IP Typo Pitfalls (192.168.l.l vs 192.168.1.1)</span>
      </div>
      <p class="text-xs text-[#5f6368] dark:text-[#e8eaed] leading-relaxed">
        Router IP addresses only contain numbers (0-9). Typing letters like "l" (lowercase L) or "o" (letter O) will mistakenly trigger a Google search instead of connecting to your local router:
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-xs font-mono font-bold">
        <div class="bg-white dark:bg-[#202124] p-2.5 rounded-xl border border-[#dadce0] dark:border-[#5f6368] flex flex-col shadow-2xs">
          <span class="text-[#ea4335] line-through text-[11px]">192.168.l.l</span>
          <span class="text-[#34a853] font-bold text-xs">✓ 192.168.1.1</span>
        </div>
        <div class="bg-white dark:bg-[#202124] p-2.5 rounded-xl border border-[#dadce0] dark:border-[#5f6368] flex flex-col shadow-2xs">
          <span class="text-[#ea4335] line-through text-[11px]">192.168.o.1</span>
          <span class="text-[#34a853] font-bold text-xs">✓ 192.168.0.1</span>
        </div>
        <div class="bg-white dark:bg-[#202124] p-2.5 rounded-xl border border-[#dadce0] dark:border-[#5f6368] flex flex-col shadow-2xs">
          <span class="text-[#ea4335] line-through text-[11px]">19216811</span>
          <span class="text-[#34a853] font-bold text-xs">✓ 192.168.1.1</span>
        </div>
        <div class="bg-white dark:bg-[#202124] p-2.5 rounded-xl border border-[#dadce0] dark:border-[#5f6368] flex flex-col shadow-2xs">
          <span class="text-[#ea4335] line-through text-[11px]">http 192.168 1.1</span>
          <span class="text-[#34a853] font-bold text-xs">✓ 192.168.1.1</span>
        </div>
      </div>
    </section>

    <!-- Cross-Directory Interlinking Network (Before FAQ) -->
    <RelatedLinksGrid currentSlug="192-168-1-1" />

    <!-- ========================================================= -->
    <!-- 6. GOOGLE SEARCH STYLE FAQ ACCORDION (JUST ABOVE FOOTER) -->
    <!-- ========================================================= -->
    <section class="g-card p-5 sm:p-7 space-y-4">
      <div class="flex items-center gap-2 border-b border-[#e8eaed] dark:border-[#3c4043] pb-3">
        <span class="text-lg">❓</span>
        <div>
          <h2 class="text-base sm:text-lg font-bold text-[#202124] dark:text-white">
            Frequently Asked Questions & Answers
          </h2>
