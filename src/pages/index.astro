<script define:vars={{ heroSearchItems }}>
  // Single-click copy handler with immediate visual feedback
  document.querySelectorAll('.copy-btn').forEach(button => {
    button.addEventListener('click', () => {
      const textToCopy = button.getAttribute('data-copy');
      if (!textToCopy) return;

      navigator.clipboard.writeText(textToCopy).then(() => {
        const originalText = button.innerHTML;
        button.innerHTML = '✓ Copied';
        button.classList.add('bg-[#34a853]', 'text-white', 'border-[#34a853]');
        button.classList.remove('bg-white', 'dark:bg-[#303134]', 'text-[#3c4043]', 'dark:text-[#e8eaed]');

        setTimeout(() => {
          button.innerHTML = originalText;
          button.classList.remove('bg-[#34a853]', 'text-white', 'border-[#34a853]');
          button.classList.add('bg-white', 'dark:bg-[#303134]', 'text-[#3c4043]', 'dark:text-[#e8eaed]');
        }, 1500);
      });
    });
  });

  // Dynamic Gateway Tab Switcher for Google Knowledge OneBox
  const tabs = document.querySelectorAll('.gateway-tab');
  const ipDisplay = document.getElementById('onebox-ip-display');
  const brandsDisplay = document.getElementById('onebox-brands-display');
  const launchBtn = document.getElementById('onebox-launch-btn');
  const launchText = document.getElementById('onebox-launch-text');
  const userDisplay = document.getElementById('onebox-user-display');
  const passDisplay = document.getElementById('onebox-pass-display');
  const copyUserBtn = document.getElementById('onebox-copy-user-btn');
  const copyPassBtn = document.getElementById('onebox-copy-pass-btn');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => {
        t.classList.remove('bg-[#e8f0fe]', 'dark:bg-[#1a3a60]', 'text-[#1a73e8]', 'dark:text-[#8ab4f8]', 'border-[#d2e3fc]', 'dark:border-[#1a73e8]');
        t.classList.add('bg-white', 'dark:bg-[#303134]', 'text-[#5f6368]', 'dark:text-[#e8eaed]', 'border-[#dadce0]', 'dark:border-[#5f6368]');
      });
      tab.classList.remove('bg-white', 'dark:bg-[#303134]', 'text-[#5f6368]', 'dark:text-[#e8eaed]', 'border-[#dadce0]', 'dark:border-[#5f6368]');
      tab.classList.add('bg-[#e8f0fe]', 'dark:bg-[#1a3a60]', 'text-[#1a73e8]', 'dark:text-[#8ab4f8]', 'border-[#d2e3fc]', 'dark:border-[#1a73e8]');

      const ip = tab.getAttribute('data-ip') || '192.168.1.1';
      const user = tab.getAttribute('data-user') || 'admin';
      const pass = tab.getAttribute('data-pass') || 'admin';
      const brands = tab.getAttribute('data-brands') || '';

      if (ipDisplay) ipDisplay.textContent = ip;
      if (brandsDisplay) brandsDisplay.textContent = `Default for ${brands}`;
      if (launchBtn) launchBtn.setAttribute('href', `http://${ip}`);
      if (launchText) launchText.textContent = `Open http://${ip}`;
      if (userDisplay) userDisplay.textContent = user;
      if (passDisplay) passDisplay.textContent = pass;
      if (copyUserBtn) copyUserBtn.setAttribute('data-copy', user);
      if (copyPassBtn) copyPassBtn.setAttribute('data-copy', pass);
    });
  });

  // Hero Live Search Autocomplete
  const heroInput = document.getElementById('hero-search-input');
  const heroResults = document.getElementById('hero-search-results');
  const heroList = document.getElementById('hero-results-list');
  const heroClear = document.getElementById('hero-search-clear');
  const heroChips = document.querySelectorAll('.hero-chip');

  function renderHeroSearch(query) {
    if (!query.trim()) {
      heroResults?.classList.add('hidden');
      heroClear?.classList.add('hidden');
      return;
    }

    heroClear?.classList.remove('hidden');
    const q = query.toLowerCase().trim();
    const matches = heroSearchItems.filter(item => 
      item.name.toLowerCase().includes(q) ||
      item.title.toLowerCase().includes(q) ||
      item.subtitle.toLowerCase().includes(q) ||
      item.category.toLowerCase().includes(q)
    ).slice(0, 6);

    if (matches.length === 0) {
      if (heroList) {
        heroList.innerHTML = `
          <div class="p-4 text-center text-xs text-[#5f6368] dark:text-[#9aa0a6]">
            No matching results found for "<strong class="text-[#202124] dark:text-white">${query}</strong>"
          </div>
        `;
      }
      heroResults?.classList.remove('hidden');
      return;
    }

    if (heroList) {
      heroList.innerHTML = matches.map(item => `
        <a 
          href="${item.url}" 
          class="flex items-center justify-between p-3.5 hover:bg-[#f8fafd] dark:hover:bg-[#303134] transition-colors text-left group"
        >
          <div class="space-y-0.5">
            <div class="text-xs font-bold text-[#202124] dark:text-white group-hover:text-[#1a73e8] dark:group-hover:text-[#8ab4f8] flex items-center gap-2">
              <span>${item.title}</span>
              <span class="text-[10px] px-2 py-0.2 rounded-full bg-[#f1f3f4] dark:bg-[#3c4043] text-[#5f6368] dark:text-[#e8eaed] font-medium border border-[#dadce0] dark:border-[#5f6368]">${item.badge}</span>
            </div>
            <div class="text-[11px] text-[#5f6368] dark:text-[#9aa0a6] font-mono">${item.subtitle}</div>
          </div>
          <span class="text-[#1a73e8] dark:text-[#8ab4f8] text-xs font-bold group-hover:translate-x-0.5 transition-transform">→</span>
        </a>
      `).join('');
    }
    heroResults?.classList.remove('hidden');
  }

  heroInput?.addEventListener('input', (e) => {
    renderHeroSearch(e.target.value);
  });

  heroClear?.addEventListener('click', () => {
    if (heroInput) heroInput.value = '';
    renderHeroSearch('');
  });

  heroChips.forEach(chip => {
    chip.addEventListener('click', () => {
      const q = chip.getAttribute('data-query') || '';
      if (heroInput) {
        heroInput.value = q;
        renderHeroSearch(q);
      }
    });
  });

  document.addEventListener('click', (e) => {
    if (!document.getElementById('hero-search-wrapper')?.contains(e.target)) {
      heroResults?.classList.add('hidden');
    }
  });
</script>
