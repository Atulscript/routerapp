---
import BaseLayout from '../layouts/BaseLayout.astro';
import RouterLookupTable from '../components/RouterLookupTable.astro';
import BrandCard from '../components/BrandCard.astro';
import AdBanner from '../components/AdBanner.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';
import { GATEWAY_IPS, BRANDS, ISPS, ROUTER_MODELS, formatModelTitle } from '../lib/data-loader';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "192.168.1.1 Router Admin Login, Passwords & Setup Guide | 19216811.page";
const description = "Access 192.168.1.1 router admin dashboard. Verified factory usernames, default passwords, Wi-Fi setup guides, and troubleshooting for TP-Link, Netgear, ASUS, JioFiber & Airtel.";
const keywords = [
  "192.168.1.1",
  "192.168.1.1 login",
  "192.168.1.1 admin",
  "router admin login",
  "default router password",
  "192.168.0.1",
  "router setup",
  "tp link router login",
  "netgear default password",
  "asus router admin",
  "default gateway ip",
  "wifi password change"
];

const currentIp = GATEWAY_IPS.find(i => i.ip === '192.168.1.1') || GATEWAY_IPS[0];
const otherIps = GATEWAY_IPS.filter(i => i.ip !== '192.168.1.1');
const popularBrands = BRANDS.slice(0, 8);

// Collect top search items for the interactive hero search
const heroSearchItems = [
  ...GATEWAY_IPS.map(ip => ({
    name: `${ip.ip} router login admin gateway default`,
    title: `${ip.ip} Admin Login`,
    category: 'Gateway IP',
    url: ip.slug === '192-168-1-1' ? `${base}/` : `${base}/${ip.slug}`,
    subtitle: `Default: ${ip.defaultUser} / ${ip.defaultPass} · ${ip.commonBrands.slice(0, 3).join(', ')}`,
    badge: 'IP Gateway'
  })),
  ...BRANDS.map(b => ({
    name: `${b.name} router setup default password admin ip`,
    title: `${b.name} Routers`,
    category: 'Brand',
    url: `${base}/${b.slug}`,
    subtitle: `Default IP: ${b.defaultIp} · ${b.models.length} Models`,
    badge: 'Brand'
  })),
  ...ROUTER_MODELS.slice(0, 150).map(m => ({
    name: `${m.brand} ${m.model} ${m.series || ''} ${m.wifiStandard || ''} ${m.category || ''} ${m.ip}`,
    title: formatModelTitle(m.brand, m.model),
    category: 'Model',
    url: `${base}/${m.slug}`,
    subtitle: `${m.wifiStandard ? m.wifiStandard.split(' ')[0] + ' · ' : ''}IP: ${m.ip} · ${m.category}`,
    badge: 'Hardware'
  })),
  {
    name: 'Internet Speed Test WiFi Ping Jitter Download Upload Bandwidth Latency',
    title: 'Internet Speed Test',
    category: 'Tool',
    url: `${base}/speed-test`,
    subtitle: 'Measure WiFi Latency, Ping, Download & Upload',
    badge: 'Tool'
  },
  {
    name: 'Subnet Calculator CIDR IP Network Host Range Netmask Wildcard',
    title: 'CIDR Subnet Calculator',
    category: 'Tool',
    url: `${base}/subnet-calculator`,
    subtitle: 'IPv4 Subnetting, Host Ranges, Netmask & Wildcard',
    badge: 'Tool'
  },
  {
    name: 'What Is My IP Public IPv4 IPv6 Address ISP Detector Gateway Finder',
    title: 'What Is My IP Address?',
    category: 'Tool',
    url: `${base}/what-is-my-ip`,
    subtitle: 'Instant Public IP, ISP & Gateway Detector',
    badge: 'Tool'
  },
  {
    name: 'WiFi QR Code Generator Scan Connect Password Guest Network',
    title: 'WiFi QR Code Generator',
    category: 'Tool',
    url: `${base}/wifi-qr-generator`,
    subtitle: 'Generate Printable QR Code to Connect Instantly',
    badge: 'Tool'
  }
];

// Comprehensive JSON-LD structured data graph
const schema = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://atulscript.github.io/routerapp/"
      }
    ]
  },
  {
    "@type": "HowTo",
    "name": "How to Log In to 192.168.1.1 Router Admin Panel",
    "description": "Step-by-step guide to connect, access, and log into your wireless router admin dashboard at 192.168.1.1.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Connect to Router Network",
        "text": "Connect your PC, smartphone, or laptop to your router via Ethernet cable or Wi-Fi network.",
        "url": "https://atulscript.github.io/routerapp/#step-1"
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Open Web Browser",
        "text": "Launch your preferred web browser such as Google Chrome, Firefox, Safari, or Microsoft Edge.",
        "url": "https://atulscript.github.io/routerapp/#step-2"
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Navigate to 192.168.1.1",
        "text": "Type http://192.168.1.1 into the browser address bar and press Enter.",
        "url": "https://atulscript.github.io/routerapp/#step-3"
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Enter Admin Credentials",
        "text": "Enter your router default username (e.g., admin) and password (e.g., admin, password, or blank), then click Login.",
        "url": "https://atulscript.github.io/routerapp/#step-4"
      }
    ]
  },
  {
    "@type": "TechArticle",
    "headline": title,
    "description": description,
    "url": "https://atulscript.github.io/routerapp/",
    "author": {
      "@type": "Organization",
      "name": "19216811.page Network Research"
    },
    "articleBody": currentIp.steps.join(' ')
  },
  {
    "@type": "FAQPage",
    "mainEntity": currentIp.faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  }
];
---

<BaseLayout 
  title={title} 
  description={description} 
  keywords={keywords}
  schema={schema}
  ogType="website"
>
  
  <!-- ========================================================= -->
  <!-- 1. GOOGLE HERO & LIVE INTERACTIVE SEARCH SECTION -->
  <!-- ========================================================= -->
  <section class="relative pt-8 sm:pt-12 pb-10 sm:pb-14 border-b border-[#dadce0] dark:border-[#3c4043] bg-gradient-to-b from-white via-[#f8fafd] to-white dark:from-[#202124] dark:via-[#292a2d]/40 dark:to-[#202124]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      
      <!-- Google Brand Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white dark:bg-[#303134] border border-[#dadce0] dark:border-[#5f6368] text-xs font-medium mb-5 shadow-2xs">
        <div class="flex items-center gap-1">
          <span class="w-2.5 h-2.5 rounded-full bg-[#4285f4]"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#ea4335]"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#fbbc05]"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#34a853]"></span>
        </div>
        <span class="font-bold text-[#202124] dark:text-[#e8eaed]">Universal Router Gateway Directory</span>
        <span class="text-[#dadce0] dark:text-[#5f6368]">|</span>
        <span class="text-[#5f6368] dark:text-[#9aa0a6]">400+ Verified Models</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#202124] dark:text-white tracking-tight mb-3 font-sans leading-tight">
        Universal Router Admin & <span class="text-[#1a73e8] dark:text-[#8ab4f8]">Network Directory</span>
      </h1>
      
      <p class="text-xs sm:text-sm text-[#5f6368] dark:text-[#9aa0a6] max-w-xl mx-auto mb-7 leading-relaxed">
        Find factory default passwords for 400+ router models, access <strong class="text-[#202124] dark:text-white font-mono">192.168.1.1</strong> & <strong class="text-[#202124] dark:text-white font-mono">192.168.0.1</strong> gateways, and run network diagnostics.
      </p>

      <!-- Google Material 3 Hero Search Bar with Live Instant Autocomplete -->
      <div class="relative max-w-xl mx-auto mb-7 text-left" id="hero-search-wrapper">
        <div class="g-search-bar px-4 py-3">
          <div class="text-[#5f6368] dark:text-[#9aa0a6] mr-3 flex items-center">
            <svg class="w-5 h-5 text-[#1a73e8] dark:text-[#8ab4f8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <input 
            type="text" 
            id="hero-search-input" 
            placeholder="Search any router model, brand, IP, or tool (e.g. Archer, Netgear, 192.168.1.1)..." 
            class="w-full bg-transparent text-sm text-[#202124] dark:text-white placeholder-[#80868b] dark:placeholder-[#9aa0a6] outline-none font-medium"
            autocomplete="off"
            spellcheck="false"
          />
          <button 
            id="hero-search-clear" 
            type="button" 
            class="hidden text-[#80868b] hover:text-[#202124] dark:hover:text-white text-sm font-bold ml-2"
          >
            ✕
          </button>
        </div>

        <!-- Live Hero Search Results Dropdown -->
        <div 
          id="hero-search-results" 
          class="absolute left-0 right-0 top-full mt-2 bg-white dark:bg-[#292a2d] rounded-2xl sm:rounded-3xl shadow-card-hover border border-[#dadce0] dark:border-[#3c4043] overflow-hidden hidden z-50 max-h-96 overflow-y-auto divide-y divide-[#f1f3f4] dark:divide-[#3c4043] custom-scrollbar animate-fade-in"
        >
          <div id="hero-results-list"></div>
        </div>
      </div>

      <!-- Quick Search Chips -->
      <div class="flex flex-wrap items-center justify-center gap-1.5 text-xs text-[#5f6368] dark:text-[#9aa0a6] mb-8">
        <span class="font-medium mr-1 text-[11px] uppercase tracking-wider text-[#80868b]">Popular:</span>
        <button type="button" class="hero-chip g-chip text-[11px]" data-query="192.168.1.1">192.168.1.1</button>
        <button type="button" class="hero-chip g-chip text-[11px]" data-query="192.168.0.1">192.168.0.1</button>
        <button type="button" class="hero-chip g-chip text-[11px]" data-query="TP-Link">TP-Link</button>
        <button type="button" class="hero-chip g-chip text-[11px]" data-query="Netgear">Netgear</button>
        <button type="button" class="hero-chip g-chip text-[11px]" data-query="ASUS">ASUS</button>
        <button type="button" class="hero-chip g-chip text-[11px]" data-query="Ubiquiti">Ubiquiti</button>
        <button type="button" class="hero-chip g-chip text-[11px]" data-query="Speed Test">⚡ Speed Test</button>
      </div>

      <!-- ========================================================= -->
      <!-- GOOGLE KNOWLEDGE ONEBOX (DYNAMIC GATEWAY SWITCHER) -->
      <!-- ========================================================= -->
      <div class="g-onebox max-w-2xl mx-auto text-left" id="onebox-container">
        
        <!-- Gateway Switcher Tab Bar -->
        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-3 mb-4 border-b border-[#e8eaed] dark:border-[#3c4043]">
          <span class="text-[11px] uppercase font-bold text-[#80868b] dark:text-[#9aa0a6] mr-1 flex-shrink-0">Gateway:</span>
          {GATEWAY_IPS.slice(0, 6).map((item, idx) => (
            <button 
              type="button" 
              class={`gateway-tab px-3 py-1 rounded-full text-xs font-mono font-bold transition-all flex-shrink-0 cursor-pointer ${idx === 0 ? 'bg-[#e8f0fe] dark:bg-[#1a3a60] text-[#1a73e8] dark:text-[#8ab4f8] border border-[#d2e3fc] dark:border-[#1a73e8]' : 'bg-white dark:bg-[#303134] text-[#5f6368] dark:text-[#e8eaed] border border-[#dadce0] dark:border-[#5f6368] hover:bg-[#f1f3f4] dark:hover:bg-[#3c4043]'}`}
              data-ip={item.ip}
              data-user={item.defaultUser}
              data-pass={item.defaultPass}
              data-desc={item.description}
              data-brands={item.commonBrands.slice(0, 4).join(', ')}
              data-slug={item.slug}
            >
              {item.ip}
            </button>
          ))}
        </div>

        <!-- Dynamic Control Card Area -->
        <div class="space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[#e8eaed] dark:border-[#3c4043] pb-4">
            <div>
              <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-[#e6f4ea] dark:bg-[#133e24] text-[#34a853] dark:text-[#81c995] border border-[#ceead6] dark:border-[#34a853] mb-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#34a853] animate-pulse"></span>
                Active Gateway Control Panel
              </div>
              <div class="text-2xl sm:text-3xl font-mono font-bold text-[#202124] dark:text-white tracking-tight" id="onebox-ip-display">
                192.168.1.1
              </div>
              <div class="text-xs text-[#5f6368] dark:text-[#9aa0a6] mt-0.5" id="onebox-brands-display">
                Default for TP-Link, Netgear, ASUS, Linksys, Cisco
              </div>
            </div>

            <a 
              href="http://192.168.1.1" 
              id="onebox-launch-btn"
              target="_blank" 
              rel="noopener noreferrer"
              class="g-btn-primary w-full sm:w-auto text-center"
            >
              <span id="onebox-launch-text">Open http://192.168.1.1</span>
              <span class="text-xs">↗</span>
            </a>
          </div>

          <!-- Credentials Row -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="p-3.5 rounded-2xl bg-[#f8fafd] dark:bg-[#202124] border border-[#e8eaed] dark:border-[#3c4043] flex items-center justify-between">
              <div>
                <div class="text-[10px] font-bold uppercase tracking-wider text-[#5f6368] dark:text-[#9aa0a6]">Default User</div>
                <div class="text-sm font-mono font-bold text-[#202124] dark:text-white mt-0.5" id="onebox-user-display">admin</div>
              </div>
              <button 
                type="button" 
                id="onebox-copy-user-btn"
                class="copy-btn text-[11px] font-bold px-3 py-1 rounded-full bg-white dark:bg-[#303134] border border-[#dadce0] dark:border-[#5f6368] text-[#3c4043] dark:text-[#e8eaed] hover:bg-[#f1f3f4] dark:hover:bg-[#3c4043] transition-all cursor-pointer shadow-2xs"
                data-copy="admin"
              >
                📋 Copy
              </button>
            </div>

            <div class="p-3.5 rounded-2xl bg-[#f8fafd] dark:bg-[#202124] border border-[#e8eaed] dark:border-[#3c4043] flex items-center justify-between">
              <div>
                <div class="text-[10px] font-bold uppercase tracking-wider text-[#5f6368] dark:text-[#9aa0a6]">Default Password</div>
                <div class="text-sm font-mono font-bold text-[#202124] dark:text-white mt-0.5" id="onebox-pass-display">admin / password</div>
              </div>
              <button 
                type="button" 
                id="onebox-copy-pass-btn"
                class="copy-btn text-[11px] font-bold px-3 py-1 rounded-full bg-white dark:bg-[#303134] border border-[#dadce0] dark:border-[#5f6368] text-[#3c4043] dark:text-[#e8eaed] hover:bg-[#f1f3f4] dark:hover:bg-[#3c4043] transition-all cursor-pointer shadow-2xs"
                data-copy="admin"
              >
                📋 Copy
              </button>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Top Leaderboard Ad Slot -->
  <AdBanner format="leaderboard" />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-9">

    <!-- ========================================================= -->
    <!-- 2. GOOGLE MATERIAL 3 DIAGNOSTIC TOOLS GRID -->
    <!-- ========================================================= -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-[#e8f0fe] dark:bg-[#1a3a60] text-[#1a73e8] dark:text-[#8ab4f8] text-xs font-bold mb-1">
            ⚡ Web Utilities
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-[#202124] dark:text-white tracking-tight">
            Network Diagnostics & Web Tools
          </h2>
          <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] mt-0.5">
            Instant browser utilities for latency testing, IP subnetting, and Wi-Fi QR generation
          </p>
        </div>
        <a href={`${base}/tools`} class="g-btn-outlined text-xs font-bold">
          <span>All Tools</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <!-- Speed Test Tool Card (Google Blue) -->
        <a href={`${base}/speed-test`} class="g-card p-5 flex flex-col justify-between group">
          <div class="space-y-3">
            <div class="w-11 h-11 rounded-2xl bg-[#e8f0fe] dark:bg-[#1a3a60] text-[#1a73e8] dark:text-[#8ab4f8] flex items-center justify-center text-xl font-bold shadow-2xs group-hover:scale-105 transition-transform">
              ⚡
            </div>
            <div>
              <h3 class="font-bold text-sm text-[#202124] dark:text-white group-hover:text-[#1a73e8] dark:group-hover:text-[#8ab4f8] transition-colors">
                Internet Speed Test
              </h3>
              <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] mt-1 leading-relaxed">
                Test download, upload speed, latency, and ping jitter in real time.
              </p>
            </div>
          </div>
          <div class="pt-3.5 border-t border-[#e8eaed] dark:border-[#3c4043] text-xs font-bold text-[#1a73e8] dark:text-[#8ab4f8] flex items-center justify-between">
            <span>Run Benchmark</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>

        <!-- Subnet Calculator Tool Card (Google Green) -->
        <a href={`${base}/subnet-calculator`} class="g-card p-5 flex flex-col justify-between group">
          <div class="space-y-3">
            <div class="w-11 h-11 rounded-2xl bg-[#e6f4ea] dark:bg-[#133e24] text-[#34a853] dark:text-[#81c995] flex items-center justify-center text-xl font-bold shadow-2xs group-hover:scale-105 transition-transform">
              🧮
            </div>
            <div>
              <h3 class="font-bold text-sm text-[#202124] dark:text-white group-hover:text-[#34a853] dark:group-hover:text-[#81c995] transition-colors">
                CIDR Subnet Calculator
              </h3>
              <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] mt-1 leading-relaxed">
                Calculate usable IPv4 host ranges, broadcast, netmask, and binary bits.
              </p>
            </div>
          </div>
          <div class="pt-3.5 border-t border-[#e8eaed] dark:border-[#3c4043] text-xs font-bold text-[#34a853] dark:text-[#81c995] flex items-center justify-between">
            <span>Calculate Subnet</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>

        <!-- What Is My IP Card (Google Yellow) -->
        <a href={`${base}/what-is-my-ip`} class="g-card p-5 flex flex-col justify-between group">
          <div class="space-y-3">
            <div class="w-11 h-11 rounded-2xl bg-[#fef7e0] dark:bg-[#4d3800] text-[#f9ab00] dark:text-[#fdd663] flex items-center justify-center text-xl font-bold shadow-2xs group-hover:scale-105 transition-transform">
              🌐
            </div>
            <div>
              <h3 class="font-bold text-sm text-[#202124] dark:text-white group-hover:text-[#f9ab00] dark:group-hover:text-[#fdd663] transition-colors">
                What Is My IP Address?
              </h3>
              <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] mt-1 leading-relaxed">
                Detect your public IPv4, IPv6, ISP provider, and default gateway address.
              </p>
            </div>
          </div>
          <div class="pt-3.5 border-t border-[#e8eaed] dark:border-[#3c4043] text-xs font-bold text-[#f9ab00] dark:text-[#fdd663] flex items-center justify-between">
            <span>Check IP Info</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>

        <!-- WiFi QR Code Generator (Google Red) -->
        <a href={`${base}/wifi-qr-generator`} class="g-card p-5 flex flex-col justify-between group">
          <div class="space-y-3">
            <div class="w-11 h-11 rounded-2xl bg-[#fce8e6] dark:bg-[#4c1d1a] text-[#ea4335] dark:text-[#f28b82] flex items-center justify-center text-xl font-bold shadow-2xs group-hover:scale-105 transition-transform">
              📱
            </div>
            <div>
              <h3 class="font-bold text-sm text-[#202124] dark:text-white group-hover:text-[#ea4335] dark:group-hover:text-[#f28b82] transition-colors">
                Wi-Fi QR Generator
              </h3>
              <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] mt-1 leading-relaxed">
                Generate printable QR codes for guests to connect instantly without typing keys.
              </p>
            </div>
          </div>
          <div class="pt-3.5 border-t border-[#e8eaed] dark:border-[#3c4043] text-xs font-bold text-[#ea4335] dark:text-[#f28b82] flex items-center justify-between">
            <span>Generate QR</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>

      </div>
    </section>

    <!-- ========================================================= -->
    <!-- 3. TOP ROUTER BRANDS SHOWCASE (GOOGLE STORE STYLE) -->
    <!-- ========================================================= -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-[#e6f4ea] dark:bg-[#133e24] text-[#34a853] dark:text-[#81c995] text-xs font-bold mb-1">
            🏷️ Hardware Manufacturers
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-[#202124] dark:text-white tracking-tight">
            Popular Router Brands & Defaults
          </h2>
          <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] mt-0.5">
            Explore setup guides and factory login credentials for leading network hardware
          </p>
        </div>
        <a href={`${base}/brands`} class="g-btn-outlined text-xs font-bold">
          <span>All Brands ({BRANDS.length})</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
        {popularBrands.map(brand => (
          <BrandCard data={brand} />
        ))}
      </div>
    </section>

    <!-- ========================================================= -->
    <!-- 4. MASTER HARDWARE CATALOG & LOOKUP TABLE -->
    <!-- ========================================================= -->
    <section class="g-card p-5 sm:p-7 space-y-4">
