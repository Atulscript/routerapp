---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import RouterLookupTable from '../components/RouterLookupTable.astro';
import RouterGuideCard from '../components/RouterGuideCard.astro';
import BrandCard from '../components/BrandCard.astro';
import IspCard from '../components/IspCard.astro';
import AdBanner from '../components/AdBanner.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';
import { GATEWAY_IPS, BRANDS, ISPS } from '../lib/data-loader';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "192.168.1.1 Router Admin Login, Passwords & Setup Guide | 19216811.page";
const description = "Access 192.168.1.1 router admin dashboard. Verified factory usernames, default passwords, Wi-Fi setup guides, and troubleshooting for TP-Link, Netgear, ASUS, JioFiber & Airtel.";
const keywords = [
  "192.168.1.1",
  "192.168.1.1 login",
  "192.168.1.1 admin",
  "router admin login",
  "default router password",
  "192.168.0.1",
  "router setup",
  "tp link router login",
  "netgear default password",
  "asus router admin",
  "default gateway ip",
  "wifi password change"
];

const currentIp = GATEWAY_IPS.find(i => i.ip === '192.168.1.1') || GATEWAY_IPS[0];
const otherIps = GATEWAY_IPS.filter(i => i.ip !== '192.168.1.1');

// Comprehensive JSON-LD structured data graph (HowTo + FAQPage + Breadcrumbs)
const schema = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://atulscript.github.io/routerapp/"
      }
    ]
  },
  {
    "@type": "HowTo",
    "name": "How to Log In to 192.168.1.1 Router Admin Panel",
    "description": "Step-by-step guide to connect, access, and log into your wireless router admin dashboard at 192.168.1.1.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Connect to Router Network",
        "text": "Connect your PC, smartphone, or laptop to your router via Ethernet cable or Wi-Fi network.",
        "url": "https://atulscript.github.io/routerapp/#step-1"
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Open Web Browser",
        "text": "Launch your preferred web browser such as Google Chrome, Firefox, Safari, or Microsoft Edge.",
        "url": "https://atulscript.github.io/routerapp/#step-2"
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Navigate to 192.168.1.1",
        "text": "Type http://192.168.1.1 into the browser address bar and press Enter.",
        "url": "https://atulscript.github.io/routerapp/#step-3"
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Enter Admin Credentials",
        "text": "Enter your router default username (e.g., admin) and password (e.g., admin, password, or blank), then click Login.",
        "url": "https://atulscript.github.io/routerapp/#step-4"
      }
    ]
  },
  {
    "@type": "TechArticle",
    "headline": title,
    "description": description,
    "url": "https://atulscript.github.io/routerapp/",
    "author": {
      "@type": "Organization",
      "name": "19216811.page Network Research"
    },
    "articleBody": currentIp.steps.join(' ')
  },
  {
    "@type": "FAQPage",
    "mainEntity": currentIp.faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  }
];
---

<BaseLayout 
  title={title} 
  description={description} 
  keywords={keywords}
  schema={schema}
  ogType="website"
>
  
  <!-- Modern Sleek Hero Section with Vibrant Background Accents -->
  <section class="relative bg-gradient-to-b from-white via-sky-50/30 to-slate-50 dark:from-slate-950 dark:via-slate-900/60 dark:to-slate-950 py-8 sm:py-12 border-b border-slate-200/80 dark:border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      
      <!-- Animated Status Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 text-slate-700 dark:text-slate-300 text-xs font-semibold tracking-tight mb-4 shadow-2xs hover:shadow-xs transition-shadow">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="font-bold text-slate-900 dark:text-white">19216811.page</span>
        <span class="text-slate-300 dark:text-slate-700">|</span>
        <span class="text-slate-600 dark:text-slate-400 font-medium">Universal Router Gateway Directory</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-3 font-sans leading-tight">
        192.168.1.1 <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-600 via-sky-600 to-indigo-600 dark:from-brand-400 dark:via-sky-400 dark:to-indigo-400">Router Admin Login</span>
      </h1>
      
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 max-w-xl mx-auto mb-6 leading-relaxed">
        Access your wireless router and modem dashboard at <strong>http://192.168.1.1</strong>. Lookup default factory passwords, configure Wi-Fi security, and fix connection errors.
      </p>

      <!-- Primary 192.168.1.1 Command Card with Live Accents -->
      <div class="bg-white dark:bg-slate-900 rounded-2xl p-5 sm:p-6 text-slate-900 dark:text-white shadow-card hover:shadow-card-hover border border-slate-200/90 dark:border-slate-800 max-w-xl mx-auto mb-5 text-left transition-all duration-200">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <div class="inline-flex items-center gap-1.5 text-[10px] uppercase font-extrabold tracking-wider text-brand-700 dark:text-brand-300 bg-sky-50 dark:bg-sky-950/60 px-2 py-0.5 rounded border border-sky-200 dark:border-sky-800/80 mb-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Default Gateway Address
            </div>
            <div class="text-2xl sm:text-3xl font-mono font-extrabold text-slate-900 dark:text-white mt-1 tracking-tight">
              192.168.1.1
            </div>
            <div class="mt-2.5 flex flex-wrap gap-2 text-xs font-mono">
              <span class="bg-slate-100/90 dark:bg-slate-800 px-2.5 py-1 rounded-lg text-slate-700 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700">User: <strong class="text-slate-900 dark:text-white font-bold">admin</strong></span>
              <span class="bg-slate-100/90 dark:bg-slate-800 px-2.5 py-1 rounded-lg text-slate-700 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700">Pass: <strong class="text-slate-900 dark:text-white font-bold">admin / password</strong></span>
            </div>
          </div>
          
          <a 
            href="http://192.168.1.1" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-slate-900 dark:bg-brand-600 hover:bg-brand-600 dark:hover:bg-brand-500 text-white text-xs font-extrabold whitespace-nowrap shadow-xs hover:shadow-md hover:shadow-brand-500/20 transition-all duration-200 active:scale-95 w-full sm:w-auto"
          >
            <span>Open 192.168.1.1</span>
            <span class="text-sky-300 dark:text-sky-100 group-hover:text-white">↗</span>
          </a>
        </div>
      </div>

      <!-- Spotlight Search Bar -->
      <div class="max-w-xl mx-auto">
        <SearchBar />
      </div>

      <!-- Common Gateways Quick Links with Colored Chips -->
      <div class="mt-4 flex flex-wrap items-center justify-center gap-1.5 text-xs">
        <span class="text-slate-400 dark:text-slate-500 font-semibold text-[11px] mr-1">Direct Gateway Shortcuts:</span>
        {otherIps.map(item => (
          <a 
            href={`${base}/${item.slug}`} 
            class="px-3 py-1 rounded-full bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 text-slate-700 dark:text-slate-300 text-xs font-mono font-bold hover:border-brand-500 dark:hover:border-brand-400 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-brand-50/30 dark:hover:bg-slate-800 transition-all shadow-2xs hover:scale-105"
          >
            {item.ip}
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- Leaderboard Ad Slot -->
  <div class="max-w-5xl mx-auto px-4 pt-4">
    <AdBanner format="leaderboard" />
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 space-y-8">
    
    <!-- 1. Interactive Brand & Model Password Table -->
    <section class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/90 dark:border-slate-800 p-4 sm:p-6 shadow-card">
      <div class="max-w-2xl mb-2">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-sky-50 dark:bg-sky-950/60 border border-sky-200 dark:border-sky-800/80 text-brand-700 dark:text-brand-300 text-[10px] font-bold uppercase tracking-wider">
          🔑 Brand Password Database
        </div>
        <h2 class="text-lg sm:text-xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-1.5">
          Find Default Passwords by Router Brand
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 leading-relaxed">
          Select your manufacturer to view default factory credentials, management IP, and protocol.
        </p>
      </div>

      <RouterLookupTable />
    </section>

    <!-- In-Content Ad Slot -->
    <AdBanner format="horizontal" />

    <!-- 2. Router Login & Support Two-Box Guide -->
    <RouterGuideCard 
      entityName="Wireless" 
      ipAddress="192.168.1.1" 
      brandName="TP-Link, Netgear, ASUS, D-Link" 
    />

    <!-- 3. Popular Router Brands That Use 192.168.1.1 -->
    <section>
      <div class="flex items-center justify-between mb-3.5">
        <div>
          <h2 class="text-lg font-bold text-slate-900 dark:text-white tracking-tight">Popular Router Brands</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">Default passwords and setup tutorials by manufacturer</p>
        </div>
        <a href={`${base}/brands`} class="text-xs font-semibold text-brand-600 dark:text-brand-400 hover:underline flex items-center gap-1">
          <span>All Brands</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {BRANDS.slice(0, 9).map(item => (
          <BrandCard data={item} />
        ))}
      </div>
    </section>

    <!-- 4. ISP Fiber ONT Configuration Section -->
    <section>
      <div class="flex items-center justify-between mb-3.5">
        <div>
          <h2 class="text-lg font-bold text-slate-900 dark:text-white tracking-tight">ISP Fiber Gateway Guides</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">Dedicated configuration guides for JioFiber, Airtel Xstream, BSNL, and ACT</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {ISPS.map(item => (
          <IspCard data={item} />
        ))}
      </div>
    </section>

    <!-- 5. Network Security & Router Hardening -->
    <section class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/90 dark:border-slate-800 p-5 sm:p-7 shadow-card space-y-4">
      <div>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/60 border border-indigo-200 dark:border-indigo-800/80 text-indigo-700 dark:text-indigo-300 text-xs font-bold uppercase tracking-wider shadow-2xs">
          🛡️ Network Security Standards
        </span>
        <h2 class="text-lg sm:text-xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
          Essential Security Steps After Logging into 192.168.1.1
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">
          Follow these three foundational security practices immediately after accessing your router control panel:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-1">
        <div class="p-4 rounded-xl bg-slate-50/80 dark:bg-slate-850/60 border border-slate-200/80 dark:border-slate-800 hover:border-indigo-300 dark:hover:border-indigo-500 transition-colors space-y-2">
          <div class="w-8 h-8 rounded-lg bg-indigo-100 dark:bg-indigo-950/80 text-indigo-700 dark:text-indigo-300 flex items-center justify-center text-sm font-bold shadow-2xs">
            🔒
          </div>
          <h3 class="font-bold text-xs sm:text-sm text-slate-900 dark:text-white">1. Change Factory Passwords</h3>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Never leave <code class="font-mono bg-white dark:bg-slate-900 px-1.5 py-0.5 rounded border border-slate-200 dark:border-slate-700 text-[11px] font-bold text-red-600 dark:text-red-400">admin/admin</code> active. Set a custom 16+ character passphrase under <strong>Administration → User Accounts</strong>.
          </p>
        </div>

        <div class="p-4 rounded-xl bg-slate-50/80 dark:bg-slate-850/60 border border-slate-200/80 dark:border-slate-800 hover:border-emerald-300 dark:hover:border-emerald-500 transition-colors space-y-2">
          <div class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300 flex items-center justify-center text-sm font-bold shadow-2xs">
            📶
          </div>
          <h3 class="font-bold text-xs sm:text-sm text-slate-900 dark:text-white">2. Upgrade to WPA3 / WPA2-AES</h3>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Avoid outdated WEP or TKIP cipher modes. Switch your Wi-Fi SSID encryption to <strong>WPA3-Personal</strong> or <strong>WPA2-PSK (AES)</strong> for robust packet protection.
          </p>
        </div>

        <div class="p-4 rounded-xl bg-slate-50/80 dark:bg-slate-850/60 border border-slate-200/80 dark:border-slate-800 hover:border-amber-300 dark:hover:border-amber-500 transition-colors space-y-2">
          <div class="w-8 h-8 rounded-lg bg-amber-100 dark:bg-amber-950/80 text-amber-700 dark:text-amber-300 flex items-center justify-center text-sm font-bold shadow-2xs">
            🚫
          </div>
          <h3 class="font-bold text-xs sm:text-sm text-slate-900 dark:text-white">3. Disable WPS & Remote WAN</h3>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Disable Wi-Fi Protected Setup (WPS PIN) and turn off <strong>Remote WAN Management</strong> to prevent brute-force attacks from the public internet.
          </p>
        </div>
      </div>
    </section>

    <!-- Quick Diagnostic: Finding Router IP on Any OS -->
    <section class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/90 dark:border-slate-800 p-5 sm:p-7 shadow-card space-y-4">
      <div>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-50 dark:bg-sky-950/60 border border-sky-200 dark:border-sky-800/80 text-brand-700 dark:text-brand-300 text-xs font-bold uppercase tracking-wider shadow-2xs">
          🔍 Gateway Detection
        </span>
        <h2 class="text-lg sm:text-xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
          How to Find Your Default Gateway IP Address
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">
          Your device automatically negotiates an IP gateway when connecting to Wi-Fi:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 text-xs">
        <div class="p-4 rounded-xl bg-slate-50/80 dark:bg-slate-850/60 border border-slate-200/80 dark:border-slate-800 hover:border-sky-300 dark:hover:border-sky-500 transition-colors space-y-1.5">
          <div class="flex items-center gap-1.5 text-slate-900 dark:text-white font-bold text-xs sm:text-sm">
            <span>💻</span> Windows
          </div>
          <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-xs">
            Press <kbd class="px-1.5 py-0.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded font-mono text-[10px] shadow-2xs">Win + R</kbd>, type <code class="font-mono bg-white dark:bg-slate-900 px-1.5 py-0.5 rounded border border-slate-200 dark:border-slate-700 text-[10px] font-bold">cmd</code>, and enter <code class="font-mono bg-white dark:bg-slate-900 px-1.5 py-0.5 rounded border border-slate-200 dark:border-slate-700 font-bold text-brand-700 dark:text-brand-400 text-[10px]">ipconfig</code>. Look for <strong>Default Gateway</strong>.
          </p>
        </div>

        <div class="p-4 rounded-xl bg-slate-50/80 dark:bg-slate-850/60 border border-slate-200/80 dark:border-slate-800 hover:border-slate-400 dark:hover:border-slate-600 transition-colors space-y-1.5">
          <div class="flex items-center gap-1.5 text-slate-900 dark:text-white font-bold text-xs sm:text-sm">
            <span>🍎</span> macOS
          </div>
          <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-xs">
            Open <strong>System Settings</strong> → <strong>Wi-Fi</strong> → click <strong>Details...</strong> → <strong>TCP/IP</strong>. Check the numerical <strong>Router IP</strong> address.
          </p>
        </div>

        <div class="p-4 rounded-xl bg-slate-50/80 dark:bg-slate-850/60 border border-slate-200/80 dark:border-slate-800 hover:border-indigo-300 dark:hover:border-indigo-500 transition-colors space-y-1.5">
          <div class="flex items-center gap-1.5 text-slate-900 dark:text-white font-bold text-xs sm:text-sm">
            <span>📱</span> iPhone / iPad
          </div>
          <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-xs">
            Open <strong>Settings</strong> → <strong>Wi-Fi</strong> → tap the blue <span class="font-bold font-mono px-1 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded">ⓘ</span> info button next to your Wi-Fi name. Scroll to <strong>Router</strong>.
          </p>
        </div>

        <div class="p-4 rounded-xl bg-slate-50/80 dark:bg-slate-850/60 border border-slate-200/80 dark:border-slate-800 hover:border-emerald-300 dark:hover:border-emerald-500 transition-colors space-y-1.5">
          <div class="flex items-center gap-1.5 text-slate-900 dark:text-white font-bold text-xs sm:text-sm">
            <span>🤖</span> Android
          </div>
          <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-xs">
            Go to <strong>Settings</strong> → <strong>Network & Internet</strong> → tap Wi-Fi ⚙️ gear icon → <strong>Advanced</strong> to view <strong>Gateway</strong>.
          </p>
        </div>
      </div>
    </section>

    <!-- 6. Typo Warning Alert Box with High Visual Pop -->
    <section class="bg-gradient-to-r from-amber-50 to-orange-50 dark:from-amber-950/40 dark:to-orange-950/30 rounded-2xl p-5 sm:p-6 border border-amber-200/90 dark:border-amber-900/60 shadow-card">
      <div class="max-w-4xl">
        <div class="flex items-center gap-2 text-amber-950 dark:text-amber-200 font-extrabold text-base mb-2">
          <span class="text-lg">⚠️</span> Common IP Typo Pitfalls (192.168.l.l vs 192.168.1.1)
        </div>
        <p class="text-xs text-amber-900/90 dark:text-amber-300/90 leading-relaxed mb-3.5">
          Router IP addresses consist exclusively of numerical digits (0-9). Typing letters such as "l" (lowercase L) or "o" (letter O) will mistakenly trigger a search engine lookup instead of connecting to your local hardware:
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-xs font-mono font-bold">
          <div class="bg-white/95 dark:bg-slate-900/90 p-2.5 rounded-xl border border-amber-200 dark:border-amber-800/70 flex flex-col shadow-2xs">
            <span class="text-red-500 dark:text-red-400 line-through text-[11px]">192.168.l.l</span>
            <span class="text-emerald-700 dark:text-emerald-400 font-extrabold text-xs">✓ 192.168.1.1</span>
          </div>
          <div class="bg-white/95 dark:bg-slate-900/90 p-2.5 rounded-xl border border-amber-200 dark:border-amber-800/70 flex flex-col shadow-2xs">
            <span class="text-red-500 dark:text-red-400 line-through text-[11px]">192.168.o.1</span>
            <span class="text-emerald-700 dark:text-emerald-400 font-extrabold text-xs">✓ 192.168.0.1</span>
          </div>
          <div class="bg-white/95 dark:bg-slate-900/90 p-2.5 rounded-xl border border-amber-200 dark:border-amber-800/70 flex flex-col shadow-2xs">
            <span class="text-red-500 dark:text-red-400 line-through text-[11px]">19216811</span>
            <span class="text-emerald-700 dark:text-emerald-400 font-extrabold text-xs">✓ 192.168.1.1</span>
          </div>
          <div class="bg-white/95 dark:bg-slate-900/90 p-2.5 rounded-xl border border-amber-200 dark:border-amber-800/70 flex flex-col shadow-2xs">
            <span class="text-red-500 dark:text-red-400 line-through text-[11px]">http 192.168 1.1</span>
            <span class="text-emerald-700 dark:text-emerald-400 font-extrabold text-xs">✓ 192.168.1.1</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Cross-Directory Interlinking Network (Before FAQ) -->
    <RelatedLinksGrid currentSlug="192-168-1-1" />

    <!-- 7. 192.168.1.1 Troubleshooting & FAQ Section (Just Above Footer) -->
    <section class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/90 dark:border-slate-800 p-5 sm:p-7 shadow-card space-y-4">
      <div>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800/80 text-emerald-800 dark:text-emerald-300 text-xs font-bold uppercase tracking-wider shadow-2xs">
          ❓ Help & Answers
        </span>
        <h2 class="text-lg sm:text-xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
          Frequently Asked Questions & Troubleshooting
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">
          Solutions for unreachable admin portals, IP address conflicts, and forgotten credentials
        </p>
      </div>

      <div class="space-y-3">
        {currentIp.faqs.map(faq => (
          <details class="group border border-slate-200/90 dark:border-slate-800 rounded-xl p-4 open:bg-slate-50/70 dark:open:bg-slate-850/60 hover:border-slate-300 dark:hover:border-slate-700 transition-all duration-150">
            <summary class="font-bold text-slate-900 dark:text-white cursor-pointer list-none flex justify-between items-center text-xs sm:text-sm">
              <span class="flex items-center gap-2">
                <span class="text-brand-600 dark:text-brand-400 font-black">Q.</span>
                {faq.question}
              </span>
              <span class="text-slate-400 dark:text-slate-500 group-open:rotate-180 group-open:text-brand-600 dark:group-open:text-brand-400 transition-transform duration-200 text-xs flex-shrink-0 ml-2">▼</span>
            </summary>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-2.5 leading-relaxed border-t border-slate-200/80 dark:border-slate-800 pt-2.5">
              {faq.answer}
            </p>
          </details>
        ))}

        <details class="group border border-slate-200/90 dark:border-slate-800 rounded-xl p-4 open:bg-slate-50/70 dark:open:bg-slate-850/60 hover:border-slate-300 dark:hover:border-slate-700 transition-all duration-150">
          <summary class="font-bold text-slate-900 dark:text-white cursor-pointer list-none flex justify-between items-center text-xs sm:text-sm">
            <span class="flex items-center gap-2">
              <span class="text-brand-600 dark:text-brand-400 font-black">Q.</span>
              How do I change the DNS servers on 192.168.1.1 for faster speeds?
            </span>
            <span class="text-slate-400 dark:text-slate-500 group-open:rotate-180 group-open:text-brand-600 dark:group-open:text-brand-400 transition-transform duration-200 text-xs flex-shrink-0 ml-2">▼</span>
          </summary>
          <p class="text-xs text-slate-600 dark:text-slate-300 mt-2.5 leading-relaxed border-t border-slate-200/80 dark:border-slate-800 pt-2.5">
            In your router's <strong>DHCP / LAN Settings</strong>, set Primary DNS to <code class="font-mono bg-white dark:bg-slate-950 px-1.5 py-0.5 rounded border border-slate-200 dark:border-slate-700 font-bold text-brand-700 dark:text-brand-400">1.1.1.1</code> (Cloudflare) or <code class="font-mono bg-white dark:bg-slate-950 px-1.5 py-0.5 rounded border border-slate-200 dark:border-slate-700 font-bold text-brand-700 dark:text-brand-400">8.8.8.8</code> (Google), and Secondary DNS to <code class="font-mono bg-white dark:bg-slate-950 px-1.5 py-0.5 rounded border border-slate-200 dark:border-slate-700 font-bold text-brand-700 dark:text-brand-400">1.0.0.1</code> or <code class="font-mono bg-white dark:bg-slate-950 px-1.5 py-0.5 rounded border border-slate-200 dark:border-slate-700 font-bold text-brand-700 dark:text-brand-400">8.8.4.4</code>.
          </p>
        </details>
      </div>
    </section>

  </div>
</BaseLayout>
