---
// SEO 301 Redirect page: Consolidates ranking signals to the Homepage root
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const targetUrl = `${base}/`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
  <link rel="canonical" href="https://atulscript.github.io/routerapp/" />
  <title>Redirecting to 192.168.1.1 Router Setup Guide...</title>
  <script define:vars={{ targetUrl }}>
    window.location.replace(targetUrl);
  </script>
</head>
<body style="font-family: system-ui, sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; background: #f8fafc; color: #334155; text-align: center;">
  <div>
    <h1 style="font-size: 1.5rem; margin-bottom: 0.5rem;">Redirecting to 192.168.1.1 Portal...</h1>
    <p style="font-size: 0.875rem; color: #64748b;">If you are not redirected automatically, <a href={targetUrl} style="color: #0284c7; font-weight: bold;">click here</a>.</p>
  </div>
</body>
</html>
