---
import BaseLayout from '../layouts/BaseLayout.astro';
import PasswordTable from '../components/PasswordTable.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';
import SearchBar from '../components/SearchBar.astro';
import AdBanner from '../components/AdBanner.astro';
import { BRANDS } from '../lib/data-loader';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "Default Router Passwords List (All Brands & Models) | 19216811.page";
const description = "Comprehensive database of default usernames, passwords, and IP addresses for TP-Link, Netgear, D-Link, ASUS, Cisco, and Linksys routers.";

const allModels = BRANDS.flatMap(b => 
  b.models.map(m => ({
    ...m,
    model: `${b.name} ${m.model}`
  }))
);
---

<BaseLayout title={title} description={description}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    
    <div class="mb-8">
      <SearchBar />
    </div>

    <header class="mb-8 text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-50 text-amber-800 text-xs font-bold uppercase mb-4 border border-amber-200">
        🔑 Master Password Database
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
        Default Router Passwords List
      </h1>
      <p class="text-sm sm:text-base text-slate-600">
        Browse and copy default factory login credentials for all major WiFi router models.
      </p>
    </header>

    <AdBanner format="leaderboard" />

    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-8 my-8">
      {BRANDS.map(brand => (
        <section class="space-y-3">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-sky-500"></span>
              {brand.name} Routers
            </h2>
            <a href={`${base}/${brand.slug}`} class="text-xs font-semibold text-sky-600 hover:text-sky-700">
              View {brand.name} Guide →
            </a>
          </div>
          <PasswordTable models={brand.models} brandName={brand.name} />
        </section>
      ))}
    </div>

    <AdBanner format="horizontal" />

    <!-- Human SEO Advisory Section -->
    <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm space-y-6 my-10">
      <h2 class="text-2xl font-bold text-slate-900">What to Do If Default Router Passwords Don't Work</h2>
      <p class="text-sm text-slate-600 leading-relaxed">
        If you typed the standard <code class="font-mono text-xs bg-slate-100 p-1 rounded">admin / admin</code> or <code class="font-mono text-xs bg-slate-100 p-1 rounded">admin / password</code> and the login prompt returned an authentication error, follow these troubleshooting steps:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 text-xs pt-2">
        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 space-y-2">
          <span class="text-xl">🏷️</span>
          <strong class="text-slate-900 block font-bold text-sm">1. Check Physical Hardware Sticker</strong>
          <p class="text-slate-600 leading-relaxed">
            Many modern routers (like JioFiber, Airtel, and TP-Link Archer) print a randomized, unique factory password on the bottom barcode label instead of generic "admin".
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 space-y-2">
          <span class="text-xl">🔘</span>
          <strong class="text-slate-900 block font-bold text-sm">2. Perform a 10-Second Hardware Reset</strong>
          <p class="text-slate-600 leading-relaxed">
            If the password was changed during initial setup and forgotten, press and hold the physical <em>RESET</em> pinhole button for 10 seconds until all front LED lights cycle.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 space-y-2">
          <span class="text-xl">🔒</span>
          <strong class="text-slate-900 block font-bold text-sm">3. Immediately Create a New Custom Key</strong>
          <p class="text-slate-600 leading-relaxed">
            Once logged in, immediately change the admin login key. Leaving default credentials exposed allows anyone on your Wi-Fi network to hijack router settings.
          </p>
        </div>
      </div>
    </section>

    <!-- Interlinking 2-Column Grid -->
    <div class="mt-12">
      <RelatedLinksGrid />
    </div>

  </div>
</BaseLayout>
