---
import BaseLayout from '../layouts/BaseLayout.astro';
import PasswordTable from '../components/PasswordTable.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';
import SearchBar from '../components/SearchBar.astro';
import AdBanner from '../components/AdBanner.astro';
import { BRANDS } from '../lib/data-loader';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "Default Router Passwords List (All Brands & Models) | 19216811.page";
const description = "Comprehensive database of default usernames, passwords, and IP addresses for TP-Link, Netgear, D-Link, ASUS, Cisco, and Linksys routers.";
---

<BaseLayout title={title} description={description}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6 sm:space-y-8">
    
    <div>
      <SearchBar />
    </div>

    <header class="text-center max-w-xl mx-auto">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-amber-100 text-amber-900 text-[11px] font-bold uppercase mb-2 border border-amber-300">
        🔑 Master Password Database
      </div>
      <h1 class="text-2xl sm:text-4xl font-black text-md-on-surface tracking-tight mb-2">
        Default Router Passwords List
      </h1>
      <p class="text-xs sm:text-sm text-md-on-surface-variant">
        Browse and copy default factory login credentials for all major WiFi router models.
      </p>
    </header>

    <AdBanner format="leaderboard" />

    <!-- Brand Quick-Jump Chips -->
    <div class="flex flex-wrap items-center justify-center gap-1.5 p-3 m3-card-compact bg-md-surface-container-low text-xs">
      <span class="text-md-on-surface-variant text-[11px] font-bold mr-1">Jump to:</span>
      {BRANDS.map(b => (
        <a 
          href={`#brand-${b.slug}`} 
          class="m3-chip m3-chip-outlined py-0.5 px-2 text-[11px] font-bold hover:border-md-primary hover:text-md-primary"
        >
          {b.name}
        </a>
      ))}
    </div>

    <!-- Grouped Brand Tables -->
    <div class="space-y-6">
      {BRANDS.map(brand => (
        <section id={`brand-${brand.slug}`} class="m3-card-compact space-y-3 scroll-mt-20">
          <div class="flex items-center justify-between">
            <h2 class="text-base font-bold text-md-on-surface flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-md-primary"></span>
              {brand.name} Routers
            </h2>
            <a href={`${base}/${brand.slug}`} class="text-xs font-bold text-md-primary hover:underline">
              View {brand.name} Guide →
            </a>
          </div>
          <PasswordTable models={brand.models} brandName={brand.name} />
        </section>
      ))}
    </div>

    <AdBanner format="horizontal" />

    <!-- Human SEO Advisory Section -->
    <section class="m3-card-compact space-y-4">
      <h2 class="text-xl font-bold text-md-on-surface">What to Do If Default Router Passwords Don't Work</h2>
      <p class="text-xs text-md-on-surface-variant leading-relaxed">
        If you entered the standard <code class="font-mono text-xs bg-white px-1.5 py-0.5 rounded border border-md-outline-variant/40">admin / admin</code> or <code class="font-mono text-xs bg-white px-1.5 py-0.5 rounded border border-md-outline-variant/40">admin / password</code> and received an authentication error:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5 text-xs pt-1">
        <div class="p-3.5 rounded-m3-md bg-md-surface-container-low border border-md-outline-variant/30 space-y-1">
          <span class="text-lg">🏷️</span>
          <strong class="text-md-on-surface block font-bold text-xs">1. Check Physical Hardware Sticker</strong>
          <p class="text-[11px] text-md-on-surface-variant leading-relaxed">
            Many modern routers print a randomized, unique factory password on the bottom barcode label instead of generic "admin".
          </p>
        </div>

        <div class="p-3.5 rounded-m3-md bg-md-surface-container-low border border-md-outline-variant/30 space-y-1">
          <span class="text-lg">🔘</span>
          <strong class="text-md-on-surface block font-bold text-xs">2. 10-Second Hardware Reset</strong>
          <p class="text-[11px] text-md-on-surface-variant leading-relaxed">
            If the password was changed previously, hold the physical <em>RESET</em> pinhole for 10 seconds until all LED lights cycle.
          </p>
        </div>

        <div class="p-3.5 rounded-m3-md bg-md-surface-container-low border border-md-outline-variant/30 space-y-1">
          <span class="text-lg">🔒</span>
          <strong class="text-md-on-surface block font-bold text-xs">3. Set a New Custom Key</strong>
          <p class="text-[11px] text-md-on-surface-variant leading-relaxed">
            Once logged in, immediately change the admin login key. Leaving default credentials exposed allows anyone on your network to hijack settings.
          </p>
        </div>
      </div>
    </section>

    <!-- Interlinking 2-Column Grid -->
    <div>
      <RelatedLinksGrid />
    </div>

  </div>
</BaseLayout>
