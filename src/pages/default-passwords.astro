---
import BaseLayout from '../layouts/BaseLayout.astro';
import PasswordMasterTable from '../components/PasswordMasterTable.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';
import AdBanner from '../components/AdBanner.astro';
import { getFeaturedBrands } from '../lib/brand-index';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "Default Router Passwords List (All Brands & Models) | RouterSync.com";
const description = "Universal directory of default router passwords and usernames. Find factory login credentials for TP-Link, Netgear, ASUS, Cisco, D-Link, and Linksys modems.";
const keywords = [
  "default router passwords",
  "router password list",
  "factory router passwords",
  "default admin password",
  "router username password list",
  "router login credentials",
  "admin password tp link",
  "netgear default login"
];

const siteUrl = "https://atulscript.github.io/routerapp";

const schema = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Default Passwords",
        "item": `${siteUrl}/default-passwords`
      }
    ]
  },
  {
    "@type": "ItemList",
    "name": "Default Router Passwords & Credentials List",
    "description": "Master list of factory default usernames and passwords for wireless routers.",
    // The most-stocked brands only. Listing all 836 cost 139KB of JSON-LD; the
    // crawlable links in the table below are what get every page discovered.
    "itemListElement": getFeaturedBrands(60).map((brand, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": `${brand.name} Default Credentials (User: ${brand.defaultUser}, Pass: ${brand.defaultPass})`,
      "url": `${siteUrl}/${brand.slug}`
    }))
  },
  {
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the most common default router username and password?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The most common default router credentials are 'admin' / 'admin', 'admin' / 'password', or 'admin' with a blank password. Many newer routers also print a unique random factory password on the bottom sticker."
        }
      },
      {
        "@type": "Question",
        "name": "How can I log into my router if I forgot my custom password?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "If you changed your router password and forgot it, perform a 10-second factory reset by holding the physical RESET button/pinhole on the back of the device. This restores the original factory credentials listed on this page."
        }
      },
      {
        "@type": "Question",
        "name": "Where can I find the exact gateway IP address of my router?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Most routers use 192.168.1.1, 192.168.0.1, or 10.0.0.1. You can check your Default Gateway in Windows Command Prompt via 'ipconfig' or on macOS / Linux via network settings."
        }
      }
    ]
  }
];
---

<BaseLayout 
  title={title} 
  description={description} 
  keywords={keywords}
  schema={schema}
  ogType="website"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 text-xs text-[#5f6368] dark:text-[#9aa0a6] font-medium" aria-label="Breadcrumb">
      <a href={`${base}/`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
      <span>/</span>
      <span class="text-[#202124] dark:text-[#e8eaed] font-semibold truncate">Default Passwords</span>
    </nav>

    <header class="text-center max-w-xl mx-auto">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-50 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 text-[11px] font-bold uppercase mb-2 border border-amber-200/50 dark:border-amber-800/50 shadow-2xs">
        🔑 Master Password Database
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#202124] dark:text-white tracking-tight mb-2">
        Default Router Passwords List
      </h1>
      <p class="text-sm sm:text-base text-[#5f6368] dark:text-[#9aa0a6]">
        Search 2,300+ router models by name, gateway IP, username or password, then copy the credentials you need.
      </p>
    </header>

    <AdBanner format="leaderboard" />

    <PasswordMasterTable />

    <AdBanner format="horizontal" />

    <!-- Human SEO Advisory Section -->
    <section class="bg-white dark:bg-[#292a2d] rounded-2xl p-4 sm:p-6 border border-[#dadce0] dark:border-[#3c4043] shadow-card space-y-3.5 transition-colors">
      <h2 class="text-lg font-bold text-[#202124] dark:text-white">What to Do If Default Router Passwords Don't Work</h2>
      <p class="text-sm text-[#5f6368] dark:text-[#bdc1c6] leading-relaxed">
        If you entered the standard <code class="font-mono text-xs bg-[#f1f3f4] dark:bg-[#303134] text-[#202124] dark:text-[#e8eaed] px-1.5 py-0.5 rounded border border-[#dadce0] dark:border-[#5f6368]">admin / admin</code> or <code class="font-mono text-xs bg-[#f1f3f4] dark:bg-[#303134] text-[#202124] dark:text-[#e8eaed] px-1.5 py-0.5 rounded border border-[#dadce0] dark:border-[#5f6368]">admin / password</code> and received an authentication error:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs pt-1">
        <div class="p-3.5 rounded-xl bg-[#f8fafd] dark:bg-[#303134]/60 border border-[#e8eaed] dark:border-[#3c4043] space-y-1">
          <span class="text-base">🏷️</span>
          <strong class="text-[#202124] dark:text-white block font-semibold text-xs">1. Check Hardware Sticker</strong>
          <p class="text-xs sm:text-sm text-[#5f6368] dark:text-[#bdc1c6] leading-relaxed">
            Many modern routers print a randomized, unique factory password on the bottom barcode label instead of generic "admin".
          </p>
        </div>

        <div class="p-3.5 rounded-xl bg-[#f8fafd] dark:bg-[#303134]/60 border border-[#e8eaed] dark:border-[#3c4043] space-y-1">
          <span class="text-base">🔘</span>
          <strong class="text-[#202124] dark:text-white block font-semibold text-xs">2. 10-Second Hardware Reset</strong>
          <p class="text-xs sm:text-sm text-[#5f6368] dark:text-[#bdc1c6] leading-relaxed">
            If the password was changed previously, hold the physical <em>RESET</em> pinhole for 10 seconds until all LED lights cycle.
          </p>
        </div>

        <div class="p-3.5 rounded-xl bg-[#f8fafd] dark:bg-[#303134]/60 border border-[#e8eaed] dark:border-[#3c4043] space-y-1">
          <span class="text-base">🔒</span>
          <strong class="text-[#202124] dark:text-white block font-semibold text-xs">3. Set a New Custom Key</strong>
          <p class="text-xs sm:text-sm text-[#5f6368] dark:text-[#bdc1c6] leading-relaxed">
            Once logged in, immediately change the admin login key. Leaving default credentials exposed allows anyone on your network to hijack settings.
          </p>
        </div>
      </div>
    </section>

    <!-- Interlinking 2-Column Grid -->
    <div>
      <RelatedLinksGrid />
    </div>

    <!-- FAQ Accordion (Positioned Strictly Just Above Footer) -->
    <section class="bg-white dark:bg-[#292a2d] rounded-2xl p-5 sm:p-6 border border-[#dadce0] dark:border-[#3c4043] shadow-card space-y-4">
      <div class="flex items-center gap-2 border-b border-[#dadce0] dark:border-[#3c4043] pb-3">
        <span class="text-lg">❓</span>
        <div>
          <h2 class="text-base sm:text-lg font-bold text-[#202124] dark:text-white">
            Default Passwords Frequently Asked Questions
          </h2>
          <p class="text-sm text-[#5f6368] dark:text-[#9aa0a6]">
            Factory credentials, resetting forgotten passwords, and securing router settings
          </p>
        </div>
      </div>

      <div class="space-y-3">
        <details class="group border border-[#dadce0] dark:border-[#3c4043] rounded-xl p-4 open:bg-slate-50/60 dark:open:bg-[#292a2d]/60 hover:border-slate-300 dark:hover:border-slate-700 transition-colors">
          <summary class="font-bold text-[#202124] dark:text-white cursor-pointer list-none flex justify-between items-center text-xs sm:text-sm">
            <span class="flex items-center gap-2">
              <span class="text-[#1a73e8] dark:text-[#8ab4f8] font-black">Q.</span>
              What is the most common default router username and password?
            </span>
            <span class="text-[#5f6368] dark:text-[#9aa0a6] group-open:rotate-180 group-open:text-brand-600 dark:group-open:text-brand-400 transition-transform text-xs flex-shrink-0 ml-2">▼</span>
          </summary>
          <p class="text-sm text-[#5f6368] dark:text-[#bdc1c6] mt-2.5 leading-relaxed border-t border-[#e8eaed] dark:border-[#3c4043] pt-2.5">
            The most common default router credentials are 'admin' / 'admin', 'admin' / 'password', or 'admin' with a blank password. Many newer routers also print a unique random factory password on the bottom sticker.
          </p>
        </details>

        <details class="group border border-[#dadce0] dark:border-[#3c4043] rounded-xl p-4 open:bg-slate-50/60 dark:open:bg-[#292a2d]/60 hover:border-slate-300 dark:hover:border-slate-700 transition-colors">
          <summary class="font-bold text-[#202124] dark:text-white cursor-pointer list-none flex justify-between items-center text-xs sm:text-sm">
            <span class="flex items-center gap-2">
              <span class="text-[#1a73e8] dark:text-[#8ab4f8] font-black">Q.</span>
              How can I log into my router if I forgot my custom password?
            </span>
            <span class="text-[#5f6368] dark:text-[#9aa0a6] group-open:rotate-180 group-open:text-brand-600 dark:group-open:text-brand-400 transition-transform text-xs flex-shrink-0 ml-2">▼</span>
          </summary>
          <p class="text-sm text-[#5f6368] dark:text-[#bdc1c6] mt-2.5 leading-relaxed border-t border-[#e8eaed] dark:border-[#3c4043] pt-2.5">
            If you changed your router password and forgot it, perform a 10-second factory reset by holding the physical RESET button/pinhole on the back of the device. This restores the original factory credentials listed on this page.
          </p>
        </details>

        <details class="group border border-[#dadce0] dark:border-[#3c4043] rounded-xl p-4 open:bg-slate-50/60 dark:open:bg-[#292a2d]/60 hover:border-slate-300 dark:hover:border-slate-700 transition-colors">
          <summary class="font-bold text-[#202124] dark:text-white cursor-pointer list-none flex justify-between items-center text-xs sm:text-sm">
            <span class="flex items-center gap-2">
              <span class="text-[#1a73e8] dark:text-[#8ab4f8] font-black">Q.</span>
              Where can I find the exact gateway IP address of my router?
            </span>
            <span class="text-[#5f6368] dark:text-[#9aa0a6] group-open:rotate-180 group-open:text-brand-600 dark:group-open:text-brand-400 transition-transform text-xs flex-shrink-0 ml-2">▼</span>
          </summary>
          <p class="text-sm text-[#5f6368] dark:text-[#bdc1c6] mt-2.5 leading-relaxed border-t border-[#e8eaed] dark:border-[#3c4043] pt-2.5">
            Most routers use 192.168.1.1, 192.168.0.1, or 10.0.0.1. You can check your Default Gateway in Windows Command Prompt via 'ipconfig' or on macOS / Linux via network settings.
          </p>
        </details>
      </div>
    </section>

  </div>
</BaseLayout>
