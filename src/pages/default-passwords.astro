---
import BaseLayout from '../layouts/BaseLayout.astro';
import PasswordTable from '../components/PasswordTable.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';
import SearchBar from '../components/SearchBar.astro';
import AdBanner from '../components/AdBanner.astro';
import { BRANDS } from '../lib/data-loader';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "Default Router Passwords List (All Brands & Models) | 19216811.page";
const description = "Comprehensive database of default usernames, passwords, and IP addresses for TP-Link, Netgear, D-Link, ASUS, Cisco, and Linksys routers.";
---

<BaseLayout title={title} description={description}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6">
    
    <div>
      <SearchBar />
    </div>

    <header class="text-center max-w-xl mx-auto">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-50 text-amber-800 text-[11px] font-bold uppercase mb-2 border border-amber-200">
        🔑 Master Password Database
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-2">
        Default Router Passwords List
      </h1>
      <p class="text-xs sm:text-sm text-slate-600">
        Browse and copy default factory login credentials for all major WiFi router models.
      </p>
    </header>

    <AdBanner format="leaderboard" />

    <!-- Brand Quick-Jump Chips -->
    <div class="flex flex-wrap items-center justify-center gap-1.5 p-3 bg-white rounded-2xl border border-slate-200/90 shadow-2xs text-xs">
      <span class="text-slate-400 font-bold text-[11px] mr-1">Jump to:</span>
      {BRANDS.map(b => (
        <a 
          href={`#brand-${b.slug}`} 
          class="px-2.5 py-0.5 rounded-full bg-slate-50 hover:bg-slate-100 border border-slate-200 text-[11px] font-semibold text-slate-700 hover:text-slate-900 transition-colors"
        >
          {b.name}
        </a>
      ))}
    </div>

    <!-- Grouped Brand Tables -->
    <div class="space-y-4">
      {BRANDS.map(brand => (
        <section id={`brand-${brand.slug}`} class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200/90 shadow-card space-y-3 scroll-mt-20">
          <div class="flex items-center justify-between">
            <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-slate-900"></span>
              {brand.name} Routers
            </h2>
            <a href={`${base}/${brand.slug}`} class="text-xs font-semibold text-brand-600 hover:underline">
              View {brand.name} Guide →
            </a>
          </div>
          <PasswordTable models={brand.models} brandName={brand.name} />
        </section>
      ))}
    </div>

    <AdBanner format="horizontal" />

    <!-- Human SEO Advisory Section -->
    <section class="bg-white rounded-2xl p-4 sm:p-6 border border-slate-200/90 shadow-card space-y-3.5">
      <h2 class="text-lg font-bold text-slate-900">What to Do If Default Router Passwords Don't Work</h2>
      <p class="text-xs text-slate-600 leading-relaxed">
        If you entered the standard <code class="font-mono text-xs bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200">admin / admin</code> or <code class="font-mono text-xs bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200">admin / password</code> and received an authentication error:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs pt-1">
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
          <span class="text-base">🏷️</span>
          <strong class="text-slate-900 block font-semibold text-xs">1. Check Hardware Sticker</strong>
          <p class="text-[11px] text-slate-600 leading-relaxed">
            Many modern routers print a randomized, unique factory password on the bottom barcode label instead of generic "admin".
          </p>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
          <span class="text-base">🔘</span>
          <strong class="text-slate-900 block font-semibold text-xs">2. 10-Second Hardware Reset</strong>
          <p class="text-[11px] text-slate-600 leading-relaxed">
            If the password was changed previously, hold the physical <em>RESET</em> pinhole for 10 seconds until all LED lights cycle.
          </p>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
          <span class="text-base">🔒</span>
          <strong class="text-slate-900 block font-semibold text-xs">3. Set a New Custom Key</strong>
          <p class="text-[11px] text-slate-600 leading-relaxed">
            Once logged in, immediately change the admin login key. Leaving default credentials exposed allows anyone on your network to hijack settings.
          </p>
        </div>
      </div>
    </section>

    <!-- Interlinking 2-Column Grid -->
    <div>
      <RelatedLinksGrid />
    </div>

  </div>
</BaseLayout>
