---
import BaseLayout from '../layouts/BaseLayout.astro';
import PasswordTable from '../components/PasswordTable.astro';
import { BRANDS } from '../lib/data-loader';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "Default Router Passwords List (All Brands & Models) | RouterGuide";
const description = "Comprehensive database of default usernames, passwords, and IP addresses for TP-Link, Netgear, D-Link, ASUS, Cisco, and Linksys routers.";

const allModels = BRANDS.flatMap(b => 
  b.models.map(m => ({
    ...m,
    model: `${b.name} ${m.model}`
  }))
);
---

<BaseLayout title={title} description={description}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    
    <header class="mb-8 text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-50 text-amber-800 text-xs font-bold uppercase mb-4 border border-amber-200">
        🔑 Master Password Database
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
        Default Router Passwords List
      </h1>
      <p class="text-sm sm:text-base text-slate-600">
        Browse and copy default factory login credentials for all major WiFi router models.
      </p>
    </header>

    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-8">
      {BRANDS.map(brand => (
        <section class="space-y-3">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-brand-500"></span>
              {brand.name} Routers
            </h2>
            <a href={`${base}/${brand.slug}`} class="text-xs font-semibold text-brand-600 hover:text-brand-700">
              View {brand.name} Guide →
            </a>
          </div>
          <PasswordTable models={brand.models} brandName={brand.name} />
        </section>
      ))}
    </div>

  </div>
</BaseLayout>
