---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';
import AdBanner from '../components/AdBanner.astro';
import { OUI_DATABASE, parseAndLookupMac } from '../lib/mac-oui-database';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "MAC Address Vendor Lookup & OUI Device Identifier | RouterSync.com";
const description = "Instantly look up any MAC address or OUI prefix to identify device manufacturer, hardware category, and detect Apple or Android randomized private Wi-Fi addresses.";
const keywords = [
  "mac address lookup",
  "oui lookup",
  "mac vendor lookup",
  "find device by mac",
  "who is on my wifi",
  "mac address vendor database",
  "randomized mac address",
  "private wifi address",
  "mac prefix search"
];

const siteUrl = "https://atulscript.github.io/routerapp";

const popularVendors = [
  { name: 'Apple Inc.', oui: 'A4:83:E7', type: 'iPhone, Mac, iPad', icon: '🍎' },
  { name: 'Samsung Electronics', oui: '08:37:3D', type: 'Galaxy, Smart TV', icon: '📱' },
  { name: 'TP-Link Technologies', oui: '50:C7:BF', type: 'Routers, Mesh, Deco', icon: '📶' },
  { name: 'Raspberry Pi Foundation', oui: 'DC:A6:32', type: 'Single Board Computers', icon: '🍓' },
  { name: 'Espressif Inc.', oui: '24:0A:C4', type: 'Smart Plugs, Tuya, IoT', icon: '💡' },
  { name: 'Sony Interactive', oui: '70:9E:29', type: 'PlayStation 5, Bravia', icon: '🎮' },
  { name: 'Amazon Technologies', oui: 'AC:63:BE', type: 'Echo, Fire TV, Kindle', icon: '📦' },
  { name: 'NETGEAR', oui: '00:09:5B', type: 'Nighthawk, Orbi', icon: '🌐' }
];

const schema = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
      { "@type": "ListItem", "position": 2, "name": "Tools", "item": `${siteUrl}/tools` },
      { "@type": "ListItem", "position": 3, "name": "MAC Address Lookup", "item": `${siteUrl}/mac-lookup` }
    ]
  },
  {
    "@type": "WebApplication",
    "name": "MAC Address Vendor & OUI Lookup",
    "url": `${siteUrl}/mac-lookup`,
    "applicationCategory": "NetworkingApplication",
    "operatingSystem": "All",
    "description": description
  },
  {
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is a MAC address and an OUI?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A Media Access Control (MAC) address is a unique 48-bit physical hardware identifier assigned to a network interface controller (NIC). The first 24 bits (first 6 hexadecimal characters) represent the Organizationally Unique Identifier (OUI), which is officially registered with the IEEE to identify the device manufacturer."
        }
      },
      {
        "@type": "Question",
        "name": "Why does my router show 'Unknown' or random vendor for a device?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Modern mobile operating systems including iOS (Apple Private Wi-Fi Address) and Android (MAC Randomization) generate randomized, locally administered MAC addresses by default for privacy. In these addresses, the second hex digit is 2, 6, A, or E, indicating it was generated dynamically by the phone rather than assigned at the factory."
        }
      },
      {
        "@type": "Question",
        "name": "How do I find unknown devices connected to my Wi-Fi router?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Log in to your router gateway (typically 192.168.1.1 or 192.168.0.1), navigate to the 'DHCP Client List' or 'Attached Devices' section, copy any unfamiliar MAC addresses, and paste them into this tool to immediately discover the manufacturer."
        }
      }
    ]
  }
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  schema={schema}
  ogType="website"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-10 font-sans">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 text-xs text-[#5f6368] dark:text-[#9aa0a6] font-medium">
      <a href={`${base}/`} class="hover:text-blue-600 dark:hover:text-cyan-400 transition-colors">Home</a>
      <span>/</span>
      <a href={`${base}/tools`} class="hover:text-blue-600 dark:hover:text-cyan-400 transition-colors">Tools</a>
      <span>/</span>
      <span class="text-[#202124] dark:text-[#e8eaed] font-medium truncate">MAC Address Lookup</span>
    </nav>

    <!-- Header -->
    <header class="space-y-3 border-b border-[#e8eaed] dark:border-[#3c4043] pb-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-cyan-300 text-xs font-bold border border-blue-200 dark:border-blue-900/60 shadow-2xs">
        <span>🔍</span>
        IEEE OUI Hardware Directory
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-[#202124] dark:text-white tracking-tight">
        MAC Address Vendor Lookup
      </h1>
      <p class="text-sm sm:text-base text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed max-w-2xl">
        Identify the manufacturer of any device connected to your Wi-Fi network. Supports colons, hyphens, Cisco-style dots, or raw hexadecimal strings.
      </p>
    </header>

    <!-- Interactive Lookup Tool Card -->
    <div class="g-card p-6 sm:p-8 space-y-6 shadow-sm">
      
      <!-- Input Group -->
      <div class="space-y-2">
        <label for="mac-input" class="block text-xs sm:text-sm font-bold text-[#202124] dark:text-white uppercase tracking-wider">
          Enter MAC Address or 6-digit OUI Prefix:
        </label>
        <div class="relative flex items-center">
          <input
            type="text"
            id="mac-input"
            placeholder="e.g. FC:EC:DA:11:22:33, 00-1A-2B, or DCA632"
            autocomplete="off"
            spellcheck="false"
            class="w-full h-13 px-4 font-mono text-base sm:text-lg bg-[#f8fafd] dark:bg-[#1e293b] text-[#202124] dark:text-white border-2 border-[#dadce0] dark:border-[#475569] rounded-xl focus:border-blue-600 dark:focus:border-cyan-400 outline-none transition-all shadow-inner"
          />
          <button
            id="clear-btn"
            type="button"
            class="hidden absolute right-3 px-2.5 py-1 text-xs font-bold text-gray-400 hover:text-gray-700 dark:hover:text-white rounded-lg transition-colors"
          >
            Clear
          </button>
        </div>
        <p class="text-[11px] sm:text-xs text-[#5f6368] dark:text-[#9aa0a6]">
          Accepted formats: <code class="font-mono bg-gray-100 dark:bg-gray-800 px-1 py-0.5 rounded">XX:XX:XX:XX:XX:XX</code>, <code class="font-mono bg-gray-100 dark:bg-gray-800 px-1 py-0.5 rounded">XX-XX-XX-XX-XX-XX</code>, <code class="font-mono bg-gray-100 dark:bg-gray-800 px-1 py-0.5 rounded">XXXX.XXXX.XXXX</code>, or 6 hex characters.
        </p>
      </div>

      <!-- Quick Test Sample Chips -->
      <div class="space-y-2">
        <span class="text-xs font-bold text-[#5f6368] dark:text-[#9aa0a6] uppercase tracking-wider">
          Quick Test Popular Samples:
        </span>
        <div class="flex flex-wrap gap-2">
          {popularVendors.map(v => (
            <button
              type="button"
              data-sample-mac={v.oui}
              class="sample-btn px-2.5 py-1 rounded-lg text-xs font-medium bg-gray-100 dark:bg-gray-800 hover:bg-blue-50 dark:hover:bg-blue-950/60 text-gray-700 dark:text-gray-200 hover:text-blue-600 dark:hover:text-cyan-400 border border-transparent hover:border-blue-200 dark:hover:border-blue-800 transition-all flex items-center gap-1.5"
            >
              <span>{v.icon}</span>
              <span>{v.name}</span>
            </button>
          ))}
          <button
            type="button"
            data-sample-mac="E2:15:B2:34:56:78"
            class="sample-btn px-2.5 py-1 rounded-lg text-xs font-medium bg-purple-50 dark:bg-purple-950/40 text-purple-700 dark:text-purple-300 hover:bg-purple-100 dark:hover:bg-purple-900/60 border border-purple-200 dark:border-purple-800/60 transition-all flex items-center gap-1.5"
          >
            <span>🔒</span>
            <span>Randomized Private MAC (iOS / Android)</span>
          </button>
        </div>
      </div>

      <!-- Result Card Display -->
      <div id="result-box" class="hidden rounded-2xl border p-5 sm:p-6 space-y-4 transition-all">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-inherit pb-4">
          <div>
            <span id="result-badge" class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold mb-1"></span>
            <h2 id="result-vendor" class="text-xl sm:text-2xl font-bold text-[#202124] dark:text-white tracking-tight"></h2>
          </div>
          <div id="result-country-badge" class="hidden items-center gap-1.5 text-xs text-[#5f6368] dark:text-[#9aa0a6] bg-white dark:bg-gray-800 px-3 py-1 rounded-full border border-gray-200 dark:border-gray-700">
            <span>📍</span>
            <span id="result-country"></span>
          </div>
        </div>

        <!-- Technical Specification Details Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div class="p-3.5 rounded-xl bg-white dark:bg-[#1e293b]/70 border border-inherit space-y-1">
            <span class="text-gray-500 dark:text-gray-400 font-medium">IEEE 24-bit OUI Prefix</span>
            <div id="result-oui" class="font-mono text-sm font-bold text-[#202124] dark:text-white"></div>
          </div>
          <div class="p-3.5 rounded-xl bg-white dark:bg-[#1e293b]/70 border border-inherit space-y-1">
            <span class="text-gray-500 dark:text-gray-400 font-medium">Hardware Category</span>
            <div id="result-category" class="text-sm font-bold text-[#202124] dark:text-white"></div>
          </div>
          <div class="p-3.5 rounded-xl bg-white dark:bg-[#1e293b]/70 border border-inherit space-y-1">
            <span class="text-gray-500 dark:text-gray-400 font-medium">Administration Type</span>
            <div id="result-admin" class="text-sm font-bold text-[#202124] dark:text-white"></div>
          </div>
          <div class="p-3.5 rounded-xl bg-white dark:bg-[#1e293b]/70 border border-inherit space-y-1">
            <span class="text-gray-500 dark:text-gray-400 font-medium">Transmission Type</span>
            <div id="result-type" class="text-sm font-bold text-[#202124] dark:text-white"></div>
          </div>
        </div>

        <!-- Copyable Formats -->
        <div class="space-y-2 pt-2">
          <span class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">
            Standard Formatted Variants:
          </span>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 font-mono text-xs">
            <div class="flex items-center justify-between p-2.5 rounded-xl bg-white dark:bg-[#1e293b] border border-gray-200 dark:border-gray-700">
              <span id="format-colon" class="truncate"></span>
              <button type="button" class="copy-btn text-[11px] font-bold text-blue-600 dark:text-cyan-400 hover:underline" data-target="format-colon">Copy</button>
            </div>
            <div class="flex items-center justify-between p-2.5 rounded-xl bg-white dark:bg-[#1e293b] border border-gray-200 dark:border-gray-700">
              <span id="format-hyphen" class="truncate"></span>
              <button type="button" class="copy-btn text-[11px] font-bold text-blue-600 dark:text-cyan-400 hover:underline" data-target="format-hyphen">Copy</button>
            </div>
            <div class="flex items-center justify-between p-2.5 rounded-xl bg-white dark:bg-[#1e293b] border border-gray-200 dark:border-gray-700">
              <span id="format-dot" class="truncate"></span>
              <button type="button" class="copy-btn text-[11px] font-bold text-blue-600 dark:text-cyan-400 hover:underline" data-target="format-dot">Copy</button>
            </div>
          </div>
        </div>

        <!-- Explanatory note if randomized -->
        <div id="random-note" class="hidden p-3.5 rounded-xl bg-purple-50 dark:bg-purple-950/30 border border-purple-200 dark:border-purple-800 text-xs text-purple-900 dark:text-purple-200 space-y-1">
          <p class="font-bold flex items-center gap-1.5">
            <span>🛡️</span>
            <span>Why does this device have a Randomized MAC Address?</span>
          </p>
          <p class="leading-relaxed">
            Since iOS 14 and Android 10, mobile devices rotate a temporary, simulated MAC address for each Wi-Fi network to stop public hotspot trackers from tracking you. In your router's client list, this phone will appear with a randomized vendor. You can see the real factory hardware MAC in your phone's <strong>Settings &rarr; Wi-Fi &rarr; Network Details</strong>.
          </p>
        </div>

      </div>

    </div>

    <!-- Ad Space -->
    <AdBanner slot="between-sections" format="horizontal" />

    <!-- Educational Guide Content -->
    <div class="space-y-6 text-xs sm:text-sm text-[#3c4043] dark:text-[#e8eaed] leading-relaxed g-card p-6 sm:p-8">
      <section class="space-y-3">
        <h2 class="text-base sm:text-lg font-bold text-[#202124] dark:text-white">
          How to Find Unknown Devices Connected to Your Router
        </h2>
        <p>
          If you suspect a neighbor is using your Wi-Fi or you see unfamiliar entries in your router's wireless client table, looking up their MAC address is the fastest way to confirm their identity:
        </p>
        <ol class="list-decimal pl-5 space-y-2">
          <li>Open your web browser and navigate to your router's default gateway (usually <a href={`${base}/`} class="text-blue-600 dark:text-cyan-400 font-bold underline font-mono">192.168.1.1</a> or <a href={`${base}/192-168-0-1`} class="text-blue-600 dark:text-cyan-400 font-bold underline font-mono">192.168.0.1</a>).</li>
          <li>Log in using your admin credentials (or look up your router in our <a href={`${base}/default-passwords`} class="text-blue-600 dark:text-cyan-400 font-bold underline">Default Passwords Directory</a>).</li>
          <li>Find the page labeled <strong>DHCP Client Table</strong>, <strong>Attached Devices</strong>, or <strong>Wireless Station List</strong>.</li>
          <li>Copy the 12-character MAC address of the mystery device and paste it into the lookup box above.</li>
        </ol>
      </section>

      <section class="space-y-3 pt-4 border-t border-[#e8eaed] dark:border-[#3c4043]">
        <h2 class="text-base sm:text-lg font-bold text-[#202124] dark:text-white">
          Understanding the Anatomy of a MAC Address
        </h2>
        <div class="p-4 rounded-xl bg-gray-50 dark:bg-gray-800/60 font-mono text-center text-xs sm:text-sm border border-gray-200 dark:border-gray-700">
          <span class="text-blue-600 dark:text-cyan-400 font-bold">FC : EC : DA</span> : <span class="text-emerald-600 dark:text-emerald-400 font-bold">11 : 22 : 33</span>
          <div class="grid grid-cols-2 gap-4 mt-2 text-[11px] font-sans">
            <span class="text-blue-600 dark:text-cyan-400 font-medium">&uarr; OUI (Manufacturer ID)</span>
            <span class="text-emerald-600 dark:text-emerald-400 font-medium">&uarr; Device NIC Serial</span>
          </div>
        </div>
        <p>
          A standard MAC-48 address contains 6 octets (48 bits). The first 3 octets (24 bits) form the <strong>OUI (Organizationally Unique Identifier)</strong>, managed exclusively by the IEEE. The remaining 24 bits are assigned sequentially by the hardware manufacturer to each unique physical chip.
        </p>
      </section>
    </div>

    <!-- Related Network Tools -->
    <RelatedLinksGrid />

  </div>

  <!-- Client-Side Lookup Logic -->
  <script is:inline define:vars={{ OUI_DATABASE }}>
    const input = document.getElementById('mac-input');
    const clearBtn = document.getElementById('clear-btn');
    const resultBox = document.getElementById('result-box');
    const resultBadge = document.getElementById('result-badge');
    const resultVendor = document.getElementById('result-vendor');
    const resultOui = document.getElementById('result-oui');
    const resultCategory = document.getElementById('result-category');
    const resultAdmin = document.getElementById('result-admin');
    const resultType = document.getElementById('result-type');
    const resultCountry = document.getElementById('result-country');
    const resultCountryBadge = document.getElementById('result-country-badge');
    const randomNote = document.getElementById('random-note');
    const formatColon = document.getElementById('format-colon');
    const formatHyphen = document.getElementById('format-hyphen');
    const formatDot = document.getElementById('format-dot');

    function performLookup(val) {
      if (!val) {
        resultBox.classList.add('hidden');
        clearBtn.classList.add('hidden');
        return;
      }
      clearBtn.classList.remove('hidden');

      const cleanHex = val.replace(/[^0-9a-fA-F]/g, '').toUpperCase();
      if (cleanHex.length < 6) {
        resultBox.classList.add('hidden');
        return;
      }

      const oui = cleanHex.substring(0, 6);
      const secondChar = cleanHex[1];
      const isRandomized = ['2', '6', 'A', 'E'].includes(secondChar);
      const isMulticast = ['1', '3', '5', '7', '9', 'B', 'D', 'F'].includes(cleanHex[1]);

      const match = OUI_DATABASE[oui];

      // Formatting
      const targetLen = cleanHex.length >= 12 ? 12 : (cleanHex.length >= 6 ? 6 : cleanHex.length);
      const hexSub = cleanHex.substring(0, targetLen);
      const pairs = [];
      for (let i = 0; i < hexSub.length; i += 2) {
        pairs.push(hexSub.substr(i, 2));
      }

      formatColon.textContent = pairs.join(':');
      formatHyphen.textContent = pairs.join('-');
      formatDot.textContent = cleanHex.length >= 12 
        ? `${cleanHex.substr(0,4)}.${cleanHex.substr(4,4)}.${cleanHex.substr(8,4)}`
        : pairs.join(':');

      resultOui.textContent = `${oui.substr(0,2)}:${oui.substr(2,2)}:${oui.substr(4,2)}`;
      resultType.textContent = isMulticast ? 'Group / Multicast Frame' : 'Individual / Unicast';
      resultAdmin.textContent = isRandomized 
        ? 'Locally Administered (Private/Randomized)' 
        : 'Universally Administered (Factory IEEE Registered)';

      if (match) {
        resultVendor.textContent = match.vendor;
        resultCategory.textContent = match.category;
        resultBox.className = 'rounded-2xl border p-5 sm:p-6 space-y-4 transition-all bg-emerald-50/70 dark:bg-emerald-950/20 border-emerald-200 dark:border-emerald-800/50';
        resultBadge.className = 'inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold mb-1 bg-emerald-100 dark:bg-emerald-900/60 text-emerald-800 dark:text-emerald-200';
        resultBadge.textContent = '✓ Verified IEEE Manufacturer';
        randomNote.classList.add('hidden');
        if (match.country) {
          resultCountry.textContent = match.country;
          resultCountryBadge.classList.remove('hidden');
          resultCountryBadge.classList.add('inline-flex');
        } else {
          resultCountryBadge.classList.add('hidden');
        }
      } else if (isRandomized) {
        resultVendor.textContent = 'Private / Randomized MAC Address';
        resultCategory.textContent = 'Mobile Smartphone / Tablet (iOS or Android)';
        resultBox.className = 'rounded-2xl border p-5 sm:p-6 space-y-4 transition-all bg-purple-50/80 dark:bg-purple-950/20 border-purple-200 dark:border-purple-800/50';
        resultBadge.className = 'inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold mb-1 bg-purple-100 dark:bg-purple-900/60 text-purple-800 dark:text-purple-200';
        resultBadge.textContent = '🔒 Privacy Protected / Randomized';
        randomNote.classList.remove('hidden');
        resultCountryBadge.classList.add('hidden');
      } else {
        resultVendor.textContent = 'Unregistered / Unknown OUI Prefix';
        resultCategory.textContent = 'Unspecified Network Hardware';
        resultBox.className = 'rounded-2xl border p-5 sm:p-6 space-y-4 transition-all bg-amber-50/70 dark:bg-amber-950/20 border-amber-200 dark:border-amber-800/50';
        resultBadge.className = 'inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold mb-1 bg-amber-100 dark:bg-amber-900/60 text-amber-800 dark:text-amber-200';
        resultBadge.textContent = '⚠️ Unlisted Manufacturer Prefix';
        randomNote.classList.add('hidden');
        resultCountryBadge.classList.add('hidden');
      }

      resultBox.classList.remove('hidden');
    }

    input.addEventListener('input', (e) => performLookup(e.target.value));
    clearBtn.addEventListener('click', () => {
      input.value = '';
      performLookup('');
      input.focus();
    });

    document.querySelectorAll('.sample-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const sample = btn.getAttribute('data-sample-mac');
        input.value = sample;
        performLookup(sample);
      });
    });

    document.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        const text = document.getElementById(targetId)?.textContent;
        if (text) {
          navigator.clipboard.writeText(text);
          const original = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => { btn.textContent = original; }, 1500);
        }
      });
    });
  </script>
</BaseLayout>

