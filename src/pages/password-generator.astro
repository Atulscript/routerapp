---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdBanner from '../components/AdBanner.astro';
import SearchBar from '../components/SearchBar.astro';

import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "Strong Router & WiFi Password Generator | Secure WPA2/WPA3 Keys";
const description = "Generate cryptographically secure passwords for your WiFi network and router admin panels. Customize length, uppercase, lowercase, numbers, and symbols.";
---

<BaseLayout title={title} description={description}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    
    <div class="mb-8">
      <SearchBar />
    </div>

    <header class="text-center max-w-2xl mx-auto mb-8">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-50 text-sky-800 text-xs font-bold uppercase mb-3 border border-sky-200">
        🛡️ Security Utility Tool
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
        Router & WiFi Password Generator
      </h1>
      <p class="text-sm sm:text-base text-slate-600">
        Generate unhackable, high-entropy passwords to protect your router configuration dashboard and wireless network from brute-force attacks.
      </p>
    </header>

    <AdBanner format="leaderboard" />

    <!-- Generator Box -->
    <div class="max-w-2xl mx-auto bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-xl shadow-slate-100 my-8 space-y-6">
      
      <!-- Password Display -->
      <div class="relative flex items-center bg-slate-50 border-2 border-slate-200 rounded-2xl p-4 focus-within:border-sky-600 transition-colors">
        <input 
          type="text" 
          id="generated-password" 
          readonly 
          class="w-full bg-transparent font-mono text-xl sm:text-2xl font-bold text-slate-900 outline-none select-all" 
          value="aK8#mP9$xL2!vR5@"
        />
        <button 
          id="copy-pw-btn" 
          class="ml-2 px-4 py-2 bg-sky-600 hover:bg-sky-700 text-white rounded-xl text-xs font-bold whitespace-nowrap shadow-sm transition-all active:scale-95"
        >
          📋 Copy
        </button>
      </div>

      <!-- Controls -->
      <div class="space-y-4 pt-2">
        <div>
          <div class="flex justify-between items-center text-xs font-bold text-slate-700 mb-2">
            <span>Password Length:</span>
            <span id="length-label" class="font-mono text-sky-600 text-sm">16 characters</span>
          </div>
          <input 
            type="range" 
            id="length-slider" 
            min="8" 
            max="64" 
            value="16" 
            class="w-full accent-sky-600 cursor-pointer"
          />
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-2 gap-3 pt-2 text-xs font-medium text-slate-700">
          <label class="flex items-center gap-2.5 p-3 rounded-xl bg-slate-50 border border-slate-200 cursor-pointer hover:bg-slate-100/70">
            <input type="checkbox" id="include-uppercase" checked class="w-4 h-4 rounded text-sky-600" />
            <span>Uppercase (A-Z)</span>
          </label>
          <label class="flex items-center gap-2.5 p-3 rounded-xl bg-slate-50 border border-slate-200 cursor-pointer hover:bg-slate-100/70">
            <input type="checkbox" id="include-lowercase" checked class="w-4 h-4 rounded text-sky-600" />
            <span>Lowercase (a-z)</span>
          </label>
          <label class="flex items-center gap-2.5 p-3 rounded-xl bg-slate-50 border border-slate-200 cursor-pointer hover:bg-slate-100/70">
            <input type="checkbox" id="include-numbers" checked class="w-4 h-4 rounded text-sky-600" />
            <span>Numbers (0-9)</span>
          </label>
          <label class="flex items-center gap-2.5 p-3 rounded-xl bg-slate-50 border border-slate-200 cursor-pointer hover:bg-slate-100/70">
            <input type="checkbox" id="include-symbols" checked class="w-4 h-4 rounded text-sky-600" />
            <span>Special Symbols (!@#$)</span>
          </label>
        </div>

        <button 
          id="regenerate-btn" 
          class="w-full py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm shadow-md transition-all active:scale-[0.99] flex items-center justify-center gap-2"
        >
          <span>🔄 Generate New Password</span>
        </button>
      </div>

    </div>

    <AdBanner format="horizontal" />

    <!-- SEO Information Section -->
    <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm space-y-6 mt-10">
      <h2 class="text-2xl font-bold text-slate-900">Why You Must Change Default Router Passwords</h2>
      <p class="text-sm text-slate-600 leading-relaxed">
        Over 80% of unauthorized home network intrusions occur because users leave factory default credentials (like <code class="font-mono text-xs bg-slate-100 p-1 rounded">admin / admin</code> or <code class="font-mono text-xs bg-slate-100 p-1 rounded">admin / password</code>) unchanged. Hackers and automated botnets scan public IP ranges to compromise routers and use them in DDoS attacks.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs pt-2">
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
          <strong class="text-slate-900 block mb-1">🔑 Separate Admin & WiFi Passwords</strong>
          Always use a different password for your 192.168.1.1 router admin login than the WiFi network password given to family and guests.
        </div>
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
          <strong class="text-slate-900 block mb-1">🛡️ Enable WPA2-AES or WPA3</strong>
          Ensure your router uses WPA3-SAE or WPA2-AES encryption to prevent offline dictionary cracking.
        </div>
      </div>
    </section>

    <!-- Interlinking 2-Column Grid -->
    <div class="mt-12">
      <RelatedLinksGrid />
    </div>

  </div>
</BaseLayout>

<script>
  const uppercase = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
  const lowercase = "abcdefghijklmnopqrstuvwxyz";
  const numbers = "0123456789";
  const symbols = "!@#$%^&*()_+-=[]{}|;:,.<>?";

  function generatePassword() {
    const length = parseInt((document.getElementById('length-slider') as HTMLInputElement)?.value || '16');
    const useUpper = (document.getElementById('include-uppercase') as HTMLInputElement)?.checked;
    const useLower = (document.getElementById('include-lowercase') as HTMLInputElement)?.checked;
    const useNum = (document.getElementById('include-numbers') as HTMLInputElement)?.checked;
    const useSym = (document.getElementById('include-symbols') as HTMLInputElement)?.checked;

    let charPool = "";
    if (useUpper) charPool += uppercase;
    if (useLower) charPool += lowercase;
    if (useNum) charPool += numbers;
    if (useSym) charPool += symbols;

    if (!charPool) charPool = lowercase + numbers;

    let password = "";
    const randomValues = new Uint32Array(length);
    window.crypto.getRandomValues(randomValues);

    for (let i = 0; i < length; i++) {
      password += charPool[randomValues[i] % charPool.length];
    }

    const output = document.getElementById('generated-password') as HTMLInputElement;
    if (output) output.value = password;
  }

  const slider = document.getElementById('length-slider') as HTMLInputElement;
  const label = document.getElementById('length-label');
  slider?.addEventListener('input', () => {
    if (label) label.innerText = `${slider.value} characters`;
    generatePassword();
  });

  document.getElementById('regenerate-btn')?.addEventListener('click', generatePassword);
  document.getElementById('include-uppercase')?.addEventListener('change', generatePassword);
  document.getElementById('include-lowercase')?.addEventListener('change', generatePassword);
  document.getElementById('include-numbers')?.addEventListener('change', generatePassword);
  document.getElementById('include-symbols')?.addEventListener('change', generatePassword);

  document.getElementById('copy-pw-btn')?.addEventListener('click', () => {
    const output = document.getElementById('generated-password') as HTMLInputElement;
    if (output) {
      navigator.clipboard.writeText(output.value);
      alert('Password copied to clipboard!');
    }
  });

  generatePassword();
</script>
