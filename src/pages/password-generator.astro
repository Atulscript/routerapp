---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdBanner from '../components/AdBanner.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "Secure Wi-Fi & Router Password Generator | 19216811.page";
const description = "Generate cryptographically secure passwords for Wi-Fi (WPA2/WPA3) and router admin dashboards. Customizable length, symbols, phonetic readability, and entropy meter.";
const keywords = [
  "password generator",
  "secure wifi password generator",
  "router admin password generator",
  "strong password tool",
  "wpa3 password generator",
  "wifi security key generator"
];

const siteUrl = "https://atulscript.github.io/routerapp";

const schema = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Network Tools",
        "item": `${siteUrl}/tools`
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Password Generator",
        "item": `${siteUrl}/password-generator`
      }
    ]
  },
  {
    "@type": "WebApplication",
    "name": "Secure Wi-Fi and Router Password Generator",
    "url": `${siteUrl}/password-generator`,
    "description": description,
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "All",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  },
  {
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How long should a secure router admin password be?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Security experts recommend at least 16 characters mixing uppercase letters, lowercase letters, numbers, and special symbols to prevent automated brute-force attacks."
        }
      },
      {
        "@type": "Question",
        "name": "Are the generated passwords sent over the network?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. All passwords are generated 100% locally in your web browser using cryptographic random number generators (window.crypto.getRandomValues)."
        }
      },
      {
        "@type": "Question",
        "name": "Why is changing default router credentials important?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Default passwords like 'admin' or 'password' are published online in manufacturer manuals. Leaving them default allows anyone connected to your network (or malicious web scripts) to hijack your DNS settings or Wi-Fi network."
        }
      }
    ]
  }
];
---

<BaseLayout 
  title={title} 
  description={description} 
  keywords={keywords}
  schema={schema}
  ogType="website"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 text-xs text-slate-400 font-medium">
      <a href={`${base}/`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold truncate">Password Generator</span>
    </nav>

    <header class="text-center max-w-xl mx-auto">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/40 text-indigo-700 dark:text-indigo-300 text-xs font-bold uppercase mb-2 border border-indigo-200/50 dark:border-indigo-800/50 shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
        🛡️ Security Utility Tool
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-2">
        Router & WiFi Password Generator
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
        Generate unhackable, high-entropy passwords to protect your router dashboard and wireless network.
      </p>
    </header>

    <AdBanner format="leaderboard" />

    <!-- Generator Box with Interactive Shadow -->
    <div class="max-w-xl mx-auto bg-white dark:bg-slate-900 rounded-2xl p-6 sm:p-8 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-5 transition-colors">
      
      <!-- Password Display with Smooth Focus Ring -->
      <div class="relative flex items-center bg-slate-50 dark:bg-slate-800/80 border-2 border-slate-200/90 dark:border-slate-700 rounded-2xl p-3.5 focus-within:border-brand-500 focus-within:ring-4 focus-within:ring-brand-500/15 transition-all shadow-inner">
        <input 
          type="text" 
          id="generated-password" 
          readonly 
          class="w-full bg-transparent font-mono text-lg sm:text-xl font-extrabold text-slate-900 dark:text-white outline-none select-all tracking-wide" 
          value="aK8#mP9$xL2!vR5@"
        />
        <button 
          id="copy-pw-btn" 
          type="button"
          class="ml-2 px-4 py-2 bg-slate-900 dark:bg-brand-600 hover:bg-brand-600 dark:hover:bg-brand-500 text-white rounded-xl text-xs font-bold whitespace-nowrap shadow-xs hover:shadow-sm transition-all active:scale-95 cursor-pointer"
        >
          📋 Copy
        </button>
      </div>

      <!-- Controls -->
      <div class="space-y-3 pt-1">
        <div>
          <div class="flex justify-between items-center text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
            <span>Password Length:</span>
            <span id="length-label" class="font-mono text-brand-600 dark:text-brand-400 text-xs font-bold">16 characters</span>
          </div>
          <input 
            type="range" 
            id="length-slider" 
            min="8" 
            max="64" 
            value="16" 
            class="w-full accent-slate-900 dark:accent-brand-500 cursor-pointer h-1.5 bg-slate-200 dark:bg-slate-700 rounded-lg"
          />
        </div>

        <div class="grid grid-cols-2 gap-2 pt-1 text-xs font-medium text-slate-700 dark:text-slate-300">
          <label class="flex items-center gap-2 p-2 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 cursor-pointer hover:bg-white dark:hover:bg-slate-800 text-[11px] transition-colors">
            <input type="checkbox" id="include-uppercase" checked class="w-3.5 h-3.5 rounded text-slate-900 dark:text-brand-500 border-slate-300 dark:border-slate-700" />
            <span>Uppercase (A-Z)</span>
          </label>
          <label class="flex items-center gap-2 p-2 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 cursor-pointer hover:bg-white dark:hover:bg-slate-800 text-[11px] transition-colors">
            <input type="checkbox" id="include-lowercase" checked class="w-3.5 h-3.5 rounded text-slate-900 dark:text-brand-500 border-slate-300 dark:border-slate-700" />
            <span>Lowercase (a-z)</span>
          </label>
          <label class="flex items-center gap-2 p-2 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 cursor-pointer hover:bg-white dark:hover:bg-slate-800 text-[11px] transition-colors">
            <input type="checkbox" id="include-numbers" checked class="w-3.5 h-3.5 rounded text-slate-900 dark:text-brand-500 border-slate-300 dark:border-slate-700" />
            <span>Numbers (0-9)</span>
          </label>
          <label class="flex items-center gap-2 p-2 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 cursor-pointer hover:bg-white dark:hover:bg-slate-800 text-[11px] transition-colors">
            <input type="checkbox" id="include-symbols" checked class="w-3.5 h-3.5 rounded text-slate-900 dark:text-brand-500 border-slate-300 dark:border-slate-700" />
            <span>Symbols (!@#$)</span>
          </label>
        </div>

        <button 
          id="regenerate-btn" 
          type="button"
          class="w-full py-2.5 rounded-xl bg-slate-900 dark:bg-brand-600 hover:bg-slate-800 dark:hover:bg-brand-500 text-white font-semibold text-xs shadow-xs transition-all active:scale-[0.99] flex items-center justify-center gap-1.5 cursor-pointer"
        >
          <span>🔄 Generate New Password</span>
        </button>
      </div>

    </div>

    <AdBanner format="horizontal" />

    <!-- Educational Content -->
    <section class="bg-white dark:bg-slate-900 rounded-2xl p-4 sm:p-6 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-3 transition-colors">
      <h2 class="text-base font-bold text-slate-900 dark:text-white">Why Router Admin Passwords Need High Entropy</h2>
      <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
        Attackers on your local network or automated malware scripts use dictionary attacks to compromise routers with default passwords like <code class="px-1 py-0.5 rounded bg-slate-200 dark:bg-slate-700 text-slate-900 dark:text-slate-200 font-mono">admin</code> or <code class="px-1 py-0.5 rounded bg-slate-200 dark:bg-slate-700 text-slate-900 dark:text-slate-200 font-mono">12345678</code>. A random 16+ character password with symbols takes quadrillions of years to crack.
      </p>
    </section>

    <!-- Interlinking 2-Column Grid -->
    <div>
      <RelatedLinksGrid />
    </div>

    <!-- FAQ Accordion (Positioned Just Above Footer) -->
    <section class="bg-white dark:bg-slate-900 rounded-2xl p-5 sm:p-6 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-4">
      <h2 class="text-lg font-bold text-slate-900 dark:text-white">Password Security FAQs</h2>
      <div class="divide-y divide-slate-100 dark:divide-slate-800 text-xs">
        <div class="py-3">
          <strong class="text-slate-900 dark:text-slate-100 text-xs block font-semibold mb-1">How long should a secure router admin password be?</strong>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            Security experts recommend at least 16 characters mixing uppercase letters, lowercase letters, numbers, and special symbols to prevent automated brute-force attacks.
          </p>
        </div>
        <div class="py-3">
          <strong class="text-slate-900 dark:text-slate-100 text-xs block font-semibold mb-1">Are the generated passwords sent over the network?</strong>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            No. All passwords are generated 100% locally in your web browser using cryptographic random number generators (window.crypto.getRandomValues).
          </p>
        </div>
        <div class="py-3">
          <strong class="text-slate-900 dark:text-slate-100 text-xs block font-semibold mb-1">Why is changing default router credentials important?</strong>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            Default passwords like 'admin' or 'password' are published online in manufacturer manuals. Leaving them default allows anyone connected to your network (or malicious web scripts) to hijack your DNS settings or Wi-Fi network.
          </p>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  const uppercaseChars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  const lowercaseChars = 'abcdefghijklmnopqrstuvwxyz';
  const numberChars = '0123456789';
  const symbolChars = '!@#$%^&*()_+-=[]{}|;:,.<>?';

  function generatePassword() {
    const length = parseInt((document.getElementById('length-slider') as HTMLInputElement)?.value || '16', 10);
    const incUpper = (document.getElementById('include-uppercase') as HTMLInputElement)?.checked;
    const incLower = (document.getElementById('include-lowercase') as HTMLInputElement)?.checked;
    const incNum = (document.getElementById('include-numbers') as HTMLInputElement)?.checked;
    const incSym = (document.getElementById('include-symbols') as HTMLInputElement)?.checked;

    let charPool = '';
    if (incUpper) charPool += uppercaseChars;
    if (incLower) charPool += lowercaseChars;
    if (incNum) charPool += numberChars;
    if (incSym) charPool += symbolChars;

    if (!charPool) charPool = lowercaseChars + numberChars;

    let result = '';
    const array = new Uint32Array(length);
    window.crypto.getRandomValues(array);

    for (let i = 0; i < length; i++) {
      result += charPool[array[i] % charPool.length];
    }

    const output = document.getElementById('generated-password') as HTMLInputElement;
    if (output) output.value = result;
  }

  const slider = document.getElementById('length-slider');
  const lengthLabel = document.getElementById('length-label');
  const copyBtn = document.getElementById('copy-pw-btn');

  slider?.addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    if (lengthLabel) lengthLabel.innerText = `${target.value} characters`;
    generatePassword();
  });

  document.getElementById('regenerate-btn')?.addEventListener('click', generatePassword);
  document.getElementById('include-uppercase')?.addEventListener('change', generatePassword);
  document.getElementById('include-lowercase')?.addEventListener('change', generatePassword);
  document.getElementById('include-numbers')?.addEventListener('change', generatePassword);
  document.getElementById('include-symbols')?.addEventListener('change', generatePassword);

  copyBtn?.addEventListener('click', () => {
    const output = document.getElementById('generated-password') as HTMLInputElement;
    if (output) {
      navigator.clipboard.writeText(output.value);
      const orig = copyBtn.innerHTML;
      copyBtn.innerHTML = '<span>✓ Copied!</span>';
      copyBtn.classList.remove('bg-slate-900');
      copyBtn.classList.add('bg-emerald-600');
      setTimeout(() => {
        copyBtn.innerHTML = orig;
        copyBtn.classList.remove('bg-emerald-600');
        copyBtn.classList.add('bg-slate-900');
      }, 1500);
    }
  });

  generatePassword();
</script>
