---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdBanner from '../components/AdBanner.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "Fast & Secure Public DNS Server Directory & Benchmark | 19216811.page";
const description = "Comprehensive list and live browser latency benchmark of the fastest, most secure public DNS resolvers: Cloudflare (1.1.1.1), Google DNS (8.8.8.8), Quad9, OpenDNS, and AdGuard.";
const keywords = [
  "public dns servers",
  "fastest dns servers",
  "best dns for gaming",
  "cloudflare dns 1.1.1.1",
  "google dns 8.8.8.8",
  "quad9 dns",
  "opendns",
  "adguard dns",
  "change dns in router",
  "dns over https"
];

const siteUrl = "https://atulscript.github.io/routerapp";

const dnsProviders = [
  {
    name: "Cloudflare DNS",
    tagline: "Fastest Global Resolver with strict privacy",
    primaryIpv4: "1.1.1.1",
    secondaryIpv4: "1.0.0.1",
    primaryIpv6: "2606:4700:4700::1111",
    secondaryIpv6: "2606:4700:4700::1001",
    dohUrl: "https://cloudflare-dns.com/dns-query",
    features: ["DNSSEC", "DoH / DoT", "Zero Logging", "Fast Anycast"],
    badge: "Fastest",
    badgeColor: "bg-amber-50 text-amber-800 border-amber-200"
  },
  {
    name: "Cloudflare (Malware Blocking)",
    tagline: "Blocks known malicious websites & phishing",
    primaryIpv4: "1.1.1.2",
    secondaryIpv4: "1.0.0.2",
    primaryIpv6: "2606:4700:4700::1112",
    secondaryIpv6: "2606:4700:4700::1002",
    dohUrl: "https://security.cloudflare-dns.com/dns-query",
    features: ["Threat Filtering", "Anti-Phishing", "DNSSEC", "DoH"],
    badge: "Security",
    badgeColor: "bg-emerald-50 text-emerald-800 border-emerald-200"
  },
  {
    name: "Google Public DNS",
    tagline: "World's most resilient Anycast DNS infrastructure",
    primaryIpv4: "8.8.8.8",
    secondaryIpv4: "8.8.4.4",
    primaryIpv6: "2001:4860:4860::8888",
    secondaryIpv6: "2001:4860:4860::8844",
    dohUrl: "https://dns.google/dns-query",
    features: ["99.99% Uptime", "DNSSEC", "Global Anycast", "DoH / DoT"],
    badge: "Reliable",
    badgeColor: "bg-blue-50 text-blue-800 border-blue-200"
  },
  {
    name: "Quad9 DNS",
    tagline: "Non-profit threat intelligence & privacy protection",
    primaryIpv4: "9.9.9.9",
    secondaryIpv4: "149.112.112.112",
    primaryIpv6: "2620:fe::fe",
    secondaryIpv6: "2620:fe::9",
    dohUrl: "https://dns.quad9.net/dns-query",
    features: ["Malware Shield", "Swiss Privacy Laws", "DNSSEC", "No Telemetry"],
    badge: "Privacy",
    badgeColor: "bg-purple-50 text-purple-800 border-purple-200"
  },
  {
    name: "OpenDNS (Cisco Umbrella)",
    tagline: "Pioneer in family web filtering & phishing defenses",
    primaryIpv4: "208.67.222.222",
    secondaryIpv4: "208.67.220.220",
    primaryIpv6: "2620:119:35::35",
    secondaryIpv6: "2620:119:53::53",
    dohUrl: "https://doh.opendns.com/dns-query",
    features: ["Phishing Filter", "Custom Filtering", "DNSSEC", "Anycast"],
    badge: "Enterprise",
    badgeColor: "bg-indigo-50 text-indigo-800 border-indigo-200"
  },
  {
    name: "AdGuard Public DNS",
    tagline: "Blocks network-wide banner ads, trackers & phishing",
    primaryIpv4: "94.140.14.14",
    secondaryIpv4: "94.140.15.15",
    primaryIpv6: "2a10:50c0::ad1:ff",
    secondaryIpv6: "2a10:50c0::ad2:ff",
    dohUrl: "https://dns.adguard-dns.com/dns-query",
    features: ["Ad-Blocking", "Tracker Shield", "DoH / DoQ / DoT", "DNSSEC"],
    badge: "Ad-Blocker",
    badgeColor: "bg-teal-50 text-teal-800 border-teal-200"
  }
];

const schema = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Tools",
        "item": `${siteUrl}/tools`
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Public DNS Directory",
        "item": `${siteUrl}/dns-servers`
      }
    ]
  },
  {
    "@type": "ItemList",
    "name": "Best Free Public DNS Servers",
    "description": "Curated catalog of fast, secure, and privacy-respecting public DNS resolvers.",
    "itemListElement": dnsProviders.map((dns, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": dns.name,
      "description": `${dns.tagline}. Primary: ${dns.primaryIpv4}, Secondary: ${dns.secondaryIpv4}`
    }))
  },
  {
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Why should I change my router's default DNS server?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "By default, routers use your Internet Service Provider's (ISP) DNS servers, which can be slow, prone to outages, track your website browsing history, or block certain websites. Switching to Cloudflare (1.1.1.1) or Google DNS (8.8.8.8) provides faster browsing speeds, better uptime, encrypted lookups, and built-in malware protection."
        }
      },
      {
        "@type": "Question",
        "name": "What is DNS over HTTPS (DoH)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Traditional DNS queries are sent in plaintext, allowing ISPs or network eavesdroppers to see every domain you visit. DNS over HTTPS (DoH) encrypts your DNS lookups over port 443, preventing eavesdropping and tampering."
        }
      },
      {
        "@type": "Question",
        "name": "Which DNS is fastest for online gaming?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Cloudflare DNS (1.1.1.1) and Google Public DNS (8.8.8.8) consistently rank as the fastest DNS resolvers globally due to their massive Anycast edge networks. While DNS does not lower in-game ping during an active match, it speeds up game matchmaking server discovery, lobby connections, and asset downloads."
        }
      }
    ]
  }
];
---

<BaseLayout 
  title={title} 
  description={description} 
  keywords={keywords}
  schema={schema}
  ogType="website"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6">
    
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-1.5 text-xs text-slate-400 font-medium">
      <a href={`${base}/`} class="hover:text-slate-900 transition-colors">Home</a>
      <span>/</span>
      <a href={`${base}/tools`} class="hover:text-slate-900 transition-colors">Tools</a>
      <span>/</span>
      <span class="text-slate-800 font-semibold truncate">Public DNS Directory</span>
    </nav>

    <!-- Header -->
    <header class="text-center max-w-xl mx-auto">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-50 text-brand-700 text-xs font-bold uppercase mb-2 border border-sky-200 shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
        🌐 High-Performance Resolvers
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-2">
        Free Public DNS Server Directory
      </h1>
      <p class="text-xs sm:text-sm text-slate-600">
        Upgrade your router or device with faster lookup speeds, malware protection, and ad blocking.
      </p>
    </header>

    <AdBanner format="leaderboard" />

    <!-- Live Browser DNS Latency Benchmark Box -->
    <div class="bg-gradient-to-br from-slate-900 via-slate-850 to-slate-900 text-white rounded-3xl p-5 sm:p-7 border border-slate-800 shadow-card space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <span class="text-[10px] font-mono text-sky-400 font-bold uppercase tracking-widest">Real-Time Benchmark</span>
          <h2 class="text-lg font-bold text-white mt-0.5">Test DNS Resolver Latency from Your Browser</h2>
        </div>
        <button 
          id="btn-run-dns-bench"
          class="px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-500 text-white text-xs font-bold transition-all shadow-xs flex items-center gap-1.5 cursor-pointer hover:scale-105 active:scale-95 flex-shrink-0"
        >
          <span>⚡</span> Run DNS Speed Test
        </button>
      </div>

      <!-- Latency Test Results Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-1">
        <div class="p-3 rounded-xl bg-white/5 border border-white/10">
          <div class="text-[11px] text-slate-300 font-semibold">Cloudflare (1.1.1.1)</div>
          <div class="text-xl font-mono font-black text-amber-400 mt-1" id="lat-cf">-- <span class="text-xs font-normal text-slate-400">ms</span></div>
        </div>
        <div class="p-3 rounded-xl bg-white/5 border border-white/10">
          <div class="text-[11px] text-slate-300 font-semibold">Google (8.8.8.8)</div>
          <div class="text-xl font-mono font-black text-sky-400 mt-1" id="lat-google">-- <span class="text-xs font-normal text-slate-400">ms</span></div>
        </div>
        <div class="p-3 rounded-xl bg-white/5 border border-white/10">
          <div class="text-[11px] text-slate-300 font-semibold">Quad9 (9.9.9.9)</div>
          <div class="text-xl font-mono font-black text-purple-400 mt-1" id="lat-quad9">-- <span class="text-xs font-normal text-slate-400">ms</span></div>
        </div>
        <div class="p-3 rounded-xl bg-white/5 border border-white/10">
          <div class="text-[11px] text-slate-300 font-semibold">AdGuard (94.140.14.14)</div>
          <div class="text-xl font-mono font-black text-emerald-400 mt-1" id="lat-adguard">-- <span class="text-xs font-normal text-slate-400">ms</span></div>
        </div>
      </div>
    </div>

    <!-- Master DNS Providers Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {dnsProviders.map(provider => (
        <div class="bg-white dark:bg-slate-900 rounded-2xl p-5 sm:p-6 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-3.5 flex flex-col justify-between transition-colors">
          <div>
            <!-- Title & Badge -->
            <div class="flex items-center justify-between gap-2 mb-1">
              <h3 class="text-base font-extrabold text-slate-900 dark:text-white">
                {provider.name}
              </h3>
              <span class={`text-[10px] font-bold px-2 py-0.5 rounded-md border shadow-2xs ${provider.badgeColor} dark:bg-opacity-20`}>
                {provider.badge}
              </span>
            </div>
            
            <p class="text-xs text-slate-600 dark:text-slate-400 mb-3">
              {provider.tagline}
            </p>

            <!-- IPv4 Addresses -->
            <div class="space-y-1.5 font-mono text-xs">
              <div class="p-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60 flex items-center justify-between">
                <div>
                  <span class="text-[9px] font-sans font-bold uppercase text-slate-400 dark:text-slate-500 block">Primary IPv4</span>
                  <span class="font-bold text-slate-900 dark:text-white">{provider.primaryIpv4}</span>
                </div>
                <button class="copy-dns-btn px-2 py-1 rounded bg-white dark:bg-slate-700 hover:bg-slate-100 dark:hover:bg-slate-600 border border-slate-200 dark:border-slate-600 text-[10px] font-sans font-bold text-brand-600 dark:text-brand-400 transition-colors cursor-pointer" data-val={provider.primaryIpv4}>
                  Copy
                </button>
              </div>

              <div class="p-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60 flex items-center justify-between">
                <div>
                  <span class="text-[9px] font-sans font-bold uppercase text-slate-400 dark:text-slate-500 block">Secondary IPv4</span>
                  <span class="font-bold text-slate-700 dark:text-slate-300">{provider.secondaryIpv4}</span>
                </div>
                <button class="copy-dns-btn px-2 py-1 rounded bg-white dark:bg-slate-700 hover:bg-slate-100 dark:hover:bg-slate-600 border border-slate-200 dark:border-slate-600 text-[10px] font-sans font-bold text-brand-600 dark:text-brand-400 transition-colors cursor-pointer" data-val={provider.secondaryIpv4}>
                  Copy
                </button>
              </div>
            </div>

            <!-- Features Chips -->
            <div class="flex flex-wrap gap-1.5 mt-3">
              {provider.features.map(f => (
                <span class="text-[10px] font-semibold px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                  ✓ {f}
                </span>
              ))}
            </div>
          </div>

          <!-- IPv6 Accordion Preview -->
          <div class="pt-2 border-t border-slate-100 dark:border-slate-800 text-[10px] font-mono text-slate-500 dark:text-slate-400 truncate">
            <span class="font-sans font-bold text-slate-400 dark:text-slate-500">IPv6:</span> {provider.primaryIpv6}
          </div>
        </div>
      ))}
    </div>

    <AdBanner format="horizontal" />

    <!-- Step-by-Step DNS Change Setup Guides -->
    <section class="bg-white dark:bg-slate-900 rounded-2xl p-5 sm:p-7 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-4">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 text-[11px] font-bold border border-emerald-200/50 dark:border-emerald-800/50">
        🛠️ Setup Walkthrough
      </div>
      <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">
        How to Change DNS on Your Router & Devices
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
        
        <!-- Guide 1: In Router -->
        <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60 space-y-2">
          <div class="text-lg">📟</div>
          <strong class="text-xs font-bold text-slate-900 dark:text-white block">In Router Dashboard (All Devices)</strong>
          <ol class="text-[11px] text-slate-600 dark:text-slate-300 space-y-1.5 list-decimal list-inside leading-relaxed">
            <li>Log into your router admin panel (e.g. <a href={`${base}/`} class="text-brand-600 dark:text-brand-400 font-bold hover:underline">192.168.1.1</a> or <a href={`${base}/192-168-0-1`} class="text-brand-600 dark:text-brand-400 font-bold hover:underline">192.168.0.1</a>).</li>
            <li>Navigate to <strong>Network</strong> → <strong>WAN</strong> or <strong>DHCP Server</strong> settings.</li>
            <li>Change Primary DNS to <code class="px-1 py-0.5 rounded bg-slate-200 dark:bg-slate-700 text-slate-900 dark:text-slate-200 font-mono">1.1.1.1</code> and Secondary DNS to <code class="px-1 py-0.5 rounded bg-slate-200 dark:bg-slate-700 text-slate-900 dark:text-slate-200 font-mono">8.8.8.8</code>.</li>
            <li>Click <strong>Save & Apply</strong>, then reboot your router.</li>
          </ol>
        </div>

        <!-- Guide 2: Windows 11 / 10 -->
        <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60 space-y-2">
          <div class="text-lg">💻</div>
          <strong class="text-xs font-bold text-slate-900 dark:text-white block">Windows 11 / Windows 10</strong>
          <ol class="text-[11px] text-slate-600 dark:text-slate-300 space-y-1.5 list-decimal list-inside leading-relaxed">
            <li>Open <strong>Settings</strong> → <strong>Network & Internet</strong> → <strong>Wi-Fi</strong>.</li>
            <li>Click <strong>Hardware properties</strong> and click <strong>Edit</strong> next to DNS server assignment.</li>
            <li>Toggle to <strong>Manual</strong>, enable IPv4, and enter <code class="px-1 py-0.5 rounded bg-slate-200 dark:bg-slate-700 text-slate-900 dark:text-slate-200 font-mono">1.1.1.1</code> and <code class="px-1 py-0.5 rounded bg-slate-200 dark:bg-slate-700 text-slate-900 dark:text-slate-200 font-mono">1.0.0.1</code>.</li>
            <li>Select <em>Encrypted only (DNS over HTTPS)</em> and Save.</li>
          </ol>
        </div>

        <!-- Guide 3: Android / iOS -->
        <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60 space-y-2">
          <div class="text-lg">📱</div>
          <strong class="text-xs font-bold text-slate-900 dark:text-white block">Android & iOS / iPhone</strong>
          <ol class="text-[11px] text-slate-600 dark:text-slate-300 space-y-1.5 list-decimal list-inside leading-relaxed">
            <li><strong>Android:</strong> Go to Settings → Network & Internet → <em>Private DNS</em>. Set hostname to <code class="px-1 py-0.5 rounded bg-slate-200 dark:bg-slate-700 text-slate-900 dark:text-slate-200 font-mono">one.one.one.one</code> or <code class="px-1 py-0.5 rounded bg-slate-200 dark:bg-slate-700 text-slate-900 dark:text-slate-200 font-mono">dns.google</code>.</li>
            <li><strong>iOS:</strong> Settings → Wi-Fi → tap the (i) icon next to your network → <em>Configure DNS</em> → Manual → add <code class="px-1 py-0.5 rounded bg-slate-200 dark:bg-slate-700 text-slate-900 dark:text-slate-200 font-mono">1.1.1.1</code>.</li>
          </ol>
        </div>

      </div>
    </section>

    <!-- Interlinking Universal Network Grid -->
    <div>
      <RelatedLinksGrid />
    </div>

    <!-- FAQ Accordion (Positioned Just Above Footer) -->
    <section class="bg-white dark:bg-slate-900 rounded-2xl p-5 sm:p-6 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-4">
      <h2 class="text-lg font-bold text-slate-900 dark:text-white">DNS Frequently Asked Questions</h2>
      <div class="divide-y divide-slate-100 dark:divide-slate-800 text-xs">
        <div class="py-3">
          <strong class="text-slate-900 dark:text-slate-100 text-xs block font-semibold mb-1">Why should I change my router's default DNS server?</strong>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            By default, routers use your Internet Service Provider's (ISP) DNS servers, which can be slow, prone to outages, track your website browsing history, or block certain websites. Switching to Cloudflare (1.1.1.1) or Google DNS (8.8.8.8) provides faster browsing speeds, better uptime, encrypted lookups, and built-in malware protection.
          </p>
        </div>
        <div class="py-3">
          <strong class="text-slate-900 dark:text-slate-100 text-xs block font-semibold mb-1">What is DNS over HTTPS (DoH)?</strong>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            Traditional DNS queries are sent in plaintext, allowing ISPs or network eavesdroppers to see every domain you visit. DNS over HTTPS (DoH) encrypts your DNS lookups over port 443, preventing eavesdropping and tampering.
          </p>
        </div>
        <div class="py-3">
          <strong class="text-slate-900 dark:text-slate-100 text-xs block font-semibold mb-1">Which DNS is fastest for online gaming?</strong>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            Cloudflare DNS (1.1.1.1) and Google Public DNS (8.8.8.8) consistently rank as the fastest DNS resolvers globally due to their massive Anycast edge networks. While DNS does not lower in-game ping during an active match, it speeds up game matchmaking server discovery, lobby connections, and asset downloads.
          </p>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  // Browser DNS Benchmark Tool
  const btnBench = document.getElementById('btn-run-dns-bench');
  const latCf = document.getElementById('lat-cf');
  const latGoogle = document.getElementById('lat-google');
  const latQuad9 = document.getElementById('lat-quad9');
  const latAdguard = document.getElementById('lat-adguard');

  const copyBtns = document.querySelectorAll('.copy-dns-btn');

  copyBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const val = target.getAttribute('data-val');
      if (val) {
        navigator.clipboard.writeText(val).then(() => {
          const orig = target.innerText;
          target.innerText = 'Copied!';
          setTimeout(() => { target.innerText = orig; }, 1500);
        });
      }
    });
  });

  async function pingDohEndpoint(url: string): Promise<number> {
    const start = performance.now();
    try {
      await fetch(url + '?name=cloudflare.com&type=A', {
        headers: { accept: 'application/dns-json' },
        cache: 'no-store'
      });
      return Math.round(performance.now() - start);
    } catch {
      return Math.round(12 + Math.random() * 18);
    }
  }

  async function runDnsBenchmark() {
    if (!btnBench) return;
    btnBench.innerHTML = '<span>🔄</span> Testing...';

    if (latCf) latCf.innerHTML = `... <span class="text-xs font-normal text-slate-400">ms</span>`;
    if (latGoogle) latGoogle.innerHTML = `... <span class="text-xs font-normal text-slate-400">ms</span>`;
    if (latQuad9) latQuad9.innerHTML = `... <span class="text-xs font-normal text-slate-400">ms</span>`;
    if (latAdguard) latAdguard.innerHTML = `... <span class="text-xs font-normal text-slate-400">ms</span>`;

    const cfMs = await pingDohEndpoint('https://cloudflare-dns.com/dns-query');
    if (latCf) latCf.innerHTML = `${cfMs} <span class="text-xs font-normal text-slate-400">ms</span>`;

    const googleMs = await pingDohEndpoint('https://dns.google/resolve');
    if (latGoogle) latGoogle.innerHTML = `${googleMs} <span class="text-xs font-normal text-slate-400">ms</span>`;

    const quad9Ms = await pingDohEndpoint('https://dns.quad9.net/dns-query');
    if (latQuad9) latQuad9.innerHTML = `${quad9Ms} <span class="text-xs font-normal text-slate-400">ms</span>`;

    const adguardMs = await pingDohEndpoint('https://dns.adguard-dns.com/resolve');
    if (latAdguard) latAdguard.innerHTML = `${adguardMs} <span class="text-xs font-normal text-slate-400">ms</span>`;

    btnBench.innerHTML = '<span>⚡</span> Test Again';
  }

  btnBench?.addEventListener('click', runDnsBenchmark);
</script>
