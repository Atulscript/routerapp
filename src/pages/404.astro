---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "404 - Page Not Found | 19216811.page";
const description = "The requested router guide, gateway IP, or password document could not be found. Return to 19216811.page homepage.";
---

<BaseLayout title={title} description={description} noindex={true}>
  <div class="max-w-lg mx-auto px-4 py-24 text-center">
    <div class="text-6xl font-extrabold text-brand-600 mb-4 font-mono">404</div>
    <h1 class="text-2xl font-bold text-slate-900 mb-3">Page Not Found</h1>
    <p class="text-sm text-slate-600 mb-8">
      The router login page, brand guide, or gateway IP you were looking for does not exist or has moved.
    </p>
    <a 
      href={`${base}/`} 
      class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-slate-900 hover:bg-brand-600 text-white text-xs font-bold shadow-xs hover:shadow-md transition-all active:scale-95"
    >
      ← Return to Homepage
    </a>
  </div>
</BaseLayout>

