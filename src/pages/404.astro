---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | RouterGuide" description="The requested router guide or page could not be found.">
  <div class="max-w-lg mx-auto px-4 py-24 text-center">
    <div class="text-6xl font-extrabold text-brand-600 mb-4 font-mono">404</div>
    <h1 class="text-2xl font-bold text-slate-900 mb-3">Page Not Found</h1>
    <p class="text-sm text-slate-600 mb-8">
      The router login page, brand guide, or IP address you were looking for doesn't exist or has moved.
    </p>
    <a 
      href="/" 
      class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-bold shadow-md transition-all"
    >
      ← Return to Homepage
    </a>
  </div>
</BaseLayout>
