---
import BaseLayout from '../layouts/BaseLayout.astro';
import IspCard from '../components/IspCard.astro';
import CardFilterBar from '../components/CardFilterBar.astro';
import { getIndexLetter } from '../lib/brand-index';
import AdBanner from '../components/AdBanner.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';
import { ISPS } from '../lib/data-loader';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Only letters that actually have a provider behind them get a chip.
const letterChips = [...new Set(ISPS.map(isp => getIndexLetter(isp.name)))]
  .sort((a, b) => (a === '0-9' ? -1 : b === '0-9' ? 1 : a.localeCompare(b)))
  .map(letter => ({ value: letter, label: letter }));
const title = "Broadband ISP Router Login Directory | RouterSync.com";
const description = `Router and ONT login guides for ${ISPS.length} broadband providers, including JioFiber, Airtel, BSNL, AT&T, Xfinity and Verizon Fios. Default gateway IPs and admin usernames.`;
const keywords = [
  "isp router login",
  "fiber ont login",
  "jiofiber router login",
  "airtel xstream router login",
  "xfinity gateway login",
  "verizon fios router login",
  "broadband router default password"
];

const siteUrl = "https://atulscript.github.io/routerapp";

const schema = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
      { "@type": "ListItem", "position": 2, "name": "Broadband ISPs", "item": `${siteUrl}/isps` }
    ]
  },
  {
    "@type": "ItemList",
    "name": "Broadband ISP Router Login Guides",
    "itemListElement": ISPS.map((isp, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": `${isp.name} Router Login`,
      "url": `${siteUrl}/${isp.slug}`
    }))
  }
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  schema={schema}
  ogType="website"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6">

    <nav class="flex items-center gap-1.5 text-xs text-[#5f6368] dark:text-[#9aa0a6] font-medium" aria-label="Breadcrumb">
      <a href={`${base}/`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
      <span>/</span>
      <span class="text-[#202124] dark:text-[#e8eaed] font-semibold truncate">Broadband ISPs</span>
    </nav>

    <header class="text-center max-w-xl mx-auto">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#f1f3f4] dark:bg-[#303134] text-[#3c4043] dark:text-[#bdc1c6] text-[11px] font-bold uppercase mb-2 border border-[#dadce0] dark:border-[#5f6368]">
        🌐 ISP Index
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#202124] dark:text-white tracking-tight mb-2">
        Broadband ISP Router Logins
      </h1>
      <p class="text-sm sm:text-base text-[#5f6368] dark:text-[#9aa0a6]">
        Login steps, gateway IPs and default usernames for the routers and fiber ONTs supplied by {ISPS.length} internet providers.
      </p>
    </header>

    <AdBanner format="leaderboard" />

    <h2 class="sr-only">All internet providers</h2>
    <section id="isp-index">
      <CardFilterBar
        chips={letterChips}
        placeholder="Filter providers by name, IP or password…"
        label="Filter internet providers by name, gateway IP or credentials"
        chipsLabel="Filter providers by first letter"
        total={ISPS.length}
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 pt-4">
        {ISPS.map(isp => (
          <div class="cf-item" data-k={getIndexLetter(isp.name)}>
            <IspCard data={isp} />
          </div>
        ))}
      </div>

      <p class="cf-empty text-center text-sm text-[#5f6368] dark:text-[#9aa0a6] py-10" hidden>
        No providers match that search.
        <button type="button" class="cf-resetter text-[#1a73e8] dark:text-[#8ab4f8] font-semibold hover:underline cursor-pointer">Reset the filters</button>
      </p>
    </section>

    <script>
      import { initCardFilter } from '../scripts/card-filter';
      initCardFilter('isp-index');
    </script>

    <AdBanner format="horizontal" />

    <div>
      <RelatedLinksGrid />
    </div>
  </div>
</BaseLayout>
