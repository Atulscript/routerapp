---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import IpCard from '../components/IpCard.astro';
import AdBanner from '../components/AdBanner.astro';
import { GATEWAY_IPS } from '../lib/data-loader';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "Default Router IP Addresses List (192.168.1.1, 192.168.0.1, 10.0.0.1)";
const description = "Comprehensive directory of private default gateway IP addresses used by WiFi routers and modems. Step-by-step admin login access and IP subnet classes.";
---

<BaseLayout title={title} description={description}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    
    <!-- Search Bar -->
    <div class="mb-8">
      <SearchBar />
    </div>

    <!-- Header -->
    <header class="text-center max-w-2xl mx-auto mb-8">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-50 text-sky-800 text-xs font-bold uppercase mb-3 border border-sky-200">
        🌐 Gateway IP Directory
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-3">
        Router IP Addresses
      </h1>
      <p class="text-sm sm:text-base text-slate-600">
        Browse common private IP addresses designated for local wireless router configuration panels and default logins.
      </p>
    </header>

    <AdBanner format="leaderboard" />

    <!-- IP Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 my-8">
      {GATEWAY_IPS.map(item => (
        <IpCard data={item} />
      ))}
    </div>

    <AdBanner format="horizontal" />

    <!-- Technical SEO Explanation Table -->
    <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm space-y-6 mt-10">
      <h2 class="text-2xl font-bold text-slate-900">Private IP Address Ranges Explained (RFC 1918)</h2>
      <p class="text-sm text-slate-600 leading-relaxed">
        The Internet Engineering Task Force (IETF) reserved specific ranges of IPv4 addresses strictly for private local area networks (LAN). These addresses cannot be routed across the public internet:
      </p>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-700 border border-slate-200 rounded-xl overflow-hidden">
          <thead class="bg-slate-50 font-bold text-xs uppercase text-slate-500 border-b border-slate-200">
            <tr>
              <th class="p-3.5">Class</th>
              <th class="p-3.5">IP Address Range</th>
              <th class="p-3.5">Default Subnet Mask</th>
              <th class="p-3.5">Typical Use</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 font-mono text-xs">
            <tr class="hover:bg-slate-50">
              <td class="p-3.5 font-bold font-sans">Class A</td>
              <td class="p-3.5">10.0.0.0 – 10.255.255.255</td>
              <td class="p-3.5">255.0.0.0 (/8)</td>
              <td class="p-3.5 font-sans">Large enterprise networks & Xfinity Gateways (10.0.0.1)</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="p-3.5 font-bold font-sans">Class B</td>
              <td class="p-3.5">172.16.0.0 – 172.31.255.255</td>
              <td class="p-3.5">255.240.0.0 (/12)</td>
              <td class="p-3.5 font-sans">Medium corporate networks & VPN connections</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="p-3.5 font-bold font-sans">Class C</td>
              <td class="p-3.5">192.168.0.0 – 192.168.255.255</td>
              <td class="p-3.5">255.255.255.0 (/24)</td>
              <td class="p-3.5 font-sans font-bold text-sky-700">Home & small office routers (192.168.1.1, 192.168.0.1)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

  </div>
</BaseLayout>
