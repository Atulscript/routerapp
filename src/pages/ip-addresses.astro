---
import BaseLayout from '../layouts/BaseLayout.astro';
import IpCard from '../components/IpCard.astro';
import AdBanner from '../components/AdBanner.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';
import { GATEWAY_IPS } from '../lib/data-loader';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "Default Router Gateway IP Addresses Directory | 19216811.page";
const description = "Comprehensive directory of private default gateway IP addresses (192.168.1.1, 192.168.0.1, 10.0.0.1, 192.168.2.1). Step-by-step router admin login access and IP subnet classes.";
const keywords = [
  "router ip addresses",
  "default gateway ip",
  "192.168.1.1",
  "192.168.0.1",
  "10.0.0.1",
  "192.168.2.1",
  "192.168.1.254",
  "192.168.100.1",
  "private ip addresses",
  "rfc 1918 subnets"
];

const siteUrl = "https://atulscript.github.io/routerapp";

const schema = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Gateway IP Addresses",
        "item": `${siteUrl}/ip-addresses`
      }
    ]
  },
  {
    "@type": "ItemList",
    "name": "Default Router Gateway IP Addresses",
    "description": "List of private RFC 1918 gateway IP addresses and router login access URLs.",
    "itemListElement": GATEWAY_IPS.map((ip, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": `${ip.ip} Gateway Guide`,
      "url": `${siteUrl}/${ip.slug}`
    }))
  },
  {
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Why do different router brands use different IP addresses?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Manufacturers select default subnets defined by RFC 1918. For instance, TP-Link and D-Link commonly use 192.168.0.1, Netgear and Linksys use 192.168.1.1, and Comcast/Xfinity uses 10.0.0.1 to avoid default subnet collisions with customer equipment."
        }
      },
      {
        "@type": "Question",
        "name": "Can I change my router's default gateway IP address?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, inside your router's LAN or Network settings you can change the Gateway IP (for example from 192.168.1.1 to 192.168.10.1). Note that all connected devices will renew their DHCP leases with the new IP range."
        }
      },
      {
        "@type": "Question",
        "name": "Why is my router IP not loading in the browser?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Verify you are directly connected to your router via Wi-Fi or Ethernet cable, ensure you are using 'http://' rather than 'https://', and check that no VPN or proxy is active on your device."
        }
      }
    ]
  }
];
---

<BaseLayout 
  title={title} 
  description={description} 
  keywords={keywords}
  schema={schema}
  ogType="website"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 text-xs text-slate-400 font-medium">
      <a href={`${base}/`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold truncate">Gateway IPs</span>
    </nav>

    <!-- Header -->
    <header class="text-center max-w-xl mx-auto">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-[11px] font-bold uppercase mb-2 border border-slate-200 dark:border-slate-700">
        🌐 Gateway IP Directory
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-2">
        Router IP Addresses
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
        Browse common private IP addresses designated for local wireless router configuration panels.
      </p>
    </header>

    <AdBanner format="leaderboard" />

    <!-- IP Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
      {GATEWAY_IPS.map(item => (
        <IpCard data={item} />
      ))}
    </div>

    <AdBanner format="horizontal" />

    <!-- Technical SEO Explanation Table -->
    <section class="bg-white dark:bg-slate-900 rounded-2xl p-4 sm:p-6 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-3.5 transition-colors">
      <h2 class="text-lg font-bold text-slate-900 dark:text-white">Private IP Address Ranges Explained (RFC 1918)</h2>
      <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
        The Internet Engineering Task Force (IETF) reserved specific ranges of IPv4 addresses strictly for private local area networks (LAN). These addresses cannot be routed across the public internet:
      </p>

      <div class="overflow-x-auto rounded-xl border border-slate-200/90 dark:border-slate-800">
        <table class="w-full text-left text-xs text-slate-800 dark:text-slate-200">
          <thead class="bg-slate-50 dark:bg-slate-800/80 font-semibold uppercase text-[11px] text-slate-500 dark:text-slate-400 border-b border-slate-200 dark:border-slate-700">
            <tr>
              <th class="p-2.5">Class</th>
              <th class="p-2.5">IP Address Range</th>
              <th class="p-2.5">Default Mask</th>
              <th class="p-2.5">Typical Use</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800 font-mono text-xs">
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
              <td class="p-2.5 font-bold font-sans">Class A</td>
              <td class="p-2.5">10.0.0.0 – 10.255.255.255</td>
              <td class="p-2.5">255.0.0.0 (/8)</td>
              <td class="p-2.5 font-sans">
                Enterprise networks & Xfinity Gateways (<a href={`${base}/10-0-0-1`} class="text-brand-600 dark:text-brand-400 font-bold hover:underline">10.0.0.1 Guide →</a>)
              </td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
              <td class="p-2.5 font-bold font-sans">Class B</td>
              <td class="p-2.5">172.16.0.0 – 172.31.255.255</td>
              <td class="p-2.5">255.240.0.0 (/12)</td>
              <td class="p-2.5 font-sans">Medium corporate networks, Docker & VPN subnets</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
              <td class="p-2.5 font-bold font-sans">Class C</td>
              <td class="p-2.5">192.168.0.0 – 192.168.255.255</td>
              <td class="p-2.5">255.255.255.0 (/24)</td>
              <td class="p-2.5 font-sans font-bold">
                Home routers (<a href={`${base}/`} class="text-brand-600 dark:text-brand-400 hover:underline">192.168.1.1</a>, <a href={`${base}/192-168-0-1`} class="text-brand-600 dark:text-brand-400 hover:underline">192.168.0.1</a>, <a href={`${base}/192-168-2-1`} class="text-brand-600 dark:text-brand-400 hover:underline">192.168.2.1</a>)
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs pt-1">
        <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 space-y-1">
          <strong class="text-slate-900 dark:text-white block font-semibold text-xs">⚠️ Avoiding IP Conflicts on Two Routers</strong>
          <p class="text-[11px] text-slate-600 dark:text-slate-300 leading-relaxed">
            If connecting a secondary router, ensure both do not share the same IP (192.168.1.1). Change the secondary router to <strong>192.168.2.1</strong> or switch it to Access Point (AP) mode.
          </p>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 space-y-1">
          <strong class="text-slate-900 dark:text-white block font-semibold text-xs">🛠️ Rescuing an Unresponsive Router</strong>
          <p class="text-[11px] text-slate-600 dark:text-slate-300 leading-relaxed">
            If DHCP fails, set a static IP like <code class="font-mono bg-white dark:bg-slate-700 px-1 py-0.5 rounded border dark:border-slate-600">192.168.1.50</code> with subnet <code class="font-mono bg-white dark:bg-slate-700 px-1 py-0.5 rounded border dark:border-slate-600">255.255.255.0</code> to reconnect.
          </p>
        </div>
      </div>
    </section>

    <!-- Interlinking 2-Column Grid -->
    <div>
      <RelatedLinksGrid />
    </div>

    <!-- FAQ Accordion (Positioned Just Above Footer) -->
    <section class="bg-white dark:bg-slate-900 rounded-2xl p-5 sm:p-6 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-4">
      <h2 class="text-lg font-bold text-slate-900 dark:text-white">Gateway IP FAQs</h2>
      <div class="divide-y divide-slate-100 dark:divide-slate-800 text-xs">
        <div class="py-3">
          <strong class="text-slate-900 dark:text-slate-100 text-xs block font-semibold mb-1">Why do different router brands use different IP addresses?</strong>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            Manufacturers select default subnets defined by RFC 1918. For instance, TP-Link and D-Link commonly use 192.168.0.1, Netgear and Linksys use 192.168.1.1, and Comcast/Xfinity uses 10.0.0.1 to avoid default subnet collisions with customer equipment.
          </p>
        </div>
        <div class="py-3">
          <strong class="text-slate-900 dark:text-slate-100 text-xs block font-semibold mb-1">Can I change my router's default gateway IP address?</strong>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            Yes, inside your router's LAN or Network settings you can change the Gateway IP (for example from 192.168.1.1 to 192.168.10.1). Note that all connected devices will renew their DHCP leases with the new IP range.
          </p>
        </div>
        <div class="py-3">
          <strong class="text-slate-900 dark:text-slate-100 text-xs block font-semibold mb-1">Why is my router IP not loading in the browser?</strong>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            Verify you are directly connected to your router via Wi-Fi or Ethernet cable, ensure you are using 'http://' rather than 'https://', and check that no VPN or proxy is active on your device.
          </p>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
