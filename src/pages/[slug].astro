---
import BaseLayout from '../layouts/BaseLayout.astro';
import PasswordTable from '../components/PasswordTable.astro';
import AdBanner from '../components/AdBanner.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';
import RouterGuideCard from '../components/RouterGuideCard.astro';
import { getAllSlugs, getBrandSlug, getIpSlug, getModelsForIp, GATEWAY_IPS, BRANDS, ISPS } from '../lib/data-loader';
import type { GatewayIp, Brand, Isp } from '../lib/types';

export async function getStaticPaths() {
  return await getAllSlugs();
}

type Props = 
  | { type: 'ip'; data: GatewayIp }
  | { type: 'brand'; data: Brand }
  | { type: 'isp'; data: Isp };

const { type, data } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Dynamic title, description, keywords, and schemas based on page type
let pageTitle = "";
let pageDescription = "";
let keywords: string[] = [];
let schemas: Record<string, any>[] = [];
const siteUrl = "https://atulscript.github.io/routerapp";
const currentCanonical = `${siteUrl}/${data.slug}`;

if (type === 'ip') {
  const ipData = data as GatewayIp;
  pageTitle = `${ipData.ip} Router Admin Login, Passwords & Setup Guide | 19216811.page`;
  pageDescription = `Access router admin dashboard at ${ipData.ip}. Default login usernames, factory passwords, WiFi security configuration, and troubleshooting for ${ipData.commonBrands.slice(0, 4).join(', ')}.`;
  keywords = [
    ipData.ip,
    `${ipData.ip} login`,
    `${ipData.ip} admin`,
    `${ipData.ip} default password`,
    `${ipData.ip} router setup`,
    "default gateway ip",
    "router admin dashboard",
    ...ipData.commonBrands.map(b => `${b} router login`)
  ];

  schemas = [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteUrl}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Gateway IP Addresses",
          "item": `${siteUrl}/ip-addresses`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": `${ipData.ip} Setup Guide`,
          "item": currentCanonical
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": `How to Login to Router Gateway at ${ipData.ip}`,
      "description": `Step-by-step instructions to connect and log into your router dashboard at ${ipData.ip}.`,
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Connect Network Cable or Wi-Fi",
          "text": "Connect your computer or phone to the router via Ethernet or Wi-Fi.",
          "url": `${currentCanonical}#step-1`
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": `Navigate to http://${ipData.ip}`,
          "text": `Open your browser address bar, type http://${ipData.ip} and press Enter.`,
          "url": `${currentCanonical}#step-2`
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Enter Credentials",
          "text": `Enter default username (${ipData.defaultUser}) and password (${ipData.defaultPass}) to access admin settings.`,
          "url": `${currentCanonical}#step-3`
        }
      ]
    },
    {
      "@type": "TechArticle",
      "headline": pageTitle,
      "description": pageDescription,
      "url": currentCanonical,
      "author": {
        "@type": "Organization",
        "name": "19216811.page Network Research"
      },
      "articleBody": ipData.steps ? ipData.steps.join(' ') : ipData.description
    }
  ];

  if (ipData.faqs && ipData.faqs.length > 0) {
    schemas.push({
      "@type": "FAQPage",
      "mainEntity": ipData.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    });
  }
} else if (type === 'brand') {
  const brandData = data as Brand;
  pageTitle = `${brandData.name} Router Default Passwords & Admin Login Guide | 19216811.page`;
  pageDescription = `Complete factory default password directory and login tutorial for ${brandData.name} wireless routers and modems. Access IP ${brandData.defaultIp} with default username '${brandData.defaultUser}'.`;
  keywords = [
    `${brandData.name} router login`,
    `${brandData.name} default password`,
    `${brandData.name} admin login`,
    `${brandData.name} default ip`,
    brandData.defaultIp,
    `${brandData.name} router setup`,
    `${brandData.name} wifi password`,
    "router password database"
  ];

  schemas = [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteUrl}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Router Brands",
          "item": `${siteUrl}/brands`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": `${brandData.name} Directory`,
          "item": currentCanonical
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": `How to Login to ${brandData.name} Router Admin Panel`,
      "description": `Step-by-step instructions to configure your ${brandData.name} router at ${brandData.defaultIp}.`,
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Connect to Router",
          "text": `Connect your device to the ${brandData.name} network via Wi-Fi or LAN cable.`,
          "url": `${currentCanonical}#step-1`
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Open Web Gateway",
          "text": `Enter http://${brandData.defaultIp} into your browser URL bar.`,
          "url": `${currentCanonical}#step-2`
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Enter Default Credentials",
          "text": `Type username '${brandData.defaultUser}' and password '${brandData.defaultPass}' to sign in.`,
          "url": `${currentCanonical}#step-3`
        }
      ]
    },
    {
      "@type": "TechArticle",
      "headline": pageTitle,
      "description": pageDescription,
      "url": currentCanonical,
      "author": {
        "@type": "Organization",
        "name": "19216811.page Network Research"
      }
    }
  ];

  if (brandData.models && brandData.models.length > 0) {
    schemas.push({
      "@type": "ItemList",
      "name": `${brandData.name} Router Models`,
      "itemListElement": brandData.models.map((model, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "name": `${brandData.name} ${model.model} - IP: ${model.ip} (User: ${model.username})`
      }))
    });
  }
} else if (type === 'isp') {
  const ispData = data as Isp;
  pageTitle = `${ispData.name} Router Admin Login (${ispData.defaultIp}) & Setup | 19216811.page`;
  pageDescription = `Step-by-step ${ispData.name} broadband router login guide. Configure Wi-Fi, view ONT optical status, and login to default IP ${ispData.defaultIp} with verified admin credentials.`;
  keywords = [
    `${ispData.name} router login`,
    `${ispData.name} default password`,
    `${ispData.name} admin login`,
    ispData.defaultIp,
    `${ispData.name} wifi settings`,
    `${ispData.name} fiber ont`,
    `${ispData.name} optical indicator lights`
  ];

  schemas = [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteUrl}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Default Passwords",
          "item": `${siteUrl}/default-passwords`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": `${ispData.name} Router Guide`,
          "item": currentCanonical
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": `How to Login to ${ispData.name} Router & ONT Dashboard`,
      "description": `Connect to ${ispData.name} optical router at ${ispData.defaultIp} and configure network settings.`,
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Connect to Broadband Network",
          "text": `Connect to your ${ispData.name} Wi-Fi SSID or plug into the LAN port.`,
          "url": `${currentCanonical}#step-1`
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": `Access ${ispData.defaultIp}`,
          "text": `Type http://${ispData.defaultIp} in your browser and hit Enter.`,
          "url": `${currentCanonical}#step-2`
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Authenticate",
          "text": `Sign in with username '${ispData.defaultUser}' and password '${ispData.defaultPass}'.`,
          "url": `${currentCanonical}#step-3`
        }
      ]
    },
    {
      "@type": "TechArticle",
      "headline": pageTitle,
      "description": pageDescription,
      "url": currentCanonical,
      "author": {
        "@type": "Organization",
        "name": "19216811.page Network Research"
      }
    }
  ];
}
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription} 
  keywords={keywords}
  schema={schemas}
  ogType="article"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 text-xs text-slate-400 dark:text-slate-500 font-medium">
      <a href={`${base}/`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
      <span>/</span>
      {type === 'ip' && (
        <>
          <a href={`${base}/ip-addresses`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Gateway IPs</a>
          <span>/</span>
        </>
      )}
      {type === 'brand' && (
        <>
          <a href={`${base}/brands`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Brands</a>
          <span>/</span>
        </>
      )}
      {type === 'isp' && (
        <>
          <a href={`${base}/default-passwords`} class="hover:text-slate-900 dark:hover:text-white transition-colors">ISPs</a>
          <span>/</span>
        </>
      )}
      <span class="text-slate-800 dark:text-slate-200 font-semibold truncate">{pageTitle.split('|')[0]}</span>
    </nav>

    <AdBanner format="leaderboard" />

    <!-- IP View -->
    {type === 'ip' && (() => {
      const ip = data as GatewayIp;
      const matchingModels = getModelsForIp(ip.ip);
      const otherIpsList = GATEWAY_IPS.filter(g => g.ip !== ip.ip);
      
      return (
        <article class="space-y-6">
          <header class="border-b border-slate-200/80 dark:border-slate-800 pb-5">
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-sky-50 dark:bg-sky-950/60 text-brand-700 dark:text-brand-300 text-[11px] font-bold font-mono uppercase mb-2 border border-sky-200 dark:border-sky-800/80">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Gateway IP: {ip.ip}
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-2">
              {ip.title}
            </h1>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              {ip.description}
            </p>
          </header>

          <!-- Quick Action Card -->
          <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 sm:p-5 border border-slate-200/90 dark:border-slate-800 shadow-card">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div>
                <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400 dark:text-slate-500 block">Direct Gateway URL</span>
                <div class="text-2xl font-mono font-extrabold text-slate-900 dark:text-white mt-0.5">http://{ip.ip}</div>
                <div class="mt-2 flex flex-wrap gap-2 text-xs font-mono">
                  <div class="bg-slate-100 dark:bg-slate-800 px-2.5 py-1 rounded-md text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                    User: <strong class="text-slate-900 dark:text-white">{ip.defaultUser}</strong>
                  </div>
                  <div class="bg-slate-100 dark:bg-slate-800 px-2.5 py-1 rounded-md text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                    Pass: <strong class="text-slate-900 dark:text-white">{ip.defaultPass}</strong>
                  </div>
                </div>
              </div>
              <a 
                href={`http://${ip.ip}`} 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-slate-900 dark:bg-brand-600 hover:bg-slate-800 dark:hover:bg-brand-500 text-white text-xs font-bold whitespace-nowrap shadow-xs hover:shadow-sm transition-all active:scale-95 w-full sm:w-auto"
              >
                Open {ip.ip} Portal ↗
              </a>
            </div>
          </div>

          <!-- Other Gateway Shortcuts -->
          <div class="flex flex-wrap items-center gap-1.5 p-3 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/90 dark:border-slate-800 shadow-2xs text-xs">
            <span class="text-slate-400 dark:text-slate-500 font-bold text-[11px] mr-1">Other Gateway IPs:</span>
            {otherIpsList.map(other => {
              const otherUrl = other.slug === '192-168-1-1' ? `${base}/` : `${base}/${other.slug}`;
              return (
                <a 
                  href={otherUrl}
                  class="px-2.5 py-1 rounded-lg bg-slate-50 dark:bg-slate-800 hover:bg-sky-50 dark:hover:bg-slate-700 border border-slate-200/80 dark:border-slate-700 font-mono font-bold text-slate-700 dark:text-slate-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors"
                >
                  {other.ip}
                </a>
              );
            })}
          </div>

          <!-- Router Login & Support Two-Box Guide -->
          <RouterGuideCard 
            entityName="Wi-Fi Router" 
            ipAddress={ip.ip} 
            brandName={ip.commonBrands.join(', ')} 
          />

          <AdBanner format="horizontal" />

          <!-- Clickable Common Brands for this IP -->
          <section class="bg-white dark:bg-slate-900 rounded-2xl p-4 sm:p-5 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-2.5">
            <div class="flex items-center justify-between">
              <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                Routers & Brands using {ip.ip}
              </h2>
              <a href={`${base}/brands`} class="text-[11px] font-semibold text-brand-600 dark:text-brand-400 hover:underline">
                All Brands →
              </a>
            </div>
            <div class="flex flex-wrap gap-1.5">
              {ip.commonBrands.map(brand => {
                const bSlug = getBrandSlug(brand);
                return bSlug ? (
                  <a 
                    href={`${base}/${bSlug}`}
                    class="px-3 py-1.5 rounded-xl bg-slate-50 dark:bg-slate-800 hover:bg-sky-50 dark:hover:bg-slate-750 border border-slate-200/80 dark:border-slate-700 text-xs font-bold text-slate-800 dark:text-slate-200 hover:text-brand-600 dark:hover:text-brand-400 hover:border-sky-300 dark:hover:border-sky-600 transition-all flex items-center gap-1"
                  >
                    <span>{brand}</span>
                    <span class="text-[10px] text-slate-400 dark:text-slate-500">→</span>
                  </a>
                ) : (
                  <span class="px-3 py-1.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 text-xs font-semibold text-slate-800 dark:text-slate-200">
                    {brand}
                  </span>
                );
              })}
            </div>
          </section>

          <!-- Router Models Using This IP Table -->
          {matchingModels.length > 0 && (
            <section class="bg-white dark:bg-slate-900 rounded-2xl p-4 sm:p-5 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-3">
              <div class="flex items-center justify-between">
                <div>
                  <h2 class="text-base font-bold text-slate-900 dark:text-white">
                    Router Hardware Models Configured at {ip.ip}
                  </h2>
                  <p class="text-xs text-slate-500 dark:text-slate-400">Verified factory credentials for hardware utilizing {ip.ip}</p>
                </div>
                <a href={`${base}/routers`} class="text-xs font-semibold text-brand-600 dark:text-brand-400 hover:underline">
                  All Hardware ({BRANDS.reduce((acc, b) => acc + b.models.length, 0)}) →
                </a>
              </div>
              <PasswordTable models={matchingModels as any} />
            </section>
          )}

          <!-- Step-by-Step WiFi Configuration Guide -->
          <section class="bg-white dark:bg-slate-900 rounded-2xl p-4 sm:p-6 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-3">
            <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
              How to Change Your Wi-Fi Password at {ip.ip}
            </h2>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Once you have successfully logged in using your default credentials, securing your wireless network is simple:
            </p>
            <ol class="list-decimal list-inside space-y-1.5 text-xs text-slate-700 dark:text-slate-300 font-medium pl-1">
              <li>Navigate to the <strong>Wireless</strong> or <strong>Wi-Fi Settings</strong> menu tab on the left dashboard.</li>
              <li>Locate the <strong>SSID Name</strong> field to rename your network (e.g., <em>Home_5G</em>).</li>
              <li>Under <strong>Security Mode</strong>, select <strong>WPA2-PSK (AES)</strong> or <strong>WPA3-Personal</strong>.</li>
              <li>Type your new custom password in the <strong>Passphrase / Pre-Shared Key</strong> field.</li>
              <li>Click <strong>Save / Apply</strong>. Your connected devices will briefly disconnect and require the new password.</li>
            </ol>
          </section>
        </article>
      );
    })()}

    <!-- Brand View -->
    {type === 'brand' && (() => {
      const brand = data as Brand;
      const primaryIp = brand.defaultIp.split('/')[0].trim();
      const ipSlug = getIpSlug(primaryIp);
      const ipUrl = ipSlug !== null ? (ipSlug === '' ? `${base}/` : `${base}/${ipSlug}`) : null;
      const otherBrands = BRANDS.filter(b => b.slug !== brand.slug);

      return (
        <article class="space-y-6">
          <header class="border-b border-slate-200/80 dark:border-slate-800 pb-5">
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-[11px] font-bold uppercase mb-2 border border-slate-200 dark:border-slate-700">
              Brand Directory
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-2">
              {brand.name} Router Default Passwords & Login Guide
            </h1>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              {brand.description}
            </p>
          </header>

          <!-- Summary info cards with Interlinks -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="bg-white dark:bg-slate-900 rounded-xl p-3.5 border border-slate-200/80 dark:border-slate-800 shadow-2xs">
              <span class="text-[11px] text-slate-400 dark:text-slate-500 block mb-0.5 font-medium">Default Gateway IP</span>
              {ipUrl ? (
                <a href={ipUrl} class="font-mono font-bold text-brand-600 dark:text-brand-400 text-sm hover:underline flex items-center justify-between">
                  <span>{brand.defaultIp}</span>
                  <span class="text-xs text-slate-400 dark:text-slate-500">Setup Guide →</span>
                </a>
              ) : (
                <span class="font-mono font-bold text-slate-900 dark:text-white text-sm">{brand.defaultIp}</span>
              )}
            </div>
            <div class="bg-white dark:bg-slate-900 rounded-xl p-3.5 border border-slate-200/80 dark:border-slate-800 shadow-2xs">
              <span class="text-[11px] text-slate-400 dark:text-slate-500 block mb-0.5 font-medium">Default Username</span>
              <span class="font-mono font-bold text-slate-900 dark:text-white text-sm">{brand.defaultUser}</span>
            </div>
            <div class="bg-white dark:bg-slate-900 rounded-xl p-3.5 border border-slate-200/80 dark:border-slate-800 shadow-2xs">
              <span class="text-[11px] text-slate-400 dark:text-slate-500 block mb-0.5 font-medium">Default Password</span>
              <span class="font-mono font-bold text-slate-900 dark:text-white text-sm">{brand.defaultPass}</span>
            </div>
          </div>

          <!-- Models Table -->
          <section class="bg-white dark:bg-slate-900 rounded-2xl p-4 sm:p-5 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-3">
            <div class="flex items-center justify-between">
              <h2 class="text-base font-bold text-slate-900 dark:text-white">
                {brand.name} Model Credentials Database
              </h2>
              <a href={`${base}/routers`} class="text-xs font-semibold text-brand-600 dark:text-brand-400 hover:underline">
                Hardware DB →
              </a>
            </div>
            <PasswordTable models={brand.models} brandName={brand.name} brandSlug={brand.slug} />
          </section>

          <AdBanner format="horizontal" />

          <!-- Router Login & Support Two-Box Guide -->
          <RouterGuideCard 
            entityName={brand.name} 
            ipAddress={brand.defaultIp} 
            brandName={brand.name} 
          />

          <!-- Other Router Brands Cross-Links -->
          <section class="bg-white dark:bg-slate-900 rounded-2xl p-4 sm:p-5 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-2.5">
            <div class="flex items-center justify-between">
              <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                Compare with Other Router Manufacturers
              </h2>
              <a href={`${base}/brands`} class="text-[11px] font-semibold text-brand-600 dark:text-brand-400 hover:underline">
                All Brands ({BRANDS.length}) →
              </a>
            </div>
            <div class="flex flex-wrap gap-1.5">
              {otherBrands.slice(0, 10).map(b => (
                <a 
                  href={`${base}/${b.slug}`}
                  class="px-2.5 py-1 rounded-lg bg-slate-50 dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-750 border border-slate-200/80 dark:border-slate-700 text-xs font-semibold text-slate-800 dark:text-slate-200 hover:text-brand-600 dark:hover:text-brand-400 transition-colors"
                >
                  {b.name}
                </a>
              ))}
            </div>
          </section>
        </article>
      );
    })()}

    <!-- ISP View -->
    {type === 'isp' && (() => {
      const isp = data as Isp;
      const ipSlug = getIpSlug(isp.defaultIp);
      const ipUrl = ipSlug !== null ? (ipSlug === '' ? `${base}/` : `${base}/${ipSlug}`) : null;
      const otherIsps = ISPS.filter(i => i.slug !== isp.slug);

      return (
        <article class="space-y-6">
          <header class="border-b border-slate-200/80 dark:border-slate-800 pb-5">
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 text-[11px] font-bold uppercase mb-2 border border-emerald-200 dark:border-emerald-800/80">
              Internet Service Provider
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-2">
              {isp.name} Router Login & Setup Guide
            </h1>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              {isp.description}
            </p>
          </header>

          <!-- Quick Action Card with Interlink to IP -->
          <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 sm:p-5 border border-slate-200/90 dark:border-slate-800 shadow-card">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div>
                <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Gateway Address</span>
                <div class="flex items-center gap-2 mt-0.5">
                  {ipUrl ? (
                    <a href={ipUrl} class="text-2xl font-mono font-bold text-brand-600 dark:text-brand-400 hover:underline" title={`View ${isp.defaultIp} guide`}>
                      {isp.defaultIp}
                    </a>
                  ) : (
                    <span class="text-2xl font-mono font-bold text-slate-900 dark:text-white">{isp.defaultIp}</span>
                  )}
                  <span class="text-xs text-slate-400 dark:text-slate-500 font-sans font-medium">(Click for IP guide)</span>
                </div>
                <div class="mt-1.5 text-xs font-mono text-slate-600 dark:text-slate-300">
                  Default Credentials: <strong class="text-slate-900 dark:text-white">{isp.defaultUser}</strong> / <strong class="text-slate-900 dark:text-white">{isp.defaultPass}</strong>
                </div>
              </div>
              <a 
                href={`http://${isp.defaultIp}`}
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center px-4 py-2 rounded-xl bg-slate-900 dark:bg-brand-600 hover:bg-slate-800 dark:hover:bg-brand-500 text-white text-xs font-semibold shadow-xs transition-all"
              >
                Open {isp.defaultIp} ↗
              </a>
            </div>
          </div>

          <!-- Router Login & Support Two-Box Guide -->
          <RouterGuideCard 
            entityName={isp.name} 
            ipAddress={isp.defaultIp} 
            brandName={isp.name} 
          />

          <!-- Fiber ONT Indicator Diagnostics for ISPs -->
          <section class="bg-white dark:bg-slate-900 rounded-2xl p-4 sm:p-5 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-3">
            <h2 class="text-base font-bold text-slate-900 dark:text-white">
              Understanding Your {isp.name} ONT Indicator Lights
            </h2>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              If your broadband shows "Connected, No Internet", glance at the front LED indicators on your fiber optical modem before logging in:
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
              <div class="p-3 rounded-xl bg-emerald-50/70 dark:bg-emerald-950/40 border border-emerald-200/80 dark:border-emerald-800/70 space-y-1">
                <span class="font-bold text-emerald-900 dark:text-emerald-300 flex items-center gap-1.5 text-xs">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span> PON Light (Solid Green)
                </span>
                <p class="text-emerald-800 dark:text-emerald-400 text-[11px] leading-relaxed">
                  Optical connection with your ISP exchange is healthy and authenticated.
                </p>
              </div>

              <div class="p-3 rounded-xl bg-rose-50/70 dark:bg-rose-950/40 border border-rose-200/80 dark:border-rose-800/70 space-y-1">
                <span class="font-bold text-rose-900 dark:text-rose-300 flex items-center gap-1.5 text-xs">
                  <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span> LOS Light (Blinking Red)
                </span>
                <p class="text-rose-800 dark:text-rose-400 text-[11px] leading-relaxed">
                  Loss of Signal: The optical fiber cord is loose, bent, or there is an ISP fiber cut.
                </p>
              </div>

              <div class="p-3 rounded-xl bg-sky-50/70 dark:bg-sky-950/40 border border-sky-200/80 dark:border-sky-800/70 space-y-1">
                <span class="font-bold text-sky-900 dark:text-sky-300 flex items-center gap-1.5 text-xs">
                  <span class="w-2 h-2 rounded-full bg-sky-500"></span> LAN / WLAN (Blinking Green)
                </span>
                <p class="text-sky-800 dark:text-sky-400 text-[11px] leading-relaxed">
                  Data packets are actively transmitting between devices and the router.
                </p>
              </div>
            </div>
          </section>

          <!-- Other Fiber ISPs Cross-Links -->
          <section class="bg-white dark:bg-slate-900 rounded-2xl p-4 sm:p-5 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-2.5">
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
              Other Fiber Broadband Providers
            </h2>
            <div class="flex flex-wrap gap-1.5">
              {otherIsps.map(i => (
                <a 
                  href={`${base}/${i.slug}`}
                  class="px-2.5 py-1 rounded-lg bg-slate-50 dark:bg-slate-800 hover:bg-emerald-50 dark:hover:bg-slate-750 border border-slate-200/80 dark:border-slate-700 text-xs font-semibold text-slate-800 dark:text-slate-200 hover:text-emerald-800 dark:hover:text-emerald-400 transition-colors"
                >
                  {i.name} ({i.defaultIp})
                </a>
              ))}
            </div>
          </section>
        </article>
      );
    })()}

    <!-- 2-Column Cross Linking Grid (Placed Before FAQ) -->
    <RelatedLinksGrid currentSlug={data.slug} />

    <!-- FAQ Accordion Section (Just Above Footer) -->
    <section class="bg-white dark:bg-slate-900 rounded-2xl p-5 sm:p-6 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-3">
      <div class="flex items-center gap-2">
        <span class="text-base">❓</span>
        <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
          Frequently Asked Questions & Answers
        </h2>
      </div>

      <div class="space-y-2.5">
        {type === 'ip' && (() => {
          const ip = data as GatewayIp;
          const faqsList = ip.faqs && ip.faqs.length > 0 ? ip.faqs : [
            { question: `What is the default login for ${ip.ip}?`, answer: `The default username is typically "${ip.defaultUser}" and password is "${ip.defaultPass}".` },
            { question: `Why is ${ip.ip} not loading in my browser?`, answer: `Make sure your device is directly connected to the router via Wi-Fi or Ethernet, and verify that mobile data or VPNs are turned off.` }
          ];

          return faqsList.map(faq => (
            <details class="group border border-slate-200/90 dark:border-slate-800 rounded-xl p-3.5 open:bg-slate-50/60 dark:open:bg-slate-850/60 hover:border-slate-300 dark:hover:border-slate-700 transition-colors">
              <summary class="font-bold text-slate-900 dark:text-white cursor-pointer list-none flex justify-between items-center text-xs sm:text-sm">
                <span class="flex items-center gap-2">
                  <span class="text-brand-600 dark:text-brand-400 font-bold">Q.</span>
                  {faq.question}
                </span>
                <span class="text-slate-400 dark:text-slate-500 group-open:rotate-180 group-open:text-brand-600 dark:group-open:text-brand-400 transition-transform text-xs flex-shrink-0 ml-2">▼</span>
              </summary>
              <p class="text-xs text-slate-600 dark:text-slate-300 mt-2 leading-relaxed border-t border-slate-100 dark:border-slate-800 pt-2">
                {faq.answer}
              </p>
            </details>
          ));
        })()}

        {type === 'brand' && (() => {
          const brand = data as Brand;
          const brandFaqs = [
            {
              question: `What is the default IP address for ${brand.name} routers?`,
              answer: `Most ${brand.name} routers use ${brand.defaultIp} as their factory default gateway management address.`
            },
            {
              question: `What is the factory default login password for ${brand.name}?`,
              answer: `The standard factory username is "${brand.defaultUser}" and default password is "${brand.defaultPass}". Check your physical router label if these don't work.`
            },
            {
              question: `How do I factory reset my ${brand.name} router if I forgot the password?`,
              answer: `Press and hold the physical RESET pinhole button on the back of your ${brand.name} device with a paperclip for 10-15 seconds until all LED lights blink, restoring default credentials.`
            }
          ];

          return brandFaqs.map(faq => (
            <details class="group border border-slate-200/90 dark:border-slate-800 rounded-xl p-3.5 open:bg-slate-50/60 dark:open:bg-slate-850/60 hover:border-slate-300 dark:hover:border-slate-700 transition-colors">
              <summary class="font-bold text-slate-900 dark:text-white cursor-pointer list-none flex justify-between items-center text-xs sm:text-sm">
                <span class="flex items-center gap-2">
                  <span class="text-brand-600 dark:text-brand-400 font-bold">Q.</span>
                  {faq.question}
                </span>
                <span class="text-slate-400 dark:text-slate-500 group-open:rotate-180 group-open:text-brand-600 dark:group-open:text-brand-400 transition-transform text-xs flex-shrink-0 ml-2">▼</span>
              </summary>
              <p class="text-xs text-slate-600 dark:text-slate-300 mt-2 leading-relaxed border-t border-slate-100 dark:border-slate-800 pt-2">
                {faq.answer}
              </p>
            </details>
          ));
        })()}

        {type === 'isp' && (() => {
          const isp = data as Isp;
          const ispFaqs = [
            {
              question: `How do I log in to my ${isp.name} fiber router admin portal?`,
              answer: `Connect to your ${isp.name} Wi-Fi network, navigate to http://${isp.defaultIp} in your browser, and enter username "${isp.defaultUser}" and password "${isp.defaultPass}".`
            },
            {
              question: `What should I do if the LOS light on my ${isp.name} router is blinking red?`,
              answer: `A blinking red LOS (Loss of Signal) light indicates an optical fiber cable disconnection or an ISP outage. Verify the thin yellow fiber cable is firmly seated, and contact ${isp.name} support if the issue persists.`
            },
            {
              question: `How can I change my ${isp.name} Wi-Fi password and network name?`,
              answer: `Log in to http://${isp.defaultIp}, go to Network/WLAN → 2.4G/5G Settings, update the SSID and WPA Pre-Shared Key, then click Apply.`
            }
          ];

          return ispFaqs.map(faq => (
            <details class="group border border-slate-200/90 dark:border-slate-800 rounded-xl p-3.5 open:bg-slate-50/60 dark:open:bg-slate-850/60 hover:border-slate-300 dark:hover:border-slate-700 transition-colors">
              <summary class="font-bold text-slate-900 dark:text-white cursor-pointer list-none flex justify-between items-center text-xs sm:text-sm">
                <span class="flex items-center gap-2">
                  <span class="text-brand-600 dark:text-brand-400 font-bold">Q.</span>
                  {faq.question}
                </span>
                <span class="text-slate-400 dark:text-slate-500 group-open:rotate-180 group-open:text-brand-600 dark:group-open:text-brand-400 transition-transform text-xs flex-shrink-0 ml-2">▼</span>
              </summary>
              <p class="text-xs text-slate-600 dark:text-slate-300 mt-2 leading-relaxed border-t border-slate-100 dark:border-slate-800 pt-2">
                {faq.answer}
              </p>
            </details>
          ));
        })()}
      </div>
    </section>

  </div>
</BaseLayout>

