---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import PasswordTable from '../components/PasswordTable.astro';
import AdBanner from '../components/AdBanner.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';
import RouterGuideCard from '../components/RouterGuideCard.astro';
import { getAllSlugs } from '../lib/data-loader';
import type { GatewayIp, Brand, Isp } from '../lib/types';

export async function getStaticPaths() {
  return await getAllSlugs();
}

type Props = 
  | { type: 'ip'; data: GatewayIp }
  | { type: 'brand'; data: Brand }
  | { type: 'isp'; data: Isp };

const { type, data } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Dynamic title and description based on page type
let pageTitle = "";
let pageDescription = "";
let schema: Record<string, any> = {};

if (type === 'ip') {
  const ipData = data as GatewayIp;
  pageTitle = `${ipData.ip} Router Login, Admin Password & Setup Guide | 19216811.page`;
  pageDescription = ipData.description;
  schema = {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "headline": pageTitle,
    "description": pageDescription,
    "articleBody": ipData.steps.join(' ')
  };
} else if (type === 'brand') {
  const brandData = data as Brand;
  pageTitle = `${brandData.name} Router Default Passwords & Login Guide | 19216811.page`;
  pageDescription = brandData.description;
  schema = {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "headline": pageTitle,
    "description": pageDescription
  };
} else if (type === 'isp') {
  const ispData = data as Isp;
  pageTitle = `${ispData.name} Router Admin Login (${ispData.defaultIp}) & Setup | 19216811.page`;
  pageDescription = ispData.description;
  schema = {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "headline": pageTitle,
    "description": pageDescription
  };
}
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6 sm:space-y-8">
    
    <!-- Contextual Search -->
    <div>
      <SearchBar />
    </div>

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 text-xs text-slate-500 font-medium">
      <a href={`${base}/`} class="hover:text-md-primary transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-900 font-semibold truncate">{pageTitle.split('|')[0]}</span>
    </nav>

    <AdBanner format="leaderboard" />

    <!-- IP View -->
    {type === 'ip' && (() => {
      const ip = data as GatewayIp;
      return (
        <article class="space-y-6 sm:space-y-8">
          <header class="border-b border-md-outline-variant/40 pb-5">
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-m3-full bg-md-primary-container text-md-on-primary-container text-[11px] font-bold font-mono uppercase mb-2 border border-md-primary/20">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              Gateway IP: {ip.ip}
            </div>
            <h1 class="text-2xl sm:text-3xl font-black text-md-on-surface tracking-tight mb-2">
              {ip.title}
            </h1>
            <p class="text-xs sm:text-sm text-md-on-surface-variant leading-relaxed">
              {ip.description}
            </p>
          </header>

          <!-- Quick Action Compact Command Card -->
          <div class="bg-gradient-to-br from-md-primary via-[#00528c] to-[#003e6d] rounded-m3-lg p-4 sm:p-6 text-white shadow-m3-2 border border-white/10">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div>
                <span class="text-[10px] uppercase font-bold tracking-wider text-md-primary-container">Direct Gateway IP Portal</span>
                <div class="text-2xl sm:text-3xl font-mono font-black mt-0.5 tracking-tight text-white">http://{ip.ip}</div>
                <div class="mt-2 flex flex-wrap gap-2 text-xs font-mono">
                  <div class="bg-white/15 px-2.5 py-1 rounded-m3-sm backdrop-blur-sm border border-white/10">
                    User: <strong class="text-white">{ip.defaultUser}</strong>
                  </div>
                  <div class="bg-white/15 px-2.5 py-1 rounded-m3-sm backdrop-blur-sm border border-white/10">
                    Pass: <strong class="text-white">{ip.defaultPass}</strong>
                  </div>
                </div>
              </div>
              <a 
                href={`http://${ip.ip}`} 
                target="_blank" 
                rel="noopener noreferrer"
                class="m3-btn-filled bg-white text-md-primary hover:bg-md-surface-container text-xs font-bold whitespace-nowrap shadow-m3-1 py-2.5 px-4 w-full sm:w-auto text-center"
              >
                Open {ip.ip} Portal ↗
              </a>
            </div>
          </div>

          <!-- Router Login & Support Two-Box Guide (Matching User Design) -->
          <RouterGuideCard 
            entityName="Wi-Fi Router" 
            ipAddress={ip.ip} 
            brandName={ip.commonBrands.join(', ')} 
          />

          <AdBanner format="horizontal" />

          <!-- Common Brands for this IP -->
          <section class="m3-card-compact bg-md-surface-container-low">
            <h2 class="text-sm font-bold text-md-on-surface mb-2.5">Routers that commonly use {ip.ip}</h2>
            <div class="flex flex-wrap gap-1.5">
              {ip.commonBrands.map(brand => (
                <span class="px-2.5 py-1 rounded-m3-sm bg-white border border-md-outline-variant/40 text-xs font-semibold text-md-on-surface shadow-2xs">
                  {brand}
                </span>
              ))}
            </div>
          </section>

          <!-- Step-by-Step WiFi Configuration Guide -->
          <section class="m3-card-compact space-y-3">
            <h2 class="text-lg font-bold text-md-on-surface">
              How to Change Your Wi-Fi Password at {ip.ip}
            </h2>
            <p class="text-xs text-md-on-surface-variant leading-relaxed">
              Once you have successfully logged in using your default credentials, securing your wireless network is simple:
            </p>
            <ol class="list-decimal list-inside space-y-1.5 text-xs text-md-on-surface font-medium pl-1">
              <li>Navigate to the <strong>Wireless</strong> or <strong>Wi-Fi Settings</strong> menu tab on the left dashboard.</li>
              <li>Locate the <strong>SSID Name</strong> field to rename your network (e.g., <em>Home_5G</em>).</li>
              <li>Under <strong>Security Mode</strong>, select <strong>WPA2-PSK (AES)</strong> or <strong>WPA3-Personal</strong>.</li>
              <li>Type your new custom password in the <strong>Passphrase / Pre-Shared Key</strong> field.</li>
              <li>Click <strong>Save / Apply</strong>. Your connected devices will briefly disconnect and require the new password.</li>
            </ol>
          </section>

          <!-- FAQ Accordion -->
          {ip.faqs && ip.faqs.length > 0 && (
            <section class="m3-card-compact space-y-3">
              <h2 class="text-lg font-bold text-md-on-surface">Troubleshooting & Questions for {ip.ip}</h2>
              <div class="space-y-2">
                {ip.faqs.map(faq => (
                  <details class="group border border-md-outline-variant/30 rounded-m3-md p-3 open:bg-md-surface-container-low transition-colors">
                    <summary class="font-bold text-md-on-surface cursor-pointer list-none flex justify-between items-center text-xs sm:text-sm">
                      {faq.question}
                      <span class="text-md-outline group-open:rotate-180 transition-transform text-xs">▼</span>
                    </summary>
                    <p class="text-xs text-md-on-surface-variant mt-2 leading-relaxed border-t border-md-surface-variant/40 pt-2">
                      {faq.answer}
                    </p>
                  </details>
                ))}
              </div>
            </section>
          )}
        </article>
      );
    })()}

    <!-- Brand View -->
    {type === 'brand' && (() => {
      const brand = data as Brand;
      return (
        <article class="space-y-6 sm:space-y-8">
          <header class="border-b border-md-outline-variant/40 pb-5">
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-m3-full bg-md-primary-container text-md-on-primary-container text-[11px] font-bold uppercase mb-2 border border-md-primary/20">
              Brand Directory
            </div>
            <h1 class="text-2xl sm:text-3xl font-black text-md-on-surface tracking-tight mb-2">
              {brand.name} Router Default Passwords & Login Guide
            </h1>
            <p class="text-xs sm:text-sm text-md-on-surface-variant leading-relaxed">
              {brand.description}
            </p>
          </header>

          <!-- Summary info cards -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="m3-card-compact">
              <span class="text-[11px] text-md-on-surface-variant block mb-0.5 font-medium">Default Gateway IP</span>
              <a href={`${base}/${brand.defaultIp === '192.168.1.1' ? '' : brand.defaultIp.replace(/\./g, '-')}`} class="font-mono font-bold text-md-primary text-sm hover:underline">
                {brand.defaultIp}
              </a>
            </div>
            <div class="m3-card-compact">
              <span class="text-[11px] text-md-on-surface-variant block mb-0.5 font-medium">Default Username</span>
              <span class="font-mono font-bold text-md-on-surface text-sm">{brand.defaultUser}</span>
            </div>
            <div class="m3-card-compact">
              <span class="text-[11px] text-md-on-surface-variant block mb-0.5 font-medium">Default Password</span>
              <span class="font-mono font-bold text-md-on-surface text-sm">{brand.defaultPass}</span>
            </div>
          </div>

          <!-- Models Table -->
          <section class="m3-card-compact">
            <h2 class="text-base font-bold text-md-on-surface mb-3">
              {brand.name} Model Credentials Database
            </h2>
            <PasswordTable models={brand.models} brandName={brand.name} />
          </section>

          <AdBanner format="horizontal" />

          <!-- Router Login & Support Two-Box Guide (Matching User Design) -->
          <RouterGuideCard 
            entityName={brand.name} 
            ipAddress={brand.defaultIp} 
            brandName={brand.name} 
          />
        </article>
      );
    })()}

    <!-- ISP View -->
    {type === 'isp' && (() => {
      const isp = data as Isp;
      return (
        <article class="space-y-6 sm:space-y-8">
          <header class="border-b border-md-outline-variant/40 pb-5">
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-m3-full bg-emerald-100 text-emerald-900 text-[11px] font-bold uppercase mb-2 border border-emerald-300">
              Internet Service Provider
            </div>
            <h1 class="text-2xl sm:text-3xl font-black text-md-on-surface tracking-tight mb-2">
              {isp.name} Router Login & Setup Guide
            </h1>
            <p class="text-xs sm:text-sm text-md-on-surface-variant leading-relaxed">
              {isp.description}
            </p>
          </header>

          <!-- Quick Action Card -->
          <div class="m3-card-compact">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div>
                <span class="text-[10px] font-bold text-md-on-surface-variant uppercase tracking-wider">Gateway Address</span>
                <div class="text-2xl font-mono font-bold text-md-on-surface mt-0.5">{isp.defaultIp}</div>
                <div class="mt-1.5 text-xs font-mono text-md-on-surface-variant">
                  Default Credentials: <strong>{isp.defaultUser}</strong> / <strong>{isp.defaultPass}</strong>
                </div>
              </div>
              <a 
                href={`http://${isp.defaultIp}`}
                target="_blank" 
                rel="noopener noreferrer"
                class="m3-btn-filled text-xs font-bold whitespace-nowrap py-2 px-4"
              >
                Open {isp.defaultIp} →
              </a>
            </div>
          </div>

          <!-- Router Login & Support Two-Box Guide (Matching User Design) -->
          <RouterGuideCard 
            entityName={isp.name} 
            ipAddress={isp.defaultIp} 
            brandName={isp.name} 
          />

          <!-- Fiber ONT Indicator Diagnostics for ISPs -->
          <section class="m3-card-compact space-y-4">
            <h2 class="text-base font-bold text-md-on-surface">
              Understanding Your {isp.name} ONT Indicator Lights
            </h2>
            <p class="text-xs text-md-on-surface-variant leading-relaxed">
              If your broadband shows "Connected, No Internet", glance at the front LED indicators on your fiber optical modem before logging in:
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
              <div class="p-3 rounded-m3-md bg-emerald-50 border border-emerald-200 space-y-1">
                <span class="font-bold text-emerald-900 flex items-center gap-1.5 text-xs">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span> PON Light (Solid Green)
                </span>
                <p class="text-emerald-800 text-[11px] leading-relaxed">
                  Optical connection with your ISP exchange is healthy and authenticated.
                </p>
              </div>

              <div class="p-3 rounded-m3-md bg-rose-50 border border-rose-200 space-y-1">
                <span class="font-bold text-rose-900 flex items-center gap-1.5 text-xs">
                  <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span> LOS Light (Blinking Red)
                </span>
                <p class="text-rose-800 text-[11px] leading-relaxed">
                  Loss of Signal: The optical fiber cord is loose, bent, or there is an ISP fiber cut.
                </p>
              </div>

              <div class="p-3 rounded-m3-md bg-sky-50 border border-sky-200 space-y-1">
                <span class="font-bold text-sky-900 flex items-center gap-1.5 text-xs">
                  <span class="w-2 h-2 rounded-full bg-sky-500"></span> LAN / WLAN (Blinking Green)
                </span>
                <p class="text-sky-800 text-[11px] leading-relaxed">
                  Data packets are actively transmitting between devices and the router.
                </p>
              </div>
            </div>
          </section>
        </article>
      );
    })()}

    <!-- 2-Column Cross Linking Grid (Requested Interlinking Feature) -->
    <RelatedLinksGrid currentSlug={data.slug} />

  </div>
</BaseLayout>
