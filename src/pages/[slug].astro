---
import BaseLayout from '../layouts/BaseLayout.astro';
import PasswordTable from '../components/PasswordTable.astro';
import AdBanner from '../components/AdBanner.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';
import RouterGuideCard from '../components/RouterGuideCard.astro';
import { getAllSlugs, getBrandSlug, getIpSlug, getModelsForIp, getModelsForBrand, GATEWAY_IPS, BRANDS, ISPS, ROUTER_MODELS } from '../lib/data-loader';
import type { GatewayIp, Brand, Isp, RouterModel } from '../lib/types';

export async function getStaticPaths() {
  return await getAllSlugs();
}

type Props = 
  | { type: 'ip'; data: GatewayIp }
  | { type: 'brand'; data: Brand }
  | { type: 'isp'; data: Isp }
  | { type: 'model'; data: RouterModel };

const { type, data } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Dynamic title, description, keywords, and schemas based on page type
let pageTitle = "";
let pageDescription = "";
let keywords: string[] = [];
let schemas: Record<string, any>[] = [];
const siteUrl = "https://atulscript.github.io/routerapp";
const currentCanonical = `${siteUrl}/${data.slug}`;

if (type === 'ip') {
  const ipData = data as GatewayIp;
  pageTitle = `${ipData.ip} Router Admin Login, Passwords & Setup Guide | 19216811.page`;
  pageDescription = `Access router admin dashboard at ${ipData.ip}. Default login usernames, factory passwords, WiFi security configuration, and troubleshooting for ${ipData.commonBrands.slice(0, 4).join(', ')}.`;
  keywords = [
    ipData.ip,
    `${ipData.ip} login`,
    `${ipData.ip} admin`,
    `${ipData.ip} default password`,
    `${ipData.ip} router setup`,
    "default gateway ip",
    "router admin dashboard",
    ...ipData.commonBrands.map(b => `${b} router login`)
  ];

  schemas = [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteUrl}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Gateway IP Addresses",
          "item": `${siteUrl}/ip-addresses`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": `${ipData.ip} Setup Guide`,
          "item": currentCanonical
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": `How to Login to Router Gateway at ${ipData.ip}`,
      "description": `Step-by-step instructions to connect and log into your router dashboard at ${ipData.ip}.`,
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Connect Network Cable or Wi-Fi",
          "text": "Connect your computer or phone to the router via Ethernet or Wi-Fi.",
          "url": `${currentCanonical}#step-1`
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": `Navigate to http://${ipData.ip}`,
          "text": `Open your browser address bar, type http://${ipData.ip} and press Enter.`,
          "url": `${currentCanonical}#step-2`
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Enter Credentials",
          "text": `Enter default username (${ipData.defaultUser}) and password (${ipData.defaultPass}) to access admin settings.`,
          "url": `${currentCanonical}#step-3`
        }
      ]
    },
    {
      "@type": "TechArticle",
      "headline": pageTitle,
      "description": pageDescription,
      "url": currentCanonical,
      "author": {
        "@type": "Organization",
        "name": "19216811.page Network Research"
      },
      "articleBody": ipData.steps.join(' ')
    },
    {
      "@type": "FAQPage",
      "mainEntity": ipData.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ];
} else if (type === 'brand') {
  const brandData = data as Brand;
  pageTitle = `${brandData.name} Router Default Passwords & Admin Login Guide | 19216811.page`;
  pageDescription = `Default router passwords, factory usernames, and admin dashboard login IP (${brandData.defaultIp}) for ${brandData.name} wireless routers, modems, and mesh systems.`;
  keywords = [
    brandData.name,
    `${brandData.name} router login`,
    `${brandData.name} default password`,
    `${brandData.name} admin login`,
    `${brandData.name} default ip`,
    `${brandData.name} wifi setup`,
    "router passwords directory"
  ];

  schemas = [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteUrl}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Router Brands",
          "item": `${siteUrl}/brands`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": `${brandData.name} Routers`,
          "item": currentCanonical
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": `How to Configure ${brandData.name} Wireless Router`,
      "description": `Step-by-step setup and admin password guide for ${brandData.name} hardware.`,
      "step": brandData.guide.map((step, idx) => ({
        "@type": "HowToStep",
        "position": idx + 1,
        "name": `Step ${idx + 1}`,
        "text": step,
        "url": `${currentCanonical}#step-${idx + 1}`
      }))
    },
    {
      "@type": "TechArticle",
      "headline": pageTitle,
      "description": pageDescription,
      "url": currentCanonical,
      "author": {
        "@type": "Organization",
        "name": "19216811.page Network Research"
      },
      "articleBody": brandData.description
    }
  ];
} else if (type === 'isp') {
  const ispData = data as Isp;
  pageTitle = `${ispData.name} Router Admin Login, Default Password & FTTH Setup | 19216811.page`;
  pageDescription = `Complete setup guide for ${ispData.name} optical fiber home gateways. Default login credentials, IP address (${ispData.defaultIp}), optical power troubleshooting, and Wi-Fi security.`;
  keywords = [
    ispData.name,
    `${ispData.name} router login`,
    `${ispData.name} default password`,
    `${ispData.name} admin ip`,
    `${ispData.name} fiber setup`,
    `${ispData.name} ont settings`,
    "isp router configuration"
  ];

  schemas = [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteUrl}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": `${ispData.name} Guide`,
          "item": currentCanonical
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": `How to Set Up ${ispData.name} Fiber Home Gateway`,
      "description": `Step-by-step instructions for ${ispData.name} broadband routers.`,
      "step": ispData.instructions.map((step, idx) => ({
        "@type": "HowToStep",
        "position": idx + 1,
        "name": `Step ${idx + 1}`,
        "text": step,
        "url": `${currentCanonical}#step-${idx + 1}`
      }))
    },
    {
      "@type": "TechArticle",
      "headline": pageTitle,
      "description": pageDescription,
      "url": currentCanonical,
      "author": {
        "@type": "Organization",
        "name": "19216811.page Network Research"
      },
      "articleBody": ispData.description
    }
  ];
} else if (type === 'model') {
  const modelData = data as RouterModel;
  pageTitle = `${modelData.brand} ${modelData.model} Default Password, Admin Login & Specs | 19216811.page`;
  pageDescription = `Factory default login credentials, IP address (${modelData.ip}), Wi-Fi specs, port configuration, and setup guide for ${modelData.brand} ${modelData.model} (${modelData.category}).`;
  keywords = [
    modelData.model,
    `${modelData.brand} ${modelData.model}`,
    `${modelData.brand} ${modelData.model} login`,
    `${modelData.brand} ${modelData.model} default password`,
    `${modelData.brand} ${modelData.model} specs`,
    `${modelData.ip} admin`,
    modelData.category,
    modelData.series || '',
    "router hardware database"
  ];

  schemas = [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteUrl}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Router Models",
          "item": `${siteUrl}/routers`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": `${modelData.brand} ${modelData.model}`,
          "item": currentCanonical
        }
      ]
    },
    {
      "@type": "Product",
      "name": `${modelData.brand} ${modelData.model}`,
      "description": modelData.useCase,
      "brand": {
        "@type": "Brand",
        "name": modelData.brand
      },
      "category": modelData.category
    },
    {
      "@type": "HowTo",
      "name": `How to Login and Setup ${modelData.brand} ${modelData.model}`,
      "description": `Step-by-step instructions to configure ${modelData.brand} ${modelData.model} router.`,
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Connect Network Cable or Wi-Fi",
          "text": `Connect your PC or mobile phone to the ${modelData.brand} ${modelData.model} via Ethernet cable or default wireless network.`,
          "url": `${currentCanonical}#step-1`
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": `Open http://${modelData.ip}`,
          "text": `Open your internet browser and type http://${modelData.ip} in the address bar.`,
          "url": `${currentCanonical}#step-2`
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Enter Default Credentials",
          "text": `Enter username "${modelData.username}" and password "${modelData.password}" to access the management dashboard.`,
          "url": `${currentCanonical}#step-3`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": `What is the default IP address for ${modelData.brand} ${modelData.model}?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `The factory default IP address for ${modelData.brand} ${modelData.model} is http://${modelData.ip}.`
          }
        },
        {
          "@type": "Question",
          "name": `What is the default username and password for ${modelData.brand} ${modelData.model}?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `The default username is "${modelData.username}" and the default password is "${modelData.password}".`
          }
        },
        {
          "@type": "Question",
          "name": `How do I factory reset the ${modelData.brand} ${modelData.model}?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `Locate the small Reset pinhole on the back panel of the ${modelData.brand} ${modelData.model}. Press and hold it with a paperclip for 10-15 seconds while powered on until the LED lights cycle.`
          }
        }
      ]
    }
  ];
}
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}
  keywords={keywords}
  canonical={currentCanonical}
  schema={schemas}
>
  <div class="space-y-6">

    <!-- Top Ad Banner -->
    <AdBanner slot="top-banner" format="horizontal" />

    {/* ========================================================= */}
    {/* VIEW 1: GATEWAY IP PAGE */}
    {/* ========================================================= */}
    {type === 'ip' && (() => {
      const ipData = data as GatewayIp;
      const associatedModels = getModelsForIp(ipData.ip);
      const otherIps = GATEWAY_IPS.filter(i => i.ip !== ipData.ip);

      return (
        <article class="space-y-6">
          <RouterGuideCard ipData={ipData} />

          {associatedModels.length > 0 && (
            <section class="bg-white dark:bg-slate-900 rounded-2xl p-4 sm:p-6 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-4">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 pb-3">
                <div>
                  <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
                    Routers Using {ipData.ip} as Default Gateway
                  </h2>
                  <p class="text-xs text-slate-700 dark:text-slate-400">
                    Hardware models configured to {ipData.ip} out of the box
                  </p>
                </div>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-brand-50 dark:bg-brand-900/30 text-brand-700 dark:text-brand-300 border border-brand-200 dark:border-brand-800 w-fit">
                  {associatedModels.length} Models
                </span>
              </div>
              <PasswordTable models={associatedModels} />
            </section>
          )}

          <section class="bg-white dark:bg-slate-900 rounded-2xl p-4 sm:p-5 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-3">
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
              Other Common Gateway IP Addresses
            </h2>
            <div class="flex flex-wrap gap-2">
              {otherIps.map(item => (
                <a 
                  href={`${base}/${item.slug}`}
                  class="px-3 py-1.5 rounded-xl bg-slate-50 dark:bg-slate-800 hover:bg-brand-50 dark:hover:bg-slate-750 border border-slate-200/80 dark:border-slate-700 text-xs font-bold text-slate-800 dark:text-slate-200 hover:text-brand-800 dark:hover:text-brand-400 transition-colors"
                >
                  {item.ip}
                </a>
              ))}
            </div>
          </section>
        </article>
      );
    })()}

    {/* ========================================================= */}
    {/* VIEW 2: BRAND PAGE */}
    {/* ========================================================= */}
    {type === 'brand' && (() => {
      const brandData = data as Brand;
      const brandModels = getModelsForBrand(brandData.slug);
      const brandIpSlug = getIpSlug(brandData.defaultIp);
      const otherBrands = BRANDS.filter(b => b.slug !== brandData.slug);

      return (
        <article class="space-y-6">
          <header class="bg-white dark:bg-slate-900 rounded-2xl p-5 sm:p-7 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-4">
            <nav class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
              <a href={`${base}/`} class="hover:text-brand-800 dark:hover:text-brand-400 transition-colors">Home</a>
              <span>/</span>
              <a href={`${base}/brands`} class="hover:text-brand-800 dark:hover:text-brand-400 transition-colors">Brands</a>
              <span>/</span>
              <span class="text-slate-900 dark:text-slate-200 font-semibold">{brandData.name}</span>
            </nav>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-4">
              <div>
                <h1 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
                  {brandData.name} Router Login & Default Passwords
                </h1>
                <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 mt-1">
                  {brandData.description}
                </p>
              </div>
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-brand-50 dark:bg-brand-900/30 text-brand-700 dark:text-brand-300 border border-brand-200 dark:border-brand-800">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
                  Verified Database
                </span>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div class="bg-slate-50 dark:bg-slate-800/80 rounded-xl p-3 border border-slate-200/80 dark:border-slate-700/80 flex items-center gap-3">
                <span class="text-xl">🌐</span>
                <div>
                  <div class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400 tracking-wider">Default IP</div>
                  <div class="text-xs font-mono font-bold text-slate-900 dark:text-white mt-0.5">
                    {brandIpSlug ? (
                      <a href={`${base}/${brandIpSlug}`} class="text-brand-800 dark:text-brand-400 hover:underline">
                        {brandData.defaultIp}
                      </a>
                    ) : (
                      brandData.defaultIp
                    )}
                  </div>
                </div>
              </div>

              <div class="bg-slate-50 dark:bg-slate-800/80 rounded-xl p-3 border border-slate-200/80 dark:border-slate-700/80 flex items-center gap-3">
                <span class="text-xl">👤</span>
                <div>
                  <div class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400 tracking-wider">Default User</div>
                  <div class="text-xs font-mono font-bold text-slate-900 dark:text-white mt-0.5">
                    {brandData.defaultUser || '(blank)'}
                  </div>
                </div>
              </div>

              <div class="bg-slate-50 dark:bg-slate-800/80 rounded-xl p-3 border border-slate-200/80 dark:border-slate-700/80 flex items-center gap-3">
                <span class="text-xl">🔑</span>
                <div>
                  <div class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400 tracking-wider">Default Pass</div>
                  <div class="text-xs font-mono font-bold text-slate-900 dark:text-white mt-0.5">
                    {brandData.defaultPass || '(blank)'}
                  </div>
                </div>
              </div>
            </div>
          </header>

          <section class="bg-white dark:bg-slate-900 rounded-2xl p-4 sm:p-6 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 pb-3">
              <div>
                <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
                  {brandData.name} Hardware Models & Default Passwords
                </h2>
                <p class="text-xs text-slate-700 dark:text-slate-400">
                  Comprehensive login credentials and specifications for {brandData.name} devices
                </p>
              </div>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 w-fit">
                {brandModels.length || brandData.models.length} Models
              </span>
            </div>

            <PasswordTable models={brandModels.length ? brandModels : brandData.models} />
          </section>

          <section class="bg-white dark:bg-slate-900 rounded-2xl p-4 sm:p-6 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-4">
            <div class="flex items-center gap-2">
              <span class="text-base">📋</span>
              <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
                How to Log In & Configure Your {brandData.name} Router
              </h2>
            </div>
            <ol class="space-y-3">
              {brandData.guide.map((step, idx) => (
                <li class="flex items-start gap-3 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
                  <span class="flex-shrink-0 w-6 h-6 rounded-full bg-brand-50 dark:bg-brand-900/40 text-brand-700 dark:text-brand-300 font-bold flex items-center justify-center text-xs border border-brand-200 dark:border-brand-800">
                    {idx + 1}
                  </span>
                  <span class="pt-0.5 leading-relaxed">{step}</span>
                </li>
              ))}
            </ol>
          </section>

          <section class="bg-white dark:bg-slate-900 rounded-2xl p-4 sm:p-5 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-3">
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
              Other Popular Router Brands
            </h2>
            <div class="flex flex-wrap gap-1.5">
              {otherBrands.map(b => (
                <a 
                  href={`${base}/${b.slug}`}
                  class="px-2.5 py-1 rounded-lg bg-slate-50 dark:bg-slate-800 hover:bg-brand-50 dark:hover:bg-slate-750 border border-slate-200/80 dark:border-slate-700 text-xs font-semibold text-slate-800 dark:text-slate-200 hover:text-brand-800 dark:hover:text-brand-400 transition-colors"
                >
                  {b.name}
                </a>
              ))}
            </div>
          </section>
        </article>
      );
    })()}

    {/* ========================================================= */}
    {/* VIEW 3: MODEL DEDICATED SPECIFICATION PAGE */}
    {/* ========================================================= */}
    {type === 'model' && (() => {
      const model = data as RouterModel;
      const brandSlug = model.brandSlug || getBrandSlug(model.brand);
      const ipSlug = getIpSlug(model.ip);
      const siblingModels = ROUTER_MODELS.filter(m => m.brandSlug === model.brandSlug && m.slug !== model.slug).slice(0, 6);

      return (
        <article class="space-y-6">
          {/* Hardware Header Card */}
          <header class="bg-white dark:bg-slate-900 rounded-2xl p-5 sm:p-7 border border-slate-200/90 dark:border-slate-800 shadow-card space-y-4">
            <nav class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400 flex-wrap">
              <a href={`${base}/`} class="hover:text-brand-800 dark:hover:text-brand-400 transition-colors">Home</a>
              <span>/</span>
              <a href={`${base}/routers`} class="hover:text-brand-800 dark:hover:text-brand-400 transition-colors">Routers</a>
              <span>/</span>
              {brandSlug ? (
                <a href={`${base}/${brandSlug}`} class="hover:text-brand-800 dark:hover:text-brand-400 transition-colors">{model.brand}</a>
              ) : (
                <span>{model.brand}</span>
              )}
              <span>/</span>
              <span class="text-slate-900 dark:text-slate-200 font-semibold">{model.model}</span>
            </nav>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-4">
              <div>
                <div class="flex items-center gap-2 flex-wrap mb-2">
                  <span class="px-2.5 py-0.5 rounded-md text-[11px] font-bold bg-brand-50 dark:bg-brand-900/40 text-brand-700 dark:text-brand-300 border border-brand-200 dark:border-brand-800">
                    {model.category}
                  </span>
                  {model.wifiStandard && (
                    <span class="px-2.5 py-0.5 rounded-md text-[11px] font-bold bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800">
                      {model.wifiStandard}
                    </span>
                  )}
                  {model.speedRating && (
                    <span class="px-2.5 py-0.5 rounded-md text-[11px] font-bold bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
                      {model.speedRating}
                    </span>
                  )}
                </div>
                <h1 class="text-xl sm:text-2xl lg:text-3xl font-bold text-slate-900 dark:text-white">
                  {model.brand} {model.model}
                </h1>
                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-1">
                  {model.useCase}
                </p>
              </div>

              <div class="flex sm:flex-col items-end gap-2 flex-shrink-0">
                <a 
                  href={`http://${model.ip}`} 
                  target="_blank" 
                  rel="noopener noreferrer"
