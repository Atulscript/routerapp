---
import BaseLayout from '../layouts/BaseLayout.astro';
import PasswordTable from '../components/PasswordTable.astro';
import AdBanner from '../components/AdBanner.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';
import RouterChecker from '../components/RouterChecker.astro';
import LoginStepper from '../components/LoginStepper.astro';
import BrandLogo from '../components/BrandLogo.astro';
import ModelImage from '../components/ModelImage.astro';
import { getAllSlugs, getBrandSlug, getIpSlug, getModelSlug, getModelsForIp, getModelsForBrand, getBrandsByPopularity, brandKey, formatModelTitle, GATEWAY_IPS, BRANDS, ISPS, ROUTER_MODELS } from '../lib/data-loader';
import type { GatewayIp, Brand, Isp, RouterModel } from '../lib/types';

export async function getStaticPaths() {
  return await getAllSlugs();
}

type Props = 
  | { type: 'ip'; data: GatewayIp }
  | { type: 'brand'; data: Brand }
  | { type: 'isp'; data: Isp }
  | { type: 'model'; data: RouterModel };

const { type, data } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Dynamic title, description, keywords, and schemas based on page type
let pageTitle = "";
let pageDescription = "";
let keywords: string[] = [];
let schemas: Record<string, any>[] = [];
const siteUrl = "https://atulscript.github.io/routerapp";
const currentCanonical = `${siteUrl}/${data.slug}`;

if (type === 'ip') {
  const ipData = data as GatewayIp;
  pageTitle = `${ipData.ip} Router Admin Login, Passwords & Setup Guide | RouterSync.com`;
  pageDescription = `Access router admin dashboard at ${ipData.ip}. Default login usernames, factory passwords, WiFi security configuration, and troubleshooting for ${ipData.commonBrands.slice(0, 4).join(', ')}.`;
  keywords = [
    ipData.ip,
    `${ipData.ip} login`,
    `${ipData.ip} admin`,
    `${ipData.ip} default password`,
    `${ipData.ip} router setup`,
    "default gateway ip",
    "router admin dashboard",
    ...ipData.commonBrands.map(b => `${b} router login`)
  ];

  schemas = [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteUrl}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Gateway IP Addresses",
          "item": `${siteUrl}/ip-addresses`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": `${ipData.ip} Setup Guide`,
          "item": currentCanonical
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": `How to Login to Router Gateway at ${ipData.ip}`,
      "description": `Step-by-step instructions to connect and log into your router dashboard at ${ipData.ip}.`,
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Connect Network Cable or Wi-Fi",
          "text": "Connect your computer or phone to the router via Ethernet or Wi-Fi.",
          "url": `${currentCanonical}#step-1`
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": `Navigate to http://${ipData.ip}`,
          "text": `Open your browser address bar, type http://${ipData.ip} and press Enter.`,
          "url": `${currentCanonical}#step-2`
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Enter Credentials",
          "text": `Enter default username (${ipData.defaultUser}) and password (${ipData.defaultPass}) to access admin settings.`,
          "url": `${currentCanonical}#step-3`
        }
      ]
    },
    {
      "@type": "TechArticle",
      "headline": pageTitle,
      "description": pageDescription,
      "url": currentCanonical,
      "author": {
        "@type": "Organization",
        "name": "RouterSync Network Research"
      },
      "articleBody": ipData.steps.join(' ')
    },
    {
      "@type": "FAQPage",
      "mainEntity": ipData.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ];
} else if (type === 'brand') {
  const brandData = data as Brand;
  pageTitle = `${brandData.name} Router Default Passwords & Admin Login Guide | RouterSync.com`;
  pageDescription = `Default router passwords, factory usernames, and admin dashboard login IP (${brandData.defaultIp}) for ${brandData.name} wireless routers, modems, and mesh systems.`;
  keywords = [
    brandData.name,
    `${brandData.name} router login`,
    `${brandData.name} default password`,
    `${brandData.name} admin login`,
    `${brandData.name} default ip`,
    `${brandData.name} wifi setup`,
    "router passwords directory"
  ];

  schemas = [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteUrl}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Router Brands",
          "item": `${siteUrl}/brands`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": `${brandData.name} Routers`,
          "item": currentCanonical
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": `How to Configure ${brandData.name} Wireless Router`,
      "description": `Step-by-step setup and admin password guide for ${brandData.name} hardware.`,
      "step": (brandData.guide || (brandData as any).instructions || []).map((step: string, idx: number) => ({
        "@type": "HowToStep",
        "position": idx + 1,
        "name": `Step ${idx + 1}`,
        "text": step,
        "url": `${currentCanonical}#step-${idx + 1}`
      }))
    },
    {
      "@type": "TechArticle",
      "headline": pageTitle,
      "description": pageDescription,
      "url": currentCanonical,
      "author": {
        "@type": "Organization",
        "name": "RouterSync Network Research"
      },
      "articleBody": brandData.description
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": `What is the default IP address for ${brandData.name} routers?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `Most ${brandData.name} routers use ${brandData.defaultIp} as their factory default gateway management address.`
          }
        },
        {
          "@type": "Question",
          "name": `What is the factory default login password for ${brandData.name}?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `The standard factory username is "${brandData.defaultUser}" and default password is "${brandData.defaultPass}". Check your physical router label if these don't work.`
          }
        },
        {
          "@type": "Question",
          "name": `How do I factory reset my ${brandData.name} router if I forgot the password?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `Press and hold the physical RESET pinhole button on the back of your ${brandData.name} device with a paperclip for 10-15 seconds until all LED lights blink, restoring default credentials.`
          }
        }
      ]
    }
  ];
} else if (type === 'isp') {
  const ispData = data as Isp;
  pageTitle = `${ispData.name} Router Admin Login, Default Password & FTTH Setup | RouterSync.com`;
  pageDescription = `Complete setup guide for ${ispData.name} optical fiber home gateways. Default login credentials, IP address (${ispData.defaultIp}), optical power troubleshooting, and Wi-Fi security.`;
  keywords = [
    ispData.name,
    `${ispData.name} router login`,
    `${ispData.name} default password`,
    `${ispData.name} admin ip`,
    `${ispData.name} fiber setup`,
    `${ispData.name} ont settings`,
    "isp router configuration"
  ];

  schemas = [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteUrl}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": `${ispData.name} Guide`,
          "item": currentCanonical
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": `How to Set Up ${ispData.name} Fiber Home Gateway`,
      "description": `Step-by-step instructions for ${ispData.name} broadband routers.`,
      "step": ispData.instructions.map((step, idx) => ({
        "@type": "HowToStep",
        "position": idx + 1,
        "name": `Step ${idx + 1}`,
        "text": step,
        "url": `${currentCanonical}#step-${idx + 1}`
      }))
    },
    {
      "@type": "TechArticle",
      "headline": pageTitle,
      "description": pageDescription,
      "url": currentCanonical,
      "author": {
        "@type": "Organization",
        "name": "RouterSync Network Research"
      },
      "articleBody": ispData.description
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": `How do I log in to my ${ispData.name} fiber router admin portal?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `Connect to your ${ispData.name} Wi-Fi network, navigate to http://${ispData.defaultIp} in your browser, and enter username "${ispData.defaultUser}" and password "${ispData.defaultPass}".`
          }
        },
        {
          "@type": "Question",
          "name": `What should I do if the LOS light on my ${ispData.name} router is blinking red?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `A blinking red LOS (Loss of Signal) light indicates an optical fiber cable disconnection or an ISP outage. Verify the thin yellow fiber cable is firmly seated, and contact ${ispData.name} support if the issue persists.`
          }
        },
        {
          "@type": "Question",
          "name": `How can I change my ${ispData.name} Wi-Fi password and network name?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `Log in to http://${ispData.defaultIp}, go to Network/WLAN -> 2.4G/5G Settings, update the SSID and WPA Pre-Shared Key, then click Apply.`
          }
        }
      ]
    }
  ];
} else if (type === 'model') {
  const modelData = data as RouterModel;
  pageTitle = `${modelData.brand} ${modelData.model} Default Password, Admin Login & Specs | RouterSync.com`;
  pageDescription = `Factory default login credentials, IP address (${modelData.ip}), Wi-Fi specs, port configuration, and setup guide for ${modelData.brand} ${modelData.model} (${modelData.category}).`;
  keywords = [
    modelData.model,
    `${modelData.brand} ${modelData.model}`,
    `${modelData.brand} ${modelData.model} login`,
    `${modelData.brand} ${modelData.model} default password`,
    `${modelData.brand} ${modelData.model} specs`,
    `${modelData.ip} admin`,
    modelData.category,
    modelData.series || '',
    "router hardware database"
  ];

  schemas = [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteUrl}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Router Models",
          "item": `${siteUrl}/routers`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": `${modelData.brand} ${modelData.model}`,
          "item": currentCanonical
        }
      ]
    },
    {
      "@type": "Product",
      "name": `${modelData.brand} ${modelData.model}`,
      "description": modelData.useCase,
      "brand": {
        "@type": "Brand",
        "name": modelData.brand
      },
      "category": modelData.category
    },
    {
      "@type": "HowTo",
      "name": `How to Login and Setup ${modelData.brand} ${modelData.model}`,
      "description": `Step-by-step instructions to configure ${modelData.brand} ${modelData.model} router.`,
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Connect Network Cable or Wi-Fi",
          "text": `Connect your PC or mobile phone to the ${modelData.brand} ${modelData.model} via Ethernet cable or default wireless network.`,
          "url": `${currentCanonical}#step-1`
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": `Open http://${modelData.ip}`,
          "text": `Open your internet browser and type http://${modelData.ip} in the address bar.`,
          "url": `${currentCanonical}#step-2`
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Enter Default Credentials",
          "text": `Enter username "${modelData.username}" and password "${modelData.password}" to access the management dashboard.`,
          "url": `${currentCanonical}#step-3`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": `What is the default IP address for ${modelData.brand} ${modelData.model}?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `The factory default IP address for ${modelData.brand} ${modelData.model} is http://${modelData.ip}.`
          }
        },
        {
          "@type": "Question",
          "name": `What is the default username and password for ${modelData.brand} ${modelData.model}?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `The default username is "${modelData.username}" and the default password is "${modelData.password}".`
          }
        },
        {
          "@type": "Question",
          "name": `How do I factory reset the ${modelData.brand} ${modelData.model}?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `Locate the small Reset pinhole on the back panel of the ${modelData.brand} ${modelData.model}. Press and hold it with a paperclip for 10-15 seconds while powered on until the LED lights cycle.`
          }
        }
      ]
    }
  ];
}
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}
  keywords={keywords}
  canonical={currentCanonical}
  schema={schemas}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6">

    {/* ========================================================= */}
    {/* VIEW 1: GATEWAY IP PAGE */}
    {/* ========================================================= */}
    {type === 'ip' && (() => {
      const ipData = data as GatewayIp;
      const associatedModels = getModelsForIp(ipData.ip);
      const otherIps = GATEWAY_IPS.filter(i => i.ip !== ipData.ip);

      return (
        <article class="space-y-6">
          {/* Breadcrumb */}
          <nav class="flex items-center gap-1.5 text-xs text-ink-muted" aria-label="Breadcrumb">
            <a href={`${base}/`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">Home</a>
            <span>/</span>
            <a href={`${base}/ip-addresses`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">IP Gateways</a>
            <span>/</span>
            <span class="text-ink font-medium">{ipData.ip}</span>
          </nav>

          {/* Hero Header Card (Google OneBox Style) */}
          <header class="g-card p-5 sm:p-7 space-y-5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-line-subtle pb-4">
              <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-accent-soft text-accent border border-[#d2e3fc] dark:border-[#1a73e8] mb-2">
                  <span class="w-2 h-2 rounded-full bg-[#34a853] animate-pulse"></span>
                  Default Gateway IP
                </div>
                <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-ink tracking-tight">
                  {ipData.ip} Router Admin Login
                </h1>
                <p class="text-sm sm:text-base text-ink-muted mt-1.5 max-w-2xl leading-relaxed">
                  {ipData.description}
                </p>
              </div>

              <div class="flex-shrink-0">
                <a 
                  href={`http://${ipData.ip}`} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="g-btn-primary"
                >
                  <span>Open {`http://${ipData.ip}`}</span>
                  <span class="text-xs">↗</span>
                </a>
              </div>
            </div>

            {/* Quick Metrics */}
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div class="bg-surface-sunken rounded-2xl p-3.5 border border-line-subtle flex items-center justify-between gap-3">
                <div class="min-w-0">
                  <div class="text-xs uppercase font-bold text-ink-muted tracking-wider">Gateway IP</div>
                  <div class="text-sm font-mono font-bold text-ink mt-0.5 break-words">{ipData.ip}</div>
                </div>
                <button 
                  type="button" 
                  class="copy-btn g-copy-btn"
                  data-copy={ipData.ip}
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg><span>Copy</span>
                </button>
              </div>

              <div class="bg-surface-sunken rounded-2xl p-3.5 border border-line-subtle flex items-center justify-between gap-3">
                <div class="min-w-0">
                  <div class="text-xs uppercase font-bold text-ink-muted tracking-wider">Default Username</div>
                  <div class="text-sm font-mono font-bold text-ink mt-0.5 break-words">{ipData.defaultUser || '(blank)'}</div>
                </div>
                <button 
                  type="button" 
                  class="copy-btn g-copy-btn"
                  data-copy={ipData.defaultUser}
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg><span>Copy</span>
                </button>
              </div>

              <div class="bg-surface-sunken rounded-2xl p-3.5 border border-line-subtle flex items-center justify-between gap-3">
                <div class="min-w-0">
                  <div class="text-xs uppercase font-bold text-ink-muted tracking-wider">Default Password</div>
                  <div class="text-sm font-mono font-bold text-ink mt-0.5 break-words">{ipData.defaultPass || '(blank)'}</div>
                </div>
                <button 
                  type="button" 
                  class="copy-btn g-copy-btn"
                  data-copy={ipData.defaultPass}
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg><span>Copy</span>
                </button>
              </div>
            </div>
          </header>

          <AdBanner format="horizontal" />

          {/* Which brands use this address */}
          {ipData.commonBrands.length > 0 && (
            <section class="g-card p-4 sm:p-5 space-y-3">
              <h2 class="text-sm font-bold text-ink">
                Brands that use {ipData.ip}
              </h2>
              <div class="flex flex-wrap gap-2">
                {ipData.commonBrands.map(brandName => {
                  const slug = getBrandSlug(brandName);
                  return slug ? (
                    <a href={`${base}/${slug}`} class="g-chip inline-flex items-center gap-1.5">
                      <BrandLogo slug={slug} name={brandName} size="xs" />
                      {brandName}
                    </a>
                  ) : (
                    <span class="g-chip cursor-default">{brandName}</span>
                  );
                })}
              </div>
            </section>
          )}

          {/* Guide and live check sit side by side on wide screens */}
          <div class="grid grid-cols-1 xl:grid-cols-5 gap-6 items-start">
            <LoginStepper ip={ipData.ip} user={ipData.defaultUser} pass={ipData.defaultPass} brandName={ipData.commonBrands[0]} class="xl:col-span-3" />
            <RouterChecker focusIp={ipData.ip} limit={8} class="xl:col-span-2" />
          </div>

          {/* Associated Router Models */}
          {associatedModels.length > 0 && (
            <section class="g-card p-5 sm:p-6 space-y-4">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-line-subtle pb-3">
                <div>
                  <h2 class="text-base sm:text-lg font-bold text-ink flex items-center gap-2">
                    <span>📡</span>
                    Hardware Routers Using {ipData.ip} Gateway
                  </h2>
                  <p class="text-sm text-ink-muted">
                    Verified factory default credentials and model specifications
                  </p>
                </div>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-accent-soft text-accent border border-[#d2e3fc] dark:border-[#1a73e8] w-fit">
                  {associatedModels.length} Models
                </span>
              </div>
              <PasswordTable models={associatedModels} />
            </section>
          )}

          <!-- Mid Ad Slot -->
          <AdBanner format="horizontal" />

          {/* Other Gateway IP Addresses Grid */}
          <section class="g-card p-4 sm:p-5 space-y-3">
            <h2 class="text-xs font-bold uppercase tracking-wider text-ink-muted">
              Other Popular Router Gateway IP Addresses
            </h2>
            <div class="flex flex-wrap gap-2">
              {otherIps.map(item => (
                <a 
                  href={`${base}/${item.slug}`}
                  class="g-chip font-mono text-[11px]"
                >
                  {item.ip}
                </a>
              ))}
            </div>
          </section>
        </article>
      );
    })()}

    {/* ========================================================= */}
    {/* VIEW 2: BRAND HUB PAGE */}
    {/* ========================================================= */}
    {type === 'brand' && (() => {
      const brandData = data as Brand;
      const brandModels = getModelsForBrand(brandData.slug);
      const finalModels = brandModels.length > 0 ? brandModels : brandData.models;
      const brandIpSlug = getIpSlug(brandData.defaultIp);
      // defaultIp can list several addresses ("192.168.1.1 / tplinkwifi.net"); the button opens the first.
      const brandPrimaryIp = brandData.defaultIp.split('/')[0].trim();
      // 12 suggestions: up to 4 brands sharing this brand's gateway IP, then the brands with the most models.
      const firstIp = (ip: string) => ip.split('/')[0].trim();
      const byModels = getBrandsByPopularity();
      const sameIp = byModels.filter(b => firstIp(b.defaultIp) === firstIp(brandData.defaultIp)).slice(0, 5);
      const seen = new Set([brandKey(brandData.name)]);
      const otherBrands = [...sameIp, ...byModels]
        .filter(b => !seen.has(brandKey(b.name)) && seen.add(brandKey(b.name)))
        .slice(0, 12);

      return (
        <article class="space-y-6">
          {/* Breadcrumbs */}
          <nav class="flex items-center gap-1.5 text-xs text-ink-muted" aria-label="Breadcrumb">
            <a href={`${base}/`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">Home</a>
            <span>/</span>
            <a href={`${base}/brands`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">Brands</a>
            <span>/</span>
            <span class="text-ink font-medium">{brandData.name}</span>
          </nav>

          {/* Hero Header Card */}
          <header class="g-card p-5 sm:p-7 space-y-5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-line-subtle pb-4">
              <div class="flex flex-col sm:flex-row sm:items-center gap-4">
                <BrandLogo slug={brandData.slug} name={brandData.name} size="lg" />
                <div>
                  <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-[11px] font-bold bg-[#e6f4ea] dark:bg-[#133e24] text-[#34a853] dark:text-[#81c995] border border-[#ceead6] dark:border-[#34a853] mb-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#34a853]"></span>
                    Verified Manufacturer Hub
                  </div>
                  <h1 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight">
