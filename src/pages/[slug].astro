---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import PasswordTable from '../components/PasswordTable.astro';
import AdBanner from '../components/AdBanner.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';
import { getAllSlugs } from '../lib/data-loader';
import type { GatewayIp, Brand, Isp } from '../lib/types';

export async function getStaticPaths() {
  return await getAllSlugs();
}

type Props = 
  | { type: 'ip'; data: GatewayIp }
  | { type: 'brand'; data: Brand }
  | { type: 'isp'; data: Isp };

const { type, data } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Dynamic title and description based on page type
let pageTitle = "";
let pageDescription = "";
let schema: Record<string, any> = {};

if (type === 'ip') {
  const ipData = data as GatewayIp;
  pageTitle = `${ipData.ip} Router Login, Admin Password & Setup Guide | 19216811.page`;
  pageDescription = ipData.description;
  schema = {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "headline": pageTitle,
    "description": pageDescription,
    "articleBody": ipData.steps.join(' ')
  };
} else if (type === 'brand') {
  const brandData = data as Brand;
  pageTitle = `${brandData.name} Router Default Passwords & Login Guide | 19216811.page`;
  pageDescription = brandData.description;
  schema = {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "headline": pageTitle,
    "description": pageDescription
  };
} else if (type === 'isp') {
  const ispData = data as Isp;
  pageTitle = `${ispData.name} Router Admin Login (${ispData.defaultIp}) & Setup | 19216811.page`;
  pageDescription = ispData.description;
  schema = {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "headline": pageTitle,
    "description": pageDescription
  };
}
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    
    <!-- Contextual Search -->
    <div class="mb-8">
      <SearchBar />
    </div>

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 font-medium">
      <a href={`${base}/`} class="hover:text-md-primary transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-900 font-semibold">{pageTitle.split('|')[0]}</span>
    </nav>

    <AdBanner format="leaderboard" />

    <!-- IP View -->
    {type === 'ip' && (() => {
      const ip = data as GatewayIp;
      return (
        <article class="space-y-10">
          <header class="border-b border-slate-200 pb-8">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-50 text-sky-700 text-xs font-bold font-mono uppercase mb-4 border border-sky-200">
              <span class="w-2 h-2 rounded-full bg-sky-500"></span>
              Gateway IP: {ip.ip}
            </div>
            <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
              {ip.title}
            </h1>
            <p class="text-base text-slate-600 leading-relaxed">
              {ip.description}
            </p>
          </header>

          <!-- Quick Action Card -->
          <div class="bg-gradient-to-br from-md-primary to-[#004b80] rounded-3xl p-6 sm:p-8 text-white shadow-xl shadow-sky-500/10">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
              <div>
                <span class="text-xs uppercase font-bold tracking-wider text-sky-200">Direct Gateway Access</span>
                <div class="text-2xl sm:text-3xl font-mono font-bold mt-1">http://{ip.ip}</div>
                <div class="mt-3 flex flex-wrap gap-4 text-xs font-mono">
                  <div class="bg-white/10 px-3 py-1.5 rounded-lg backdrop-blur-sm">
                    Default User: <strong class="text-white">{ip.defaultUser}</strong>
                  </div>
                  <div class="bg-white/10 px-3 py-1.5 rounded-lg backdrop-blur-sm">
                    Default Pass: <strong class="text-white">{ip.defaultPass}</strong>
                  </div>
                </div>
              </div>
              <a 
                href={`http://${ip.ip}`} 
                target="_blank" 
                rel="noopener noreferrer"
                class="px-6 py-3.5 rounded-xl bg-white text-md-primary font-bold text-sm shadow-lg hover:bg-sky-50 transition-all hover:scale-105 active:scale-95 whitespace-nowrap"
              >
                Open {ip.ip} Portal ↗
              </a>
            </div>
          </div>

          <!-- Step by step instructions -->
          <section class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
            <h2 class="text-xl font-bold text-slate-900 mb-6 flex items-center gap-2">
              <span>📋</span> How to Login to {ip.ip} (Step-by-Step)
            </h2>
            <ol class="space-y-4">
              {ip.steps.map((step, idx) => (
                <li class="flex items-start gap-4">
                  <span class="flex-shrink-0 w-7 h-7 rounded-full bg-sky-100 text-md-primary font-bold text-xs flex items-center justify-center font-mono">
                    {idx + 1}
                  </span>
                  <span class="text-sm text-slate-700 leading-relaxed pt-0.5">
                    {step}
                  </span>
                </li>
              ))}
            </ol>
          </section>

          <AdBanner format="horizontal" />

          <!-- Common Brands for this IP -->
          <section class="bg-slate-100/70 rounded-3xl p-6 sm:p-8 border border-slate-200">
            <h2 class="text-lg font-bold text-slate-900 mb-4">Routers that commonly use {ip.ip}</h2>
            <div class="flex flex-wrap gap-2">
              {ip.commonBrands.map(brand => (
                <span class="px-3 py-1.5 rounded-xl bg-white border border-slate-200 text-xs font-semibold text-slate-800 shadow-sm">
                  {brand}
                </span>
              ))}
            </div>
          </section>

          <!-- Human Guide: Troubleshooting {ip.ip} -->
          <section class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-6">
            <h2 class="text-xl font-bold text-slate-900">
              Why Can't I Connect to {ip.ip}? (Top 4 Quick Fixes)
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 space-y-1.5">
                <strong class="text-slate-900 block font-bold text-sm">1. Check Your Physical Connection</strong>
                <p class="text-slate-600 leading-relaxed">
                  Make sure your phone or laptop is actively connected to your router's Wi-Fi network or plugged directly into a LAN port with an Ethernet cable. If you are on cellular data (4G/5G), turn off mobile data first.
                </p>
              </div>

              <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 space-y-1.5">
                <strong class="text-slate-900 block font-bold text-sm">2. Disable Active VPNs & Proxies</strong>
                <p class="text-slate-600 leading-relaxed">
                  Active VPN tunnels reroute your network traffic to a remote server, making local private IP addresses like <code class="font-mono bg-white px-1 py-0.5 rounded">{ip.ip}</code> unreachable. Temporarily disconnect your VPN.
                </p>
              </div>

              <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 space-y-1.5">
                <strong class="text-slate-900 block font-bold text-sm">3. Avoid Typo Mistakes</strong>
                <p class="text-slate-600 leading-relaxed">
                  Double check the URL bar. Do not type letters (like "l" instead of "1") and do not search for it in Google. Type <code class="font-mono bg-white px-1 py-0.5 rounded font-bold text-sky-700">http://{ip.ip}</code> directly in the browser address bar.
                </p>
              </div>

              <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 space-y-1.5">
                <strong class="text-slate-900 block font-bold text-sm">4. Verify Gateway Address</strong>
                <p class="text-slate-600 leading-relaxed">
                  Your router might be on a different subnet (e.g. 192.168.0.1 or 10.0.0.1). Open Command Prompt on Windows and type <code class="font-mono bg-white px-1 py-0.5 rounded">ipconfig</code> to confirm your Default Gateway.
                </p>
              </div>
            </div>
          </section>

          <!-- Step-by-Step WiFi Configuration Guide -->
          <section class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-4">
            <h2 class="text-xl font-bold text-slate-900">
              How to Change Your Wi-Fi Password at {ip.ip}
            </h2>
            <p class="text-xs text-slate-600 leading-relaxed">
              Once you have successfully logged in using your default credentials, securing your wireless network is simple:
            </p>
            <ol class="list-decimal list-inside space-y-2 text-xs text-slate-700 font-medium pl-1">
              <li>Navigate to the <strong>Wireless</strong> or <strong>Wi-Fi Settings</strong> menu tab on the left dashboard.</li>
              <li>Locate the <strong>SSID Name</strong> field to rename your network (e.g., <em>Home_5G</em>).</li>
              <li>Under <strong>Security Mode</strong>, select <strong>WPA2-PSK (AES)</strong> or <strong>WPA3-Personal</strong>.</li>
              <li>Type your new custom password in the <strong>Passphrase / Pre-Shared Key</strong> field.</li>
              <li>Click <strong>Save / Apply</strong>. Your connected devices will briefly disconnect and require the new password.</li>
            </ol>
          </section>

          <!-- FAQ Accordion -->
          {ip.faqs && ip.faqs.length > 0 && (
            <section class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-4">
              <h2 class="text-xl font-bold text-slate-900 mb-4">Troubleshooting & Questions for {ip.ip}</h2>
              {ip.faqs.map(faq => (
                <div class="border-b border-slate-100 pb-4 last:border-0 last:pb-0">
                  <h3 class="text-sm font-bold text-slate-900 mb-1.5">Q: {faq.question}</h3>
                  <p class="text-xs text-slate-600 leading-relaxed">{faq.answer}</p>
                </div>
              ))}
            </section>
          )}
        </article>
      );
    })()}

    <!-- Brand View -->
    {type === 'brand' && (() => {
      const brand = data as Brand;
      return (
        <article class="space-y-10">
          <header class="border-b border-slate-200 pb-8">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-50 text-sky-700 text-xs font-bold uppercase mb-4 border border-sky-200">
              Brand Directory
            </div>
            <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
              {brand.name} Router Default Passwords & Login Guide
            </h1>
            <p class="text-base text-slate-600 leading-relaxed">
              {brand.description}
            </p>
          </header>

          <!-- Summary info -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
              <span class="text-xs text-slate-500 block mb-1">Default Gateway IP</span>
              <span class="font-mono font-bold text-md-primary text-sm">{brand.defaultIp}</span>
            </div>
            <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
              <span class="text-xs text-slate-500 block mb-1">Default Username</span>
              <span class="font-mono font-bold text-slate-900 text-sm">{brand.defaultUser}</span>
            </div>
            <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
              <span class="text-xs text-slate-500 block mb-1">Default Password</span>
              <span class="font-mono font-bold text-slate-900 text-sm">{brand.defaultPass}</span>
            </div>
          </div>

          <!-- Models Table -->
          <section>
            <h2 class="text-xl font-bold text-slate-900 mb-4">
              {brand.name} Model Credentials Database
            </h2>
            <PasswordTable models={brand.models} brandName={brand.name} />
          </section>

          <AdBanner format="horizontal" />

          <!-- Setup Guide -->
          <section class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
            <h2 class="text-xl font-bold text-slate-900 mb-6">
              How to configure your {brand.name} Router
            </h2>
            <ol class="space-y-4">
              {brand.guide.map((step, idx) => (
                <li class="flex items-start gap-4">
                  <span class="flex-shrink-0 w-7 h-7 rounded-full bg-sky-100 text-md-primary font-bold text-xs flex items-center justify-center font-mono">
                    {idx + 1}
                  </span>
                  <span class="text-sm text-slate-700 leading-relaxed pt-0.5">
                    {step}
                  </span>
                </li>
              ))}
            </ol>
          </section>

          <!-- Factory Reset & Troubleshooting Guide for Brand -->
          <section class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-6">
            <h2 class="text-xl font-bold text-slate-900">
              Forgot Your {brand.name} Custom Login? How to Factory Reset
            </h2>
            <p class="text-xs text-slate-600 leading-relaxed">
              If the default password ({brand.defaultPass}) has been changed and you can no longer sign in, you can reset the hardware back to original factory defaults:
            </p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
                <strong class="text-slate-900 block font-bold">1. Find the Pinhole</strong>
                <p class="text-slate-600">Locate the small hole marked <em>RESET</em> on the back or bottom panel of your {brand.name} router.</p>
              </div>
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
                <strong class="text-slate-900 block font-bold">2. Press for 10 Seconds</strong>
                <p class="text-slate-600">While the router is powered ON, press and hold the button with a paperclip or pin for 10 to 15 seconds.</p>
              </div>
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
                <strong class="text-slate-900 block font-bold">3. Reconnect with Defaults</strong>
                <p class="text-slate-600">Release the button when the LEDs flash. The router will reboot and restore default IP <strong>{brand.defaultIp}</strong>.</p>
              </div>
            </div>
          </section>
        </article>
      );
    })()}

    <!-- ISP View -->
    {type === 'isp' && (() => {
      const isp = data as Isp;
      return (
        <article class="space-y-10">
          <header class="border-b border-slate-200 pb-8">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold uppercase mb-4 border border-emerald-200">
              Internet Service Provider
            </div>
            <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
              {isp.name} Router Login & Setup Guide
            </h1>
            <p class="text-base text-slate-600 leading-relaxed">
              {isp.description}
            </p>
          </header>

          <!-- Quick Action Card -->
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
              <div>
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Gateway Address</span>
                <div class="text-2xl font-mono font-bold text-slate-900 mt-1">{isp.defaultIp}</div>
                <div class="mt-2 text-xs font-mono text-slate-600">
                  Default Credentials: <strong>{isp.defaultUser}</strong> / <strong>{isp.defaultPass}</strong>
                </div>
              </div>
              <a 
                href={`http://${isp.defaultIp}`}
                target="_blank" 
                rel="noopener noreferrer"
                class="px-5 py-3 rounded-xl bg-md-primary hover:bg-[#004b80] text-white font-bold text-xs shadow-sm transition-all"
              >
                Open {isp.defaultIp} →
              </a>
            </div>
          </div>

          <!-- Instructions -->
          <section class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
            <h2 class="text-xl font-bold text-slate-900 mb-6">
              Step-by-Step {isp.name} ONT Setup
            </h2>
            <ol class="space-y-4">
              {isp.instructions.map((step, idx) => (
                <li class="flex items-start gap-4">
                  <span class="flex-shrink-0 w-7 h-7 rounded-full bg-sky-100 text-md-primary font-bold text-xs flex items-center justify-center font-mono">
                    {idx + 1}
                  </span>
                  <span class="text-sm text-slate-700 leading-relaxed pt-0.5">
                    {step}
                  </span>
                </li>
              ))}
            </ol>
          </section>

          <!-- Fiber ONT Indicator Diagnostics for ISPs -->
          <section class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-6">
            <h2 class="text-xl font-bold text-slate-900">
              Understanding Your {isp.name} ONT Indicator Lights
            </h2>
            <p class="text-xs text-slate-600 leading-relaxed">
              If your {isp.name} broadband shows "Connected, No Internet", glance at the front LED indicators on your fiber optical modem before logging in:
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
              <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 space-y-1">
                <span class="font-bold text-emerald-900 flex items-center gap-1.5 text-sm">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> PON Light (Solid Green)
                </span>
                <p class="text-emerald-800 text-[11px] leading-relaxed">
                  Optical connection with your ISP exchange is healthy and authenticated.
                </p>
              </div>

              <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 space-y-1">
                <span class="font-bold text-rose-900 flex items-center gap-1.5 text-sm">
                  <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-pulse"></span> LOS Light (Blinking Red)
                </span>
                <p class="text-rose-800 text-[11px] leading-relaxed">
                  Loss of Signal: The yellow fiber optic patch cord is loose, bent, or there is an area-wide fiber cut.
                </p>
              </div>

              <div class="p-4 rounded-xl bg-sky-50 border border-sky-200 space-y-1">
                <span class="font-bold text-sky-900 flex items-center gap-1.5 text-sm">
                  <span class="w-2.5 h-2.5 rounded-full bg-sky-500"></span> LAN / WLAN (Blinking Green)
                </span>
                <p class="text-sky-800 text-[11px] leading-relaxed">
                  Data packets are actively transmitting between your Wi-Fi devices and the router.
                </p>
              </div>
            </div>
          </section>
        </article>
      );
    })()}

    <!-- 2-Column Cross Linking Grid (Requested Interlinking Feature) -->
    <RelatedLinksGrid currentSlug={data.slug} />

  </div>
</BaseLayout>
