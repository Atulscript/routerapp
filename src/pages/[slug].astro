                    <span class="w-1.5 h-1.5 rounded-full bg-[#34a853]"></span>
                    Fiber Broadband Provider
                  </div>
                  <h1 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight">
                    {ispData.name} Router Login & Setup Guide
                  </h1>
                  <p class="text-sm sm:text-base text-ink-muted mt-1 max-w-2xl leading-relaxed">
                    {ispData.description}
                  </p>
                </div>
              </div>

              <div class="flex-shrink-0">
                <a 
                  href={`http://${ispPrimaryIp}`} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="g-btn-primary"
                >
                  <span>Open {ispPrimaryIp}</span>
                  <span class="text-xs">↗</span>
                </a>
              </div>
            </div>

            {/* Default Login Credentials Action Grid */}
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div class="bg-surface-sunken rounded-2xl p-3.5 border border-line-subtle flex items-center justify-between gap-3">
                <div class="min-w-0">
                  <div class="text-xs uppercase font-bold text-ink-muted tracking-wider">Gateway IP</div>
                  <div class="text-sm font-mono font-bold text-ink mt-0.5 break-words">{ispData.defaultIp}</div>
                </div>
                <button 
                  type="button" 
                  class="copy-btn g-copy-btn"
                  data-copy={ispData.defaultIp}
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg><span>Copy</span>
                </button>
              </div>

              <div class="bg-surface-sunken rounded-2xl p-3.5 border border-line-subtle flex items-center justify-between gap-3">
                <div class="min-w-0">
                  <div class="text-xs uppercase font-bold text-ink-muted tracking-wider">Default User</div>
                  <div class="text-sm font-mono font-bold text-ink mt-0.5 break-words">{ispData.defaultUser}</div>
                </div>
                <button 
                  type="button" 
                  class="copy-btn g-copy-btn"
                  data-copy={ispData.defaultUser}
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg><span>Copy</span>
                </button>
              </div>

              <div class="bg-surface-sunken rounded-2xl p-3.5 border border-line-subtle flex items-center justify-between gap-3">
                <div class="min-w-0">
                  <div class="text-xs uppercase font-bold text-ink-muted tracking-wider">Default Pass</div>
                  <div class="text-sm font-mono font-bold text-ink mt-0.5 break-words">{ispData.defaultPass}</div>
                </div>
                <button 
                  type="button" 
                  class="copy-btn g-copy-btn"
                  data-copy={ispData.defaultPass}
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg><span>Copy</span>
                </button>
              </div>
            </div>
          </header>

          <AdBanner format="horizontal" />

          {/* Step-by-Step ONT Setup Guide */}
          <section class="g-card p-5 sm:p-6 space-y-4">
            <div class="flex items-center gap-2 border-b border-line-subtle pb-3">
              <span class="text-lg">🛠️</span>
              <h2 class="text-base sm:text-lg font-bold text-ink">
                Step-by-Step {ispData.name} ONT Setup Guide
              </h2>
            </div>
            <ol class="space-y-3">
              {ispData.instructions.map((step, idx) => (
                <li class="flex items-start gap-3.5 text-xs sm:text-sm text-[#3c4043] dark:text-[#e8eaed] p-3.5 rounded-2xl bg-surface-sunken border border-line-subtle">
                  <span class="flex-shrink-0 w-7 h-7 rounded-full bg-[#34a853] text-white font-bold flex items-center justify-center text-xs shadow-xs">
                    {idx + 1}
                  </span>
                  <span class="pt-0.5 leading-relaxed">{step}</span>
                </li>
              ))}
            </ol>
          </section>

          {/* Other Fiber Broadband Providers Grid */}
          <section class="g-card p-4 sm:p-5 space-y-3">
            <h2 class="text-xs font-bold uppercase tracking-wider text-ink-muted">
              Other Fiber Broadband Providers
            </h2>
            <div class="flex flex-wrap gap-2">
              {otherIsps.map(i => (
                <a 
                  href={`${base}/${i.slug}`}
                  class="g-chip"
                >
                  {i.name} ({i.defaultIp})
                </a>
              ))}
            </div>
          </section>
        </article>
      );
    })()}

    {/* 2-Column Cross Linking Grid (Placed Before FAQ) */}
    <RelatedLinksGrid currentSlug={data.slug} />

    {/* ========================================================= */}
    {/* FAQ ACCORDION SECTION (STRICTLY JUST ABOVE FOOTER) */}
    {/* ========================================================= */}
    <section class="g-card p-5 sm:p-7 space-y-4">
      <div class="flex items-center gap-2 border-b border-line-subtle pb-3">
        <span class="text-lg">❓</span>
        <div>
          <h2 class="text-base sm:text-lg font-bold text-ink">
            Frequently Asked Questions & Answers
          </h2>
          <p class="text-sm text-ink-muted">
            Common troubleshooting solutions and login assistance
          </p>
        </div>
      </div>

      <div class="space-y-3">
        {type === 'ip' && (() => {
          const ip = data as GatewayIp;
          const faqsList = ip.faqs && ip.faqs.length > 0 ? ip.faqs : [
            { question: `What is the default login for ${ip.ip}?`, answer: `The default username is typically "${ip.defaultUser}" and password is "${ip.defaultPass}".` },
            { question: `Why is ${ip.ip} not loading in my browser?`, answer: `Make sure your device is directly connected to the router via Wi-Fi or Ethernet, and verify that mobile data or VPNs are turned off.` }
          ];

          return faqsList.map(faq => (
            <details class="group border border-line rounded-2xl p-4 open:bg-[#f8fafd] dark:open:bg-[#303134]/50 hover:border-[#bdc1c6] dark:hover:border-[#5f6368] transition-colors">
              <summary class="font-bold text-ink cursor-pointer list-none flex justify-between items-center text-xs sm:text-sm">
                <span class="flex items-center gap-2">
                  <span class="text-accent font-bold">Q.</span>
                  {faq.question}
                </span>
                <span class="text-[#9aa0a6] group-open:rotate-180 group-open:text-[#1a73e8] dark:group-open:text-[#8ab4f8] transition-transform text-xs flex-shrink-0 ml-2">▼</span>
              </summary>
              <p class="text-sm text-ink-muted mt-2.5 leading-relaxed border-t border-line-subtle pt-2.5">
                {faq.answer}
              </p>
            </details>
          ));
        })()}

        {type === 'brand' && (() => {
          const brand = data as Brand;
          const brandFaqs = [
            {
              question: `What is the default IP address for ${brand.name} routers?`,
              answer: `Most ${brand.name} routers use ${brand.defaultIp} as their factory default gateway management address.`
            },
            {
              question: `What is the factory default login password for ${brand.name}?`,
              answer: `The standard factory username is "${brand.defaultUser}" and default password is "${brand.defaultPass}". Check your physical router label if these don't work.`
            },
            {
              question: `How do I factory reset my ${brand.name} router if I forgot the password?`,
              answer: `Press and hold the physical RESET pinhole button on the back of your ${brand.name} device with a paperclip for 10-15 seconds until all LED lights blink, restoring default credentials.`
            }
          ];

          return brandFaqs.map(faq => (
            <details class="group border border-line rounded-2xl p-4 open:bg-[#f8fafd] dark:open:bg-[#303134]/50 hover:border-[#bdc1c6] dark:hover:border-[#5f6368] transition-colors">
              <summary class="font-bold text-ink cursor-pointer list-none flex justify-between items-center text-xs sm:text-sm">
                <span class="flex items-center gap-2">
                  <span class="text-accent font-bold">Q.</span>
                  {faq.question}
                </span>
                <span class="text-[#9aa0a6] group-open:rotate-180 group-open:text-[#1a73e8] dark:group-open:text-[#8ab4f8] transition-transform text-xs flex-shrink-0 ml-2">▼</span>
              </summary>
              <p class="text-sm text-ink-muted mt-2.5 leading-relaxed border-t border-line-subtle pt-2.5">
                {faq.answer}
              </p>
            </details>
          ));
        })()}

        {type === 'model' && (() => {
          const model = data as RouterModel;
          const modelFaqs = [
            {
              question: `What is the default login for ${model.brand} ${model.model}?`,
              answer: `The default IP address is http://${model.ip}, default username is "${model.username}", and default password is "${model.password}".`
            },
            {
              question: `What ports and speeds does ${model.brand} ${model.model} support?`,
              answer: `The ${model.brand} ${model.model} is equipped with ${model.ports} with an overall speed rating of ${model.speedRating || 'Gigabit Class'}.`
            },
            {
              question: `How do I reset my ${model.brand} ${model.model} to factory settings?`,
              answer: `Press and hold the physical Reset button on the ${model.brand} ${model.model} for 10 to 15 seconds until the power LED blinks, resetting all settings to factory default.`
            }
          ];

          return modelFaqs.map(faq => (
            <details class="group border border-line rounded-2xl p-4 open:bg-[#f8fafd] dark:open:bg-[#303134]/50 hover:border-[#bdc1c6] dark:hover:border-[#5f6368] transition-colors">
              <summary class="font-bold text-ink cursor-pointer list-none flex justify-between items-center text-xs sm:text-sm">
                <span class="flex items-center gap-2">
                  <span class="text-accent font-bold">Q.</span>
                  {faq.question}
                </span>
                <span class="text-[#9aa0a6] group-open:rotate-180 group-open:text-[#1a73e8] dark:group-open:text-[#8ab4f8] transition-transform text-xs flex-shrink-0 ml-2">▼</span>
              </summary>
              <p class="text-sm text-ink-muted mt-2.5 leading-relaxed border-t border-line-subtle pt-2.5">
                {faq.answer}
              </p>
            </details>
          ));
        })()}

        {type === 'isp' && (() => {
          const isp = data as Isp;
          const ispFaqs = [
            {
              question: `How do I log in to my ${isp.name} fiber router admin portal?`,
              answer: `Connect to your ${isp.name} Wi-Fi network, navigate to http://${isp.defaultIp} in your browser, and enter username "${isp.defaultUser}" and password "${isp.defaultPass}".`
            },
            {
              question: `What should I do if the LOS light on my ${isp.name} router is blinking red?`,
              answer: `A blinking red LOS (Loss of Signal) light indicates an optical fiber cable disconnection or an ISP outage. Verify the thin yellow fiber cable is firmly seated, and contact ${isp.name} support if the issue persists.`
            },
            {
              question: `How can I change my ${isp.name} Wi-Fi password and network name?`,
              answer: `Log in to http://${isp.defaultIp}, go to Network/WLAN -> 2.4G/5G Settings, update the SSID and WPA Pre-Shared Key, then click Apply.`
            }
          ];

          return ispFaqs.map(faq => (
            <details class="group border border-line rounded-2xl p-4 open:bg-[#f8fafd] dark:open:bg-[#303134]/50 hover:border-[#bdc1c6] dark:hover:border-[#5f6368] transition-colors">
              <summary class="font-bold text-ink cursor-pointer list-none flex justify-between items-center text-xs sm:text-sm">
                <span class="flex items-center gap-2">
                  <span class="text-accent font-bold">Q.</span>
                  {faq.question}
                </span>
                <span class="text-[#9aa0a6] group-open:rotate-180 group-open:text-[#1a73e8] dark:group-open:text-[#8ab4f8] transition-transform text-xs flex-shrink-0 ml-2">▼</span>
              </summary>
              <p class="text-sm text-ink-muted mt-2.5 leading-relaxed border-t border-line-subtle pt-2.5">
                {faq.answer}
              </p>
            </details>
          ));
        })()}
      </div>
    </section>

  </div>
</BaseLayout>

