---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "Privacy Policy & Google AdSense Disclosures | RouterSync.com";
const description = "Privacy Policy for RouterSync.com detailing Google AdSense DoubleClick DART cookies, GDPR & CCPA privacy rights, and user data protection measures.";
const keywords = [
  "privacy policy",
  "adsense privacy policy",
  "cookie policy",
  "gdpr compliance",
  "ccpa compliance",
  "google dart cookie disclosures"
];

const siteUrl = "https://atulscript.github.io/routerapp";

const schema = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Privacy Policy",
        "item": `${siteUrl}/privacy-policy`
      }
    ]
  },
  {
    "@type": "WebPage",
    "name": "RouterSync.com Privacy Policy",
    "url": `${siteUrl}/privacy-policy`,
    "description": description
  }
];
---

<BaseLayout 
  title={title} 
  description={description} 
  keywords={keywords}
  schema={schema}
  ogType="website"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-8 font-sans">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 text-xs text-ink-muted font-medium" aria-label="Breadcrumb">
      <a href={`${base}/`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
      <span>/</span>
      <span class="text-ink font-semibold truncate">Privacy Policy</span>
    </nav>

    <!-- Header -->
    <header class="space-y-2 border-b border-slate-200/80 dark:border-slate-800 pb-6">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-50 dark:bg-sky-950/40 text-brand-700 dark:text-brand-300 text-xs font-bold uppercase border border-sky-200/50 dark:border-sky-800/50 shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
        Legal & Compliance
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-ink tracking-tight">
        Privacy Policy
      </h1>
      <p class="text-sm sm:text-base text-ink-muted">
        Last Updated & Effective: <strong>September 7, 2026</strong>
      </p>
    </header>

    <!-- Policy Content Sections -->
    <div class="space-y-6 text-xs sm:text-sm text-ink-muted leading-relaxed bg-surface rounded-2xl p-6 sm:p-8 border border-line shadow-card transition-colors">
      
      <section class="space-y-2">
        <h2 class="text-base sm:text-lg font-bold text-ink">1. Introduction</h2>
        <p>
          At <strong>RouterSync.com</strong> ("we," "our," or "us"), we respect your privacy and are committed to protecting any information collected during your visit to our website. This Privacy Policy outlines what information is collected, how it is used, and the choices available to you regarding your data.
        </p>
        <p>
          RouterSync.com operates as an open, educational networking reference directory designed to assist home and enterprise users in managing their private local area networks, router gateways, and default hardware configurations.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-base sm:text-lg font-bold text-ink">2. Information We Collect</h2>
        <p>
          <strong>A. Log Files:</strong> Like standard web servers, RouterSync.com utilizes log files. These files log visitors when they access the site. Information collected includes internet protocol (IP) addresses, browser type, Internet Service Provider (ISP), date/time stamps, referring/exit pages, and number of clicks. This data is not linked to any personally identifiable information and is used strictly for analyzing trends, administering the site, and improving user experience.
        </p>
        <p>
          <strong>B. Local Browser Storage & Utilities:</strong> Our client-side networking utilities (including WiFi QR Code Generator, Password Generator, and IP Lookup) run entirely in your local browser. We do not store, log, transmit, or retain your Wi-Fi credentials or generated passwords on our servers.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-base sm:text-lg font-bold text-ink">3. Google AdSense & Third-Party Advertising Cookies</h2>
        <p>
          We use <strong>Google AdSense</strong> and other third-party advertising partners to serve advertisements when you visit our website.
        </p>
        <div class="p-4 rounded-xl bg-surface-muted/60 border border-slate-200/80 dark:border-slate-700/60 space-y-2 text-xs">
          <p class="font-bold text-ink">Important Google Advertising Disclosures:</p>
          <ul class="list-disc list-inside space-y-1 text-ink-muted pl-1">
            <li>Google, as a third-party vendor, uses cookies to serve ads on RouterSync.com.</li>
            <li>Google's use of advertising cookies enables it and its partners to serve ads to users based on their visit to this site and/or other sites on the Internet.</li>
            <li>Users may opt out of personalized advertising by visiting the <a href="https://adssettings.google.com" target="_blank" rel="noopener noreferrer" class="text-accent font-bold underline">Google Ads Settings</a>.</li>
            <li>Alternatively, users can opt out of third-party vendor cookies for personalized advertising by visiting <a href="https://www.aboutads.info" target="_blank" rel="noopener noreferrer" class="text-accent font-bold underline">aboutads.info</a>.</li>
          </ul>
        </div>
      </section>

      <section class="space-y-2">
        <h2 class="text-base sm:text-lg font-bold text-ink">4. Third-Party Links & Content</h2>
        <p>
          Our website contains links to external router admin portals (e.g., <code class="font-mono bg-surface-muted text-ink px-1.5 py-0.5 rounded text-xs">http://192.168.1.1</code>), official manufacturer documentation, and diagnostic tools. We do not control or endorse the content, security, or privacy practices of external third-party websites. Users access external links at their own discretion.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-base sm:text-lg font-bold text-ink">5. GDPR & CCPA Privacy Rights</h2>
        <p>
          Depending on your location, you have rights under applicable privacy legislation, including the General Data Protection Regulation (GDPR) and California Consumer Privacy Act (CCPA):
        </p>
        <ul class="list-disc list-inside space-y-1 text-ink-muted pl-1">
          <li><strong>Right to Access:</strong> Request copies of any personal data held.</li>
          <li><strong>Right to Erasure:</strong> Request the deletion of your personal data.</li>
          <li><strong>Right to Restrict Processing:</strong> Request restrictions on how your data is processed.</li>
          <li><strong>Right to Opt-Out:</strong> Opt-out of the sale or sharing of personal data with advertising vendors.</li>
        </ul>
      </section>

      <section class="space-y-2">
        <h2 class="text-base sm:text-lg font-bold text-ink">6. Children's Information</h2>
        <p>
          We do not knowingly collect any Personal Identifiable Information from children under the age of 13. If you believe your child provided this kind of information on our website, please contact us immediately and we will promptly remove such information.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-base sm:text-lg font-bold text-ink">7. Contact Information</h2>
        <p>
          If you have additional questions or require more information about our Privacy Policy, do not hesitate to contact us at <strong class="text-accent font-mono">contact@routersync.com</strong> or via our <a href={`${base}/contact`} class="text-accent font-bold underline">Contact Page</a>.
        </p>
      </section>

    </div>

    <!-- Related Links -->
    <RelatedLinksGrid />

  </div>
</BaseLayout>
