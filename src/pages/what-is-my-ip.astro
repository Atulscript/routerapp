---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdBanner from '../components/AdBanner.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "What Is My IP Address & Network Diagnostics Tool | 19216811.page";
const description = "Instantly detect your public IPv4/IPv6 address, internet service provider, browser details, and local router default gateway IP address.";
const keywords = [
  "what is my ip",
  "my ip address",
  "check my ip",
  "public ip lookup",
  "ipv4 address lookup",
  "find default gateway",
  "router ip lookup"
];

const siteUrl = "https://atulscript.github.io/routerapp";

const schema = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Network Tools",
        "item": `${siteUrl}/tools`
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "What Is My IP?",
        "item": `${siteUrl}/what-is-my-ip`
      }
    ]
  },
  {
    "@type": "WebApplication",
    "name": "What Is My IP Address Tool",
    "url": `${siteUrl}/what-is-my-ip`,
    "description": description,
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "All",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  },
  {
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the difference between a Public IP and a Private Gateway IP?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Your Public IP is assigned by your ISP and visible to all websites across the world wide web. Your Private Gateway IP (such as 192.168.1.1 or 192.168.0.1) is used locally inside your home or office to manage router settings."
        }
      },
      {
        "@type": "Question",
        "name": "Why does my public IP address change over time?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Most internet service providers use Dynamic IP addressing or CGNAT to allocate addresses from a pool. When you restart your router or your DHCP lease expires, your ISP assigns a new public IP."
        }
      },
      {
        "@type": "Question",
        "name": "Can anyone find my exact physical home address from my IP?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Geolocation databases only map public IPs to your ISP's regional routing hub or city area, never to your specific physical house or street address."
        }
      }
    ]
  }
];
---

<BaseLayout 
  title={title} 
  description={description} 
  keywords={keywords}
  schema={schema}
  ogType="website"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6 text-center">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 text-xs text-[#80868b] font-medium text-left">
      <a href={`${base}/`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
      <span>/</span>
      <span class="text-[#202124] dark:text-[#e8eaed] font-semibold truncate">What is My IP?</span>
    </nav>

    <header class="max-w-xl mx-auto">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 text-[11px] font-bold uppercase mb-2 border border-emerald-200/50 dark:border-emerald-800/50">
        🌐 IP Detection Tool
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#202124] dark:text-white tracking-tight mb-2">
        What is My IP Address?
      </h1>
      <p class="text-xs sm:text-sm text-[#5f6368] dark:text-[#9aa0a6]">
        Check your current public IP address and discover your local router gateway.
      </p>
    </header>

    <AdBanner format="leaderboard" />

    <!-- Compact IP Display Card -->
    <div class="bg-white dark:bg-[#292a2d] rounded-2xl p-6 sm:p-8 max-w-md mx-auto shadow-card border border-[#dadce0] dark:border-[#3c4043] transition-colors">
      <span class="text-[10px] uppercase font-bold text-[#80868b] dark:text-[#9aa0a6] tracking-wider">Your Public IPv4 Address</span>
      <div id="ip-display" class="text-3xl sm:text-4xl font-mono font-extrabold text-[#202124] dark:text-white my-3 tracking-tight">
        Checking...
      </div>
      <p id="ip-location" class="text-xs text-[#5f6368] dark:text-[#9aa0a6] mb-4 font-medium">
        Detecting Connection...
      </p>
      <button 
        id="copy-ip-btn"
        type="button"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-900 dark:bg-[#1a73e8] hover:bg-slate-800 dark:hover:bg-brand-500 text-white text-xs font-semibold shadow-xs transition-all active:scale-95 cursor-pointer"
      >
        <span>📋 Copy IP Address</span>
      </button>
    </div>

    <AdBanner format="horizontal" />

    <!-- Gateway Detection Info -->
    <div class="bg-white dark:bg-[#292a2d] rounded-2xl p-4 sm:p-6 text-left max-w-2xl mx-auto border border-[#dadce0] dark:border-[#3c4043] shadow-card transition-colors">
      <h2 class="text-xs font-bold uppercase tracking-wider text-[#5f6368] dark:text-[#9aa0a6] mb-1">💡 Looking for your Local Router IP instead?</h2>
      <p class="text-xs text-[#5f6368] dark:text-[#bdc1c6] leading-relaxed mb-3">
        Your <strong>Public IP</strong> (shown above) is what external websites see. Your <strong>Private Gateway IP</strong> is used to access your router settings at home:
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center text-xs font-mono font-bold">
        <a href={`${base}/`} class="p-2.5 bg-[#f8fafd] dark:bg-[#303134] border border-[#dadce0] dark:border-[#5f6368] rounded-xl hover:border-[#1a73e8] dark:hover:border-[#1a73e8] hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] text-[#202124] dark:text-[#e8eaed] transition-colors">192.168.1.1</a>
        <a href={`${base}/192-168-0-1`} class="p-2.5 bg-[#f8fafd] dark:bg-[#303134] border border-[#dadce0] dark:border-[#5f6368] rounded-xl hover:border-[#1a73e8] dark:hover:border-[#1a73e8] hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] text-[#202124] dark:text-[#e8eaed] transition-colors">192.168.0.1</a>
        <a href={`${base}/192-168-2-1`} class="p-2.5 bg-[#f8fafd] dark:bg-[#303134] border border-[#dadce0] dark:border-[#5f6368] rounded-xl hover:border-[#1a73e8] dark:hover:border-[#1a73e8] hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] text-[#202124] dark:text-[#e8eaed] transition-colors">192.168.2.1</a>
        <a href={`${base}/10-0-0-1`} class="p-2.5 bg-[#f8fafd] dark:bg-[#303134] border border-[#dadce0] dark:border-[#5f6368] rounded-xl hover:border-[#1a73e8] dark:hover:border-[#1a73e8] hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] text-[#202124] dark:text-[#e8eaed] transition-colors">10.0.0.1</a>
      </div>
    </div>

    <!-- Human SEO Explanation -->
    <section class="bg-white dark:bg-[#292a2d] rounded-2xl p-4 sm:p-6 text-left max-w-2xl mx-auto border border-[#dadce0] dark:border-[#3c4043] shadow-card space-y-3.5 transition-colors">
      <h2 class="text-base font-bold text-[#202124] dark:text-white">Understanding Your Public IP Address</h2>
      
      <div class="space-y-2.5 text-xs text-[#5f6368] dark:text-[#bdc1c6] leading-relaxed">
        <div class="p-3 rounded-xl bg-[#f8fafd] dark:bg-[#303134]/60 border border-[#e8eaed] dark:border-[#3c4043]">
          <strong class="text-[#202124] dark:text-white block font-semibold mb-0.5">🌐 Public IPv4 vs Private Gateway IP</strong>
          Your Public IP is assigned by your Internet Service Provider and acts as your network's external postal address. Your private IP (192.168.1.1) stays inside your home network.
        </div>

        <div class="p-3 rounded-xl bg-[#f8fafd] dark:bg-[#303134]/60 border border-[#e8eaed] dark:border-[#3c4043]">
          <strong class="text-[#202124] dark:text-white block font-semibold mb-0.5">🔄 Why Does My Public IP Change?</strong>
          Most residential internet connections use <strong>Dynamic IP addressing</strong> or <strong>CGNAT</strong>. Your ISP reassigns IP addresses whenever your modem restarts or the DHCP lease refreshes.
        </div>

        <div class="p-3 rounded-xl bg-[#f8fafd] dark:bg-[#303134]/60 border border-[#e8eaed] dark:border-[#3c4043]">
          <strong class="text-[#202124] dark:text-white block font-semibold mb-0.5">📍 Can Someone Find My Exact Location from My IP?</strong>
          No. Public IP geolocation only identifies the ISP's nearest routing exchange or city hub — never your private residence or street address.
        </div>
      </div>
    </section>

    <!-- Interlinking 2-Column Grid -->
    <div class="text-left">
      <RelatedLinksGrid />
    </div>

    <!-- FAQ Accordion (Positioned Just Above Footer) -->
    <section class="bg-white dark:bg-[#292a2d] rounded-2xl p-5 sm:p-6 border border-[#dadce0] dark:border-[#3c4043] shadow-card space-y-4 text-left">
      <h2 class="text-lg font-bold text-[#202124] dark:text-white">What Is My IP FAQs</h2>
      <div class="divide-y divide-[#e8eaed] dark:divide-[#3c4043] text-xs">
        <div class="py-3">
          <strong class="text-slate-900 dark:text-slate-100 text-xs block font-semibold mb-1">What is the difference between a Public IP and a Private Gateway IP?</strong>
          <p class="text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed">
            Your Public IP is assigned by your ISP and visible to all websites across the world wide web. Your Private Gateway IP (such as 192.168.1.1 or 192.168.0.1) is used locally inside your home or office to manage router settings.
          </p>
        </div>
        <div class="py-3">
          <strong class="text-slate-900 dark:text-slate-100 text-xs block font-semibold mb-1">Why does my public IP address change over time?</strong>
          <p class="text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed">
            Most internet service providers use Dynamic IP addressing or CGNAT to allocate addresses from a pool. When you restart your router or your DHCP lease expires, your ISP assigns a new public IP.
          </p>
        </div>
        <div class="py-3">
          <strong class="text-slate-900 dark:text-slate-100 text-xs block font-semibold mb-1">Can anyone find my exact physical home address from my IP?</strong>
          <p class="text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed">
            No. Geolocation databases only map public IPs to your ISP's regional routing hub or city area, never to your specific physical house or street address.
          </p>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  async function fetchIp() {
    const display = document.getElementById('ip-display');
    const loc = document.getElementById('ip-location');
    const copyBtn = document.getElementById('copy-ip-btn');

    try {
      const res = await fetch('https://api.ipify.org?format=json');
      const data = await res.json();
      if (display) display.innerText = data.ip;
      if (loc) loc.innerText = 'Connected via IPv4';

      copyBtn?.addEventListener('click', () => {
        navigator.clipboard.writeText(data.ip);
        const original = copyBtn.innerHTML;
        copyBtn.innerHTML = '<span>✓ Copied!</span>';
        copyBtn.classList.remove('bg-slate-900');
        copyBtn.classList.add('bg-emerald-600');
        setTimeout(() => {
          copyBtn.innerHTML = original;
          copyBtn.classList.remove('bg-emerald-600');
          copyBtn.classList.add('bg-slate-900');
        }, 1500);
      });
    } catch {
      if (display) display.innerText = 'Unable to detect';
      if (loc) loc.innerText = 'Please check your internet connection';
    }
  }

  fetchIp();
</script>
