---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "About Us - Why We Built RouterSync.com | RouterSync.com";
const description = "Learn why we built RouterSync.com: a fast, clean, ad-balanced router directory and network toolkit designed by network technicians and everyday power users.";
const keywords = [
  "about RouterSync.com",
  "router gateway directory",
  "network research",
  "router login documentation",
  "router editorial standards"
];

const siteUrl = "https://atulscript.github.io/routerapp";

const schema = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "About Us",
        "item": `${siteUrl}/about`
      }
    ]
  },
  {
    "@type": "AboutPage",
    "name": "About RouterSync.com",
    "url": `${siteUrl}/about`,
    "description": description,
    "mainEntity": {
      "@type": "Organization",
      "name": "RouterSync.com",
      "url": siteUrl,
      "description": "Clean, verified directory of router default passwords, gateway IP addresses, and Wi-Fi setup guides."
    }
  }
];
---

<BaseLayout 
  title={title} 
  description={description} 
  keywords={keywords}
  schema={schema}
  ogType="website"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-8 font-sans">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 text-xs text-ink-muted font-medium">
      <a href={`${base}/`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">Home</a>
      <span>/</span>
      <span class="text-ink font-medium truncate">About Us</span>
    </nav>

    <!-- Header -->
    <header class="space-y-2 border-b border-line-subtle pb-6">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-accent-soft text-accent text-xs font-bold uppercase border border-[#d2e3fc] dark:border-[#1a73e8] shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-[#1a73e8]"></span>
        Who We Are & Why We Built This
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-ink tracking-tight">
        About RouterSync.com
      </h1>
      <p class="text-sm sm:text-base text-ink-muted leading-relaxed max-w-2xl">
        A fast, clutter-free reference directory and browser toolkit built for anyone trying to fix, configure, or secure their home Wi-Fi network.
      </p>
    </header>

    <!-- About Content Cards -->
    <div class="space-y-6 text-xs sm:text-sm text-[#3c4043] dark:text-[#e8eaed] leading-relaxed g-card p-6 sm:p-8">
      
      <section class="space-y-3">
        <h2 class="text-base sm:text-lg font-bold text-ink">Why We Built This Site</h2>
        <p>
          If you have ever tried to look up your router's default login or figure out why <code class="font-mono bg-surface-muted text-ink px-1.5 py-0.5 rounded text-xs">192.168.1.1</code> wouldn't open, you probably landed on websites filled with intrusive popups, fake download buttons, and outdated information.
        </p>
        <p>
          We created <strong>RouterSync.com</strong> to be the exact opposite: an uncluttered, fast-loading, and practical reference site. Whether you are changing your Wi-Fi password, setting up parental controls, or helping family members troubleshoot a disconnected modem, our goal is to give you the exact IP, factory credentials, and step-by-step setup guide in seconds.
        </p>
      </section>

      <section class="space-y-3 pt-4 border-t border-line-subtle">
        <h2 class="text-base sm:text-lg font-bold text-ink">What Makes Us Different</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
          <div class="p-4 rounded-2xl bg-surface-sunken border border-line-subtle space-y-2">
            <span class="text-xl">📋</span>
            <h3 class="font-bold text-ink text-sm">Verified Credentials</h3>
            <p class="text-ink-muted leading-relaxed">
              Every default username, password, and IP address in our database is cross-checked against official manufacturer documentation and actual hardware labels.
            </p>
          </div>

          <div class="p-4 rounded-2xl bg-surface-sunken border border-line-subtle space-y-2">
            <span class="text-xl">🔒</span>
            <h3 class="font-bold text-ink text-sm">Privacy by Default</h3>
            <p class="text-ink-muted leading-relaxed">
              All of our utilities—including the Password Generator and Wi-Fi QR code creator—run entirely in your browser. Your sensitive keys never touch any server.
            </p>
          </div>

          <div class="p-4 rounded-2xl bg-surface-sunken border border-line-subtle space-y-2">
            <span class="text-xl">⚡</span>
            <h3 class="font-bold text-ink text-sm">No Bloat or Deception</h3>
            <p class="text-ink-muted leading-relaxed">
              No misleading "scan now" software ads, no required registrations, and no endless click-through pages. Just clean, direct technical facts.
            </p>
          </div>
        </div>
      </section>

      <section class="space-y-3 pt-4 border-t border-line-subtle">
        <h2 class="text-base sm:text-lg font-bold text-ink">Got a Suggestion or Found a Typo?</h2>
        <p>
          Hardware revisions happen all the time, and internet service providers occasionally push custom firmware that alters default credentials. If you spot a model we missed or a credential that needs updating, we welcome your input! Drop us a message via our <a href={`${base}/contact`} class="text-accent font-bold underline">Contact Page</a>.
        </p>
      </section>

    </div>

    <!-- Related Links -->
    <RelatedLinksGrid />

  </div>
</BaseLayout>
