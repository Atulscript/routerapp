---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedLinksGrid from '../components/RelatedLinksGrid.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "Disclaimer & Brand Non-Affiliation Notice | 19216811.page";
const description = "Non-affiliation and trademark disclaimer. 19216811.page is an independent educational portal not affiliated with any router manufacturer or ISP.";
const keywords = [
  "trademark disclaimer",
  "non affiliation notice",
  "router brand disclaimer",
  "fair use educational notice"
];

const siteUrl = "https://atulscript.github.io/routerapp";

const schema = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Disclaimer",
        "item": `${siteUrl}/disclaimer`
      }
    ]
  },
  {
    "@type": "WebPage",
    "name": "19216811.page Non-Affiliation Disclaimer",
    "url": `${siteUrl}/disclaimer`,
    "description": description
  }
];
---

<BaseLayout 
  title={title} 
  description={description} 
  keywords={keywords}
  schema={schema}
  ogType="website"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-8 font-sans">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 text-xs text-slate-400 font-medium">
      <a href={`${base}/`} class="hover:text-slate-900 transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-800 font-semibold truncate">Disclaimer</span>
    </nav>

    <!-- Header -->
    <header class="space-y-2 border-b border-slate-200/80 pb-6">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-50 text-amber-800 text-xs font-bold uppercase border border-amber-200 shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
        Legal & Non-Affiliation
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Disclaimer
      </h1>
      <p class="text-xs sm:text-sm text-slate-500">
        Last Updated: <strong>September 7, 2026</strong>
      </p>
    </header>

    <!-- Disclaimer Content -->
    <div class="space-y-6 text-xs sm:text-sm text-slate-700 leading-relaxed bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/90 shadow-card">
      
      <section class="space-y-2">
        <h2 class="text-base sm:text-lg font-bold text-slate-900">1. Independent Reference Status</h2>
        <p>
          <strong>19216811.page</strong> is an independent educational reference website and technical directory. This site is not owned, operated, authorized, sponsored, or affiliated with any router manufacturer, internet service provider, or technology vendor.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-base sm:text-lg font-bold text-slate-900">2. Trademark Notice</h2>
        <p>
          All product names, logos, brands, trademarks, and registered trademarks (including but not limited to <em>TP-Link, Netgear, ASUS, D-Link, Cisco, Linksys, Belkin, Huawei, MikroTik, Ubiquiti, JioFiber, Airtel Xstream, BSNL</em>) are the property of their respective owners.
        </p>
        <p>
          Use of these company names and trademarks on 19216811.page is solely for identification and descriptive educational purposes under fair use doctrine.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-base sm:text-lg font-bold text-slate-900">3. Technical Accuracy & No Warranty</h2>
        <p>
          While we strive to keep all default IP addresses, subnet guidelines, and factory passwords accurate and up to date, router firmware and ISP configurations can vary across hardware revisions and regional firmware releases.
        </p>
        <p>
          All content and utilities on this site are provided on an "as is" and "as available" basis without any express or implied warranties. Always consult your official hardware user manual for device-specific instructions.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-base sm:text-lg font-bold text-slate-900">4. Advertising Disclosure</h2>
        <p>
          This website is monetized through third-party advertising networks, such as Google AdSense. Advertisements are clearly designated with "Advertisement" or "Sponsored" labels. Advertising revenue supports the free maintenance and server costs of our database.
        </p>
      </section>

    </div>

    <!-- Related Links -->
    <RelatedLinksGrid />

  </div>
</BaseLayout>
