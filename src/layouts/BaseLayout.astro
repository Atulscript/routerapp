---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import BottomNav from '../components/BottomNav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  keywords?: string | string[];
  canonical?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  noindex?: boolean;
  schema?: Record<string, any> | Record<string, any>[];
}

const { 
  title, 
  description, 
  keywords = "192.168.1.1, 192.168.0.1, router login, default router password, router admin password, gateway IP, wifi setup, router guide",
  canonical = Astro.url.href,
  ogType = 'website',
  ogImage,
  noindex = false,
  schema 
} = Astro.props;

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site ? new URL(base, Astro.site).href.replace(/\/$/, '') : "https://atulscript.github.io/routerapp";
const socialImage = ogImage || `${siteUrl}/og-image.svg`;
const keywordsString = Array.isArray(keywords) ? keywords.join(', ') : keywords;

// Automatic Indexing Control:
// Blocks all search engines on GitHub Pages (*.github.io) staging/preview.
// Automatically allows indexing when deployed to a live custom domain.
// Can be manually overridden with PUBLIC_ALLOW_INDEXING=true
const isGitHubPages = Astro.site?.hostname.includes('github.io') || siteUrl.includes('github.io');
const allowIndexing = import.meta.env.PUBLIC_ALLOW_INDEXING === 'true';
const shouldNoIndex = (noindex || isGitHubPages) && !allowIndexing;

// Base Organization and WebSite Schema for rich snippets
const globalSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "RouterSync.com",
      "url": siteUrl,
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/favicon.svg`,
        "caption": "RouterSync.com Logo"
      }
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "RouterSync.com",
      "description": "Comprehensive Directory of Router Default Passwords, Gateway IPs, Hardware Specifications, and Network Tools",
      "publisher": {
        "@id": `${siteUrl}/#organization`
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${siteUrl}/?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    }
  ]
};

// Merge page-specific schemas if provided
let finalSchema = globalSchema;
if (schema) {
  const pageSchemas = Array.isArray(schema) ? schema : [schema];
  finalSchema = {
    "@context": "https://schema.org",
    "@graph": [
      ...globalSchema["@graph"],
      ...pageSchemas
    ]
  };
}
---

<!DOCTYPE html>
<html lang="en" class="bg-surface-sunken text-ink antialiased transition-colors duration-200">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
  
  <!-- Theme Detection & Initialization Script (Zero-FOUC) -->
  <script is:inline>
    if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>

  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywordsString} />
  <meta name="author" content="RouterSync.com Editorial Team" />
  <meta name="publisher" content="RouterSync.com" />
  <meta name="theme-color" content="#f8fafd" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#202124" media="(prefers-color-scheme: dark)" />
  <meta name="color-scheme" content="light dark" />

  <!-- Self-hosted fonts, preloaded so headings paint in the right font straight away -->
  <link rel="preload" as="font" type="font/woff2" href={`${base}/fonts/inter.woff2`} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={`${base}/fonts/jetbrains-mono.woff2`} crossorigin />
  <link rel="canonical" href={canonical} />

  <!-- Search Engine Robots Directive -->
  {shouldNoIndex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  )}

  <!-- Open Graph / Facebook / LinkedIn / Discord -->
  <meta property="og:locale" content="en_US" />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="RouterSync.com" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="RouterSync.com Gateway & Default Password Directory" />

  <!-- Twitter / X Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonical} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImage} />
  <meta name="twitter:image:alt" content="RouterSync.com Gateway & Default Password Directory" />

  <!-- Google AdSense Verification & Auto Ads Script -->
  <script 
    async 
    src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8700784373117801"
    crossorigin="anonymous"
  ></script>

  <!-- Schema.org JSON-LD Structured Data Graph -->
  <script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />
</head>
<body data-base={base} class="min-h-screen flex flex-col justify-between selection:bg-[#1a73e8] selection:text-white font-sans bg-surface-sunken text-ink transition-colors duration-200">
  <Header currentPath={currentPath} />
  
  <main id="main-content" class="flex-grow pb-20 md:pb-0" tabindex="-1">
    <slot />
  </main>

  <Footer />
  <BottomNav currentPath={currentPath} />
  <CookieConsent />

  <!-- Screen-reader announcements (e.g. "Copied") -->
  <div id="sr-announcer" class="sr-only" aria-live="polite"></div>

  <script>
    // Copy buttons anywhere on the site: <button class="copy-btn" data-copy="text">
    document.addEventListener('click', async (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.copy-btn');
      const text = button?.dataset.copy;
      if (!button || !text) return;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        return;
      }
      const original = button.innerHTML;
      button.innerHTML = '✓ Copied';
      button.classList.add('!bg-[#34a853]', '!text-white', '!border-[#34a853]');
      const announcer = document.getElementById('sr-announcer');
      if (announcer) announcer.textContent = `Copied ${text}`;
      setTimeout(() => {
        button.innerHTML = original;
        button.classList.remove('!bg-[#34a853]', '!text-white', '!border-[#34a853]');
      }, 1500);
    });
  </script>
</body>
</html>
