---
/**
 * Sticky search + chip bar for the card-grid landing pages.
 *
 * The page supplies the chips and tags each card wrapper with a matching data-k;
 * behaviour lives in scripts/card-filter.ts. Styling matches the A-Z rail on
 * /brands: one row that scrolls sideways on phones rather than wrapping.
 */

interface Props {
  /** Label for the "everything" chip, e.g. "ALL" */
  allLabel?: string;
  chips: { value: string; label: string }[];
  placeholder: string;
  /** Accessible name for the search field */
  label: string;
  total: number;
  /** Accessible name for the chip group */
  chipsLabel: string;
}

const { allLabel = 'ALL', chips, placeholder, label, total, chipsLabel } = Astro.props;
---

<div class="sticky top-16 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 pt-2 pb-2.5 bg-[#f8fafd]/95 dark:bg-[#202124]/95 backdrop-blur-md border-b border-[#dadce0] dark:border-[#3c4043] space-y-2">

  <!-- The running count sits inside the field, so the control reads as one object -->
  <div class="g-search-bar h-11 sm:h-10 pl-4 pr-2">
    <svg class="w-4 h-4 text-[#5f6368] dark:text-[#9aa0a6] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
    </svg>
    <label for="cf-q" class="sr-only">{label}</label>
    <input
      id="cf-q"
      class="cf-q min-w-0 flex-1 bg-transparent border-0 outline-none px-3 text-base sm:text-sm text-[#202124] dark:text-white placeholder-[#5f6368] dark:placeholder-[#9aa0a6]"
      type="text"
      autocomplete="off"
      spellcheck="false"
      placeholder={placeholder}
    />
    <button type="button" class="cf-clear hidden icon-btn w-7 h-7 flex-shrink-0" aria-label="Clear the search">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>
    <span
      class="cf-count flex-shrink-0 ml-1 mr-1.5 pl-2.5 border-l border-[#dadce0] dark:border-[#5f6368] text-[11px] font-semibold tabular-nums text-[#5f6368] dark:text-[#9aa0a6] whitespace-nowrap"
      aria-live="polite"
    >{total}</span>
  </div>

  <!-- One row that scrolls sideways on phones rather than wrapping to several -->
  <div class="cf-rail -mx-1 px-1">
    <div
      class="no-scrollbar flex items-center gap-1 overflow-x-auto p-1 rounded-full bg-[#f1f3f4] dark:bg-[#303134] border border-[#e8eaed] dark:border-[#3c4043]"
      role="group"
      aria-label={chipsLabel}
    >
      <button
        class="cf-chip flex-shrink-0 h-7 px-3 rounded-full text-[11px] font-bold tracking-wide bg-[#1a73e8] text-white cursor-pointer transition-colors"
        data-v="ALL"
        aria-pressed="true"
      >{allLabel}</button>
      {chips.map(chip => (
        <button
          class="cf-chip flex-shrink-0 h-7 min-w-[1.75rem] px-2.5 rounded-full font-mono text-xs font-bold text-[#3c4043] dark:text-[#bdc1c6] hover:bg-white dark:hover:bg-[#3c4043] cursor-pointer transition-colors whitespace-nowrap"
          data-v={chip.value}
          aria-pressed="false"
        >{chip.label}</button>
      ))}
    </div>
  </div>
</div>

<style>
  /* On phones the rail scrolls, so both edges fade to show there is more past
     the cut. On wider screens everything fits and the mask would be a lie. */
  @media (max-width: 640px) {
    .cf-rail {
      -webkit-mask-image: linear-gradient(to right, transparent, #000 14px, #000 calc(100% - 14px), transparent);
      mask-image: linear-gradient(to right, transparent, #000 14px, #000 calc(100% - 14px), transparent);
    }
  }

  .cf-chip:focus-visible {
    outline: 2px solid #1a73e8;
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .cf-chip { transition: none; }
  }
</style>
