---
/**
 * Sticky search + chip bar for the card-grid landing pages.
 *
 * The page supplies the chips and tags each card wrapper with a matching data-k;
 * behaviour lives in scripts/card-filter.ts. Styling matches the A-Z rail on
 * /brands: one row that scrolls sideways on phones rather than wrapping.
 */

interface Props {
  /** Label for the "everything" chip, e.g. "ALL" */
  allLabel?: string;
  chips: { value: string; label: string }[];
  placeholder: string;
  /** Accessible name for the search field */
  label: string;
  total: number;
  /** Accessible name for the chip group */
  chipsLabel: string;
}

const { allLabel = 'ALL', chips, placeholder, label, total, chipsLabel } = Astro.props;
---

<div class="sticky top-16 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 pt-2 pb-2.5 bg-surface-sunken/95 backdrop-blur-md border-b border-line space-y-2">

  <!-- The running count sits inside the field, so the control reads as one object -->
  <div class="g-search-bar h-11 sm:h-10 pl-4 pr-2">
    <svg class="w-4 h-4 text-ink-muted flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
    </svg>
    <label for="cf-q" class="sr-only">{label}</label>
    <input
      id="cf-q"
      class="cf-q min-w-0 flex-1 bg-transparent border-0 outline-none px-3 text-base sm:text-sm text-ink placeholder-ink-subtle"
      type="search"
      inputmode="search"
      placeholder={placeholder}
      autocomplete="off"
      spellcheck="false"
    />
    <span
      class="cf-count flex-shrink-0 text-xs font-mono font-medium text-ink-muted px-2 py-0.5 rounded-full bg-surface-raised tabular-nums"
      data-total={total}
      aria-live="polite"
      aria-atomic="true"
    >{total.toLocaleString()}</span>
  </div>

  <!-- A-Z or segment filter chips -->
  <div class="cf-rail relative">
    <div
      class="no-scrollbar flex items-center gap-1 overflow-x-auto p-1 rounded-full bg-surface-muted border border-line-subtle"
      role="group"
      aria-label={chipsLabel}
    >
      <button
        class="cf-chip flex-shrink-0 h-7 px-3 rounded-full text-[11px] font-bold tracking-wide bg-accent text-white cursor-pointer transition-colors"
        data-v="ALL"
        aria-pressed="true"
      >{allLabel}</button>
      {chips.map(chip => (
        <button
          class="cf-chip flex-shrink-0 h-7 min-w-[1.75rem] px-2.5 rounded-full font-mono text-xs font-bold text-ink-muted hover:bg-surface-raised cursor-pointer transition-colors whitespace-nowrap"
          data-v={chip.value}
          aria-pressed="false"
        >{chip.label}</button>
      ))}
    </div>
  </div>
</div>

<style>
  /* On phones the rail scrolls, so both edges fade to show there is more past
     the cut. On wider screens everything fits and the mask would be a lie. */
  @media (max-width: 640px) {
    .cf-rail {
      -webkit-mask-image: linear-gradient(to right, transparent, #000 14px, #000 calc(100% - 14px), transparent);
      mask-image: linear-gradient(to right, transparent, #000 14px, #000 calc(100% - 14px), transparent);
    }
  }

  .cf-chip:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .cf-chip { transition: none; }
  }
</style>
