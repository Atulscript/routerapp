---
// Interactive 4-step login guide (Material vertical stepper).
// Every step has a "Done" action and an "I'm stuck" panel with the help for that step.
interface Props {
  ip: string;
  user?: string;
  pass?: string;
  brandName?: string;
  class?: string;
}

const { ip, user = 'admin', pass = 'admin', brandName, class: className = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const who = brandName ? `your ${brandName} router` : 'your router';

const osTabs = [
  { id: 'win', label: 'Windows', steps: ['Press Windows + R, type cmd and press Enter.', 'Type ipconfig and press Enter.', 'Read the number next to "Default Gateway".'] },
  { id: 'mac', label: 'macOS', steps: ['Open System Settings › Network.', 'Select your Wi-Fi, then click Details.', 'Open the TCP/IP tab and read "Router".'] },
  { id: 'ios', label: 'iPhone', steps: ['Open Settings › Wi-Fi.', 'Tap the ⓘ next to your network.', 'Read the number next to "Router".'] },
  { id: 'android', label: 'Android', steps: ['Open Settings › Network & internet › Internet.', 'Tap the gear next to your Wi-Fi network.', 'Open Advanced and read "Gateway".'] },
];

const checklist = [
  { id: 'admin-pass', label: 'Change the router admin password', hint: 'Anyone on your Wi-Fi can open this page. Replace admin / admin with something only you know.' },
  { id: 'wifi-pass', label: 'Set a strong Wi-Fi password with WPA3 or WPA2', hint: 'Wireless › Security. Avoid WEP and "open" networks.' },
  { id: 'firmware', label: 'Install firmware updates', hint: 'Usually under System Tools, Administration or Management.' },
  { id: 'wps', label: 'Turn off WPS and remote management', hint: 'Both are common ways routers get taken over.' },
];
---

<section class={`login-stepper g-card p-5 sm:p-7 space-y-5 ${className}`} aria-labelledby="stepper-title" data-stepper>
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 border-b border-[#e8eaed] dark:border-[#3c4043] pb-4">
    <div>
      <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-[#e8f0fe] dark:bg-[#1a3a60] text-[#1a73e8] dark:text-[#8ab4f8] text-xs font-bold mb-2">
        Step-by-step
      </div>
      <h2 id="stepper-title" class="text-xl sm:text-2xl font-bold text-[#202124] dark:text-white tracking-tight">
        Log in to {ip}
      </h2>
      <p class="text-sm text-[#5f6368] dark:text-[#9aa0a6] mt-0.5">
        Four steps, with help at each one if something doesn't work.
      </p>
    </div>
    <div class="flex items-center gap-3 flex-shrink-0">
      <div class="text-sm font-medium text-[#5f6368] dark:text-[#9aa0a6] whitespace-nowrap" data-step-count aria-live="polite">Step 1 of 4</div>
      <div class="w-24 h-1.5 rounded-full bg-[#e8eaed] dark:bg-[#3c4043] overflow-hidden" aria-hidden="true">
        <div class="h-full w-1/4 bg-[#1a73e8] dark:bg-[#8ab4f8] rounded-full transition-[width] duration-300" data-step-bar></div>
      </div>
    </div>
  </div>

  <ol class="space-y-3">
    {[1, 2, 3, 4].map(n => (
      <li class="step rounded-2xl border border-[#e8eaed] dark:border-[#3c4043] overflow-hidden transition-colors" data-step={n}>
        <h3>
          <button
            type="button"
            class="w-full flex items-center gap-3 p-4 text-left hover:bg-[#f8fafd] dark:hover:bg-[#303134]/60 transition-colors"
            aria-expanded={n === 1 ? 'true' : 'false'}
            aria-controls={`step-panel-${n}`}
            data-step-toggle
          >
            <span class="step-marker w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold flex-shrink-0 transition-colors bg-[#e8f0fe] dark:bg-[#1a3a60] text-[#1a73e8] dark:text-[#8ab4f8]">
              <span data-step-number>{n}</span>
              <svg class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" data-step-check aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
            </span>
            <span class="flex-1 min-w-0">
              <span class="block text-sm sm:text-base font-bold text-[#202124] dark:text-white">
                {n === 1 && 'Connect to your router'}
                {n === 2 && `Open ${ip} in a browser`}
                {n === 3 && 'Sign in with the default login'}
                {n === 4 && 'Secure your network'}
              </span>
              <span class="block text-xs text-[#5f6368] dark:text-[#9aa0a6] mt-0.5" data-step-summary>
                {n === 1 && 'Use the router\'s Wi-Fi or a cable'}
                {n === 2 && 'Type the address exactly, with http://'}
                {n === 3 && `Username ${user || '(blank)'}, password ${pass || '(blank)'}`}
                {n === 4 && 'Four quick changes worth making'}
              </span>
            </span>
            <svg class="w-5 h-5 text-[#5f6368] dark:text-[#9aa0a6] flex-shrink-0 transition-transform" data-step-chevron viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </button>
        </h3>

        <div id={`step-panel-${n}`} class="step-panel" hidden={n !== 1}>
          <div class="px-4 pb-4 sm:pl-[3.75rem] space-y-3 text-sm text-[#3c4043] dark:text-[#e8eaed]">

            {n === 1 && (
              <div class="space-y-3">
                <p>Join the Wi-Fi network of {who}, or plug a network cable into one of its LAN ports. You don't need internet access for this, only a connection to the router itself.</p>
                <p class="text-[#5f6368] dark:text-[#9aa0a6]">On a phone, turn off mobile data while you set things up, and switch off any VPN.</p>
              </div>
            )}

            {n === 2 && (
              <div class="space-y-3">
                <div class="flex flex-wrap items-center gap-2">
                  <a href={`http://${ip}`} target="_blank" rel="noopener noreferrer" class="g-btn-primary">Open {`http://${ip}`} ↗</a>
                  <button type="button" class="copy-btn g-copy-btn" data-copy={ip}>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg><span>Copy address</span>
                  </button>
                </div>
                <p class="text-[#5f6368] dark:text-[#9aa0a6]">Type it in the address bar, not in a search box. Search engines can't reach your router.</p>
              </div>
            )}

            {n === 3 && (
              <div class="space-y-3">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                  <div class="rounded-2xl bg-[#f8fafd] dark:bg-[#202124] border border-[#e8eaed] dark:border-[#3c4043] p-3.5 flex items-center justify-between gap-3">
                    <span class="min-w-0">
                      <span class="block text-xs font-bold uppercase tracking-wider text-[#5f6368] dark:text-[#9aa0a6]">Username</span>
                      <span class="block font-mono font-bold text-[#202124] dark:text-white mt-0.5 break-words">{user || '(blank)'}</span>
                    </span>
                    <button type="button" class="copy-btn g-copy-btn" data-copy={user} aria-label="Copy username">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg><span>Copy</span>
                    </button>
                  </div>
                  <div class="rounded-2xl bg-[#f8fafd] dark:bg-[#202124] border border-[#e8eaed] dark:border-[#3c4043] p-3.5 flex items-center justify-between gap-3">
                    <span class="min-w-0">
                      <span class="block text-xs font-bold uppercase tracking-wider text-[#5f6368] dark:text-[#9aa0a6]">Password</span>
                      <span class="block font-mono font-bold text-[#202124] dark:text-white mt-0.5 break-words">{pass || '(blank)'}</span>
                    </span>
                    <button type="button" class="copy-btn g-copy-btn" data-copy={pass} aria-label="Copy password">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg><span>Copy</span>
                    </button>
                  </div>
                </div>
                <p class="text-[#5f6368] dark:text-[#9aa0a6]">Newer routers ship with a unique password printed on a sticker underneath, so check there before trying the defaults.</p>
              </div>
            )}

            {n === 4 && (
              <div class="space-y-3">
                <p>You're in. These four changes matter most:</p>
                <ul class="space-y-2">
                  {checklist.map(item => (
                    <li>
                      <label class="flex items-start gap-3 p-3 rounded-2xl bg-[#f8fafd] dark:bg-[#202124] border border-[#e8eaed] dark:border-[#3c4043] cursor-pointer hover:border-[#1a73e8]/40 transition-colors">
                        <input type="checkbox" class="mt-0.5 w-5 h-5 flex-shrink-0 accent-[#1a73e8] cursor-pointer" data-secure-check value={item.id} />
                        <span>
                          <span class="block font-medium text-[#202124] dark:text-white">{item.label}</span>
                          <span class="block text-xs text-[#5f6368] dark:text-[#9aa0a6] mt-0.5">{item.hint}</span>
                        </span>
                      </label>
                    </li>
                  ))}
                </ul>
                <p class="text-sm rounded-2xl bg-[#e6f4ea] dark:bg-[#133e24] text-[#0d652d] dark:text-[#ceead6] p-3 hidden" data-secure-done>
                  All four done. Your network is in much better shape.
                </p>
                <div class="flex flex-wrap gap-2 pt-1">
                  <a href={`${base}/password-generator`} class="g-btn-outlined">Generate a strong password</a>
                  <a href={`${base}/wifi-qr-generator`} class="g-btn-outlined">Make a Wi-Fi QR code</a>
                </div>
              </div>
            )}

            <!-- Help panel -->
            <div class="rounded-2xl bg-[#fef7e0] dark:bg-[#332a00]/60 border border-[#fbbc04]/50 p-4 space-y-2.5 text-sm text-[#3c4043] dark:text-[#e8eaed]" data-help hidden>
              {n === 1 && (
                <div class="space-y-2">
                  <p class="font-bold text-[#7a4a00] dark:text-[#fdd663]">Can't find the network?</p>
                  <p>The Wi-Fi name (SSID) and its password are printed on a sticker on the bottom or back of the router.</p>
                  <p>If the router is new, plug it in and wait two minutes for its lights to settle before connecting.</p>
                </div>
              )}
              {n === 2 && (
                <div class="space-y-3">
                  <p class="font-bold text-[#7a4a00] dark:text-[#fdd663]">The page won't load</p>
                  <p>Router addresses are numbers only. <span class="font-mono line-through">192.168.l.l</span> and <span class="font-mono line-through">192.168.o.1</span> use letters and end up in a search engine instead.</p>
                  <p>Use <span class="font-mono">http://</span>, not <span class="font-mono">https://</span>, and try a private window if an old page is cached.</p>
                  <p class="font-bold text-[#7a4a00] dark:text-[#fdd663] pt-1">Your router may use a different address. Find it:</p>
                  <div class="flex flex-wrap gap-1.5" role="tablist" aria-label="Find your gateway address">
                    {osTabs.map((tab, i) => (
                      <button type="button" role="tab" id={`os-tab-${tab.id}`} aria-controls={`os-panel-${tab.id}`} aria-selected={i === 0 ? 'true' : 'false'} class="os-tab g-chip" data-os-tab={tab.id}>{tab.label}</button>
                    ))}
                  </div>
                  {osTabs.map((tab, i) => (
                    <ol id={`os-panel-${tab.id}`} role="tabpanel" aria-labelledby={`os-tab-${tab.id}`} class="os-panel list-decimal pl-5 space-y-1 text-sm" data-os-panel={tab.id} hidden={i !== 0}>
                      {tab.steps.map(s => <li>{s}</li>)}
                    </ol>
                  ))}
                </div>
              )}
              {n === 3 && (
                <div class="space-y-2">
                  <p class="font-bold text-[#7a4a00] dark:text-[#fdd663]">The password doesn't work</p>
                  <p>Try the other common pairs: <span class="font-mono">admin / admin</span>, <span class="font-mono">admin / password</span>, <span class="font-mono">admin</span> with an empty password, or <span class="font-mono">user / user</span>.</p>
                  <p>Routers from an internet provider often use a password printed on the label, not a standard one.</p>
                  <p>As a last resort, hold the recessed <strong>Reset</strong> button with a paperclip for 10–15 seconds. That erases every setting, including your Wi-Fi name and password, so you'll set the router up from scratch.</p>
                </div>
              )}
              {n === 4 && (
                <div class="space-y-2">
                  <p class="font-bold text-[#7a4a00] dark:text-[#fdd663]">Can't find these settings?</p>
                  <p>Menu names differ by brand. Admin password sits under System, Administration or Management. Wi-Fi security sits under Wireless or WLAN.</p>
                  <p>Write the new passwords down somewhere safe before you save them.</p>
                </div>
              )}
            </div>

            <div class="flex flex-wrap items-center gap-2 pt-1">
              <button type="button" class="g-btn-primary" data-step-done>
                {n === 4 ? 'Finish' : 'Done, next step'}
              </button>
              <button type="button" class="g-btn-outlined" data-help-toggle aria-expanded="false" aria-controls={`step-panel-${n}`}>
                I'm stuck
              </button>
            </div>
          </div>
        </div>
      </li>
    ))}
  </ol>

  <p class="text-sm rounded-2xl bg-[#e8f0fe] dark:bg-[#1a3a60] text-[#174ea6] dark:text-[#d2e3fc] p-4 hidden" data-stepper-done>
    That's everything. If you get stuck later, reopen any step above.
  </p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-stepper]').forEach(root => {
    const steps = [...root.querySelectorAll<HTMLElement>('.step')];
    const count = root.querySelector<HTMLElement>('[data-step-count]')!;
    const bar = root.querySelector<HTMLElement>('[data-step-bar]')!;
    const finished = root.querySelector<HTMLElement>('[data-stepper-done]')!;
    const completed = new Set<number>();

    const open = (index: number, focus = false) => {
      steps.forEach((step, i) => {
        const toggle = step.querySelector<HTMLButtonElement>('[data-step-toggle]')!;
        const panel = step.querySelector<HTMLElement>('.step-panel')!;
        const chevron = step.querySelector<HTMLElement>('[data-step-chevron]')!;
        const isOpen = i === index;
        toggle.setAttribute('aria-expanded', String(isOpen));
        panel.hidden = !isOpen;
        chevron.classList.toggle('rotate-180', isOpen);
        step.classList.toggle('border-[#1a73e8]', isOpen);
        step.classList.toggle('dark:border-[#8ab4f8]', isOpen);
      });
      count.textContent = `Step ${index + 1} of ${steps.length}`;
      bar.style.width = `${((index + 1) / steps.length) * 100}%`;
      if (focus) steps[index].querySelector<HTMLButtonElement>('[data-step-toggle]')!.focus();
    };

    const markDone = (index: number) => {
      completed.add(index);
      const marker = steps[index].querySelector<HTMLElement>('.step-marker')!;
      marker.querySelector<HTMLElement>('[data-step-number]')!.classList.add('hidden');
      marker.querySelector<HTMLElement>('[data-step-check]')!.classList.remove('hidden');
      marker.classList.remove('bg-[#e8f0fe]', 'dark:bg-[#1a3a60]', 'text-[#1a73e8]', 'dark:text-[#8ab4f8]');
      marker.classList.add('bg-[#34a853]', 'text-white');
    };

    steps.forEach((step, i) => {
      step.querySelector<HTMLButtonElement>('[data-step-toggle]')!.addEventListener('click', () => {
        const isOpen = step.querySelector<HTMLElement>('.step-panel')!.hidden === false;
        open(isOpen ? -1 : i);
      });

      step.querySelector<HTMLButtonElement>('[data-step-done]')!.addEventListener('click', () => {
        markDone(i);
        if (i + 1 < steps.length) {
          open(i + 1, true);
        } else {
          open(-1);
          count.textContent = `All ${steps.length} steps done`;
          bar.style.width = '100%';
          finished.classList.remove('hidden');
          finished.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });

      const helpToggle = step.querySelector<HTMLButtonElement>('[data-help-toggle]');
      const help = step.querySelector<HTMLElement>('[data-help]');
      helpToggle?.addEventListener('click', () => {
        const show = help!.hidden;
        help!.hidden = !show;
        helpToggle.setAttribute('aria-expanded', String(show));
        helpToggle.textContent = show ? 'Hide help' : "I'm stuck";
      });
    });

    // "Find your gateway address" OS tabs
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-os-tab]')];
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          t.classList.toggle('bg-[#e8f0fe]', on);
          t.classList.toggle('dark:bg-[#1a3a60]', on);
          t.classList.toggle('text-[#1a73e8]', on);
          t.classList.toggle('dark:text-[#8ab4f8]', on);
        });
        root.querySelectorAll<HTMLElement>('[data-os-panel]').forEach(panel => {
          panel.hidden = panel.dataset.osPanel !== tab.dataset.osTab;
        });
      });
    });

    // Security checklist progress
    const checks = [...root.querySelectorAll<HTMLInputElement>('[data-secure-check]')];
    const secureDone = root.querySelector<HTMLElement>('[data-secure-done]');
    checks.forEach(check => check.addEventListener('change', () => {
      secureDone?.classList.toggle('hidden', !checks.every(c => c.checked));
    }));
  });
</script>
