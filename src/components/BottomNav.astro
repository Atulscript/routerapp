---
// App-style bottom navigation for phones (Material 3). Hidden from md upwards,
// where the header's own navigation takes over.
interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = currentPath.replace(base, '') || '/';

const items = [
  { label: 'Home', href: `${base}/`, active: path === '/', icon: 'home' },
  { label: 'Brands', href: `${base}/brands`, active: path.startsWith('/brands'), icon: 'tag' },
  { label: 'Gateways', href: `${base}/ip-addresses`, active: path.startsWith('/ip-addresses'), icon: 'globe' },
  { label: 'Routers', href: `${base}/routers`, active: path.startsWith('/routers'), icon: 'router' },
  { label: 'Tools', href: `${base}/tools`, active: path.startsWith('/tools'), icon: 'tools' },
];
---

<nav
  class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 dark:bg-[#202124]/95 backdrop-blur-md border-t border-[#dadce0] dark:border-[#3c4043] pb-[env(safe-area-inset-bottom)]"
  aria-label="Primary"
>
  <ul class="grid grid-cols-5">
    {items.map(item => (
      <li>
        <a
          href={item.href}
          aria-current={item.active ? 'page' : undefined}
          class={`group flex flex-col items-center gap-1 pt-2 pb-1.5 text-[11px] font-medium transition-colors ${
            item.active ? 'text-[#1a73e8] dark:text-[#8ab4f8]' : 'text-[#5f6368] dark:text-[#9aa0a6]'
          }`}
        >
          <span class={`flex items-center justify-center w-14 h-8 rounded-full transition-colors ${item.active ? 'bg-[#e8f0fe] dark:bg-[#1a3a60]' : 'group-active:bg-[#f1f3f4] dark:group-active:bg-[#3c4043]'}`}>
            {item.icon === 'home' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 10.5 9-7 9 7V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
            )}
            {item.icon === 'tag' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 13.4 12 22l-9-9V4a1 1 0 0 1 1-1h9z"/><circle cx="7.5" cy="7.5" r="1.3"/></svg>
            )}
            {item.icon === 'globe' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18Z"/></svg>
            )}
            {item.icon === 'router' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 16.5h.01M10 16.5h.01M12 13V9M8.8 6.8a4.5 4.5 0 0 1 6.4 0"/></svg>
            )}
            {item.icon === 'tools' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a4 4 0 0 0 5 5L21 21l-3-0-6.5-9.5a4 4 0 0 1-5-5z"/><path d="M3 21l6-6"/></svg>
            )}
          </span>
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
