---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div
  id="cookie-consent-banner"
  role="dialog"
  aria-live="polite"
  aria-labelledby="cookie-consent-title"
  aria-describedby="cookie-consent-text"
  hidden
  class="fixed z-50 inset-x-0 bottom-[4.25rem] md:bottom-0 bg-surface text-ink border-t border-line shadow-2xl"
>
  {/* A single row rather than a card. The card covered roughly a third of a
      phone screen on pages whose answer is near the top. */}
  <div class="max-w-6xl mx-auto px-4 py-2.5 flex flex-wrap items-center gap-x-4 gap-y-2">
    <h2 id="cookie-consent-title" class="sr-only">Cookies on this site</h2>
    <p id="cookie-consent-text" class="flex-1 min-w-[15rem] text-xs leading-snug text-ink-muted">
      We use cookies to show ads through Google AdSense and to measure how the site is used.
      <a href={`${base}/privacy-policy`} class="font-medium text-accent underline underline-offset-2">Privacy policy</a>
    </p>
    <div class="flex items-center gap-2 flex-shrink-0">
      <button id="decline-cookies-btn" type="button" class="h-8 px-3.5 rounded-full text-xs font-medium bg-surface-muted hover:bg-surface-raised transition-colors">
        Necessary only
      </button>
      <button id="accept-cookies-btn" type="button" class="h-8 px-3.5 rounded-full text-xs font-medium bg-accent hover:bg-accent-hover text-white transition-colors">
        Accept all
      </button>
    </div>
  </div>
</div>

<!-- Decide visibility before first paint, so the banner never pops in late -->
<script is:inline>
  try {
    if (!localStorage.getItem('cookie_consent_routersync')) document.getElementById('cookie-consent-banner').hidden = false;
  } catch (e) {}
</script>

<script>
  const KEY = 'cookie_consent_routersync';
  const banner = document.getElementById('cookie-consent-banner');

  let stored: string | null = null;
  try { stored = localStorage.getItem(KEY); } catch {}

  if (banner && !stored) {
    const choose = (value: string) => {
      try { localStorage.setItem(KEY, value); } catch {}
      banner.hidden = true;
    };
    document.getElementById('accept-cookies-btn')?.addEventListener('click', () => choose('accepted'));
    document.getElementById('decline-cookies-btn')?.addEventListener('click', () => choose('declined'));
  }
</script>
