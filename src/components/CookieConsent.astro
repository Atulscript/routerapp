---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div
  id="cookie-consent-banner"
  role="dialog"
  aria-live="polite"
  aria-labelledby="cookie-consent-title"
  aria-describedby="cookie-consent-text"
  hidden
  class="fixed z-50 inset-x-3 bottom-[5.5rem] md:bottom-3 sm:inset-x-auto sm:right-5 sm:bottom-5 sm:max-w-sm bg-white dark:bg-[#292a2d] text-[#202124] dark:text-[#e8eaed] rounded-2xl border border-[#dadce0] dark:border-[#5f6368] shadow-2xl p-4 sm:p-5"
>
  <h2 id="cookie-consent-title" class="text-sm font-bold">Cookies on this site</h2>
  <p id="cookie-consent-text" class="mt-1.5 text-sm leading-relaxed text-[#5f6368] dark:text-[#bdc1c6]">
    We use cookies to show ads through Google AdSense and to measure how the site is used.
    <a href={`${base}/privacy-policy`} class="font-medium text-[#1a73e8] dark:text-[#8ab4f8] underline underline-offset-2">Privacy policy</a>
  </p>
  <div class="mt-4 grid grid-cols-2 gap-2">
    <button id="decline-cookies-btn" type="button" class="h-10 rounded-full text-sm font-medium bg-[#f1f3f4] dark:bg-[#3c4043] hover:bg-[#e8eaed] dark:hover:bg-[#4a4d51] transition-colors">
      Necessary only
    </button>
    <button id="accept-cookies-btn" type="button" class="h-10 rounded-full text-sm font-medium bg-[#1a73e8] hover:bg-[#1557b0] text-white transition-colors">
      Accept all
    </button>
  </div>
</div>

<!-- Decide visibility before first paint, so the banner never pops in late -->
<script is:inline>
  try {
    if (!localStorage.getItem('cookie_consent_routersync')) document.getElementById('cookie-consent-banner').hidden = false;
  } catch (e) {}
</script>

<script>
  const KEY = 'cookie_consent_routersync';
  const banner = document.getElementById('cookie-consent-banner');

  let stored: string | null = null;
  try { stored = localStorage.getItem(KEY); } catch {}

  if (banner && !stored) {
    const choose = (value: string) => {
      try { localStorage.setItem(KEY, value); } catch {}
      banner.hidden = true;
    };
    document.getElementById('accept-cookies-btn')?.addEventListener('click', () => choose('accepted'));
    document.getElementById('decline-cookies-btn')?.addEventListener('click', () => choose('declined'));
  }
</script>
