---
// "Find my router": probes common gateway addresses from the visitor's browser.
// Browsers limit requests from a website to devices on the local network (mixed content,
// Chrome's Local Network Access prompt, Safari/Firefox blocking), so every outcome is explained
// and there is always a manual "Open" fallback.
import { GATEWAY_IPS } from '../lib/data-loader';

interface Props {
  /** Address to check first and highlight, e.g. on the 192.168.0.1 page */
  focusIp?: string;
  limit?: number;
  class?: string;
  /** Two columns of addresses; only for full-width placements */
  wide?: boolean;
}

const { focusIp, limit = 12, class: className = '', wide = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const ordered = focusIp
  ? [...GATEWAY_IPS.filter(g => g.ip === focusIp), ...GATEWAY_IPS.filter(g => g.ip !== focusIp)]
  : GATEWAY_IPS;
const candidates = ordered.slice(0, limit).map(g => ({
  ip: g.ip,
  href: g.slug === '192-168-1-1' ? `${base}/` : `${base}/${g.slug}`,
  brands: g.commonBrands.slice(0, 3).join(', '),
  user: g.defaultUser,
  pass: g.defaultPass,
}));
const uid = `rc-${Math.random().toString(36).slice(2, 8)}`;
const hiddenCount = GATEWAY_IPS.length - candidates.length;
---

<section id={uid} class={`router-checker g-card p-5 sm:p-6 flex flex-col gap-4 ${className}`} aria-labelledby={`${uid}-title`} data-router-checker>
  <div class="flex items-start gap-3">
    <span class="w-11 h-11 rounded-2xl bg-[#e8f0fe] dark:bg-[#1a3a60] text-[#1a73e8] dark:text-[#8ab4f8] flex items-center justify-center flex-shrink-0" aria-hidden="true">
      <!-- radar -->
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M19.07 4.93A10 10 0 1 0 22 12"/><path d="M16.24 7.76A6 6 0 1 0 18 12"/><circle cx="12" cy="12" r="2"/><path d="m13.4 10.6 6.2-6.2"/></svg>
    </span>
    <div class="min-w-0">
      <h2 id={`${uid}-title`} class="text-lg font-bold text-[#202124] dark:text-white">
        {focusIp ? `Is ${focusIp} your router?` : 'Find my router'}
      </h2>
      <p class="text-sm text-[#5f6368] dark:text-[#bdc1c6] mt-0.5">
        Checks {candidates.length} common router addresses from this browser. Connect to your home Wi-Fi first.
      </p>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <button type="button" class="g-btn-primary" data-scan>
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>
      <span data-scan-label>{focusIp ? `Check ${focusIp}` : 'Scan my network'}</span>
    </button>
    <span class="text-xs text-[#5f6368] dark:text-[#9aa0a6] flex items-center gap-1.5">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
      Runs in your browser. Nothing is sent to our servers.
    </span>
  </div>

  <!-- Material linear progress -->
  <div class="h-1 rounded-full bg-[#e8f0fe] dark:bg-[#1a3a60] overflow-hidden opacity-0 transition-opacity" data-progress-track aria-hidden="true">
    <div class="h-full w-0 bg-[#1a73e8] dark:bg-[#8ab4f8] rounded-full transition-[width] duration-300" data-progress-bar></div>
  </div>

  <!-- Summary appears after a scan -->
  <div class="hidden rounded-2xl p-4 text-sm" data-summary role="status" aria-live="polite"></div>

  <ul class={`grid grid-cols-1 ${wide ? "sm:grid-cols-2" : ""} gap-2 content-start`} data-list>
    {candidates.map((c, i) => (
      <li
        class={`checker-row flex items-center gap-3 rounded-2xl border px-3.5 py-2.5 transition-colors ${c.ip === focusIp ? 'border-[#1a73e8]/40 dark:border-[#8ab4f8]/40 bg-[#f8fafd] dark:bg-[#202124]' : 'border-[#e8eaed] dark:border-[#3c4043]'}`}
        data-ip={c.ip}
        data-href={c.href}
        data-user={c.user}
        data-pass={c.pass}
      >
        <span class="status-dot w-2.5 h-2.5 rounded-full bg-[#dadce0] dark:bg-[#5f6368] flex-shrink-0" aria-hidden="true"></span>
        <span class="min-w-0 flex-1">
          <a href={c.href} class="block truncate font-mono text-sm font-bold text-[#202124] dark:text-white hover:text-[#1a73e8] dark:hover:text-[#8ab4f8]">{c.ip}</a>
          <span class="block text-xs text-[#5f6368] dark:text-[#9aa0a6] truncate" data-status-text>{c.brands}</span>
        </span>
        <a
          href={`http://${c.ip}`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-shrink-0 inline-flex items-center gap-1 h-9 px-3 rounded-full text-sm font-medium text-[#1a73e8] dark:text-[#8ab4f8] hover:bg-[#e8f0fe] dark:hover:bg-[#1a3a60] transition-colors"
          aria-label={`Open ${c.ip} in a new tab`}
        >
          Open <span aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ul>

  {hiddenCount > 0 && (
    <a href={`${base}/ip-addresses`} class="mt-auto text-sm font-medium text-[#1a73e8] dark:text-[#8ab4f8] hover:underline">
      See all {GATEWAY_IPS.length} gateway addresses →
    </a>
  )}
</section>

<script>
  type Outcome = 'found' | 'timeout' | 'none';

  // A router answering on port 80 resolves an opaque no-cors request. A missing device times out.
  // A request the browser refuses to send fails almost instantly, which is how "blocked" is told apart.
  async function probe(ip: string): Promise<{ outcome: Outcome; ms: number }> {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), 3000);
    const started = performance.now();
    try {
      await fetch(`http://${ip}/`, {
        mode: 'no-cors',
        cache: 'no-store',
        signal: controller.signal,
        // Chrome's Local Network Access: lets an https page ask permission to reach the home network
        ...({ targetAddressSpace: 'local' } as RequestInit),
      });
      return { outcome: 'found', ms: performance.now() - started };
    } catch (err) {
      const ms = performance.now() - started;
      // A single instant failure can mean "no device" or "browser refused"; only the whole-scan
      // pattern tells them apart, so each row just reports "no answer".
      return { outcome: (err as Error).name === 'AbortError' ? 'timeout' : 'none', ms };
    } finally {
      clearTimeout(timer);
    }
  }

  const STATUS: Record<Outcome | 'checking', { dot: string; text: string; row?: string }> = {
    checking: { dot: 'bg-[#1a73e8] animate-pulse', text: 'Checking…' },
    found: { dot: 'bg-[#34a853]', text: 'Answered: a router is here', row: 'border-[#34a853] bg-[#e6f4ea] dark:bg-[#133e24]' },
    timeout: { dot: 'bg-[#dadce0] dark:bg-[#5f6368]', text: 'No answer' },
    none: { dot: 'bg-[#dadce0] dark:bg-[#5f6368]', text: 'No answer' },
  };
  const DOT_CLASSES = ['bg-[#dadce0]', 'dark:bg-[#5f6368]', 'bg-[#1a73e8]', 'animate-pulse', 'bg-[#34a853]'];
  const ROW_CLASSES = ['border-[#34a853]', 'bg-[#e6f4ea]', 'dark:bg-[#133e24]'];

  const escapeHtml = (s: string) => s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

  document.querySelectorAll<HTMLElement>('[data-router-checker]').forEach(root => {
    const button = root.querySelector<HTMLButtonElement>('[data-scan]')!;
    const label = root.querySelector<HTMLElement>('[data-scan-label]')!;
    const track = root.querySelector<HTMLElement>('[data-progress-track]')!;
    const bar = root.querySelector<HTMLElement>('[data-progress-bar]')!;
    const summary = root.querySelector<HTMLElement>('[data-summary]')!;
    const rows = [...root.querySelectorAll<HTMLElement>('.checker-row')];
    const originalLabel = label.textContent;

    const setRow = (row: HTMLElement, state: Outcome | 'checking') => {
      const s = STATUS[state];
      const dot = row.querySelector<HTMLElement>('.status-dot')!;
      dot.classList.remove(...DOT_CLASSES);
      dot.classList.add(...s.dot.split(' '));
      row.classList.remove(...ROW_CLASSES);
      if (s.row) row.classList.add(...s.row.split(' '));
      row.querySelector<HTMLElement>('[data-status-text]')!.textContent = s.text;
    };

    const showSummary = (tone: 'success' | 'info' | 'warning', html: string) => {
      const tones = {
        success: 'bg-[#e6f4ea] dark:bg-[#133e24] text-[#0d652d] dark:text-[#ceead6]',
        info: 'bg-[#f1f3f4] dark:bg-[#303134] text-[#3c4043] dark:text-[#e8eaed]',
        warning: 'bg-[#fef7e0] dark:bg-[#332a00] text-[#7a4a00] dark:text-[#fdd663]',
      };
      summary.className = `rounded-2xl p-4 text-sm leading-relaxed ${tones[tone]}`;
      summary.innerHTML = html;
    };

    button.addEventListener('click', async () => {
      button.disabled = true;
      label.textContent = 'Checking…';
      summary.classList.add('hidden');
      track.classList.remove('opacity-0');
      bar.style.width = '0%';
      rows.forEach(r => setRow(r, 'checking'));

      let done = 0;
      const results = await Promise.all(rows.map(async row => {
        const { outcome, ms } = await probe(row.dataset.ip!);
        setRow(row, outcome);
        bar.style.width = `${Math.round((++done / rows.length) * 100)}%`;
        return { row, outcome, ms };
      }));

      const found = results.filter(r => r.outcome === 'found');
      // Every address failing within a few milliseconds means the browser never sent the requests.
      const blockedByBrowser = !found.length && results.every(r => r.outcome === 'none' && r.ms < 60);

      if (found.length) {
        const { row } = found[0];
        const ip = escapeHtml(row.dataset.ip!);
        showSummary('success', `
          <p class="font-bold text-base">Your router is probably at <span class="font-mono">${ip}</span></p>
          <p class="mt-1">Try username <strong class="font-mono">${escapeHtml(row.dataset.user || 'admin')}</strong> with password <strong class="font-mono">${escapeHtml(row.dataset.pass || 'admin')}</strong>. The sticker on the router has the exact details.</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <a href="http://${ip}" target="_blank" rel="noopener noreferrer" class="g-btn-primary">Open ${ip} ↗</a>
            <a href="${row.dataset.href}" class="g-btn-outlined">Login guide for ${ip}</a>
          </div>
          ${found.length > 1 ? `<p class="mt-2 text-xs">${found.length} addresses answered. If ${ip} isn't your router, try the other green ones below.</p>` : ''}`);
      } else if (blockedByBrowser) {
        showSummary('warning', `
          <p class="font-bold">Your browser didn't allow the check</p>
          <p class="mt-1">Browsers limit websites from reaching devices on your home network. In Chrome, allow <em>Local network access</em> if asked and try again. On Safari, Firefox or a phone, use the <strong>Open</strong> buttons below one by one: the one that shows a login page is your router.</p>`);
      } else {
        showSummary('info', `
          <p class="font-bold">No router answered</p>
          <ul class="mt-1 list-disc pl-5 space-y-0.5">
            <li>Make sure this device is on your router's Wi-Fi or plugged in with a cable.</li>
            <li>Turn off VPN and mobile data, then scan again.</li>
            <li>Still nothing? Find the exact address in step 2 of the guide below.</li>
          </ul>`);
      }

      summary.classList.remove('hidden');
      label.textContent = 'Scan again';
      button.disabled = false;
      setTimeout(() => track.classList.add('opacity-0'), 600);
    });

    // Let other parts of the page start a scan, e.g. a "Check this address" button in the hero.
    root.addEventListener('router-checker:scan', () => { if (!button.disabled) button.click(); });
    void originalLabel;
  });
</script>
