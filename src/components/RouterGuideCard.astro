---
interface Props {
  entityName: string;
  ipAddress: string;
  brandName?: string;
  customSuggestion?: string;
}

const { 
  entityName, 
  ipAddress, 
  brandName = entityName,
  customSuggestion 
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="space-y-6 my-6 font-sans">
  
  <!-- Box 1: Router Login Guide -->
  <div class="g-card p-5 sm:p-7 space-y-5">
    <div class="flex items-center justify-between border-b border-[#e8eaed] dark:border-[#3c4043] pb-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-[#e8f0fe] dark:bg-[#1a3a60] text-[#1a73e8] dark:text-[#8ab4f8] flex items-center justify-center text-lg font-bold">
          🔑
        </div>
        <div>
          <h2 class="text-base sm:text-lg font-bold text-[#202124] dark:text-white tracking-tight">
            How to Log In to {entityName} @ {ipAddress}
          </h2>
          <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6]">Universal router access instructions</p>
        </div>
      </div>
      <span class="inline-flex items-center gap-1.5 text-xs font-bold text-[#1a73e8] dark:text-[#8ab4f8] bg-[#e8f0fe] dark:bg-[#1a3a60] border border-[#d2e3fc] dark:border-[#1a73e8] px-3 py-1 rounded-full shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-[#1a73e8]"></span>
        3 Quick Steps
      </span>
    </div>

    <div class="space-y-3.5">
      <!-- Step 1 (Google Blue) -->
      <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-[#f8fafd] dark:bg-[#202124] border border-[#e8eaed] dark:border-[#3c4043] transition-colors">
        <div class="w-8 h-8 rounded-full bg-[#1a73e8] text-white flex-shrink-0 flex items-center justify-center text-xs font-bold shadow-xs">
          1
        </div>
        <div class="text-xs text-[#3c4043] dark:text-[#e8eaed] space-y-1.5 flex-1">
          <p class="font-bold text-[#202124] dark:text-white text-sm">Connect your device to the router</p>
          <p class="text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed text-xs">
            Make sure your PC, laptop, or smartphone is connected via an <strong>RJ-45 Ethernet cable</strong> or to the router's <strong>Wi-Fi network</strong> SSID.
          </p>
          <div class="mt-2 p-2.5 bg-white dark:bg-[#303134] rounded-xl border border-[#dadce0] dark:border-[#5f6368] text-xs text-[#3c4043] dark:text-[#e8eaed] flex items-center gap-2 shadow-2xs">
            <span class="text-[#f9ab00] text-sm">💡</span>
            <div><strong class="text-[#202124] dark:text-white font-bold">Pro Tip:</strong> {customSuggestion || `Using an Ethernet cable provides a direct link and prevents signal dropouts during setup.`}</div>
          </div>
        </div>
      </div>

      <!-- Step 2 (Google Green) -->
      <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-[#f8fafd] dark:bg-[#202124] border border-[#e8eaed] dark:border-[#3c4043] transition-colors">
        <div class="w-8 h-8 rounded-full bg-[#34a853] text-white flex-shrink-0 flex items-center justify-center text-xs font-bold shadow-xs">
          2
        </div>
        <div class="text-xs text-[#3c4043] dark:text-[#e8eaed] space-y-1.5 flex-1">
          <p class="font-bold text-[#202124] dark:text-white text-sm">Open your web browser and navigate to {ipAddress}</p>
          <p class="text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed text-xs">
            Open Chrome, Safari, Edge, or Firefox and type <code class="font-mono bg-white dark:bg-[#303134] px-2 py-0.5 rounded border border-[#dadce0] dark:border-[#5f6368] font-bold text-[#1a73e8] dark:text-[#8ab4f8] shadow-2xs">http://{ipAddress}</code> into the URL bar, then press <strong>Enter</strong>.
          </p>
        </div>
      </div>

      <!-- Step 3 (Google Yellow) -->
      <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-[#f8fafd] dark:bg-[#202124] border border-[#e8eaed] dark:border-[#3c4043] transition-colors">
        <div class="w-8 h-8 rounded-full bg-[#f9ab00] text-white flex-shrink-0 flex items-center justify-center text-xs font-bold shadow-xs">
          3
        </div>
        <div class="text-xs text-[#3c4043] dark:text-[#e8eaed] space-y-1.5 flex-1">
          <p class="font-bold text-[#202124] dark:text-white text-sm">Enter factory default username & password</p>
          <p class="text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed text-xs">
            When prompted by the login dialog, input the default credentials (usually <code class="font-mono bg-white dark:bg-[#303134] px-1.5 py-0.5 rounded border border-[#dadce0] dark:border-[#5f6368] text-[#202124] dark:text-[#e8eaed] font-medium">admin / admin</code> or <code class="font-mono bg-white dark:bg-[#303134] px-1.5 py-0.5 rounded border border-[#dadce0] dark:border-[#5f6368] text-[#202124] dark:text-[#e8eaed] font-medium">admin / password</code>).
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Box 2: Routers Support & Troubleshooting -->
  <div class="g-card p-5 sm:p-7 space-y-5">
    <div class="flex items-center justify-between border-b border-[#e8eaed] dark:border-[#3c4043] pb-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-[#fef7e0] dark:bg-[#4d3800] text-[#f9ab00] dark:text-[#fdd663] flex items-center justify-center text-lg font-bold">
          🛠️
        </div>
        <div>
          <h2 class="text-base sm:text-lg font-bold text-[#202124] dark:text-white tracking-tight">
            {entityName} @ {ipAddress} Support & Troubleshooting
          </h2>
          <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6]">Quick fixes for common connection issues</p>
        </div>
      </div>
      <span class="inline-flex items-center gap-1.5 text-xs font-bold text-[#b06000] dark:text-[#fdd663] bg-[#fef7e0] dark:bg-[#4d3800] border border-[#fbbc04]/60 dark:border-[#fbbc04]/40 px-3 py-1 rounded-full shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-[#f9ab00]"></span>
        Diagnostics
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 text-xs">
      <div class="p-4 rounded-2xl bg-[#f8fafd] dark:bg-[#202124] border border-[#e8eaed] dark:border-[#3c4043] space-y-1.5">
        <div class="flex items-center gap-1.5 text-[#202124] dark:text-white font-bold text-xs">
          <span>🔄</span>
          <span>Forgotten Admin Password?</span>
        </div>
        <p class="text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed text-xs">
          Locate the physical <strong>RESET pinhole button</strong> on the router's rear panel. Press and hold with a paperclip for 10-15 seconds until all LED lights flash. This restores default factory credentials.
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-[#f8fafd] dark:bg-[#202124] border border-[#e8eaed] dark:border-[#3c4043] space-y-1.5">
        <div class="flex items-center gap-1.5 text-[#202124] dark:text-white font-bold text-xs">
          <span>⚠️</span>
          <span>{ipAddress} Refuses to Connect?</span>
        </div>
        <p class="text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed text-xs">
          Disable mobile data on your phone and disconnect active VPN connections. Confirm your router's exact gateway IP using our <a href={`${base}/what-is-my-ip`} class="text-[#1a73e8] dark:text-[#8ab4f8] font-bold underline">Gateway Finder Tool</a>.
        </p>
      </div>
    </div>
  </div>

</div>
