---
interface Props {
  entityName: string;
  ipAddress: string;
  brandName?: string;
  customSuggestion?: string;
}

const { 
  entityName, 
  ipAddress, 
  brandName = entityName,
  customSuggestion 
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="space-y-4 my-4 font-sans">
  
  <!-- Box 1: Router Login Guide -->
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-card p-4 sm:p-6 space-y-4">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <div class="flex items-center gap-2">
        <span class="w-7 h-7 rounded-lg bg-brand-50 text-brand-700 flex items-center justify-center text-sm font-bold">
          🔑
        </span>
        <h2 class="text-base sm:text-lg font-bold text-slate-900">
          How to Log In to {entityName} @ {ipAddress}
        </h2>
      </div>
      <span class="text-[11px] font-semibold text-slate-500 bg-slate-100 px-2.5 py-0.5 rounded-full">
        Step-by-Step
      </span>
    </div>

    <p class="text-xs text-slate-600 leading-relaxed">
      Follow these three steps to access the web-based management dashboard of your <strong>{entityName}</strong> router at <strong>http://{ipAddress}</strong>:
    </p>

    <div class="space-y-3">
      <!-- Step 1 -->
      <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-50/70 border border-slate-100">
        <span class="w-6 h-6 rounded-full bg-slate-900 text-white flex-shrink-0 flex items-center justify-center text-[11px] font-bold">
          1
        </span>
        <div class="text-xs text-slate-700 space-y-1">
          <p class="font-semibold text-slate-900">Connect your device to the router</p>
          <p class="text-slate-600 leading-relaxed">
            Ensure your computer or phone is connected via Ethernet cable or to the router's Wi-Fi network.
          </p>
          <div class="mt-1.5 p-2 bg-white rounded-lg border border-slate-200 text-[11px] text-slate-600">
            💡 <strong class="text-slate-800">Pro Tip:</strong> {customSuggestion || `Using an Ethernet cable ensures a stable setup without accidental disconnections during firmware updates.`}
          </div>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-50/70 border border-slate-100">
        <span class="w-6 h-6 rounded-full bg-slate-900 text-white flex-shrink-0 flex items-center justify-center text-[11px] font-bold">
          2
        </span>
        <div class="text-xs text-slate-700 space-y-1">
          <p class="font-semibold text-slate-900">Open your web browser and navigate to {ipAddress}</p>
          <p class="text-slate-600 leading-relaxed">
            Type <code class="font-mono bg-white px-1.5 py-0.5 rounded border border-slate-200 font-bold text-brand-700">http://{ipAddress}</code> in your browser's address bar and press Enter.
          </p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-50/70 border border-slate-100">
        <span class="w-6 h-6 rounded-full bg-slate-900 text-white flex-shrink-0 flex items-center justify-center text-[11px] font-bold">
          3
        </span>
        <div class="text-xs text-slate-700 space-y-1">
          <p class="font-semibold text-slate-900">Enter factory default username and password</p>
          <p class="text-slate-600 leading-relaxed">
            Enter the default credentials (usually <code class="font-mono bg-white px-1 py-0.5 rounded border border-slate-200">admin / admin</code> or <code class="font-mono bg-white px-1 py-0.5 rounded border border-slate-200">admin / password</code>) to open the control panel.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Box 2: Routers Support -->
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-card p-4 sm:p-6 space-y-4">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <div class="flex items-center gap-2">
        <span class="w-7 h-7 rounded-lg bg-amber-50 text-amber-700 flex items-center justify-center text-sm font-bold">
          🛠️
        </span>
        <h2 class="text-base sm:text-lg font-bold text-slate-900">
          {entityName} @ {ipAddress} Support & Troubleshooting
        </h2>
      </div>
      <span class="text-[11px] font-semibold text-slate-500 bg-slate-100 px-2.5 py-0.5 rounded-full">
        Help Guide
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
      <div class="p-3 rounded-xl bg-slate-50/70 border border-slate-100 space-y-1">
        <strong class="text-slate-900 block font-semibold">Forgotten Admin Password?</strong>
        <p class="text-slate-600 leading-relaxed">
          Press and hold the physical <strong>RESET</strong> button on the back of the router for 10 seconds to restore factory default settings.
        </p>
      </div>

      <div class="p-3 rounded-xl bg-slate-50/70 border border-slate-100 space-y-1">
        <strong class="text-slate-900 block font-semibold">192.168.1.1 Not Opening?</strong>
        <p class="text-slate-600 leading-relaxed">
          Make sure your device is connected to the right Wi-Fi SSID and not on cellular mobile data. Check our <a href={`${base}/ip-addresses`} class="text-brand-600 font-semibold underline hover:text-brand-800">gateway IP list</a> to confirm your address.
        </p>
      </div>
    </div>
  </div>

</div>
