---
// Small model thumbnail for table rows: the product photo when we have one,
// otherwise a neutral router mark so every row looks complete.
import { getModelPhoto } from '../lib/model-images';
import RouterGlyph from './RouterGlyph.astro';

interface Props {
  slug?: string | null;
  name: string;
  class?: string;
}

const { slug, name, class: className = '' } = Astro.props;
const photo = getModelPhoto(slug);
---

{photo ? (
  <img
    src={photo.url}
    alt=""
    width="32"
    height="24"
    loading="lazy"
    decoding="async"
    class={`w-8 h-6 object-contain rounded-lg bg-white border border-[#e8eaed] dark:border-[#5f6368] flex-shrink-0 ${className}`}
  />
) : (
  <span
    class={`w-8 h-6 rounded-md bg-surface-muted border border-[#e8eaed] dark:border-[#5f6368] text-ink-muted flex items-center justify-center flex-shrink-0 ${className}`}
    role="img"
    aria-label={`${name} (no photo available)`}
  >
    <RouterGlyph class="w-5 h-5" />
  </span>
)}
