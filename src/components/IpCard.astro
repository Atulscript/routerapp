---
import type { GatewayIp } from '../lib/types';
import { getBrandSlug } from '../lib/data-loader';

interface Props {
  data: GatewayIp;
}

const { data } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageUrl = (data.slug === '192-168-1-1' || data.ip === '192.168.1.1') ? `${base}/` : `${base}/${data.slug}`;
---

<div class="group g-card p-4 sm:p-5 flex flex-col justify-between">
  <div>
    <div class="flex items-center justify-between mb-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-bold bg-[#e8f0fe] dark:bg-[#1a3a60] text-[#1a73e8] dark:text-[#8ab4f8] border border-[#d2e3fc] dark:border-[#1a73e8] shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-[#34a853] animate-pulse"></span>
        {data.ip}
      </span>
      <span class="text-[10px] font-bold uppercase tracking-wider text-[#5f6368] dark:text-[#9aa0a6] bg-[#f1f3f4] dark:bg-[#303134] px-2 py-0.5 rounded-full border border-[#dadce0] dark:border-[#5f6368]">
        Gateway
      </span>
    </div>

    <h3 class="text-base font-bold text-[#202124] dark:text-white group-hover:text-[#1a73e8] dark:group-hover:text-[#8ab4f8] transition-colors mb-2">
      <a href={pageUrl} class="flex items-center justify-between">
        <span>{data.ip} Admin Login</span>
        <span class="text-[#80868b] group-hover:text-[#1a73e8] dark:group-hover:text-[#8ab4f8] group-hover:translate-x-1 transition-all">→</span>
      </a>
    </h3>

    <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] line-clamp-2 mb-3 leading-relaxed">
      {data.description}
    </p>

    <!-- Clickable Brand Links for this Gateway IP -->
    {data.commonBrands && data.commonBrands.length > 0 && (
      <div class="mb-3">
        <span class="text-[10px] font-bold uppercase tracking-wider text-[#5f6368] dark:text-[#9aa0a6] block mb-1.5">Common Routers:</span>
        <div class="flex flex-wrap gap-1">
          {data.commonBrands.map(brandName => {
            const bSlug = getBrandSlug(brandName);
            return bSlug ? (
              <a 
                href={`${base}/${bSlug}`} 
                class="text-[10px] px-2 py-0.5 rounded-full bg-[#f1f3f4] dark:bg-[#303134] hover:bg-[#e8f0fe] dark:hover:bg-[#1a3a60] text-[#3c4043] dark:text-[#e8eaed] hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] font-semibold border border-[#dadce0] dark:border-[#5f6368] transition-colors"
              >
                {brandName}
              </a>
            ) : (
              <span class="text-[10px] px-2 py-0.5 rounded-full bg-[#f1f3f4] dark:bg-[#303134] text-[#5f6368] dark:text-[#9aa0a6] font-medium border border-[#dadce0] dark:border-[#5f6368]">
                {brandName}
              </span>
            );
          })}
        </div>
      </div>
    )}

    <!-- Quick Credentials -->
    <div class="p-2.5 rounded-xl bg-[#f8fafd] dark:bg-[#202124] border border-[#e8eaed] dark:border-[#3c4043] mb-3 text-xs space-y-1">
      <div class="flex justify-between items-center font-mono text-[11px]">
        <span class="text-[#5f6368] dark:text-[#9aa0a6]">Default User:</span>
        <span class="font-bold text-[#202124] dark:text-white bg-white dark:bg-[#303134] px-1.5 py-0.5 rounded border border-[#dadce0] dark:border-[#5f6368]">{data.defaultUser}</span>
      </div>
      <div class="flex justify-between items-center font-mono text-[11px]">
        <span class="text-[#5f6368] dark:text-[#9aa0a6]">Default Pass:</span>
        <span class="font-bold text-[#137333] dark:text-[#81c995] bg-[#e6f4ea] dark:bg-[#137333]/20 px-1.5 py-0.5 rounded border border-[#ceead6] dark:border-[#137333]/40">{data.defaultPass}</span>
      </div>
    </div>
  </div>

  <div class="pt-2.5 border-t border-[#e8eaed] dark:border-[#3c4043] flex items-center justify-between">
    <a 
      href={`http://${data.ip}`} 
      target="_blank" 
      rel="noopener noreferrer"
      class="text-[11px] font-medium text-[#5f6368] dark:text-[#9aa0a6] hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] inline-flex items-center gap-1"
    >
      Open http://{data.ip} ↗
    </a>
    <a 
      href={pageUrl}
      class="text-xs font-bold text-[#1a73e8] dark:text-[#8ab4f8] group-hover:underline inline-flex items-center gap-1"
    >
      Setup Guide →
    </a>
  </div>
</div>
