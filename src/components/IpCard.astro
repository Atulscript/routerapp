---
import type { GatewayIp } from '../lib/types';

interface Props {
  data: GatewayIp;
}

const { data } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm hover:shadow-md hover:border-brand-300 transition-all flex flex-col justify-between group">
  <div>
    <div class="flex items-center justify-between mb-3">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold font-mono bg-sky-50 text-sky-700 border border-sky-200">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        {data.ip}
      </span>
      <span class="text-xs font-semibold text-slate-700">Gateway IP</span>
    </div>

    <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-600 transition-colors mb-2">
      <a href={`${base}/${data.slug}`} class="focus:outline-none">
        {data.ip} Admin Login
      </a>
    </h3>

    <p class="text-xs text-slate-500 line-clamp-2 mb-4 leading-relaxed">
      {data.description}
    </p>

    <div class="bg-slate-50 rounded-xl p-3 border border-slate-100 mb-4 space-y-1.5 text-xs font-mono">
      <div class="flex justify-between">
        <span class="text-slate-700 font-sans">User:</span>
        <span class="font-bold text-slate-700">{data.defaultUser}</span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-700 font-sans">Pass:</span>
        <span class="font-bold text-slate-700">{data.defaultPass}</span>
      </div>
    </div>
  </div>

  <div class="pt-2 border-t border-slate-100 flex items-center justify-between">
    <a 
      href={`http://${data.ip}`} 
      target="_blank" 
      rel="noopener noreferrer"
      class="text-xs font-semibold text-slate-600 hover:text-brand-600 flex items-center gap-1"
    >
      Open IP ↗
    </a>
    <a 
      href={`${base}/${data.slug}`} 
      class="text-xs font-bold text-brand-600 hover:text-brand-700 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
    >
      Full Guide →
    </a>
  </div>
</div>
