---
import type { GatewayIp } from '../lib/types';

interface Props {
  data: GatewayIp;
}

const { data } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageUrl = (data.slug === '192-168-1-1' || data.ip === '192.168.1.1') ? `${base}/` : `${base}/${data.slug}`;
---

<div class="bg-white rounded-xl border border-slate-200/80 p-4 shadow-card hover:shadow-card-hover hover:border-slate-300 transition-all flex flex-col justify-between">
  <div>
    <div class="flex items-center justify-between mb-2">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-sky-50 text-brand-700 border border-sky-200">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        {data.ip}
      </span>
      <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Gateway</span>
    </div>

    <h3 class="text-base font-bold text-slate-900 hover:text-brand-600 transition-colors mb-1.5">
      <a href={pageUrl}>
        {data.ip} Admin Login
      </a>
    </h3>

    <p class="text-xs text-slate-500 line-clamp-2 mb-3 leading-relaxed">
      {data.description}
    </p>

    <!-- Credential Box -->
    <div class="bg-slate-50 rounded-lg p-2.5 border border-slate-100 mb-3 space-y-1 text-xs font-mono">
      <div class="flex justify-between">
        <span class="text-slate-500 font-sans text-[11px]">User:</span>
        <span class="font-bold text-slate-800">{data.defaultUser}</span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-500 font-sans text-[11px]">Pass:</span>
        <span class="font-bold text-slate-800">{data.defaultPass}</span>
      </div>
    </div>
  </div>

  <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs">
    <a 
      href={`http://${data.ip}`} 
      target="_blank" 
      rel="noopener noreferrer"
      class="text-slate-500 hover:text-slate-900 font-medium flex items-center gap-0.5 text-[11px]"
    >
      Open IP ↗
    </a>
    <a 
      href={pageUrl} 
      class="font-semibold text-brand-600 hover:text-brand-800 text-[11px]"
    >
      Guide →
    </a>
  </div>
</div>
