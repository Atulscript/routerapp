---
import type { GatewayIp } from '../lib/types';

interface Props {
  data: GatewayIp;
}

const { data } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="m3-card p-6 flex flex-col justify-between group hover:border-md-primary/60 transition-all">
  <div>
    <div class="flex items-center justify-between mb-3">
      <span class="m3-chip m3-chip-tonal text-xs font-mono font-bold bg-md-primary-container text-md-on-primary-container">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        {data.ip}
      </span>
      <span class="text-[11px] font-bold uppercase tracking-wider text-md-on-surface-variant">Default Gateway</span>
    </div>

    <h3 class="text-lg font-bold text-md-on-surface group-hover:text-md-primary transition-colors mb-2">
      <a href={`${base}/${data.slug}`} class="focus:outline-none">
        {data.ip} Admin Login
      </a>
    </h3>

    <p class="text-xs text-md-on-surface-variant line-clamp-2 mb-4 leading-relaxed font-normal">
      {data.description}
    </p>

    <!-- Tonal Credential Chip Box -->
    <div class="bg-md-surface-container rounded-m3-md p-3.5 border border-md-surface-variant/50 mb-4 space-y-1 text-xs font-mono">
      <div class="flex justify-between">
        <span class="text-md-on-surface-variant font-sans font-medium">Username:</span>
        <span class="font-bold text-md-on-surface">{data.defaultUser}</span>
      </div>
      <div class="flex justify-between">
        <span class="text-md-on-surface-variant font-sans font-medium">Password:</span>
        <span class="font-bold text-md-on-surface">{data.defaultPass}</span>
      </div>
    </div>
  </div>

  <div class="pt-3 border-t border-md-surface-variant/50 flex items-center justify-between">
    <a 
      href={`http://${data.ip}`} 
      target="_blank" 
      rel="noopener noreferrer"
      class="text-xs font-bold text-md-on-surface-variant hover:text-md-primary flex items-center gap-1"
    >
      Open IP ↗
    </a>
    <a 
      href={`${base}/${data.slug}`} 
      class="m3-btn-outlined text-xs py-1.5 px-3.5 group-hover:bg-md-primary group-hover:text-white group-hover:border-md-primary transition-all"
    >
      Setup Guide →
    </a>
  </div>
</div>
