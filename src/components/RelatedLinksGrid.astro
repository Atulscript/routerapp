---
import { GATEWAY_IPS, BRANDS, ISPS } from '../lib/data-loader';

interface Props {
  currentSlug?: string;
}

const { currentSlug = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Filter out current item from lists if needed
const otherBrands = BRANDS.filter(b => b.slug !== currentSlug);
const otherIsps = ISPS.filter(i => i.slug !== currentSlug);
const otherIps = GATEWAY_IPS.filter(i => i.slug !== currentSlug);

const tools = [
  { title: 'What is My IP Address?', slug: 'what-is-my-ip', icon: '🌐' },
  { title: 'WiFi QR Code Generator', slug: 'wifi-qr-generator', icon: '📶' },
  { title: 'Strong Password Generator', slug: 'password-generator', icon: '🛡️' },
  { title: 'Master Password List', slug: 'default-passwords', icon: '🔑' }
];
---

<div class="mt-14 pt-10 border-t border-md-surface-variant/60">
  <div class="mb-6">
    <span class="m3-chip m3-chip-tonal text-xs font-bold uppercase tracking-wider">
      🔗 Related Network Portals
    </span>
    <h2 class="text-2xl font-black text-md-on-surface tracking-tight mt-2">
      Explore Other Routers, ISPs & Gateway IPs
    </h2>
    <p class="text-xs sm:text-sm text-md-on-surface-variant mt-1">
      Quickly navigate between router models, provider configurations, and gateway setup pages.
    </p>
  </div>

  <!-- Two-Column Interlinking Layout -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    
    <!-- Column 1: Other Routers & ISPs -->
    <div class="m3-card p-5 sm:p-6 bg-white space-y-5">
      
      <!-- Brands Sub-section -->
      <div>
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-sm font-bold text-md-on-surface flex items-center gap-1.5">
            <span>🏷️</span> Other Router Brands & Models
          </h3>
          <a href={`${base}/brands`} class="text-xs font-bold text-md-primary hover:underline">
            All Brands →
          </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          {otherBrands.slice(0, 12).map(brand => (
            <a 
              href={`${base}/${brand.slug}`} 
              class="p-2.5 rounded-m3-md bg-md-surface-container-low hover:bg-md-primary-container/40 border border-md-outline-variant/30 text-xs font-bold text-md-on-surface hover:text-md-primary transition-all flex flex-col justify-between group"
            >
              <span class="group-hover:translate-x-0.5 transition-transform">{brand.name}</span>
              <span class="text-[10px] font-mono text-md-on-surface-variant font-normal">{brand.defaultIp.split('/')[0]}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- ISPs Sub-section -->
      <div class="pt-4 border-t border-md-surface-variant/40">
        <h3 class="text-sm font-bold text-md-on-surface mb-3 flex items-center gap-1.5">
          <span>📡</span> Internet Service Providers (ISPs)
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {otherIsps.map(isp => (
            <a 
              href={`${base}/${isp.slug}`} 
              class="p-2.5 rounded-m3-md bg-md-surface-container-low hover:bg-emerald-50 border border-md-outline-variant/30 text-xs font-bold text-md-on-surface hover:text-emerald-800 transition-all flex items-center justify-between group"
            >
              <span class="group-hover:translate-x-0.5 transition-transform">{isp.name}</span>
              <span class="text-[10px] font-mono font-bold text-emerald-700 bg-emerald-100/70 px-1.5 py-0.5 rounded">
                {isp.defaultIp}
              </span>
            </a>
          ))}
        </div>
      </div>

    </div>

    <!-- Column 2: Gateway IPs & Utilities -->
    <div class="m3-card p-5 sm:p-6 bg-white space-y-5">
      
      <!-- Gateway IPs Sub-section -->
      <div>
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-sm font-bold text-md-on-surface flex items-center gap-1.5">
            <span>🌐</span> Default Gateway IP Addresses
          </h3>
          <a href={`${base}/ip-addresses`} class="text-xs font-bold text-md-primary hover:underline">
            All IPs →
          </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          {otherIps.map(ip => (
            <a 
              href={`${base}/${ip.slug}`} 
              class="p-2.5 rounded-m3-md bg-md-surface-container-low hover:bg-md-primary-container/40 border border-md-outline-variant/30 text-xs font-mono font-bold text-md-on-surface hover:text-md-primary transition-all flex flex-col justify-between group"
            >
              <span class="group-hover:translate-x-0.5 transition-transform text-md-primary">{ip.ip}</span>
              <span class="text-[10px] font-sans text-md-on-surface-variant font-normal">Login Guide</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Network Tools Sub-section -->
      <div class="pt-4 border-t border-md-surface-variant/40">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-sm font-bold text-md-on-surface flex items-center gap-1.5">
            <span>🛠️</span> Network & Security Tools
          </h3>
          <a href={`${base}/tools`} class="text-xs font-bold text-md-primary hover:underline">
            All Tools →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {tools.map(tool => (
            <a 
              href={`${base}/${tool.slug}`} 
              class="p-2.5 rounded-m3-md bg-md-surface-container-low hover:bg-sky-50 border border-md-outline-variant/30 text-xs font-bold text-md-on-surface hover:text-sky-800 transition-all flex items-center gap-2 group"
            >
              <span>{tool.icon}</span>
              <span class="group-hover:translate-x-0.5 transition-transform">{tool.title}</span>
            </a>
          ))}
        </div>
      </div>

    </div>

  </div>
</div>
