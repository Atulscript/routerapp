---
import { GATEWAY_IPS, BRANDS, ISPS } from '../lib/data-loader';

interface Props {
  currentSlug?: string;
}

const { currentSlug = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Filter out current item from lists if needed
const otherBrands = BRANDS.filter(b => b.slug !== currentSlug);
const otherIsps = ISPS.filter(i => i.slug !== currentSlug);
const otherIps = GATEWAY_IPS.filter(i => i.slug !== currentSlug);

const tools = [
  { title: 'What is My IP Address?', slug: 'what-is-my-ip', icon: '🌐' },
  { title: 'WiFi QR Generator', slug: 'wifi-qr-generator', icon: '📶' },
  { title: 'Password Generator', slug: 'password-generator', icon: '🛡️' },
  { title: 'Default Passwords', slug: 'default-passwords', icon: '🔑' }
];
---

<div class="mt-8 pt-6 border-t border-slate-200/80">
  <div class="mb-3.5">
    <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 text-[10px] font-bold uppercase tracking-wider mb-1">
      🔗 Quick Directory Navigation
    </div>
    <h2 class="text-lg font-bold text-slate-900 tracking-tight">
      Explore Other Routers, ISPs & Gateway IPs
    </h2>
  </div>

  <!-- Two-Column Interlinking Layout -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
    
    <!-- Column 1: Other Routers & ISPs -->
    <div class="bg-white rounded-xl p-4 border border-slate-200/80 shadow-2xs space-y-3.5">
      
      <!-- Brands Sub-section -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-xs font-bold text-slate-900 flex items-center gap-1">
            <span>🏷️</span> Router Brands
          </h3>
          <a href={`${base}/brands`} class="text-[11px] font-semibold text-brand-600 hover:underline">
            All Brands →
          </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-1.5">
          {otherBrands.slice(0, 12).map(brand => (
            <a 
              href={`${base}/${brand.slug}`} 
              class="p-2 rounded-lg bg-slate-50 hover:bg-slate-100 border border-slate-100 text-xs font-semibold text-slate-800 hover:text-brand-600 transition-all flex flex-col justify-between"
            >
              <span class="text-[11px] truncate">{brand.name}</span>
              <span class="text-[9px] font-mono text-slate-400 font-normal">{brand.defaultIp.split('/')[0]}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- ISPs Sub-section -->
      <div class="pt-3 border-t border-slate-100">
        <h3 class="text-xs font-bold text-slate-900 mb-2 flex items-center gap-1">
          <span>📡</span> Fiber ISPs & Gateways
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
          {otherIsps.map(isp => (
            <a 
              href={`${base}/${isp.slug}`} 
              class="p-2 rounded-lg bg-slate-50 hover:bg-emerald-50/70 border border-slate-100 text-xs font-semibold text-slate-800 hover:text-emerald-800 transition-all flex items-center justify-between"
            >
              <span class="text-[11px]">{isp.name}</span>
              <span class="text-[9px] font-mono font-bold text-emerald-700 bg-emerald-100/60 px-1 py-0.5 rounded">
                {isp.defaultIp}
              </span>
            </a>
          ))}
        </div>
      </div>

    </div>

    <!-- Column 2: Gateway IPs & Utilities -->
    <div class="bg-white rounded-xl p-4 border border-slate-200/80 shadow-2xs space-y-3.5">
      
      <!-- Gateway IPs Sub-section -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-xs font-bold text-slate-900 flex items-center gap-1">
            <span>🌐</span> Gateway IPs
          </h3>
          <a href={`${base}/ip-addresses`} class="text-[11px] font-semibold text-brand-600 hover:underline">
            All IPs →
          </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-1.5">
          {otherIps.map(ip => (
            <a 
              href={ip.slug === '192-168-1-1' ? `${base}/` : `${base}/${ip.slug}`} 
              class="p-2 rounded-lg bg-slate-50 hover:bg-slate-100 border border-slate-100 text-xs font-mono font-bold text-slate-800 hover:text-brand-600 transition-all flex flex-col justify-between"
            >
              <span class="text-brand-700 text-[11px]">{ip.ip}</span>
              <span class="text-[9px] font-sans text-slate-400 font-normal">Login Guide</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Network Tools Sub-section -->
      <div class="pt-3 border-t border-slate-100">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-xs font-bold text-slate-900 flex items-center gap-1">
            <span>🛠️</span> Network Tools
          </h3>
          <a href={`${base}/tools`} class="text-[11px] font-semibold text-brand-600 hover:underline">
            All Tools →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
          {tools.map(tool => (
            <a 
              href={`${base}/${tool.slug}`} 
              class="p-2 rounded-lg bg-slate-50 hover:bg-slate-100 border border-slate-100 text-xs font-medium text-slate-800 hover:text-brand-600 transition-all flex items-center gap-1.5"
            >
              <span class="text-xs">{tool.icon}</span>
              <span class="text-[11px] font-semibold">{tool.title}</span>
            </a>
          ))}
        </div>
      </div>

    </div>

  </div>
</div>
