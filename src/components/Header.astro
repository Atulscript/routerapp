---
interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navItems = [
  { label: 'Home', href: `${base}/`, active: currentPath === '/' || currentPath === base || currentPath === `${base}/` },
  { label: 'Brands', href: `${base}/brands`, active: currentPath.includes('brands') },
  { label: 'Gateway IPs', href: `${base}/ip-addresses`, active: currentPath.includes('ip-addresses') },
  { label: 'Router Models', href: `${base}/routers`, active: currentPath.includes('routers') },
  { label: 'Tools', href: `${base}/tools`, active: currentPath.includes('tools') || currentPath.includes('generator') || currentPath.includes('what-is-my-ip') },
  { label: 'Default Passwords', href: `${base}/default-passwords`, active: currentPath.includes('default-passwords') }
];
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-xl border-b border-slate-200/80 transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-4">
    
    <!-- Sleek Modern Logo -->
    <a href={`${base}/`} class="flex items-center gap-2.5 group flex-shrink-0">
      <div class="w-8 h-8 rounded-xl bg-slate-900 text-white flex items-center justify-center font-mono font-bold text-xs shadow-xs group-hover:bg-brand-600 transition-colors">
        IP
      </div>
      <div class="flex items-baseline gap-1">
        <span class="font-extrabold text-base tracking-tight text-slate-900 font-sans">
          19216811<span class="text-brand-600">.page</span>
        </span>
        <span class="hidden sm:inline-block text-[10px] font-semibold text-slate-500 uppercase tracking-widest pl-1">
          Router Guide
        </span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-1">
      {navItems.map(item => (
        <a 
          href={item.href} 
          class={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${item.active ? 'bg-slate-100 text-slate-900 font-semibold shadow-2xs' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'}`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Quick Open CTA -->
    <div class="flex items-center gap-2 flex-shrink-0">
      <a 
        href="http://192.168.1.1"
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-xs hover:shadow-sm transition-all active:scale-95"
      >
        <span>Open</span>
        <span class="font-mono text-[11px] font-bold text-sky-300">192.168.1.1</span>
        <span class="text-[10px] text-slate-300">↗</span>
      </a>
    </div>
  </div>

  <!-- Mobile Swipeable Nav Bar -->
  <div class="md:hidden flex items-center gap-1 px-4 py-1.5 bg-slate-50/90 border-t border-slate-200/60 overflow-x-auto no-scrollbar">
    {navItems.map(item => (
      <a 
        href={item.href} 
        class={`px-2.5 py-1 rounded-md text-xs font-medium whitespace-nowrap transition-all flex-shrink-0 ${item.active ? 'bg-slate-900 text-white font-semibold shadow-2xs' : 'text-slate-600 hover:text-slate-900 bg-white border border-slate-200/70'}`}
      >
        {item.label}
      </a>
    ))}
  </div>
</header>
