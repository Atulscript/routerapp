---
import { GATEWAY_IPS, BRANDS, ISPS } from '../lib/data-loader';

interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Navigation items with icons and Tools placed in the LAST position
const navItems = [
  { 
    label: 'Home', 
    href: `${base}/`, 
    active: currentPath === '/' || currentPath === base || currentPath === `${base}/`,
    icon: 'home'
  },
  { 
    label: 'Brands', 
    href: `${base}/brands`, 
    active: currentPath.includes('brands'),
    icon: 'tag'
  },
  { 
    label: 'Gateway IPs', 
    href: `${base}/ip-addresses`, 
    active: currentPath.includes('ip-addresses'),
    icon: 'globe'
  },
  { 
    label: 'Router Models', 
    href: `${base}/routers`, 
    active: currentPath.includes('routers'),
    icon: 'router'
  },
  { 
    label: 'Default Passwords', 
    href: `${base}/default-passwords`, 
    active: currentPath.includes('default-passwords'),
    icon: 'lock'
  },
  { 
    label: 'Tools', 
    href: `${base}/tools`, 
    active: currentPath.includes('tools') || currentPath.includes('generator') || currentPath.includes('what-is-my-ip'),
    icon: 'wrench'
  }
];

// Search index for header live search
const searchItems = [
  ...GATEWAY_IPS.map(ip => ({
    name: ip.ip,
    title: `${ip.ip} Router Login`,
    category: 'Gateway IP',
    url: ip.slug === '192-168-1-1' ? `${base}/` : `${base}/${ip.slug}`,
    subtitle: `Default: ${ip.defaultUser} / ${ip.defaultPass}`
  })),
  ...BRANDS.map(b => ({
    name: b.name,
    title: `${b.name} Default Passwords`,
    category: 'Brand',
    url: `${base}/${b.slug}`,
    subtitle: `Default IP: ${b.defaultIp}`
  })),
  ...ISPS.map(isp => ({
    name: isp.name,
    title: `${isp.name} Setup Guide`,
    category: 'ISP',
    url: `${base}/${isp.slug}`,
    subtitle: `Gateway: ${isp.defaultIp}`
  }))
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-2xs transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-3">
    
    <!-- Modern Brand Logo with Animated Glow Hover -->
    <a href={`${base}/`} class="flex items-center gap-2.5 group flex-shrink-0 transition-transform active:scale-95">
      <div class="w-8 h-8 rounded-xl bg-slate-900 text-white flex items-center justify-center shadow-xs group-hover:bg-brand-600 transition-all duration-300 group-hover:shadow-md group-hover:shadow-brand-500/20">
        <svg class="w-4 h-4 text-sky-400 group-hover:text-white transition-colors animate-pulse-slow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12.55a11 11 0 0 1 14.08 0"></path>
          <path d="M1.42 9a16 16 0 0 1 21.16 0"></path>
          <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
          <line x1="12" y1="20" x2="12.01" y2="20"></line>
        </svg>
      </div>
      <div class="flex items-baseline gap-1.5">
        <span class="font-black text-base tracking-tight text-slate-900 font-sans group-hover:text-brand-600 transition-colors">
          19216811<span class="text-brand-600">.page</span>
        </span>
        <span class="inline-flex items-center gap-1 text-[10px] font-bold text-slate-500 uppercase tracking-widest pl-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          Gateway
        </span>
      </div>
    </a>

    <!-- Desktop / Tablet Navigation Links with Icons & Hover Effects -->
    <nav class="hidden md:flex items-center gap-0.5 lg:gap-1">
      {navItems.map(item => (
        <a 
          href={item.href} 
          class={`group flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-semibold transition-all duration-150 ${
            item.active 
              ? 'bg-slate-100 text-brand-700 shadow-2xs font-bold ring-1 ring-slate-200/80' 
              : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70 hover:scale-[1.02] active:scale-95'
          }`}
        >
          {item.icon === 'home' && (
            <svg class={`w-3.5 h-3.5 transition-colors ${item.active ? 'text-brand-600' : 'text-slate-400 group-hover:text-brand-500'}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
          )}
          {item.icon === 'tag' && (
            <svg class={`w-3.5 h-3.5 transition-colors ${item.active ? 'text-brand-600' : 'text-slate-400 group-hover:text-brand-500'}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
              <line x1="7" y1="7" x2="7.01" y2="7"></line>
            </svg>
          )}
          {item.icon === 'globe' && (
            <svg class={`w-3.5 h-3.5 transition-colors ${item.active ? 'text-brand-600' : 'text-slate-400 group-hover:text-brand-500'}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          )}
          {item.icon === 'router' && (
            <svg class={`w-3.5 h-3.5 transition-colors ${item.active ? 'text-brand-600' : 'text-slate-400 group-hover:text-brand-500'}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="13" width="20" height="8" rx="2"></rect>
              <path d="M6 13V7a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v6"></path>
              <circle cx="6" cy="17" r="1" fill="currentColor"></circle>
              <circle cx="10" cy="17" r="1" fill="currentColor"></circle>
            </svg>
          )}
          {item.icon === 'lock' && (
            <svg class={`w-3.5 h-3.5 transition-colors ${item.active ? 'text-brand-600' : 'text-slate-400 group-hover:text-brand-500'}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          )}
          {item.icon === 'wrench' && (
            <svg class={`w-3.5 h-3.5 transition-colors ${item.active ? 'text-brand-600' : 'text-slate-400 group-hover:text-brand-500'}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
            </svg>
          )}
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <!-- Default Header Live Search Bar (No CTA) -->
    <div class="relative w-40 sm:w-56 md:w-60 lg:w-64" id="header-search-container">
      <div class="relative flex items-center bg-slate-50 hover:bg-slate-100/90 focus-within:bg-white border border-slate-200/90 focus-within:border-brand-500 focus-within:ring-2 focus-within:ring-brand-500/20 rounded-xl transition-all shadow-2xs">
        <div class="pl-2.5 pr-1.5 pointer-events-none text-slate-400 flex items-center">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <input 
          type="text" 
          id="header-search-input" 
          placeholder="Search IP, brand, ISP..." 
          class="w-full py-1.5 pr-6 bg-transparent text-slate-900 placeholder-slate-400 outline-none text-xs font-medium"
          autocomplete="off"
        />
        <button 
          id="header-search-clear" 
          type="button" 
          class="absolute right-2 text-slate-400 hover:text-slate-600 hidden text-xs font-bold my-auto hover:scale-110 transition-transform"
        >
          ✕
        </button>
      </div>

      <!-- Live Search Results Dropdown with Smooth Animation -->
      <div 
        id="header-search-results" 
        class="absolute right-0 top-full mt-1.5 w-72 sm:w-80 bg-white rounded-xl shadow-card-hover border border-slate-200 overflow-hidden hidden z-50 max-h-72 overflow-y-auto divide-y divide-slate-100 custom-scrollbar animate-fade-in"
      >
        <div id="header-results-list"></div>
      </div>
    </div>

  </div>

  <!-- Mobile Swipeable Nav Bar (Tools at last) -->
  <div class="md:hidden flex items-center gap-1.5 px-4 py-1.5 bg-slate-50/90 border-t border-slate-200/60 overflow-x-auto no-scrollbar">
    {navItems.map(item => (
      <a 
        href={item.href} 
        class={`flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-medium whitespace-nowrap transition-all flex-shrink-0 ${
          item.active 
            ? 'bg-slate-900 text-white font-semibold shadow-2xs ring-1 ring-slate-800' 
            : 'text-slate-600 hover:text-slate-900 bg-white border border-slate-200/80 active:scale-95'
        }`}
      >
        <span>{item.label}</span>
      </a>
    ))}
  </div>
</header>

<script define:vars={{ searchItems }}>
  const input = document.getElementById('header-search-input');
  const resultsContainer = document.getElementById('header-search-results');
  const resultsList = document.getElementById('header-results-list');
  const clearBtn = document.getElementById('header-search-clear');

  function renderResults(query) {
    if (!query.trim()) {
      resultsContainer.classList.add('hidden');
      clearBtn.classList.add('hidden');
      return;
    }

    clearBtn.classList.remove('hidden');
    const q = query.toLowerCase().trim();
    const matches = searchItems.filter(item => 
      item.name.toLowerCase().includes(q) ||
      item.title.toLowerCase().includes(q) ||
      item.subtitle.toLowerCase().includes(q)
    );

    if (matches.length === 0) {
      resultsList.innerHTML = `
        <div class="p-4 text-center text-xs text-slate-400">
          No matches found for "<strong class="text-slate-700">${query}</strong>"
        </div>
      `;
    } else {
      resultsList.innerHTML = matches.map(item => `
        <a href="${item.url}" class="flex items-center justify-between p-2.5 hover:bg-slate-50 transition-colors group">
          <div class="flex items-center gap-2">
            <span class="text-[9px] font-semibold px-1.5 py-0.5 rounded bg-slate-100 text-slate-700">
              ${item.category}
            </span>
            <div>
              <div class="text-xs font-semibold text-slate-900 group-hover:text-brand-600">${item.title}</div>
              <div class="text-[10px] text-slate-500">${item.subtitle}</div>
            </div>
          </div>
          <span class="text-xs text-slate-400 group-hover:text-slate-900 font-semibold">
            →
          </span>
        </a>
      `).join('');
    }

    resultsContainer.classList.remove('hidden');
  }

  input?.addEventListener('input', (e) => renderResults(e.target.value));
  input?.addEventListener('focus', () => {
    if (input.value.trim()) resultsContainer.classList.remove('hidden');
  });

  clearBtn?.addEventListener('click', () => {
    input.value = '';
    renderResults('');
    input.focus();
  });

  document.addEventListener('click', (e) => {
    if (!document.getElementById('header-search-container')?.contains(e.target)) {
      resultsContainer.classList.add('hidden');
    }
  });

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      input?.focus();
      input?.select();
    }
    if (e.key === 'Escape') {
      resultsContainer.classList.add('hidden');
      input?.blur();
    }
  });
</script>
