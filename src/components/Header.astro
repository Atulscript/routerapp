---
interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = currentPath.replace(base, '') || '/';

const navItems = [
  { label: 'Home', href: `${base}/`, active: path === '/' },
  { label: 'Brands', href: `${base}/brands`, active: path.startsWith('/brands') },
  { label: 'Gateway IPs', href: `${base}/ip-addresses`, active: path.startsWith('/ip-addresses') },
  { label: 'Router Models', href: `${base}/routers`, active: path.startsWith('/routers') },
  { label: 'ISPs', href: `${base}/isps`, active: path.startsWith('/isps') },
  { label: 'Default Passwords', short: 'Passwords', href: `${base}/default-passwords`, active: path.startsWith('/default-passwords') },
  { label: 'Tools', href: `${base}/tools`, active: path.startsWith('/tools') },
];
---

<a href="#main-content" class="skip-link">Skip to content</a>

<header class="sticky top-0 z-50 bg-white/90 dark:bg-[#202124]/90 backdrop-blur-md border-b border-line transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center gap-3">

    <a href={`${base}/`} class="flex items-center gap-2.5 flex-shrink-0 group" aria-label="RouterSync.com home">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-blue-600 via-indigo-600 to-cyan-500 p-0.5 shadow-sm flex-shrink-0 group-hover:scale-105 transition-transform" aria-hidden="true">
        <div class="w-full h-full bg-[#0f172a] rounded-[10px] flex items-center justify-center">
          <svg class="w-5 h-5 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="13" width="20" height="8" rx="2"></rect>
            <path d="M6 13v-4"></path>
            <path d="M18 13v-4"></path>
            <path d="M10 5a3.5 3.5 0 0 1 4 0"></path>
            <path d="M7.5 2.5a7.5 7.5 0 0 1 9 0"></path>
            <circle cx="7" cy="17" r="1" fill="currentColor"></circle>
            <circle cx="12" cy="17" r="1" fill="currentColor"></circle>
          </svg>
        </div>
      </div>
      <span class="flex flex-col leading-none">
        <span class="font-bold text-lg text-[#111827] dark:text-white tracking-tight font-sans flex items-center">
          Router<span class="text-blue-600 dark:text-cyan-400">Sync</span><span class="text-xs font-mono text-gray-400 dark:text-gray-500 font-normal ml-0.5">.com</span>
        </span>
        <span class="hidden sm:block text-[10px] font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mt-0.5">Hardware & Gateway Directory</span>
      </span>
    </a>

    <nav class="hidden xl:flex items-center gap-0.5 ml-2" aria-label="Main">
      {/* The logo already links home, so the wide nav skips "Home" to stay on one line */}
      {navItems.filter(item => item.label !== 'Home').map(item => (
        <a
          href={item.href}
          aria-current={item.active ? 'page' : undefined}
          class={`px-3 py-2 rounded-full text-sm font-medium whitespace-nowrap transition-colors ${
            item.active
              ? 'bg-accent-soft text-accent'
              : 'text-[#3c4043] dark:text-[#e8eaed] hover:bg-[#f1f3f4] dark:hover:bg-[#3c4043]'
          }`}
        >
          {item.short ?? item.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <!-- Search: inline field on md+, opens as a full-width panel on small screens -->
      <div class="site-search relative" data-search-root>
        <button
          type="button"
          class="md:hidden icon-btn"
          aria-label="Search"
          aria-expanded="false"
          aria-controls="header-search-panel"
          data-search-open
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </button>

        <div
          id="header-search-panel"
          class="search-panel hidden md:block fixed md:static inset-x-0 top-16 md:top-auto p-3 md:p-0 bg-white dark:bg-[#202124] md:bg-transparent md:dark:bg-transparent border-b md:border-0 border-line shadow-lg md:shadow-none"
        >
          <div class="relative md:w-64 lg:w-72 xl:w-60">
            <label for="header-search-input" class="sr-only">Search IPs, brands, models and tools</label>
            <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-ink-muted pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input
              id="header-search-input"
              type="search"
              inputmode="search"
              placeholder="Search routers and IPs"
              autocomplete="off"
              spellcheck="false"
              role="combobox"
              aria-autocomplete="list"
              aria-expanded="false"
              aria-controls="header-search-results"
              class="w-full h-11 md:h-10 pl-10 pr-12 rounded-full bg-surface-muted border border-transparent focus:bg-white dark:focus:bg-[#303134] focus:border-[#1a73e8] dark:focus:border-[#8ab4f8] text-base md:text-sm text-ink placeholder-[#5f6368] dark:placeholder-[#9aa0a6] outline-none transition-colors"
            />
            <kbd class="hidden lg:flex absolute right-3 top-1/2 -translate-y-1/2 px-1.5 py-0.5 text-[11px] font-mono text-ink-muted bg-white dark:bg-[#3c4043] border border-line rounded-md pointer-events-none" data-search-kbd>/</kbd>

            <ul
              id="header-search-results"
              role="listbox"
              aria-label="Search suggestions"
              class="hidden absolute left-0 right-0 md:left-auto md:w-96 top-full mt-2 bg-surface rounded-2xl shadow-card-hover border border-line overflow-y-auto max-h-[70vh] py-1.5 z-50"
            ></ul>
          </div>
        </div>
      </div>

      <button id="theme-toggle" type="button" class="icon-btn" aria-label="Switch to dark theme">
        <svg class="w-5 h-5 hidden dark:block text-[#fbbc05]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2m-7.07-17.07 1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        <svg class="w-5 h-5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>
    </div>
  </div>

  <!-- Below xl: swipeable nav row, with a fade on the right edge hinting there is more -->
  <nav class="hidden md:block xl:hidden relative border-t border-line-subtle" aria-label="Main">
    <div class="max-w-6xl mx-auto flex items-center gap-1.5 px-4 sm:px-6 py-2 overflow-x-auto no-scrollbar scroll-px-4">
      {navItems.map(item => (
        <a
          href={item.href}
          aria-current={item.active ? 'page' : undefined}
          class={`flex-shrink-0 px-3.5 py-2 rounded-full text-sm font-medium whitespace-nowrap transition-colors ${
            item.active
              ? 'bg-accent-soft text-accent'
              : 'text-[#3c4043] dark:text-[#e8eaed] hover:bg-[#f1f3f4] dark:hover:bg-[#3c4043]'
          }`}
        >
          {item.label}
        </a>
      ))}
    </div>
    <span class="pointer-events-none absolute right-0 inset-y-0 w-10 bg-gradient-to-l from-white dark:from-[#202124] sm:hidden" aria-hidden="true"></span>
  </nav>
</header>

<script define:vars={{ indexUrl: `${base}/search-index.json` }}>
  (() => {
    const input = document.getElementById('header-search-input');
    const list = document.getElementById('header-search-results');
    const panel = document.getElementById('header-search-panel');
    const openBtn = document.querySelector('[data-search-open]');
    const root = document.querySelector('[data-search-root]');
    if (!input || !list || !panel) return;

    // The index is loaded on first use and cached for the session, so pages stay light.
    let index = null;
    let loading = null;
    const loadIndex = () => loading ??= fetch(indexUrl).then(r => r.json()).then(data => (index = data)).catch(() => (index = []));

    const escapeHtml = (s) => s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const BADGE = {
      'Gateway IP': 'bg-emerald-50 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-200',
      'Brand': 'bg-sky-50 text-sky-800 dark:bg-sky-900/40 dark:text-sky-200',
      'Model': 'bg-violet-50 text-violet-800 dark:bg-violet-900/40 dark:text-violet-200',
      'ISP': 'bg-amber-50 text-amber-800 dark:bg-amber-900/40 dark:text-amber-200',
      'Tool': 'bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-200',
    };

    let matches = [];
    let active = -1;

    function search(q) {
      const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
      const scored = [];
      for (const item of index) {
        const hay = `${item.title} ${item.k}`.toLowerCase();
        if (!terms.every(t => hay.includes(t))) continue;
        // Title matches first, then shorter titles.
        const score = (item.title.toLowerCase().startsWith(terms[0]) ? 0 : item.title.toLowerCase().includes(terms[0]) ? 1 : 2) * 1000 + item.title.length;
        scored.push([score, item]);
      }
      return scored.sort((a, b) => a[0] - b[0]).slice(0, 8).map(s => s[1]);
    }

    function setOpen(open) {
      list.classList.toggle('hidden', !open);
      input.setAttribute('aria-expanded', String(open));
    }

    async function render() {
      const q = input.value.trim();
      if (!q) { setOpen(false); return; }
      if (!index) {
        list.innerHTML = '<li class="px-4 py-3 text-sm text-ink-muted">Loading…</li>';
        setOpen(true);
        await loadIndex();
        if (input.value.trim() !== q) return;
      }
      matches = search(q);
      active = matches.length ? 0 : -1;
      list.innerHTML = matches.length
        ? matches.map((m, i) => `
            <li role="option" id="hs-opt-${i}" aria-selected="${i === active}">
              <a href="${m.url}" tabindex="-1" class="flex items-center gap-3 px-3 py-2.5 mx-1.5 rounded-xl hover:bg-[#f1f3f4] dark:hover:bg-[#35373a] aria-selected:bg-[#e8f0fe]">
                <span class="flex-shrink-0 text-[11px] font-semibold px-2 py-0.5 rounded-full ${BADGE[m.category] || ''}">${m.category}</span>
                <span class="min-w-0">
                  <span class="block text-sm font-medium text-ink truncate">${escapeHtml(m.title)}</span>
                  <span class="block text-xs text-ink-muted truncate">${escapeHtml(m.subtitle)}</span>
                </span>
              </a>
            </li>`).join('')
        : `<li class="px-4 py-3 text-sm text-ink-muted">No results for “${escapeHtml(q)}”. Try an IP like 192.168.0.1 or a brand name.</li>`;
      highlight();
      setOpen(true);
    }

    function highlight() {
      list.querySelectorAll('[role="option"]').forEach((el, i) => {
        const on = i === active;
        el.setAttribute('aria-selected', String(on));
        el.firstElementChild.classList.toggle('bg-[#e8f0fe]', on);
        el.firstElementChild.classList.toggle('dark:bg-[#1a3a60]', on);
        if (on) el.scrollIntoView({ block: 'nearest' });
      });
      if (active >= 0) input.setAttribute('aria-activedescendant', `hs-opt-${active}`);
      else input.removeAttribute('aria-activedescendant');
    }

    let timer;
    input.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(render, 80); });
    input.addEventListener('focus', () => { loadIndex(); if (input.value.trim()) render(); });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        if (!matches.length) return;
        e.preventDefault();
        active = (active + (e.key === 'ArrowDown' ? 1 : -1) + matches.length) % matches.length;
        highlight();
      } else if (e.key === 'Enter' && matches[active]) {
        e.preventDefault();
        window.location.href = matches[active].url;
      } else if (e.key === 'Escape') {
        setOpen(false);
        closeMobilePanel();
      }
    });

    function closeMobilePanel() {
      if (!openBtn || getComputedStyle(openBtn).display === 'none') return;
      panel.classList.add('hidden');
      openBtn.setAttribute('aria-expanded', 'false');
    }
    openBtn?.addEventListener('click', () => {
      const open = panel.classList.toggle('hidden') === false;
      openBtn.setAttribute('aria-expanded', String(open));
      if (open) input.focus();
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target)) { setOpen(false); closeMobilePanel(); }
    });
    document.addEventListener('keydown', (e) => {
      const typing = /INPUT|TEXTAREA|SELECT/.test(document.activeElement?.tagName || '') || document.activeElement?.isContentEditable;
      if ((e.key === '/' && !typing) || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k')) {
        e.preventDefault();
        if (openBtn && getComputedStyle(openBtn).display !== 'none') { panel.classList.remove('hidden'); openBtn.setAttribute('aria-expanded', 'true'); }
        input.focus();
        input.select();
      }
    });

    // Theme toggle
    const themeBtn = document.getElementById('theme-toggle');
    const syncThemeLabel = () => themeBtn?.setAttribute('aria-label', document.documentElement.classList.contains('dark') ? 'Switch to light theme' : 'Switch to dark theme');
    syncThemeLabel();
    themeBtn?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.theme = isDark ? 'dark' : 'light';
      syncThemeLabel();
    });
  })();
</script>
