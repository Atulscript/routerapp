---
import { GATEWAY_IPS, BRANDS, ISPS } from '../lib/data-loader';

interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navItems = [
  { label: 'Home', href: `${base}/`, active: currentPath === '/' || currentPath === base || currentPath === `${base}/` },
  { label: 'Brands', href: `${base}/brands`, active: currentPath.includes('brands') },
  { label: 'Gateway IPs', href: `${base}/ip-addresses`, active: currentPath.includes('ip-addresses') },
  { label: 'Router Models', href: `${base}/routers`, active: currentPath.includes('routers') },
  { label: 'Tools', href: `${base}/tools`, active: currentPath.includes('tools') || currentPath.includes('generator') || currentPath.includes('what-is-my-ip') },
  { label: 'Default Passwords', href: `${base}/default-passwords`, active: currentPath.includes('default-passwords') }
];

// Search index for global spotlight search dialog
const searchItems = [
  ...GATEWAY_IPS.map(ip => ({
    name: ip.ip,
    title: `${ip.ip} Router Login`,
    category: 'Gateway IP',
    url: ip.slug === '192-168-1-1' ? `${base}/` : `${base}/${ip.slug}`,
    subtitle: `Default: ${ip.defaultUser} / ${ip.defaultPass}`
  })),
  ...BRANDS.map(b => ({
    name: b.name,
    title: `${b.name} Default Passwords`,
    category: 'Brand',
    url: `${base}/${b.slug}`,
    subtitle: `Default IP: ${b.defaultIp}`
  })),
  ...ISPS.map(isp => ({
    name: isp.name,
    title: `${isp.name} Setup Guide`,
    category: 'ISP',
    url: `${base}/${isp.slug}`,
    subtitle: `Gateway: ${isp.defaultIp}`
  }))
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-2xs transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-3">
    
    <!-- Modern Brand Logo -->
    <a href={`${base}/`} class="flex items-center gap-2.5 group flex-shrink-0">
      <div class="w-8 h-8 rounded-xl bg-slate-900 text-white flex items-center justify-center shadow-xs group-hover:bg-brand-600 transition-colors">
        <svg class="w-4 h-4 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12.55a11 11 0 0 1 14.08 0"></path>
          <path d="M1.42 9a16 16 0 0 1 21.16 0"></path>
          <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
          <line x1="12" y1="20" x2="12.01" y2="20"></line>
        </svg>
      </div>
      <div class="flex items-baseline gap-1">
        <span class="font-black text-base tracking-tight text-slate-900 font-sans">
          19216811<span class="text-brand-600">.page</span>
        </span>
        <span class="hidden sm:inline-block text-[10px] font-semibold text-slate-400 uppercase tracking-widest pl-1">
          Gateway
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-1">
      {navItems.map(item => (
        <a 
          href={item.href} 
          class={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-all ${item.active ? 'bg-slate-100 text-slate-900 shadow-2xs' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'}`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Header Actions (Global Search Trigger + Open CTA) -->
    <div class="flex items-center gap-2">
      
      <!-- Spotlight Search Trigger Button -->
      <button 
        type="button" 
        id="global-search-trigger"
        class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-50 hover:bg-slate-100 border border-slate-200/80 text-slate-500 hover:text-slate-900 text-xs font-medium transition-all shadow-2xs cursor-pointer"
        title="Quick Search (Ctrl+K)"
      >
        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <span class="hidden sm:inline">Search...</span>
        <kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[9px] font-mono font-bold bg-white rounded border border-slate-200 text-slate-400">⌘K</kbd>
      </button>

      <!-- Direct Gateway Access CTA -->
      <a 
        href="http://192.168.1.1"
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 sm:px-3.5 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-xs hover:shadow-sm transition-all active:scale-95 flex-shrink-0"
      >
        <span class="hidden xs:inline">Open</span>
        <span class="font-mono text-[11px] font-bold text-sky-300">192.168.1.1</span>
        <span class="text-[10px] text-slate-400">↗</span>
      </a>
    </div>
  </div>

  <!-- Mobile Swipeable Nav Bar -->
  <div class="lg:hidden flex items-center gap-1.5 px-4 py-1.5 bg-slate-50/90 border-t border-slate-200/60 overflow-x-auto no-scrollbar">
    {navItems.map(item => (
      <a 
        href={item.href} 
        class={`px-2.5 py-1 rounded-md text-xs font-medium whitespace-nowrap transition-all flex-shrink-0 ${item.active ? 'bg-slate-900 text-white font-semibold shadow-2xs' : 'text-slate-600 hover:text-slate-900 bg-white border border-slate-200/80'}`}
      >
        {item.label}
      </a>
    ))}
  </div>

  <!-- Global Spotlight Search Modal Backdrop -->
  <div 
    id="search-modal" 
    class="fixed inset-0 bg-slate-950/40 backdrop-blur-sm z-50 hidden flex items-start justify-center p-4 sm:pt-20"
  >
    <div 
      class="bg-white rounded-2xl shadow-card-hover border border-slate-200 w-full max-w-lg overflow-hidden animate-in fade-in zoom-in-95 duration-150"
      id="search-modal-content"
    >
      <!-- Search Input Bar -->
      <div class="relative flex items-center border-b border-slate-200/80 p-3 bg-slate-50/50">
        <svg class="w-4 h-4 text-slate-400 ml-2 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input 
          type="text" 
          id="modal-search-input" 
          placeholder="Search router brand, IP address (192.168.1.1), or ISP..." 
          class="w-full bg-transparent text-slate-900 text-sm font-medium outline-none placeholder-slate-400"
          autocomplete="off"
        />
        <button 
          type="button" 
          id="modal-close-btn" 
          class="text-xs font-semibold px-2 py-1 rounded-md text-slate-400 hover:text-slate-700 hover:bg-slate-200/60 transition-colors"
        >
          ESC
        </button>
      </div>

      <!-- Live Search Results List -->
      <div id="modal-results-list" class="max-h-80 overflow-y-auto divide-y divide-slate-100 p-1.5 custom-scrollbar">
        <div class="p-6 text-center text-xs text-slate-400">
          Type any IP (e.g. 192.168.1.1), brand (TP-Link), or ISP to search...
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="px-4 py-2 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
        <span>Navigation shortcut: <kbd class="font-mono bg-white px-1 rounded border">ESC</kbd> to close</span>
        <span>19216811.page Directory</span>
      </div>
    </div>
  </div>
</header>

<script define:vars={{ searchItems }}>
  const triggerBtn = document.getElementById('global-search-trigger');
  const modal = document.getElementById('search-modal');
  const modalContent = document.getElementById('search-modal-content');
  const modalInput = document.getElementById('modal-search-input');
  const closeBtn = document.getElementById('modal-close-btn');
  const resultsList = document.getElementById('modal-results-list');

  function openModal() {
    modal?.classList.remove('hidden');
    modalInput?.focus();
  }

  function closeModal() {
    modal?.classList.add('hidden');
    if (modalInput) modalInput.value = '';
    renderModalResults('');
  }

  function renderModalResults(query) {
    if (!query.trim()) {
      if (resultsList) {
        resultsList.innerHTML = `
          <div class="p-6 text-center text-xs text-slate-400">
            Type any IP (e.g. 192.168.1.1), brand (TP-Link), or ISP to search...
          </div>
        `;
      }
      return;
    }

    const q = query.toLowerCase().trim();
    const matches = searchItems.filter(item => 
      item.name.toLowerCase().includes(q) ||
      item.title.toLowerCase().includes(q) ||
      item.subtitle.toLowerCase().includes(q)
    );

    if (matches.length === 0) {
      if (resultsList) {
        resultsList.innerHTML = `
          <div class="p-6 text-center text-xs text-slate-400">
            No matching router brands, IPs, or guides found for "<strong>${query}</strong>"
          </div>
        `;
      }
    } else {
      if (resultsList) {
        resultsList.innerHTML = matches.map(item => `
          <a href="${item.url}" class="flex items-center justify-between p-2.5 hover:bg-slate-50 rounded-xl transition-colors group">
            <div class="flex items-center gap-2.5">
              <span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-700">
                ${item.category}
              </span>
              <div>
                <div class="text-xs font-semibold text-slate-900 group-hover:text-brand-600">${item.title}</div>
                <div class="text-[11px] text-slate-500">${item.subtitle}</div>
              </div>
            </div>
            <span class="text-xs text-slate-400 group-hover:text-slate-900 font-semibold">
              Open →
            </span>
          </a>
        `).join('');
      }
    }
  }

  triggerBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (!modalContent?.contains(e.target)) {
      closeModal();
    }
  });

  modalInput?.addEventListener('input', (e) => renderModalResults(e.target.value));

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openModal();
    }
    if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
      closeModal();
    }
  });
</script>
