---
import { GATEWAY_IPS, BRANDS, ISPS } from '../lib/data-loader';

interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Navigation items with Tools placed in the LAST position
const navItems = [
  { label: 'Home', href: `${base}/`, active: currentPath === '/' || currentPath === base || currentPath === `${base}/` },
  { label: 'Brands', href: `${base}/brands`, active: currentPath.includes('brands') },
  { label: 'Gateway IPs', href: `${base}/ip-addresses`, active: currentPath.includes('ip-addresses') },
  { label: 'Router Models', href: `${base}/routers`, active: currentPath.includes('routers') },
  { label: 'Default Passwords', href: `${base}/default-passwords`, active: currentPath.includes('default-passwords') },
  { label: 'Tools', href: `${base}/tools`, active: currentPath.includes('tools') || currentPath.includes('generator') || currentPath.includes('what-is-my-ip') }
];

// Search index for header live search
const searchItems = [
  ...GATEWAY_IPS.map(ip => ({
    name: ip.ip,
    title: `${ip.ip} Router Login`,
    category: 'Gateway IP',
    url: ip.slug === '192-168-1-1' ? `${base}/` : `${base}/${ip.slug}`,
    subtitle: `Default: ${ip.defaultUser} / ${ip.defaultPass}`
  })),
  ...BRANDS.map(b => ({
    name: b.name,
    title: `${b.name} Default Passwords`,
    category: 'Brand',
    url: `${base}/${b.slug}`,
    subtitle: `Default IP: ${b.defaultIp}`
  })),
  ...ISPS.map(isp => ({
    name: isp.name,
    title: `${isp.name} Setup Guide`,
    category: 'ISP',
    url: `${base}/${isp.slug}`,
    subtitle: `Gateway: ${isp.defaultIp}`
  }))
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-2xs transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-3">
    
    <!-- Modern Brand Logo -->
    <a href={`${base}/`} class="flex items-center gap-2.5 group flex-shrink-0">
      <div class="w-8 h-8 rounded-xl bg-slate-900 text-white flex items-center justify-center shadow-xs group-hover:bg-brand-600 transition-colors">
        <svg class="w-4 h-4 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12.55a11 11 0 0 1 14.08 0"></path>
          <path d="M1.42 9a16 16 0 0 1 21.16 0"></path>
          <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
          <line x1="12" y1="20" x2="12.01" y2="20"></line>
        </svg>
      </div>
      <div class="flex items-baseline gap-1">
        <span class="font-black text-base tracking-tight text-slate-900 font-sans">
          19216811<span class="text-brand-600">.page</span>
        </span>
        <span class="hidden sm:inline-block text-[10px] font-semibold text-slate-400 uppercase tracking-widest pl-1">
          Gateway
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links (Tools at last) -->
    <nav class="hidden lg:flex items-center gap-1">
      {navItems.map(item => (
        <a 
          href={item.href} 
          class={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-all ${item.active ? 'bg-slate-100 text-slate-900 shadow-2xs' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'}`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Default Header Live Search Bar (No CTA) -->
    <div class="relative w-44 sm:w-60 md:w-64" id="header-search-container">
      <div class="relative flex items-center bg-slate-50 hover:bg-slate-100/80 focus-within:bg-white border border-slate-200 focus-within:border-brand-500 focus-within:ring-2 focus-within:ring-brand-500/15 rounded-xl transition-all shadow-2xs">
        <div class="pl-2.5 pr-1.5 pointer-events-none text-slate-400 flex items-center">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <input 
          type="text" 
          id="header-search-input"
          placeholder="Search IP, brand, ISP..." 
          class="w-full py-1.5 pr-6 bg-transparent text-slate-900 placeholder-slate-400 outline-none text-xs font-medium"
          autocomplete="off"
        />
        <button 
          id="header-search-clear" 
          type="button"
          class="absolute right-2 text-slate-400 hover:text-slate-600 hidden text-xs font-bold my-auto"
        >
          ✕
        </button>
      </div>

      <!-- Live Search Results Dropdown -->
      <div 
        id="header-search-results" 
        class="absolute right-0 top-full mt-1.5 w-72 sm:w-80 bg-white rounded-xl shadow-card-hover border border-slate-200 overflow-hidden hidden z-50 max-h-72 overflow-y-auto divide-y divide-slate-100 custom-scrollbar"
      >
        <div id="header-results-list"></div>
      </div>
    </div>

  </div>

  <!-- Mobile Swipeable Nav Bar (Tools at last) -->
  <div class="lg:hidden flex items-center gap-1.5 px-4 py-1.5 bg-slate-50/90 border-t border-slate-200/60 overflow-x-auto no-scrollbar">
    {navItems.map(item => (
      <a 
        href={item.href} 
        class={`px-2.5 py-1 rounded-md text-xs font-medium whitespace-nowrap transition-all flex-shrink-0 ${item.active ? 'bg-slate-900 text-white font-semibold shadow-2xs' : 'text-slate-600 hover:text-slate-900 bg-white border border-slate-200/80'}`}
      >
        {item.label}
      </a>
    ))}
  </div>
</header>

<script define:vars={{ searchItems }}>
  const input = document.getElementById('header-search-input');
  const resultsContainer = document.getElementById('header-search-results');
  const resultsList = document.getElementById('header-results-list');
  const clearBtn = document.getElementById('header-search-clear');

  function renderResults(query) {
    if (!query.trim()) {
      resultsContainer.classList.add('hidden');
      clearBtn.classList.add('hidden');
      return;
    }

    clearBtn.classList.remove('hidden');
    const q = query.toLowerCase().trim();
    const matches = searchItems.filter(item => 
      item.name.toLowerCase().includes(q) ||
      item.title.toLowerCase().includes(q) ||
      item.subtitle.toLowerCase().includes(q)
    );

    if (matches.length === 0) {
      resultsList.innerHTML = `
        <div class="p-4 text-center text-xs text-slate-400">
          No matches found for "<strong class="text-slate-700">${query}</strong>"
        </div>
      `;
    } else {
      resultsList.innerHTML = matches.map(item => `
        <a href="${item.url}" class="flex items-center justify-between p-2.5 hover:bg-slate-50 transition-colors group">
          <div class="flex items-center gap-2">
            <span class="text-[9px] font-semibold px-1.5 py-0.5 rounded bg-slate-100 text-slate-700">
              ${item.category}
            </span>
            <div>
              <div class="text-xs font-semibold text-slate-900 group-hover:text-brand-600">${item.title}</div>
              <div class="text-[10px] text-slate-500">${item.subtitle}</div>
            </div>
          </div>
          <span class="text-xs text-slate-400 group-hover:text-slate-900 font-semibold">
            →
          </span>
        </a>
      `).join('');
    }

    resultsContainer.classList.remove('hidden');
  }

  input?.addEventListener('input', (e) => renderResults(e.target.value));
  input?.addEventListener('focus', () => {
    if (input.value.trim()) resultsContainer.classList.remove('hidden');
  });

  clearBtn?.addEventListener('click', () => {
    input.value = '';
    renderResults('');
    input.focus();
  });

  document.addEventListener('click', (e) => {
    if (!document.getElementById('header-search-container')?.contains(e.target)) {
      resultsContainer.classList.add('hidden');
    }
  });

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      input?.focus();
      input?.select();
    }
    if (e.key === 'Escape') {
      resultsContainer.classList.add('hidden');
      input?.blur();
    }
  });
</script>
