---
import { GATEWAY_IPS, BRANDS, ISPS, ROUTER_MODELS, formatModelTitle } from '../lib/data-loader';

interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Navigation items with icons and Tools placed in the LAST position
const navItems = [
  { 
    label: 'Home', 
    href: `${base}/`, 
    active: currentPath === '/' || currentPath === base || currentPath === `${base}/`,
    icon: 'home'
  },
  { 
    label: 'Brands', 
    href: `${base}/brands`, 
    active: currentPath.includes('brands'),
    icon: 'tag'
  },
  { 
    label: 'Gateway IPs', 
    href: `${base}/ip-addresses`, 
    active: currentPath.includes('ip-addresses'),
    icon: 'globe'
  },
  { 
    label: 'Router Models', 
    href: `${base}/routers`, 
    active: currentPath.includes('routers'),
    icon: 'router'
  },
  { 
    label: 'Default Passwords', 
    href: `${base}/default-passwords`, 
    active: currentPath.includes('default-passwords'),
    icon: 'lock'
  },
  { 
    label: 'Tools', 
    href: `${base}/tools`, 
    active: currentPath.includes('tools') || currentPath.includes('generator') || currentPath.includes('what-is-my-ip'),
    icon: 'wrench'
  }
];

// Search index for header live search
const searchItems = [
  // Gateway IPs
  ...GATEWAY_IPS.map(ip => ({
    name: ip.ip,
    title: `${ip.ip} Router Login`,
    category: 'Gateway IP',
    url: ip.slug === '192-168-1-1' ? `${base}/` : `${base}/${ip.slug}`,
    subtitle: `Default: ${ip.defaultUser} / ${ip.defaultPass}`,
    badgeColor: 'bg-emerald-50 text-emerald-700 border-emerald-200'
  })),
  // Router Brands
  ...BRANDS.map(b => ({
    name: b.name,
    title: `${b.name} Default Passwords`,
    category: 'Brand',
    url: `${base}/${b.slug}`,
    subtitle: `Default IP: ${b.defaultIp}`,
    badgeColor: 'bg-sky-50 text-sky-700 border-sky-200'
  })),
  // Router Models - Dedicated Model Pages
  ...ROUTER_MODELS.map(m => ({
    name: `${m.brand} ${m.model} ${m.series || ''} ${m.wifiStandard || ''} ${m.category || ''} ${m.ip}`,
    title: formatModelTitle(m.brand, m.model),
    category: 'Model',
    url: `${base}/${m.slug}`,
    subtitle: `${m.wifiStandard ? m.wifiStandard.split(' ')[0] + ' · ' : ''}IP: ${m.ip} · ${m.speedRating || m.category || 'Router'}`,
    badgeColor: 'bg-purple-50 text-purple-700 border-purple-200'
  })),
  // ISPs
  ...ISPS.map(isp => ({
    name: isp.name,
    title: `${isp.name} Setup Guide`,
    category: 'ISP',
    url: `${base}/${isp.slug}`,
    subtitle: `Gateway: ${isp.defaultIp}`,
    badgeColor: 'bg-amber-50 text-amber-700 border-amber-200'
  })),
  // Tools & Utilities
  {
    name: 'Internet Speed Test WiFi Ping Jitter Download Upload',
    title: 'Internet Speed Test',
    category: 'Tool',
    url: `${base}/speed-test`,
    subtitle: 'Measure WiFi Latency, Ping, Download & Upload',
    badgeColor: 'bg-indigo-50 text-indigo-700 border-indigo-200'
  },
  {
    name: 'Subnet Calculator CIDR IP Network Host Range',
    title: 'CIDR Subnet Calculator',
    category: 'Tool',
    url: `${base}/subnet-calculator`,
    subtitle: 'IPv4 Subnetting, Host Ranges, Netmask & Wildcard',
    badgeColor: 'bg-indigo-50 text-indigo-700 border-indigo-200'
  },
  {
    name: 'Public DNS Directory Servers Cloudflare Google Quad9 Benchmark',
    title: 'Public DNS Directory',
    category: 'Tool',
    url: `${base}/dns-servers`,
    subtitle: 'Fast & Secure DNS Resolvers (1.1.1.1, 8.8.8.8)',
    badgeColor: 'bg-indigo-50 text-indigo-700 border-indigo-200'
  },
  {
    name: 'Port Forwarding Common Ports List Minecraft Steam Plex NAT Firewall',
    title: 'Port Forwarding Guide',
    category: 'Tool',
    url: `${base}/port-forwarding`,
    subtitle: '40+ Ports Directory & Router NAT Forwarding Rules',
    badgeColor: 'bg-indigo-50 text-indigo-700 border-indigo-200'
  },
  {
    name: 'What Is My IP Public IPv4 IPv6 Address ISP Detector',
    title: 'What Is My IP Address?',
    category: 'Tool',
    url: `${base}/what-is-my-ip`,
    subtitle: 'Instant Public IP, ISP & Gateway Detector',
    badgeColor: 'bg-indigo-50 text-indigo-700 border-indigo-200'
  },
  {
    name: 'WiFi QR Code Generator Scan Connect Password',
    title: 'WiFi QR Code Generator',
    category: 'Tool',
    url: `${base}/wifi-qr-generator`,
    subtitle: 'Generate Printable QR Code to Connect Instantly',
    badgeColor: 'bg-indigo-50 text-indigo-700 border-indigo-200'
  },
  {
    name: 'Password Generator Secure High Entropy WPA3 Admin Key',
    title: 'Secure Password Generator',
    category: 'Tool',
    url: `${base}/password-generator`,
    subtitle: 'Cryptographic Passwords for Routers & WiFi',
    badgeColor: 'bg-indigo-50 text-indigo-700 border-indigo-200'
  },
  {
    name: 'Default Router Passwords List Database',
    title: 'Default Passwords DB',
    category: 'Tool',
    url: `${base}/default-passwords`,
    subtitle: 'Master Catalog of Factory Router Passwords',
    badgeColor: 'bg-indigo-50 text-indigo-700 border-indigo-200'
  }
];
---

<header class="sticky top-0 z-50 bg-white/95 dark:bg-slate-950/95 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800 shadow-2xs transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-2.5 sm:gap-3">
    
    <!-- Modern Text-Based Brand Logo with Vector Router Icon -->
    <a href={`${base}/`} class="flex items-center gap-2.5 group flex-shrink-0 transition-transform active:scale-95 select-none">
      <div class="relative w-9 h-9 rounded-xl bg-slate-900 dark:bg-brand-600 text-white flex items-center justify-center shadow-xs group-hover:bg-brand-600 dark:group-hover:bg-brand-500 transition-all duration-300 group-hover:shadow-md group-hover:shadow-brand-500/25">
        <!-- Modern Vector Router SVG -->
        <svg class="w-5 h-5 text-sky-400 dark:text-white transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="13" x2="3" y2="5"></line>
          <line x1="19" y1="13" x2="21" y2="5"></line>
          <line x1="12" y1="13" x2="12" y2="3"></line>
          <path d="M8 6a5.5 5.5 0 0 1 8 0" stroke-width="1.6" class="opacity-80"></path>
          <rect x="2" y="13" width="20" height="8" rx="2.5" fill="currentColor" fill-opacity="0.2"></rect>
          <circle cx="6" cy="17" r="0.75" fill="#10B981" stroke="none"></circle>
          <circle cx="9.5" cy="17" r="0.75" fill="#38BDF8" stroke="none"></circle>
          <circle cx="13" cy="17" r="0.75" fill="#38BDF8" stroke="none"></circle>
          <circle cx="16.5" cy="17" r="0.75" fill="#38BDF8" stroke="none"></circle>
        </svg>
      </div>
      <div class="flex flex-col text-left leading-none">
        <div class="flex items-baseline tracking-tight">
          <span class="font-black text-base sm:text-lg text-slate-900 dark:text-white font-sans tracking-tight group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
            19216811<span class="text-brand-600 dark:text-brand-400">.page</span>
          </span>
        </div>
        <span class="flex items-center gap-1 text-[9px] font-extrabold text-slate-400 dark:text-slate-500 uppercase tracking-widest mt-0.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          Router Gateway
        </span>
      </div>
    </a>

    <!-- Desktop / Tablet Navigation Links with Icons & Hover Effects -->
    <nav class="hidden md:flex items-center gap-0.5 lg:gap-1">
      {navItems.map(item => (
        <a 
          href={item.href} 
          class={`group flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-semibold transition-all duration-150 ${
            item.active 
              ? 'bg-slate-100 dark:bg-slate-800 text-brand-700 dark:text-brand-400 shadow-2xs font-bold ring-1 ring-slate-200/80 dark:ring-slate-700' 
              : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100/70 dark:hover:bg-slate-800/70 hover:scale-[1.02] active:scale-95'
          }`}
        >
          {item.icon === 'home' && (
            <svg class={`w-3.5 h-3.5 transition-colors ${item.active ? 'text-brand-600 dark:text-brand-400' : 'text-slate-400 dark:text-slate-500 group-hover:text-brand-500'}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
          )}
          {item.icon === 'tag' && (
            <svg class={`w-3.5 h-3.5 transition-colors ${item.active ? 'text-brand-600 dark:text-brand-400' : 'text-slate-400 dark:text-slate-500 group-hover:text-brand-500'}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
              <line x1="7" y1="7" x2="7.01" y2="7"></line>
            </svg>
          )}
          {item.icon === 'globe' && (
            <svg class={`w-3.5 h-3.5 transition-colors ${item.active ? 'text-brand-600 dark:text-brand-400' : 'text-slate-400 dark:text-slate-500 group-hover:text-brand-500'}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          )}
          {item.icon === 'router' && (
            <svg class={`w-3.5 h-3.5 transition-colors ${item.active ? 'text-brand-600 dark:text-brand-400' : 'text-slate-400 dark:text-slate-500 group-hover:text-brand-500'}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="13" width="20" height="8" rx="2"></rect>
              <path d="M6 13V7a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v6"></path>
              <circle cx="6" cy="17" r="1" fill="currentColor"></circle>
              <circle cx="10" cy="17" r="1" fill="currentColor"></circle>
            </svg>
          )}
          {item.icon === 'lock' && (
            <svg class={`w-3.5 h-3.5 transition-colors ${item.active ? 'text-brand-600 dark:text-brand-400' : 'text-slate-400 dark:text-slate-500 group-hover:text-brand-500'}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          )}
          {item.icon === 'wrench' && (
            <svg class={`w-3.5 h-3.5 transition-colors ${item.active ? 'text-brand-600 dark:text-brand-400' : 'text-slate-400 dark:text-slate-500 group-hover:text-brand-500'}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
            </svg>
          )}
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <!-- Search Bar & Theme Toggle Controls -->
    <div class="flex items-center gap-1.5 sm:gap-2">
      
      <!-- Live Search Bar -->
      <div class="relative w-40 sm:w-56 md:w-60 lg:w-68" id="header-search-container">
        <div class="relative flex items-center bg-slate-50 dark:bg-slate-900 hover:bg-slate-100/90 dark:hover:bg-slate-850 focus-within:bg-white dark:focus-within:bg-slate-900 border border-slate-200/90 dark:border-slate-800 focus-within:border-brand-500 focus-within:ring-2 focus-within:ring-brand-500/20 rounded-xl transition-all shadow-2xs">
          <div class="pl-2.5 pr-1.5 pointer-events-none text-slate-400 dark:text-slate-500 flex items-center">
            <svg class="w-3.5 h-3.5 text-brand-600 dark:text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <input 
            type="text" 
            id="header-search-input" 
            placeholder="Search IP, brand, tool..." 
            class="w-full py-1.5 pr-12 bg-transparent text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 outline-none text-xs font-medium"
            autocomplete="off"
            spellcheck="false"
          />
          <div class="absolute right-2 flex items-center gap-1">
            <button 
              id="header-search-clear" 
              type="button" 
              class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 hidden text-xs font-bold my-auto hover:scale-110 transition-transform"
              aria-label="Clear header search"
            >
              ✕
            </button>
            <kbd class="hidden lg:inline-flex items-center px-1 py-0.5 text-[9px] font-mono text-slate-400 dark:text-slate-500 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded">
              ⌘K
            </kbd>
          </div>
        </div>

        <!-- Live Search Results Dropdown -->
        <div 
          id="header-search-results" 
          class="absolute right-0 top-full mt-1.5 w-72 sm:w-84 bg-white dark:bg-slate-900 rounded-2xl shadow-card-hover border border-slate-200/90 dark:border-slate-800 overflow-hidden hidden z-50 max-h-80 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-800 custom-scrollbar animate-fade-in"
        >
          <div id="header-results-list"></div>
          <div class="px-3 py-1.5 bg-slate-50 dark:bg-slate-850 border-t border-slate-100 dark:border-slate-800 text-[9px] text-slate-400 dark:text-slate-500 flex items-center justify-between">
            <span><kbd class="px-1 py-0.2 bg-white dark:bg-slate-800 border dark:border-slate-700 rounded text-[8px]">↑↓</kbd> navigate</span>
            <span><kbd class="px-1 py-0.2 bg-white dark:bg-slate-800 border dark:border-slate-700 rounded text-[8px]">Enter</kbd> select</span>
          </div>
        </div>
      </div>

      <!-- Dark / Light Theme Toggle Button -->
      <button 
        id="theme-toggle" 
        type="button"
        class="w-8 h-8 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 text-slate-600 dark:text-amber-400 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center transition-all duration-150 hover:scale-105 active:scale-95 shadow-2xs cursor-pointer flex-shrink-0"
        aria-label="Toggle Dark Mode"
        title="Toggle Theme"
      >
        <!-- Sun icon (shown when dark) -->
        <svg id="theme-icon-sun" class="w-4 h-4 hidden dark:block text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <!-- Moon icon (shown when light) -->
        <svg id="theme-icon-moon" class="w-4 h-4 block dark:hidden text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

    </div>

  </div>

  <!-- Mobile Swipeable Nav Bar (Tools at last) -->
  <div class="md:hidden flex items-center gap-1.5 px-4 py-1.5 bg-slate-50/90 dark:bg-slate-900/90 border-t border-slate-200/60 dark:border-slate-800 overflow-x-auto no-scrollbar">
    {navItems.map(item => (
      <a 
        href={item.href} 
        class={`flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-medium whitespace-nowrap transition-all flex-shrink-0 ${
          item.active 
            ? 'bg-slate-900 dark:bg-brand-600 text-white font-semibold shadow-2xs ring-1 ring-slate-800 dark:ring-brand-500' 
            : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 active:scale-95'
        }`}
      >
        <span>{item.label}</span>
      </a>
    ))}
  </div>
</header>

<script define:vars={{ searchItems }}>
  // Header Search Engine
  const input = document.getElementById('header-search-input');
  const resultsContainer = document.getElementById('header-search-results');
  const resultsList = document.getElementById('header-results-list');
  const clearBtn = document.getElementById('header-search-clear');
  let selectedIndex = -1;
  let currentMatches = [];

  function highlightMatch(text, query) {
    if (!query) return text;
    const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
    return text.replace(regex, '<mark class="bg-amber-100 dark:bg-amber-900/80 text-amber-900 dark:text-amber-200 rounded-xs px-0.5 font-semibold">$1</mark>');
  }

  function renderResults(query) {
    selectedIndex = -1;
    if (!query.trim()) {
      resultsContainer.classList.add('hidden');
      clearBtn.classList.add('hidden');
      currentMatches = [];
      return;
    }

    clearBtn.classList.remove('hidden');
    const q = query.toLowerCase().trim();
    currentMatches = searchItems.filter(item => 
      item.name.toLowerCase().includes(q) ||
      item.title.toLowerCase().includes(q) ||
      item.subtitle.toLowerCase().includes(q) ||
      item.category.toLowerCase().includes(q)
    ).slice(0, 8);

    if (currentMatches.length === 0) {
      resultsList.innerHTML = `
        <div class="p-4 text-center text-xs text-slate-400 dark:text-slate-500">
          No matches found for "<strong class="text-slate-700 dark:text-slate-300">${query}</strong>"
        </div>
      `;
    } else {
      resultsList.innerHTML = currentMatches.map((item, idx) => `
        <a 
          href="${item.url}" 
          data-index="${idx}"
          class="header-search-item flex items-center justify-between p-2.5 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors group ${idx === 0 ? 'bg-slate-50/60 dark:bg-slate-800/60' : ''}"
        >
          <div class="flex items-center gap-2 min-w-0">
            <span class="text-[9px] font-bold px-1.5 py-0.5 rounded border ${item.badgeColor || 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300'} flex-shrink-0">
              ${item.category}
            </span>
            <div class="min-w-0">
              <div class="text-xs font-bold text-slate-900 dark:text-slate-100 group-hover:text-brand-600 dark:group-hover:text-brand-400 truncate">${highlightMatch(item.title, q)}</div>
              <div class="text-[10px] text-slate-500 dark:text-slate-400 truncate">${highlightMatch(item.subtitle, q)}</div>
            </div>
          </div>
          <span class="text-xs text-slate-300 dark:text-slate-600 group-hover:text-brand-600 dark:group-hover:text-brand-400 font-semibold flex-shrink-0 ml-1.5">
            →
          </span>
        </a>
      `).join('');
      selectedIndex = 0;
      updateActiveItem();
    }

    resultsContainer.classList.remove('hidden');
  }

  function updateActiveItem() {
    const items = resultsList.querySelectorAll('.header-search-item');
    items.forEach((item, idx) => {
      if (idx === selectedIndex) {
        item.classList.add('bg-brand-50/70', 'dark:bg-slate-800', 'ring-1', 'ring-brand-500/30');
        item.scrollIntoView({ block: 'nearest' });
      } else {
        item.classList.remove('bg-brand-50/70', 'dark:bg-slate-800', 'ring-1', 'ring-brand-500/30');
      }
    });
  }

  input?.addEventListener('input', (e) => renderResults(e.target.value));
  input?.addEventListener('focus', () => {
    if (input.value.trim()) renderResults(input.value);
  });

  clearBtn?.addEventListener('click', () => {
    input.value = '';
    renderResults('');
    input.focus();
  });

  input?.addEventListener('keydown', (e) => {
    if (resultsContainer.classList.contains('hidden')) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (currentMatches.length > 0) {
        selectedIndex = (selectedIndex + 1) % currentMatches.length;
        updateActiveItem();
      }
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (currentMatches.length > 0) {
        selectedIndex = (selectedIndex - 1 + currentMatches.length) % currentMatches.length;
        updateActiveItem();
      }
    } else if (e.key === 'Enter') {
      if (selectedIndex >= 0 && currentMatches[selectedIndex]) {
        e.preventDefault();
        window.location.href = currentMatches[selectedIndex].url;
      }
    } else if (e.key === 'Escape') {
      resultsContainer.classList.add('hidden');
    }
  });

  document.addEventListener('click', (e) => {
    if (!document.getElementById('header-search-container')?.contains(e.target)) {
      resultsContainer.classList.add('hidden');
    }
  });

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      input?.focus();
      input?.select();
    }
    if (e.key === 'Escape') {
      resultsContainer.classList.add('hidden');
      input?.blur();
    }
  });

  // Theme Toggle Handler
  const themeBtn = document.getElementById('theme-toggle');
  themeBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.theme = isDark ? 'dark' : 'light';
  });
</script>
