---
interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-md-surface-variant/70 shadow-m3-1">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    
    <!-- M3 Logo -->
    <a href={`${base}/`} class="flex items-center gap-2.5 group">
      <div class="w-10 h-10 rounded-m3-md bg-md-primary text-md-on-primary flex items-center justify-center text-xl shadow-m3-1 group-hover:scale-105 transition-transform">
        📡
      </div>
      <div>
        <div class="flex items-center gap-1.5">
          <span class="font-black text-lg sm:text-xl text-md-on-surface tracking-tight">Router<span class="text-md-primary">Guide</span></span>
          <span class="hidden sm:inline-block text-[10px] font-bold uppercase tracking-wider text-md-on-primary-container bg-md-primary-container px-2 py-0.5 rounded-m3-full">
            192.168.1.1
          </span>
        </div>
      </div>
    </a>

    <!-- M3 Navigation Chips (Desktop) -->
    <nav class="hidden lg:flex items-center gap-1.5">
      <a 
        href={`${base}/`} 
        class={`m3-chip ${currentPath === '/' || currentPath === base || currentPath === `${base}/` ? 'm3-chip-tonal font-bold text-md-primary bg-md-primary-container' : 'm3-chip-outlined font-medium'}`}
      >
        <span>🏠 Home</span>
      </a>
      <a 
        href={`${base}/brands`} 
        class={`m3-chip ${currentPath.includes('brands') ? 'm3-chip-tonal font-bold text-md-primary bg-md-primary-container' : 'm3-chip-outlined font-medium'}`}
      >
        <span>🏷️ Brands</span>
      </a>
      <a 
        href={`${base}/ip-addresses`} 
        class={`m3-chip ${currentPath.includes('ip-addresses') ? 'm3-chip-tonal font-bold text-md-primary bg-md-primary-container' : 'm3-chip-outlined font-medium'}`}
      >
        <span>🌐 Gateway IPs</span>
      </a>
      <a 
        href={`${base}/routers`} 
        class={`m3-chip ${currentPath.includes('routers') ? 'm3-chip-tonal font-bold text-md-primary bg-md-primary-container' : 'm3-chip-outlined font-medium'}`}
      >
        <span>📟 Models</span>
      </a>
      <a 
        href={`${base}/tools`} 
        class={`m3-chip ${currentPath.includes('tools') || currentPath.includes('generator') || currentPath.includes('what-is-my-ip') ? 'm3-chip-tonal font-bold text-md-primary bg-md-primary-container' : 'm3-chip-outlined font-medium'}`}
      >
        <span>🛠️ Tools</span>
      </a>
      <a 
        href={`${base}/default-passwords`} 
        class={`m3-chip ${currentPath.includes('default-passwords') ? 'm3-chip-tonal font-bold text-md-primary bg-md-primary-container' : 'm3-chip-outlined font-medium'}`}
      >
        <span>🔑 Passwords</span>
      </a>
    </nav>

    <!-- M3 FAB Action Button -->
    <div class="flex items-center gap-2">
      <a 
        href="http://192.168.1.1"
        target="_blank"
        rel="noopener noreferrer"
        class="m3-btn-filled text-xs py-2 px-4 shadow-m3-1 flex items-center gap-1.5"
      >
        <span>🔗 Open 192.168.1.1</span>
        <span class="text-[10px] opacity-80">↗</span>
      </a>
    </div>
  </div>

  <!-- Mobile Segmented Navigation Bar -->
  <div class="lg:hidden flex items-center justify-start gap-1.5 px-3 py-2 bg-md-surface-container overflow-x-auto no-scrollbar border-t border-md-surface-variant/40">
    <a href={`${base}/`} class="m3-chip m3-chip-outlined text-[11px] py-1 px-3 whitespace-nowrap">Home</a>
    <a href={`${base}/brands`} class="m3-chip m3-chip-outlined text-[11px] py-1 px-3 whitespace-nowrap">Brands</a>
    <a href={`${base}/ip-addresses`} class="m3-chip m3-chip-outlined text-[11px] py-1 px-3 whitespace-nowrap">IPs</a>
    <a href={`${base}/routers`} class="m3-chip m3-chip-outlined text-[11px] py-1 px-3 whitespace-nowrap">Models</a>
    <a href={`${base}/tools`} class="m3-chip m3-chip-outlined text-[11px] py-1 px-3 whitespace-nowrap">Tools</a>
    <a href={`${base}/default-passwords`} class="m3-chip m3-chip-outlined text-[11px] py-1 px-3 whitespace-nowrap">Passwords</a>
  </div>
</header>
