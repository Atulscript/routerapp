---
import { BRANDS, getModelsForBrand, getIpSlug, getModelSlug, formatModelTitle } from '../lib/data-loader';
import '../styles/data-table.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/**
 * The whole credential database as one table.
 *
 * The page used to render a separate PasswordTable per brand: 836 tables and 845
 * inline scripts for 2,363 rows, most of the weight being Tailwind utility classes
 * repeated on every cell. Here the classes are declared once in a global stylesheet
 * (global so Astro does not stamp a scope attribute onto all ~12,000 cells) and the
 * rows carry only their data.
 */

type Row = {
  title: string;
  href: string | null;
  ip: string;
  ipHref: string | null;
  username: string;
  password: string;
  brand: string;
  wifi: string;
  category: string;
};

const rows: Row[] = [];

for (const brand of BRANDS) {
  const models = getModelsForBrand(brand.slug);
  const source = models.length ? models : brand.models;

  for (const item of source) {
    const brandName = (item as any).brand || brand.name;
    const modelSlug = item.slug || getModelSlug(brandName, item.model);
    const ip = item.ip || '192.168.1.1';
    const ipSlug = getIpSlug(ip);
    const wifi = (item as any).wifiStandard || '';

    rows.push({
      title: formatModelTitle(brandName, item.model),
      href: modelSlug ? `${base}/${modelSlug}` : `${base}/${brand.slug}`,
      ip,
      ipHref: ipSlug !== null ? (ipSlug === '' ? `${base}/` : `${base}/${ipSlug}`) : null,
      username: item.username || 'admin',
      password: item.password || '(blank)',
      brand: brand.name,
      // "Wi-Fi 6 (802.11ax)" filters better as plain "Wi-Fi 6". Wired and modem-only
      // entries are "N/A (...)", which is not a standard worth badging or filtering by.
      wifi: wifi && !wifi.startsWith('N/A') ? wifi.replace(/\s*\(.*\)\s*/, '').trim() : '',
      category: (item as any).category || '',
    });
  }
}

const brandNames = [...new Set(rows.map(r => r.brand))].sort((a, b) => a.localeCompare(b));
const wifiStandards = [...new Set(rows.map(r => r.wifi).filter(Boolean))].sort();
const categories = [...new Set(rows.map(r => r.category).filter(Boolean))].sort();
const ips = [...new Set(rows.map(r => r.ip))]
  .map(ip => ({ ip, count: rows.filter(r => r.ip === ip).length }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 20);

// How many rows render before the reader asks for more.
const WINDOW = 100;
---

<section id="password-database">
  <!-- Controls stay in reach while the table scrolls; the site header is h-16. -->
  <div class="dt-bar">
    <div class="dt-search g-search-bar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
      </svg>
      <label for="dt-q" class="sr-only">Search models, IP addresses, usernames and passwords</label>
      <input id="dt-q" class="dt-q" type="text" autocomplete="off" spellcheck="false" placeholder="Search a model, IP, username or password…" />
      <button type="button" class="dt-clear" aria-label="Clear the search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div class="dt-facets">
      <label class="sr-only" for="dt-brand">Brand</label>
      <select id="dt-brand" class="dt-select" data-facet="brand">
        <option value="">All brands</option>
        {brandNames.map(name => <option value={name.toLowerCase()}>{name}</option>)}
      </select>

      <label class="sr-only" for="dt-wifi">Wi-Fi standard</label>
      <select id="dt-wifi" class="dt-select" data-facet="wifi">
        <option value="">Any Wi-Fi</option>
        {wifiStandards.map(w => <option value={w.toLowerCase()}>{w}</option>)}
      </select>

      <label class="sr-only" for="dt-cat">Device type</label>
      <select id="dt-cat" class="dt-select" data-facet="cat">
        <option value="">Any device</option>
        {categories.map(c => <option value={c.toLowerCase()}>{c}</option>)}
      </select>

      <label class="sr-only" for="dt-ipf">Gateway IP</label>
      <select id="dt-ipf" class="dt-select" data-facet="ip">
        <option value="">Any IP</option>
        {ips.map(({ ip, count }) => <option value={ip}>{ip} ({count})</option>)}
      </select>

      <button type="button" class="dt-reset dt-resetter">Reset</button>
    </div>

    <p class="dt-count" aria-live="polite">{rows.length} devices</p>
  </div>

  <div class="dt-wrap">
    <table class="dt-table">
      <caption class="sr-only">Default usernames and passwords for every router model in the directory</caption>
      <thead>
        <tr>
          <th scope="col">Model</th>
          <th scope="col" data-l="Gateway IP">Gateway IP</th>
          <th scope="col" data-l="Username">Username</th>
          <th scope="col" data-l="Password">Password</th>
          <th scope="col"><span class="sr-only">Copy password</span></th>
        </tr>
      </thead>
      <tbody class="dt-body">
        {rows.map((row, i) => (
          <tr class="dt-row" data-f={`${row.brand}|${row.wifi}|${row.category}|${row.ip}`.toLowerCase()} hidden={i >= WINDOW}>
            <td class="dt-t">
              {row.href ? <a href={row.href}>{row.title}</a> : row.title}
              {row.wifi && <b class="dt-tag">{row.wifi}</b>}
            </td>
            <td class="dt-ip">
              {row.ipHref ? <a href={row.ipHref}>{row.ip}</a> : row.ip}
            </td>
            <td class="dt-k"><code>{row.username}</code></td>
            <td class="dt-p"><code>{row.password}</code></td>
            <td class="dt-c">
              {/* The icon is a CSS mask, not inline SVG: 198 bytes x 2,363 rows is 456KB of identical markup. */}
              <button type="button" class="dt-copy" data-c={row.password} aria-label={`Copy ${row.title} password`}></button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="dt-empty" hidden>
    Nothing matches those filters. <button type="button" class="dt-resetter">Reset the filters</button> to see all {rows.length} devices.
  </p>

  <div class="dt-more">
    <button type="button">Show more devices</button>
    <span class="dt-shown">Showing {WINDOW} of {rows.length}</span>
  </div>
</section>

<script>
  import { initDataTable } from '../scripts/data-table';
  initDataTable('password-database');
</script>
