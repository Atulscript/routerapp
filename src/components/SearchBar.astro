---
import { GATEWAY_IPS, BRANDS, ISPS } from '../lib/data-loader';

// Prepare search index data
const searchItems = [
  ...GATEWAY_IPS.map(ip => ({
    name: ip.ip,
    title: `${ip.ip} Router Login`,
    category: 'Gateway IP',
    url: `/${ip.slug}`,
    subtitle: `Default: ${ip.defaultUser} / ${ip.defaultPass}`
  })),
  ...BRANDS.map(b => ({
    name: b.name,
    title: `${b.name} Default Passwords`,
    category: 'Router Brand',
    url: `/${b.slug}`,
    subtitle: `Default IP: ${b.defaultIp}`
  })),
  ...ISPS.map(isp => ({
    name: isp.name,
    title: `${isp.name} Setup Guide`,
    category: 'ISP Provider',
    url: `/${isp.slug}`,
    subtitle: `Gateway IP: ${isp.defaultIp}`
  }))
];
---

<div class="relative max-w-2xl mx-auto w-full" id="search-container">
  <div class="relative flex items-center">
    <div class="absolute left-4 pointer-events-none text-slate-400">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </div>
    <input 
      type="text" 
      id="search-input"
      placeholder="Search IP (192.168.1.1), Brand (TP-Link), or ISP (JioFiber)..." 
      class="w-full pl-12 pr-4 py-3.5 bg-white rounded-2xl border-2 border-slate-200 shadow-lg shadow-slate-200/50 focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 text-slate-800 placeholder-slate-400 outline-none text-base transition-all"
      autocomplete="off"
    />
    <button 
      id="search-clear" 
      class="absolute right-4 text-slate-400 hover:text-slate-600 hidden text-sm font-medium"
    >
      Clear
    </button>
  </div>

  <!-- Results Dropdown -->
  <div 
    id="search-results" 
    class="absolute left-0 right-0 top-full mt-2 bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden hidden z-50 max-h-80 overflow-y-auto"
  >
    <div id="results-list" class="divide-y divide-slate-100"></div>
  </div>
</div>

<script define:vars={{ searchItems }}>
  const input = document.getElementById('search-input');
  const resultsContainer = document.getElementById('search-results');
  const resultsList = document.getElementById('results-list');
  const clearBtn = document.getElementById('search-clear');

  function renderResults(query) {
    if (!query.trim()) {
      resultsContainer.classList.add('hidden');
      clearBtn.classList.add('hidden');
      return;
    }

    clearBtn.classList.remove('hidden');
    const q = query.toLowerCase().trim();
    const matches = searchItems.filter(item => 
      item.name.toLowerCase().includes(q) ||
      item.title.toLowerCase().includes(q) ||
      item.subtitle.toLowerCase().includes(q)
    );

    if (matches.length === 0) {
      resultsList.innerHTML = `
        <div class="p-4 text-center text-sm text-slate-500">
          No matching routers, IPs, or brands found for "<strong>${query}</strong>"
        </div>
      `;
    } else {
      resultsList.innerHTML = matches.map(item => `
        <a href="${item.url}" class="flex items-center justify-between p-3.5 hover:bg-brand-50/70 transition-colors group">
          <div class="flex items-center gap-3">
            <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-600 group-hover:bg-brand-100 group-hover:text-brand-700">
              ${item.category}
            </span>
            <div>
              <div class="text-sm font-bold text-slate-900 group-hover:text-brand-600">${item.title}</div>
              <div class="text-xs text-slate-500">${item.subtitle}</div>
            </div>
          </div>
          <span class="text-xs font-semibold text-brand-600 opacity-0 group-hover:opacity-100 transition-opacity">
            Open →
          </span>
        </a>
      `).join('');
    }

    resultsContainer.classList.remove('hidden');
  }

  input?.addEventListener('input', (e) => renderResults(e.target.value));
  input?.addEventListener('focus', () => {
    if (input.value.trim()) resultsContainer.classList.remove('hidden');
  });

  clearBtn?.addEventListener('click', () => {
    input.value = '';
    renderResults('');
    input.focus();
  });

  document.addEventListener('click', (e) => {
    if (!document.getElementById('search-container')?.contains(e.target)) {
      resultsContainer.classList.add('hidden');
    }
  });
</script>
