---
import { GATEWAY_IPS, BRANDS, ISPS } from '../lib/data-loader';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Prepare search index data
const searchItems = [
  ...GATEWAY_IPS.map(ip => ({
    name: ip.ip,
    title: `${ip.ip} Router Login`,
    category: 'Gateway IP',
    url: `${base}/${ip.slug}`,
    subtitle: `Default: ${ip.defaultUser} / ${ip.defaultPass}`
  })),
  ...BRANDS.map(b => ({
    name: b.name,
    title: `${b.name} Default Passwords`,
    category: 'Router Brand',
    url: `${base}/${b.slug}`,
    subtitle: `Default IP: ${b.defaultIp}`
  })),
  ...ISPS.map(isp => ({
    name: isp.name,
    title: `${isp.name} Setup Guide`,
    category: 'ISP Provider',
    url: `${base}/${isp.slug}`,
    subtitle: `Gateway IP: ${isp.defaultIp}`
  }))
];
---

<div class="relative max-w-2xl mx-auto w-full" id="search-container">
  <div class="relative flex items-center bg-white rounded-m3-full shadow-m3-2 border border-md-outline-variant/60 hover:shadow-m3-3 focus-within:shadow-m3-3 focus-within:border-md-primary transition-all duration-200">
    <div class="pl-5 pr-2 pointer-events-none text-md-primary flex items-center">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </div>
    <input 
      type="text" 
      id="search-input"
      placeholder="Search IP (192.168.1.1), Brand (TP-Link), or ISP (JioFiber)..." 
      class="w-full py-4 pr-12 bg-transparent text-md-on-surface placeholder-md-outline outline-none text-sm sm:text-base font-medium"
      autocomplete="off"
    />
    <button 
      id="search-clear" 
      class="absolute right-4 text-md-outline hover:text-md-on-surface hidden text-xs font-bold px-2 py-1 rounded-m3-full hover:bg-md-surface-container transition-colors"
    >
      ✕ Clear
    </button>
  </div>

  <!-- Results Dropdown -->
  <div 
    id="search-results" 
    class="absolute left-0 right-0 top-full mt-2 bg-white rounded-m3-xl shadow-m3-3 border border-md-outline-variant/60 overflow-hidden hidden z-50 max-h-80 overflow-y-auto divide-y divide-md-surface-variant/40"
  >
    <div id="results-list"></div>
  </div>
</div>

<script define:vars={{ searchItems }}>
  const input = document.getElementById('search-input');
  const resultsContainer = document.getElementById('search-results');
  const resultsList = document.getElementById('results-list');
  const clearBtn = document.getElementById('search-clear');

  function renderResults(query) {
    if (!query.trim()) {
      resultsContainer.classList.add('hidden');
      clearBtn.classList.add('hidden');
      return;
    }

    clearBtn.classList.remove('hidden');
    const q = query.toLowerCase().trim();
    const matches = searchItems.filter(item => 
      item.name.toLowerCase().includes(q) ||
      item.title.toLowerCase().includes(q) ||
      item.subtitle.toLowerCase().includes(q)
    );

    if (matches.length === 0) {
      resultsList.innerHTML = `
        <div class="p-6 text-center text-sm text-md-on-surface-variant">
          No matching routers, IPs, or brands found for "<strong class="text-md-on-surface">${query}</strong>"
        </div>
      `;
    } else {
      resultsList.innerHTML = matches.map(item => `
        <a href="${item.url}" class="flex items-center justify-between p-4 hover:bg-md-primary-container/40 transition-colors group">
          <div class="flex items-center gap-3.5">
            <span class="text-[11px] font-bold px-2.5 py-1 rounded-m3-full bg-md-secondary-container text-md-on-secondary-container">
              ${item.category}
            </span>
            <div>
              <div class="text-sm font-bold text-md-on-surface group-hover:text-md-primary">${item.title}</div>
              <div class="text-xs text-md-on-surface-variant">${item.subtitle}</div>
            </div>
          </div>
          <span class="text-xs font-bold text-md-primary opacity-0 group-hover:opacity-100 transition-opacity">
            Open →
          </span>
        </a>
      `).join('');
    }

    resultsContainer.classList.remove('hidden');
  }

  input?.addEventListener('input', (e) => renderResults(e.target.value));
  input?.addEventListener('focus', () => {
    if (input.value.trim()) resultsContainer.classList.remove('hidden');
  });

  clearBtn?.addEventListener('click', () => {
    input.value = '';
    renderResults('');
    input.focus();
  });

  document.addEventListener('click', (e) => {
    if (!document.getElementById('search-container')?.contains(e.target)) {
      resultsContainer.classList.add('hidden');
    }
  });
</script>
