---
import type { RouterModel } from '../lib/types';

interface Props {
  models: RouterModel[];
  brandName?: string;
}

const { models, brandName = '' } = Astro.props;
---

<div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
  <table class="w-full text-left text-sm text-slate-600">
    <thead class="bg-slate-50 text-xs font-bold uppercase tracking-wider text-slate-500 border-b border-slate-200">
      <tr>
        <th class="px-5 py-3.5">Router Model</th>
        <th class="px-5 py-3.5">Gateway IP</th>
        <th class="px-5 py-3.5">Default Username</th>
        <th class="px-5 py-3.5">Default Password</th>
        <th class="px-5 py-3.5 text-right">Action</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      {models.map((item) => (
        <tr class="hover:bg-slate-50/70 transition-colors">
          <td class="px-5 py-4 font-semibold text-slate-900">
            {brandName ? `${brandName} ` : ''}{item.model}
          </td>
          <td class="px-5 py-4 font-mono font-bold text-brand-600">
            {item.ip}
          </td>
          <td class="px-5 py-4 font-mono">
            <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-800 border border-slate-200 text-xs">
              {item.username}
            </span>
          </td>
          <td class="px-5 py-4 font-mono">
            <span class="px-2 py-0.5 rounded bg-amber-50 text-amber-900 border border-amber-200 text-xs">
              {item.password}
            </span>
          </td>
          <td class="px-5 py-4 text-right">
            <button 
              type="button"
              onclick={`navigator.clipboard.writeText('${item.password}'); alert('Copied password: ${item.password}')`}
              class="text-xs font-medium text-slate-500 hover:text-brand-600 px-2 py-1 rounded hover:bg-brand-50 transition-colors"
            >
              📋 Copy
            </button>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
