---
import type { RouterModel, BrandModel } from '../lib/types';
import { getIpSlug, getBrandSlug, getModelSlug, formatModelTitle } from '../lib/data-loader';
import ModelThumb from './ModelThumb.astro';

interface Props {
  /** Full records from ROUTER_MODELS, or the short entries stored on a Brand */
  models: (RouterModel | BrandModel)[];
  brandName?: string;
  brandSlug?: string;
}

const { models, brandName = '', brandSlug = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolvedBrandSlug = brandSlug || (brandName ? getBrandSlug(brandName) : null);
const tableId = `pw-table-${Math.random().toString(36).substring(2, 8)}`;
---

<div class="space-y-3 font-sans" id={tableId}>
  {models.length > 5 && (
    <div class="flex flex-col sm:flex-row items-center justify-between gap-2.5 pb-1">
      <div class="relative w-full sm:w-80">
        <input 
          type="text" 
          placeholder="Filter model, IP, username, password..." 
          class="table-filter-input w-full pl-9 pr-3 py-2 bg-surface border border-line rounded-xl text-xs font-medium text-ink placeholder-ink-subtle focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-all shadow-2xs"
        />
        <span class="absolute left-3 inset-y-0 flex items-center text-ink-muted text-xs pointer-events-none">🔍</span>
      </div>
      <span class="text-xs text-ink-muted font-medium table-model-count">
        Showing all {models.length} devices
      </span>
    </div>
  )}

  <div class="overflow-x-auto rounded-2xl border border-line bg-surface shadow-sm">
    <table class="responsive-table w-full text-left text-sm text-ink-muted border-collapse">
      <thead class="bg-surface-sunken text-[11px] font-bold uppercase tracking-wider text-ink-muted border-b border-line">
        <tr>
          <th class="px-4 py-3">Hardware Model</th>
          <th class="px-4 py-3">Gateway IP</th>
          <th class="px-4 py-3">Default Username</th>
          <th class="px-4 py-3">Default Password</th>
          <th class="px-4 py-3 text-right"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line-subtle font-sans table-rows-container">
        {models.map((item) => {
          const itemBrandName = (item as any).brand || brandName;
          const itemBrandSlug = (item as any).brandSlug || resolvedBrandSlug || (itemBrandName ? getBrandSlug(itemBrandName) : null);
          const itemModelSlug = item.slug || getModelSlug(itemBrandName, item.model);
          const displayTitle = formatModelTitle(itemBrandName, item.model);
          const cleanIp = item.ip || '192.168.1.1';
          const ipSlug = getIpSlug(cleanIp);
          const internalIpUrl = ipSlug !== null ? (ipSlug === '' ? `${base}/` : `${base}/${ipSlug}`) : null;
          
          return (
            <tr class="model-row hover:bg-surface-muted transition-colors" data-search={`${itemBrandName} ${item.model} ${cleanIp} ${item.username} ${item.password} ${item.category || ''} ${item.wifiStandard || ''}`.toLowerCase()}>
              <td class="px-4 py-3 font-semibold text-ink">
                <div class="flex items-center gap-2 flex-wrap">
                  <ModelThumb slug={itemModelSlug} name={displayTitle} />
                  {itemModelSlug ? (
                    <a 
                      href={`${base}/${itemModelSlug}`} 
                      class="text-accent hover:underline inline-flex items-center gap-1 font-bold"
                      title={`View dedicated ${displayTitle} specs and setup guide`}
                    >
                      <span>{displayTitle}</span>
                      <span class="text-xs text-accent opacity-75">→</span>
                    </a>
                  ) : itemBrandSlug ? (
                    <a 
                      href={`${base}/${itemBrandSlug}`} 
                      class="text-accent hover:underline"
                      title={`View ${itemBrandName} guide`}
                    >
                      <span>{displayTitle}</span>
                    </a>
                  ) : (
                    <span>{displayTitle}</span>
                  )}
                  {item.wifiStandard && (
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-accent-soft text-accent border border-accent/20">
                      {item.wifiStandard.split(' ')[0]}
                    </span>
                  )}
                  {item.category && item.category !== 'Home Wi-Fi' && (
                    <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-surface-muted text-ink-muted border border-line">
                      {item.category}
                    </span>
                  )}
                </div>
              </td>
              <td class="px-4 py-3 font-mono font-bold" data-label="Gateway IP">
                <div class="flex items-center gap-1.5">
                  {internalIpUrl ? (
                    <a 
                      href={internalIpUrl} 
                      class="text-accent hover:underline inline-flex items-center gap-1"
                      title={`View ${cleanIp} setup guide`}
                    >
                      <span>{cleanIp}</span>
                    </a>
                  ) : (
                    <span class="text-ink">{cleanIp}</span>
                  )}
                  <a 
                    href={`http://${cleanIp}`} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="inline-flex items-center justify-center w-7 h-7 rounded-full text-sm text-ink-muted hover:bg-accent-soft hover:text-accent transition-colors"
                    title={`Open http://${cleanIp} in a new tab`}
                    aria-label={`Open ${cleanIp} in a new tab`}
                  >
                    ↗
                  </a>
                </div>
              </td>
              <td class="px-4 py-3 font-mono" data-label="Username">
                <span class="whitespace-nowrap px-2.5 py-1 rounded-md bg-surface-muted text-ink border border-line text-xs font-semibold">
                  {item.username}
                </span>
              </td>
              <td class="px-4 py-3 font-mono" data-label="Password">
                <span class="whitespace-nowrap px-2.5 py-1 rounded-md bg-ok-soft text-ok border border-ok/20 text-xs font-bold">
                  {item.password}
                </span>
              </td>
              <td class="px-4 py-3 text-right" data-label="">
                <button
                  type="button"
                  class="copy-btn g-copy-btn"
                  data-copy={item.password}
                  aria-label={`Copy default password for ${displayTitle}`}
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
                  <span>Copy password</span>
                </button>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</div>

<script define:vars={{ tableId }}>
  const container = document.getElementById(tableId);
  if (container) {
    const filterInput = container.querySelector('.table-filter-input');
    const rows = container.querySelectorAll('.model-row');
    const countDisplay = container.querySelector('.table-model-count');

    if (filterInput) {
      filterInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        let visibleCount = 0;

        rows.forEach(row => {
          const searchData = row.getAttribute('data-search') || '';
          if (!query || searchData.includes(query)) {
            row.style.display = '';
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        });

        if (countDisplay) {
          countDisplay.textContent = query 
            ? `Showing ${visibleCount} of ${rows.length} models`
            : `Showing all ${rows.length} devices`;
        }
      });
    }
  }
</script>
