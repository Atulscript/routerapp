---
import type { RouterModel } from '../lib/types';
import { getIpSlug, getBrandSlug } from '../lib/data-loader';

interface Props {
  models: RouterModel[];
  brandName?: string;
  brandSlug?: string;
}

const { models, brandName = '', brandSlug = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolvedBrandSlug = brandSlug || (brandName ? getBrandSlug(brandName) : null);
---

<div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs">
  <table class="w-full text-left text-xs text-slate-700 dark:text-slate-300">
    <thead class="bg-slate-100 dark:bg-slate-950 text-[11px] font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 border-b border-slate-200 dark:border-slate-800">
      <tr>
        <th class="px-3.5 py-2.5">Router Model</th>
        <th class="px-3.5 py-2.5">Gateway IP Guide</th>
        <th class="px-3.5 py-2.5">Username</th>
        <th class="px-3.5 py-2.5">Password</th>
        <th class="px-3.5 py-2.5 text-right">Action</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100 dark:divide-slate-800 font-sans">
      {models.map((item) => {
        const itemBrandName = (item as any).brand || brandName;
        const itemBrandSlug = (item as any).brandSlug || resolvedBrandSlug || (itemBrandName ? getBrandSlug(itemBrandName) : null);
        const cleanIp = item.ip || '192.168.1.1';
        const ipSlug = getIpSlug(cleanIp);
        const internalIpUrl = ipSlug !== null ? (ipSlug === '' ? `${base}/` : `${base}/${ipSlug}`) : null;
        
        return (
          <tr class="hover:bg-sky-50/70 dark:hover:bg-slate-800/70 transition-colors">
            <td class="px-3.5 py-2 font-semibold text-slate-900 dark:text-white">
              {itemBrandSlug ? (
                <a href={`${base}/${itemBrandSlug}`} class="text-brand-700 dark:text-brand-400 hover:text-brand-900 dark:hover:text-brand-300 hover:underline">
                  {itemBrandName ? `${itemBrandName} ` : ''}{item.model}
                </a>
              ) : (
                <span>{itemBrandName ? `${itemBrandName} ` : ''}{item.model}</span>
              )}
            </td>
            <td class="px-3.5 py-2 font-mono font-bold">
              <div class="flex items-center gap-1.5">
                {internalIpUrl ? (
                  <a 
                    href={internalIpUrl} 
                    class="text-brand-600 dark:text-brand-400 hover:text-brand-800 dark:hover:text-brand-300 hover:underline inline-flex items-center gap-1"
                    title={`View ${cleanIp} setup guide`}
                  >
                    <span>{cleanIp}</span>
                  </a>
                ) : (
                  <span class="text-slate-800 dark:text-slate-200">{cleanIp}</span>
                )}
                <a 
                  href={`http://${cleanIp}`} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-[10px] text-slate-400 hover:text-brand-600 dark:hover:text-brand-400"
                  title={`Open http://${cleanIp} directly in new tab`}
                >
                  ↗
                </a>
              </div>
            </td>
            <td class="px-3.5 py-2 font-mono">
              <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700 text-xs">
                {item.username}
              </span>
            </td>
            <td class="px-3.5 py-2 font-mono">
              <span class="px-2 py-0.5 rounded bg-amber-50 dark:bg-amber-950/60 text-amber-900 dark:text-amber-300 border border-amber-200 dark:border-amber-800/80 text-xs font-bold">
                {item.password}
              </span>
            </td>
            <td class="px-3.5 py-2 text-right">
              <button 
                type="button"
                onclick={`
                  navigator.clipboard.writeText('${item.password}');
                  const orig = this.innerHTML;
                  this.innerHTML = '✓ Copied';
                  this.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
                  setTimeout(() => {
                    this.innerHTML = orig;
                    this.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600');
                  }, 1500);
                `}
                class="text-[10px] font-bold text-slate-600 dark:text-slate-300 hover:text-sky-700 dark:hover:text-white px-2.5 py-1 rounded-md border border-slate-200 dark:border-slate-700 hover:border-sky-300 dark:hover:border-slate-600 bg-white dark:bg-slate-800 hover:bg-sky-50 dark:hover:bg-slate-700 transition-all active:scale-95 cursor-pointer shadow-2xs"
              >
                📋 Copy
              </button>
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
