---
import type { RouterModel } from '../lib/types';
import { getIpSlug, getBrandSlug, getModelSlug, formatModelTitle } from '../lib/data-loader';

interface Props {
  models: RouterModel[];
  brandName?: string;
  brandSlug?: string;
}

const { models, brandName = '', brandSlug = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolvedBrandSlug = brandSlug || (brandName ? getBrandSlug(brandName) : null);
const tableId = `pw-table-${Math.random().toString(36).substring(2, 8)}`;
---

<div class="space-y-3 font-sans" id={tableId}>
  {models.length > 5 && (
    <div class="flex flex-col sm:flex-row items-center justify-between gap-2.5 pb-1">
      <div class="relative w-full sm:w-72">
        <input 
          type="text" 
          placeholder="Filter models, IP, or credentials..." 
          class="table-filter-input w-full pl-8 pr-3 py-1.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-medium text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500/20 transition-all shadow-2xs"
        />
        <span class="absolute left-2.5 inset-y-0 flex items-center text-slate-400 text-xs pointer-events-none">🔍</span>
      </div>
      <span class="text-[11px] text-slate-500 dark:text-slate-400 font-medium table-model-count">
        Showing all {models.length} devices
      </span>
    </div>
  )}

  <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs">
    <table class="w-full text-left text-xs text-slate-700 dark:text-slate-300">
      <thead class="bg-slate-100 dark:bg-slate-950 text-[11px] font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 border-b border-slate-200 dark:border-slate-800">
        <tr>
          <th class="px-3.5 py-2.5">Hardware Model</th>
          <th class="px-3.5 py-2.5">Gateway IP Guide</th>
          <th class="px-3.5 py-2.5">Username</th>
          <th class="px-3.5 py-2.5">Password</th>
          <th class="px-3.5 py-2.5 text-right">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-slate-800 font-sans table-rows-container">
        {models.map((item) => {
          const itemBrandName = (item as any).brand || brandName;
          const itemBrandSlug = (item as any).brandSlug || resolvedBrandSlug || (itemBrandName ? getBrandSlug(itemBrandName) : null);
          const itemModelSlug = item.slug || getModelSlug(itemBrandName, item.model);
          const displayTitle = formatModelTitle(itemBrandName, item.model);
          const cleanIp = item.ip || '192.168.1.1';
          const ipSlug = getIpSlug(cleanIp);
          const internalIpUrl = ipSlug !== null ? (ipSlug === '' ? `${base}/` : `${base}/${ipSlug}`) : null;
          
          return (
            <tr class="model-row hover:bg-sky-50/70 dark:hover:bg-slate-800/70 transition-colors" data-search={`${itemBrandName} ${item.model} ${cleanIp} ${item.username} ${item.password} ${item.category || ''} ${item.wifiStandard || ''}`.toLowerCase()}>
              <td class="px-3.5 py-2.5 font-semibold text-slate-900 dark:text-white">
                <div class="flex items-center gap-2 flex-wrap">
                  {itemModelSlug ? (
                    <a 
                      href={`${base}/${itemModelSlug}`} 
                      class="text-brand-700 dark:text-brand-400 hover:text-brand-900 dark:hover:text-brand-300 hover:underline inline-flex items-center gap-1 font-bold"
                      title={`View dedicated ${displayTitle} specs and setup guide`}
                    >
                      <span>{displayTitle}</span>
                      <span class="text-[10px] text-brand-500 dark:text-brand-400 opacity-75">→</span>
                    </a>
                  ) : itemBrandSlug ? (
                    <a 
                      href={`${base}/${itemBrandSlug}`} 
                      class="text-brand-700 dark:text-brand-400 hover:text-brand-900 dark:hover:text-brand-300 hover:underline"
                      title={`View ${itemBrandName} guide`}
                    >
                      <span>{displayTitle}</span>
                    </a>
                  ) : (
                    <span>{displayTitle}</span>
                  )}
                  {item.wifiStandard && (
                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                      {item.wifiStandard.split(' ')[0]}
                    </span>
                  )}
                  {item.category && item.category !== 'Home Wi-Fi' && (
                    <span class="hidden sm:inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800/60">
                      {item.category}
                    </span>
                  )}
                </div>
              </td>
              <td class="px-3.5 py-2.5 font-mono font-bold">
                <div class="flex items-center gap-1.5">
                  {internalIpUrl ? (
                    <a 
                      href={internalIpUrl} 
                      class="text-brand-700 dark:text-brand-400 hover:underline inline-flex items-center gap-1"
                      title={`View ${cleanIp} setup guide`}
                    >
                      <span>{cleanIp}</span>
                    </a>
                  ) : (
                    <span class="text-slate-800 dark:text-slate-200">{cleanIp}</span>
                  )}
                  <a 
                    href={`http://${cleanIp}`} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="text-[10px] text-slate-400 hover:text-brand-600 dark:hover:text-brand-400"
                    title={`Open http://${cleanIp} directly in new tab`}
                  >
                    ↗
                  </a>
                </div>
              </td>
              <td class="px-3.5 py-2.5 font-mono">
                <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700 text-xs">
                  {item.username}
                </span>
              </td>
              <td class="px-3.5 py-2.5 font-mono">
                <span class="px-2 py-0.5 rounded bg-amber-50 dark:bg-amber-950/60 text-amber-900 dark:text-amber-300 border border-amber-200 dark:border-amber-800/80 text-xs font-bold">
                  {item.password}
                </span>
              </td>
              <td class="px-3.5 py-2.5 text-right">
                <button 
                  type="button"
                  onclick={`
                    navigator.clipboard.writeText('${item.password}');
                    const orig = this.innerHTML;
                    this.innerHTML = '✓ Copied';
                    this.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
                    setTimeout(() => {
                      this.innerHTML = orig;
                      this.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600');
                    }, 1500);
                  `}
                  class="text-[10px] font-bold text-slate-600 dark:text-slate-300 hover:text-sky-700 dark:hover:text-white px-2.5 py-1 rounded-md border border-slate-200 dark:border-slate-700 hover:border-sky-300 dark:hover:border-slate-600 bg-white dark:bg-slate-800 hover:bg-sky-50 dark:hover:bg-slate-700 transition-all active:scale-95 cursor-pointer shadow-2xs"
                >
                  📋 Copy
                </button>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</div>

<script define:vars={{ tableId }}>
  const container = document.getElementById(tableId);
  if (container) {
    const filterInput = container.querySelector('.table-filter-input');
    const rows = container.querySelectorAll('.model-row');
    const countDisplay = container.querySelector('.table-model-count');

    if (filterInput) {
      filterInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        let visibleCount = 0;

        rows.forEach(row => {
          const searchData = row.getAttribute('data-search') || '';
          if (!query || searchData.includes(query)) {
            row.style.display = '';
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        });

        if (countDisplay) {
          countDisplay.textContent = query 
            ? `Showing ${visibleCount} of ${rows.length} models`
            : `Showing all ${rows.length} devices`;
        }
      });
    }
  }
</script>
