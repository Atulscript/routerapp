---
import { BRANDS } from '../lib/data-loader';

// Collect all models with brand and protocol
const allModels = BRANDS.flatMap(b => 
  b.models.map(m => ({
    brand: b.name,
    brandSlug: b.slug,
    model: m.model,
    protocol: m.protocol || 'HTTP',
    ip: m.ip,
    username: m.username,
    password: m.password
  }))
);

const brandNames = Array.from(new Set(BRANDS.map(b => b.name))).sort((a, b) => a.localeCompare(b));
const popularBrands = ['TP-Link', 'Netgear', 'ASUS', 'D-Link', 'Cisco', 'JioFiber', 'Airtel', 'Linksys', 'Tenda'];
---

<div class="w-full my-3 font-sans" id="router-lookup-container">
  
  <!-- Filter Controls Toolbar -->
  <div class="mb-3 space-y-2.5">
    <div class="grid grid-cols-1 sm:grid-cols-12 gap-2.5 items-end">
      
      <!-- Brand Dropdown Selector -->
      <div class="sm:col-span-7">
        <label for="brand-select" class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">
          🏢 Select Router Brand:
        </label>
        <div class="relative">
          <select 
            id="brand-select" 
            class="w-full pl-3 pr-8 py-2 bg-white border border-slate-300 rounded-lg text-slate-900 text-xs font-bold shadow-2xs focus:border-sky-600 focus:ring-2 focus:ring-sky-500/20 outline-none cursor-pointer appearance-none transition-all"
          >
            <option value="ALL">-- All Brands ({allModels.length} Models) --</option>
            {brandNames.map(brand => (
              <option value={brand} selected={brand === 'TP-Link'}>
                {brand}
              </option>
            ))}
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-2.5 flex items-center text-slate-500 text-xs">
            ▼
          </div>
        </div>
      </div>

      <!-- Quick Filter Search Input -->
      <div class="sm:col-span-5">
        <label for="table-search-input" class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">
          🔍 Quick Search:
        </label>
        <div class="relative">
          <input 
            type="text" 
            id="table-search-input" 
            placeholder="Search model, admin, pass..." 
            class="w-full pl-3 pr-7 py-2 bg-white border border-slate-300 rounded-lg text-xs font-medium text-slate-900 focus:border-sky-600 focus:ring-2 focus:ring-sky-500/20 outline-none shadow-2xs"
          />
          <button 
            type="button" 
            id="clear-search-btn" 
            class="hidden absolute right-2 inset-y-0 text-slate-400 hover:text-slate-600 text-xs font-bold my-auto"
          >
            ✕
          </button>
        </div>
      </div>

    </div>

    <!-- Quick Brand Pills -->
    <div class="flex flex-wrap items-center gap-1.5 pt-0.5 text-xs">
      <span class="text-slate-500 font-bold text-[11px] mr-0.5">Popular:</span>
      <button type="button" class="brand-pill px-2 py-0.5 rounded-md text-[11px] font-bold border border-slate-200 bg-white hover:bg-sky-50 hover:border-sky-300 text-slate-700 transition-all cursor-pointer" data-brand="ALL">
        All
      </button>
      {popularBrands.map(pb => (
        <button 
          type="button" 
          class={`brand-pill px-2 py-0.5 rounded-md text-[11px] font-bold border transition-all cursor-pointer ${pb === 'TP-Link' ? 'bg-sky-600 text-white border-sky-600 shadow-2xs' : 'border-slate-200 bg-white hover:bg-sky-50 hover:border-sky-300 text-slate-700'}`}
          data-brand={pb}
        >
          {pb}
        </button>
      ))}
    </div>
  </div>

  <!-- High-Density Scrollable Table with Sticky Header -->
  <div class="overflow-x-auto border border-sky-800/80 rounded-xl shadow-2xs bg-white max-h-80 overflow-y-auto custom-scrollbar">
    <table class="w-full text-left border-collapse" id="models-table">
      <thead class="sticky top-0 z-10 bg-[#3e6b89] text-white text-xs font-bold shadow-2xs">
        <tr>
          <th class="py-2 px-3 border-r border-sky-700/60 whitespace-nowrap">Brand</th>
          <th class="py-2 px-3 border-r border-sky-700/60 whitespace-nowrap">Model</th>
          <th class="py-2 px-3 border-r border-sky-700/60 whitespace-nowrap">Gateway IP</th>
          <th class="py-2 px-3 border-r border-sky-700/60 whitespace-nowrap">Protocol</th>
          <th class="py-2 px-3 border-r border-sky-700/60 whitespace-nowrap">Username</th>
          <th class="py-2 px-3 whitespace-nowrap">Password</th>
        </tr>
      </thead>
      <tbody id="table-body" class="divide-y divide-slate-100 text-xs text-slate-800 font-sans">
        <!-- Filled dynamically -->
      </tbody>
    </table>
  </div>

  <!-- Footer status bar -->
  <div class="flex flex-col sm:flex-row justify-between items-center mt-2 text-xs text-slate-500 gap-1 px-1">
    <span id="model-count-text" class="font-semibold text-[11px] text-slate-700">Loading models...</span>
    <span class="text-[11px] text-slate-400">
      💡 Click copy button next to password to copy
    </span>
  </div>
</div>

<script define:vars={{ allModels }}>
  const select = document.getElementById('brand-select');
  const searchInput = document.getElementById('table-search-input');
  const clearBtn = document.getElementById('clear-search-btn');
  const tbody = document.getElementById('table-body');
  const countText = document.getElementById('model-count-text');
  const pills = document.querySelectorAll('.brand-pill');

  function copyPassword(pw, btn) {
    navigator.clipboard.writeText(pw);
    const origHtml = btn.innerHTML;
    btn.innerHTML = '✓ Copied';
    btn.classList.remove('bg-white', 'text-sky-700', 'border-sky-300');
    btn.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
    setTimeout(() => {
      btn.innerHTML = origHtml;
      btn.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600');
      btn.classList.add('bg-white', 'text-sky-700', 'border-sky-300');
    }, 1500);
  }
  window.copyPassword = copyPassword;

  function updatePillActive(currentBrand) {
    pills.forEach(pill => {
      const b = pill.getAttribute('data-brand');
      if (b === currentBrand || (b === 'ALL' && currentBrand === 'ALL')) {
        pill.classList.remove('bg-white', 'text-slate-700', 'border-slate-200');
        pill.classList.add('bg-sky-600', 'text-white', 'border-sky-600', 'shadow-2xs');
      } else {
        pill.classList.remove('bg-sky-600', 'text-white', 'border-sky-600', 'shadow-2xs');
        pill.classList.add('bg-white', 'text-slate-700', 'border-slate-200');
      }
    });
  }

  function renderTable() {
    const selectedBrand = select?.value || 'TP-Link';
    const searchQuery = searchInput?.value.toLowerCase().trim() || '';

    if (clearBtn) {
      clearBtn.classList.toggle('hidden', searchQuery.length === 0);
    }

    updatePillActive(selectedBrand);

    let filtered = allModels;
    if (selectedBrand && selectedBrand !== 'ALL') {
      filtered = allModels.filter(item => item.brand.toUpperCase() === selectedBrand.toUpperCase());
    }

    if (searchQuery) {
      filtered = filtered.filter(item => 
        item.brand.toLowerCase().includes(searchQuery) ||
        item.model.toLowerCase().includes(searchQuery) ||
        item.ip.toLowerCase().includes(searchQuery) ||
        item.protocol.toLowerCase().includes(searchQuery) ||
        item.username.toLowerCase().includes(searchQuery) ||
        item.password.toLowerCase().includes(searchQuery)
      );
    }

    if (countText) {
      countText.innerText = selectedBrand === 'ALL' 
        ? `Showing ${filtered.length} models across all brands` 
        : `Showing ${filtered.length} model(s) for ${selectedBrand}`;
    }

    if (filtered.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="6" class="py-6 text-center text-slate-400 italic bg-slate-50">
            No matching router models found. Try changing your brand or search term.
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = filtered.map((item, index) => {
      const bgClass = index % 2 === 0 ? 'bg-[#f4f8fb]' : 'bg-white';
      const cleanIp = item.ip || '192.168.1.1';
      return `
        <tr class="${bgClass} hover:bg-sky-50 transition-colors">
          <td class="py-1.5 px-3 font-bold text-slate-900 border-r border-slate-200/60 whitespace-nowrap text-xs">${item.brand}</td>
          <td class="py-1.5 px-3 font-medium text-slate-800 border-r border-slate-200/60 whitespace-nowrap text-xs">${item.model}</td>
          <td class="py-1.5 px-3 font-mono font-bold text-sky-700 border-r border-slate-200/60 whitespace-nowrap text-xs">
            <a href="http://${cleanIp}" target="_blank" rel="noopener noreferrer" class="hover:underline hover:text-sky-900">
              ${cleanIp} <span class="text-[9px]">↗</span>
            </a>
          </td>
          <td class="py-1.5 px-3 text-slate-500 border-r border-slate-200/60 whitespace-nowrap text-[11px]">${item.protocol}</td>
          <td class="py-1.5 px-3 font-mono text-slate-700 border-r border-slate-200/60 whitespace-nowrap text-xs font-semibold">${item.username}</td>
          <td class="py-1.5 px-3 font-mono font-bold text-slate-900 whitespace-nowrap text-xs">
            <div class="flex items-center justify-between gap-2">
              <span class="truncate max-w-[100px] sm:max-w-[140px]">${item.password}</span>
              <button 
                type="button" 
                onclick="window.copyPassword('${item.password}', this)"
                class="text-[10px] px-2 py-0.5 rounded bg-white hover:bg-sky-600 hover:text-white text-sky-700 font-sans font-bold border border-sky-300 shadow-2xs transition-all active:scale-95 cursor-pointer flex-shrink-0"
              >
                Copy
              </button>
            </div>
          </td>
        </tr>
      `;
    }).join('');
  }

  // Set initial select value to TP-Link
  if (select) {
    select.value = 'TP-Link';
  }

  // Initial render
  renderTable();

  select?.addEventListener('change', renderTable);
  searchInput?.addEventListener('input', renderTable);
  clearBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    renderTable();
  });

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      const brand = pill.getAttribute('data-brand') || 'ALL';
      if (select) {
        select.value = brand;
      }
      renderTable();
    });
  });
</script>
