---
import { BRANDS } from '../lib/data-loader';

// Collect all models with brand and protocol
const allModels = BRANDS.flatMap(b => 
  b.models.map(m => ({
    brand: b.name,
    brandSlug: b.slug,
    model: m.model,
    protocol: m.protocol || 'HTTP',
    ip: m.ip,
    username: m.username,
    password: m.password
  }))
);

const brandNames = Array.from(new Set(BRANDS.map(b => b.name))).sort((a, b) => a.localeCompare(b));
---

<div class="w-full max-w-4xl mx-auto my-4 font-sans" id="router-lookup-container">
  
  <!-- Compact Filter Bar -->
  <div class="mb-3.5 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5">
    <div class="flex-1 sm:max-w-xs">
      <label for="brand-select" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">
        Router Brand:
      </label>
      <div class="relative">
        <select 
          id="brand-select" 
          class="w-full pl-3 pr-8 py-2 bg-white border border-slate-300 rounded-xl text-slate-900 text-xs font-bold shadow-xs focus:border-sky-600 focus:ring-2 focus:ring-sky-500/15 outline-none cursor-pointer appearance-none transition-all"
        >
          <option value="ALL">-- All Brands ({allModels.length} Models) --</option>
          {brandNames.map(brand => (
            <option value={brand} selected={brand === 'TP-LINK' || brand === '3WARE'}>
              {brand}
            </option>
          ))}
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-2.5 flex items-center text-slate-500 text-xs">
          ▼
        </div>
      </div>
    </div>

    <!-- Quick filter input -->
    <div class="flex-1 sm:max-w-xs">
      <label for="table-search-input" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">
        Quick Filter:
      </label>
      <input 
        type="text" 
        id="table-search-input" 
        placeholder="Search model, admin, pass..." 
        class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs font-medium text-slate-900 focus:border-sky-600 outline-none shadow-xs"
      />
    </div>
  </div>

  <!-- High-Density Scrollable Table with Sticky Header -->
  <div class="overflow-x-auto border border-sky-800 rounded-xl shadow-sm bg-white max-h-80 overflow-y-auto">
    <table class="w-full text-left border-collapse" id="models-table">
      <thead class="sticky top-0 z-10 bg-[#3b6584] text-white text-xs font-bold shadow-xs">
        <tr>
          <th class="py-2.5 px-3 border-r border-sky-700/50 whitespace-nowrap">Brand</th>
          <th class="py-2.5 px-3 border-r border-sky-700/50 whitespace-nowrap">Model</th>
          <th class="py-2.5 px-3 border-r border-sky-700/50 whitespace-nowrap">Protocol</th>
          <th class="py-2.5 px-3 border-r border-sky-700/50 whitespace-nowrap">Username</th>
          <th class="py-2.5 px-3 whitespace-nowrap">Password</th>
        </tr>
      </thead>
      <tbody id="table-body" class="divide-y divide-slate-100 text-xs text-slate-800 font-sans">
        <!-- Filled dynamically -->
      </tbody>
    </table>
  </div>

  <!-- Footer status bar -->
  <div class="flex flex-col sm:flex-row justify-between items-center mt-2.5 text-xs text-slate-500 gap-1.5 px-1">
    <span id="model-count-text" class="font-medium text-[11px]">Loading models...</span>
    <span class="text-[11px] text-slate-400">
      💡 Click copy button next to password to copy
    </span>
  </div>
</div>

<script define:vars={{ allModels }}>
  const select = document.getElementById('brand-select');
  const searchInput = document.getElementById('table-search-input');
  const tbody = document.getElementById('table-body');
  const countText = document.getElementById('model-count-text');

  function copyPassword(pw, btn) {
    navigator.clipboard.writeText(pw);
    const origText = btn.innerText;
    btn.innerText = '✓ Copied';
    btn.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
    setTimeout(() => {
      btn.innerText = origText;
      btn.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600');
    }, 1500);
  }
  window.copyPassword = copyPassword;

  function renderTable() {
    const selectedBrand = select?.value || 'ALL';
    const searchQuery = searchInput?.value.toLowerCase().trim() || '';

    let filtered = allModels;
    if (selectedBrand && selectedBrand !== 'ALL') {
      filtered = allModels.filter(item => item.brand.toUpperCase() === selectedBrand.toUpperCase());
    }

    if (searchQuery) {
      filtered = filtered.filter(item => 
        item.brand.toLowerCase().includes(searchQuery) ||
        item.model.toLowerCase().includes(searchQuery) ||
        item.protocol.toLowerCase().includes(searchQuery) ||
        item.username.toLowerCase().includes(searchQuery) ||
        item.password.toLowerCase().includes(searchQuery)
      );
    }

    if (countText) {
      countText.innerText = selectedBrand === 'ALL' 
        ? `Showing ${filtered.length} models across all brands` 
        : `Showing ${filtered.length} model(s) for ${selectedBrand}`;
    }

    if (filtered.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="5" class="py-6 text-center text-slate-400 italic bg-slate-50">
            No matching router models found.
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = filtered.map((item, index) => {
      const bgClass = index % 2 === 0 ? 'bg-[#f0f6fa]' : 'bg-white';
      return `
        <tr class="${bgClass} hover:bg-sky-50 transition-colors">
          <td class="py-2 px-3 font-bold text-slate-900 border-r border-slate-200/60 whitespace-nowrap">${item.brand}</td>
          <td class="py-2 px-3 font-medium text-slate-800 border-r border-slate-200/60 whitespace-nowrap">${item.model}</td>
          <td class="py-2 px-3 text-slate-500 border-r border-slate-200/60 whitespace-nowrap">${item.protocol}</td>
          <td class="py-2 px-3 font-mono text-slate-700 border-r border-slate-200/60 whitespace-nowrap">${item.username}</td>
          <td class="py-2 px-3 font-mono font-bold text-slate-900 whitespace-nowrap">
            <div class="flex items-center justify-between gap-2">
              <span>${item.password}</span>
              <button 
                type="button" 
                onclick="window.copyPassword('${item.password}', this)"
                class="text-[10px] px-2 py-0.5 rounded-md bg-white hover:bg-sky-600 hover:text-white text-sky-700 font-sans font-bold border border-sky-300 shadow-2xs transition-all active:scale-95 cursor-pointer"
              >
                Copy
              </button>
            </div>
          </td>
        </tr>
      `;
    }).join('');
  }

  // Initial render
  renderTable();

  select?.addEventListener('change', renderTable);
  searchInput?.addEventListener('input', renderTable);
</script>
