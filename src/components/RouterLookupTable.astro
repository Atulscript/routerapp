---
import { BRANDS, ROUTER_MODELS, formatModelTitle } from '../lib/data-loader';
import photos from '../lib/model-images.json';

// Collect all models with brand, model, slug, and protocol
const allModels = ROUTER_MODELS.length > 0 ? ROUTER_MODELS.map(m => ({
  brand: m.brand,
  brandSlug: m.brandSlug,
  model: m.model,
  slug: m.slug,
  protocol: m.protocol || 'HTTP',
  ip: m.ip,
  username: m.username,
  password: m.password,
  wifiStandard: m.wifiStandard || '',
  category: m.category || ''
})) : BRANDS.flatMap(b => 
  b.models.map(m => ({
    brand: b.name,
    brandSlug: b.slug,
    model: m.model,
    slug: (m as any).slug || '',
    protocol: m.protocol || 'HTTP',
    ip: m.ip,
    username: m.username,
    password: m.password,
    wifiStandard: '',
    category: ''
  }))
);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const photoMap = Object.fromEntries(Object.entries(photos as Record<string, { file: string }>).map(([slug, v]) => [slug, v.file]));
const brandNames = Array.from(new Set(allModels.map(b => b.brand))).sort((a, b) => a.localeCompare(b));
const popularBrands = ['TP-Link', 'Netgear', 'ASUS', 'Ubiquiti', 'Cisco', 'MikroTik', 'Linksys', 'D-Link', 'Xiaomi', 'GL.iNet'];

---

<div class="w-full my-2 font-sans" id="router-lookup-container">
  
  <!-- Filter Controls Toolbar -->
  <div class="mb-4 space-y-3">
    <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-end">
      
      <!-- Brand Dropdown Selector -->
      <div class="sm:col-span-7">
        <label for="brand-select" class="block text-[11px] font-bold uppercase tracking-wider text-[#5f6368] dark:text-[#9aa0a6] mb-1.5">
          Select Router Brand
        </label>
        <div class="relative">
          <select 
            id="brand-select" 
            class="w-full pl-3.5 pr-8 py-2.5 bg-white dark:bg-[#303134] hover:bg-[#f8fafd] dark:hover:bg-[#35373a] border border-[#dadce0] dark:border-[#5f6368] rounded-xl text-[#202124] dark:text-white text-xs font-bold shadow-2xs focus:border-[#1a73e8] dark:focus:border-[#8ab4f8] focus:ring-2 focus:ring-[#1a73e8]/20 outline-none cursor-pointer appearance-none transition-all"
          >
            <option value="ALL">-- All Brands ({allModels.length} Models) --</option>
            {brandNames.map(brand => (
              <option value={brand} selected={brand === 'TP-Link'}>
                {brand}
              </option>
            ))}
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-[#5f6368] dark:text-[#9aa0a6] text-xs">
            ▼
          </div>
        </div>
      </div>

      <!-- Quick Filter Search Input -->
      <div class="sm:col-span-5">
        <label for="table-search-input" class="block text-[11px] font-bold uppercase tracking-wider text-[#5f6368] dark:text-[#9aa0a6] mb-1.5">
          Instant Keyword Search
        </label>
        <div class="relative">
          <input 
            type="text" 
            id="table-search-input" 
            placeholder="Filter model, IP, username..." 
            class="w-full pl-3.5 pr-8 py-2.5 bg-white dark:bg-[#303134] hover:bg-[#f8fafd] dark:hover:bg-[#35373a] border border-[#dadce0] dark:border-[#5f6368] rounded-xl text-xs font-medium text-[#202124] dark:text-white placeholder-[#80868b] dark:placeholder-[#9aa0a6] focus:border-[#1a73e8] dark:focus:border-[#8ab4f8] focus:ring-2 focus:ring-[#1a73e8]/20 outline-none shadow-2xs transition-all"
          />
          <button 
            type="button" 
            id="clear-search-btn" 
            class="hidden absolute right-2.5 inset-y-0 text-[#5f6368] hover:text-[#202124] dark:hover:text-white text-xs font-bold my-auto"
          >
            ✕
          </button>
        </div>
      </div>

    </div>

    <!-- Quick Brand Filter Chips -->
    <div class="flex flex-wrap items-center gap-1.5 pt-1 text-xs">
      <span class="text-[#5f6368] dark:text-[#9aa0a6] font-medium text-[11px] mr-1">Quick:</span>
      <button type="button" class="brand-pill g-chip text-[11px] font-medium" data-brand="ALL">
        All
      </button>
      {popularBrands.map(pb => (
        <button 
          type="button" 
          class={`brand-pill text-[11px] font-medium transition-all cursor-pointer ${pb === 'TP-Link' ? 'g-chip-active' : 'g-chip'}`}
          data-brand={pb}
        >
          {pb}
        </button>
      ))}
    </div>
  </div>

  <!-- Material 3 Styled Table Container -->
  <div class="overflow-x-auto border border-[#dadce0] dark:border-[#3c4043] rounded-2xl shadow-card bg-white dark:bg-[#202124] h-96 overflow-y-auto custom-scrollbar">
    <table class="w-full text-left border-collapse" id="models-table">
      <thead class="sticky top-0 z-10 bg-[#f8fafd] dark:bg-[#303134] text-[#5f6368] dark:text-[#e8eaed] text-[11px] font-bold uppercase tracking-wider border-b border-[#dadce0] dark:border-[#3c4043] shadow-2xs">
        <tr>
          <th class="py-3 px-4 whitespace-nowrap">Manufacturer</th>
          <th class="py-3 px-4 whitespace-nowrap">Hardware Model</th>
          <th class="py-3 px-4 whitespace-nowrap">Gateway IP</th>
          <th class="py-3 px-4 whitespace-nowrap">Protocol</th>
          <th class="py-3 px-4 whitespace-nowrap">Username</th>
          <th class="py-3 px-4 whitespace-nowrap text-right">Default Password</th>
        </tr>
      </thead>
      <tbody id="table-body" class="divide-y divide-[#f1f3f4] dark:divide-[#3c4043] text-xs text-[#202124] dark:text-[#e8eaed] font-sans">
        <!-- Filled dynamically -->
      </tbody>
    </table>
  </div>

  <!-- Footer Status Bar -->
  <div class="flex flex-col sm:flex-row justify-between items-center mt-3 text-xs text-[#5f6368] dark:text-[#9aa0a6] gap-1 px-1">
    <span id="model-count-text" class="font-medium text-[11px] text-[#3c4043] dark:text-[#e8eaed]">Loading models...</span>
    <span class="text-[11px] text-[#5f6368] dark:text-[#9aa0a6]">
      💡 Click any brand or IP to open dedicated setup instructions
    </span>
  </div>
</div>

<script define:vars={{ modelsUrl: `${base}/models.json`, base, photoMap }}>
  let allModels = [];
  const escapeHtml = (v) => String(v).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const select = document.getElementById('brand-select');
  const searchInput = document.getElementById('table-search-input');
  const clearBtn = document.getElementById('clear-search-btn');
  const tbody = document.getElementById('table-body');
  const countText = document.getElementById('model-count-text');
  const pills = document.querySelectorAll('.brand-pill');

  function getIpPath(ip) {
    if (ip === '192.168.1.1') return `${base}/`;
    return `${base}/${ip.replace(/\./g, '-')}`;
  }

  function updatePillActive(currentBrand) {
    pills.forEach(pill => {
      const b = pill.getAttribute('data-brand');
      if (b === currentBrand || (b === 'ALL' && currentBrand === 'ALL')) {
        pill.classList.remove('bg-white', 'dark:bg-[#292a2d]', 'text-[#3c4043]', 'dark:text-[#e8eaed]', 'border-[#dadce0]', 'dark:border-[#5f6368]');
        pill.classList.add('bg-[#e8f0fe]', 'dark:bg-[#1a3a60]', 'text-[#1a73e8]', 'dark:text-[#8ab4f8]', 'border-[#d2e3fc]', 'dark:border-[#1a73e8]', 'font-bold');
      } else {
        pill.classList.remove('bg-[#e8f0fe]', 'dark:bg-[#1a3a60]', 'text-[#1a73e8]', 'dark:text-[#8ab4f8]', 'border-[#d2e3fc]', 'dark:border-[#1a73e8]', 'font-bold');
        pill.classList.add('bg-white', 'dark:bg-[#292a2d]', 'text-[#3c4043]', 'dark:text-[#e8eaed]', 'border-[#dadce0]', 'dark:border-[#5f6368]');
      }
    });
  }

  function renderTable() {
    const selectedBrand = select?.value || 'TP-Link';
    const searchQuery = searchInput?.value.toLowerCase().trim() || '';

    if (clearBtn) {
      clearBtn.classList.toggle('hidden', searchQuery.length === 0);
    }

    updatePillActive(selectedBrand);

    let filtered = allModels;
    if (selectedBrand && selectedBrand !== 'ALL') {
      filtered = allModels.filter(item => item.brand.toUpperCase() === selectedBrand.toUpperCase());
    }

    if (searchQuery) {
      filtered = filtered.filter(item => 
        item.brand.toLowerCase().includes(searchQuery) ||
        item.model.toLowerCase().includes(searchQuery) ||
        item.ip.toLowerCase().includes(searchQuery) ||
        item.protocol.toLowerCase().includes(searchQuery) ||
        item.username.toLowerCase().includes(searchQuery) ||
        item.password.toLowerCase().includes(searchQuery)
      );
    }

    if (countText) {
      countText.innerText = selectedBrand === 'ALL' 
        ? `Showing ${filtered.length} models across all manufacturers` 
        : `Showing ${filtered.length} model(s) for ${selectedBrand}`;
    }

    if (filtered.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="6" class="py-8 text-center text-[#5f6368] dark:text-[#9aa0a6] italic bg-[#f8fafd]/50 dark:bg-[#202124]/50">
            No matching router models found. Try clearing your search query.
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = filtered.map((item, index) => {
      const bgClass = index % 2 === 0 ? 'bg-[#f8fafd]/60 dark:bg-[#202124]/40' : 'bg-white dark:bg-[#292a2d]/80';
      const cleanIp = item.ip || '192.168.1.1';
      const ipHref = getIpPath(cleanIp);
      const brandHref = `${base}/${item.brandSlug}`;

      const modelHref = item.slug ? `${base}/${item.slug}` : (item.brandSlug ? `${base}/${item.brandSlug}` : null);
      const modelCellHtml = modelHref ? `
        <a href="${modelHref}" class="text-[#1a73e8] dark:text-[#8ab4f8] hover:text-[#1557b0] dark:hover:text-[#a8c7fa] hover:underline font-bold inline-flex items-center gap-1">
          <span>${escapeHtml(item.model)}</span>
          <span class="text-xs opacity-75">→</span>
        </a>
      ` : `<span>${escapeHtml(item.model)}</span>`;

      const photoFile = photoMap[item.slug];
      const thumb = photoFile
        ? `<img src="${base}/${photoFile}" alt="" width="44" height="32" loading="lazy" decoding="async" class="w-11 h-8 object-contain rounded-lg bg-white border border-[#e8eaed] dark:border-[#5f6368] flex-shrink-0">`
        : `<span class="w-11 h-8 rounded-lg bg-[#f1f3f4] dark:bg-[#303134] border border-[#e8eaed] dark:border-[#5f6368] text-[#5f6368] dark:text-[#9aa0a6] flex items-center justify-center flex-shrink-0" aria-hidden="true">
             <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="14" width="18" height="6.5" rx="2"/><path d="M7 17.2h.01M10 17.2h.01"/><path d="M12 14v-2.5"/><path d="M9.2 9.3a4 4 0 0 1 5.6 0"/><path d="M6.6 6.6a7.7 7.7 0 0 1 10.8 0"/></svg>
           </span>`;

      return `
        <tr class="${bgClass} hover:bg-[#e8f0fe]/70 dark:hover:bg-[#303134]/80 transition-colors">
          <td class="py-2.5 px-4 font-bold text-[#202124] dark:text-white whitespace-nowrap text-xs">
            <a href="${brandHref}" class="text-[#1a73e8] dark:text-[#8ab4f8] hover:underline inline-flex items-center gap-1">
              ${escapeHtml(item.brand)}
            </a>
          </td>
          <td class="py-2.5 px-4 font-medium text-[#202124] dark:text-[#e8eaed] whitespace-nowrap text-xs">
            <span class="flex items-center gap-2.5">${thumb}${modelCellHtml}</span>
          </td>
          <td class="py-2.5 px-4 font-mono font-bold whitespace-nowrap text-xs">
            <div class="inline-flex items-center gap-1.5">
              <a href="${ipHref}" class="text-[#1a73e8] dark:text-[#8ab4f8] hover:underline" title="View ${cleanIp} guide">
                ${cleanIp}
              </a>
              <a href="http://${cleanIp}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center w-7 h-7 rounded-full text-sm text-[#5f6368] dark:text-[#9aa0a6] hover:bg-[#e8f0fe] dark:hover:bg-[#1a3a60] hover:text-[#1a73e8] dark:hover:text-[#8ab4f8]" title="Open http://${cleanIp} in a new tab" aria-label="Open ${cleanIp} in a new tab">
                ↗
              </a>
            </div>
          </td>
          <td class="py-2.5 px-4 text-[#5f6368] dark:text-[#9aa0a6] whitespace-nowrap text-[11px]">
            <span class="px-2 py-0.5 rounded-full bg-[#f1f3f4] dark:bg-[#303134] border border-[#dadce0] dark:border-[#5f6368] text-[#3c4043] dark:text-[#e8eaed] font-mono text-xs font-bold">${item.protocol}</span>
          </td>
          <td class="py-2.5 px-4 font-mono text-[#3c4043] dark:text-[#e8eaed] whitespace-nowrap text-xs">${escapeHtml(item.username)}</td>
          <td class="py-2.5 px-4 font-mono font-bold text-[#202124] dark:text-white whitespace-nowrap text-xs text-right">
            <div class="inline-flex items-center justify-end gap-2">
              <span class="truncate max-w-[90px] sm:max-w-[130px] font-mono" title="${escapeHtml(item.password)}">${escapeHtml(item.password)}</span>
              <button 
                type="button" 
                data-copy="${escapeHtml(item.password)}"
                aria-label="Copy password for ${escapeHtml(item.model)}"
                class="copy-btn "text-xs font-bold px-2.5 py-1 rounded-full bg-white dark:bg-[#303134] hover:bg-[#f1f3f4] dark:hover:bg-[#3c4043] text-[#3c4043] dark:text-[#e8eaed] font-sans border border-[#dadce0] dark:border-[#5f6368] transition-all active:scale-95 cursor-pointer shadow-2xs"
              >
                Copy
              </button>
            </div>
          </td>
        </tr>
      `;
    }).join('');
  }

  // Set initial select value to TP-Link
  if (select) {
    select.value = 'TP-Link';
  }

  // Load the model list once the table is close to the viewport, then render.
  const container = document.getElementById('router-lookup-container');
  const loadModels = () => fetch(modelsUrl).then(r => r.json()).then(data => { allModels = data; renderTable(); }).catch(() => {
    tbody.innerHTML = '<tr><td colspan="6" class="py-8 text-center text-sm text-[#5f6368]">Could not load the model list. Please refresh the page.</td></tr>';
  });
  tbody.innerHTML = '<tr><td colspan="6" class="py-8 text-center text-sm text-[#5f6368] dark:text-[#9aa0a6]">Loading router models…</td></tr>';
  if ('IntersectionObserver' in window && container) {
    const observer = new IntersectionObserver((entries) => {
      if (entries.some(e => e.isIntersecting)) { observer.disconnect(); loadModels(); }
    }, { rootMargin: '600px' });
    observer.observe(container);
  } else {
    loadModels();
  }

  select?.addEventListener('change', renderTable);
  searchInput?.addEventListener('input', renderTable);
  clearBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    renderTable();
  });

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      const brand = pill.getAttribute('data-brand') || 'ALL';
      if (select) {
        select.value = brand;
      }
      renderTable();
    });
  });
</script>
