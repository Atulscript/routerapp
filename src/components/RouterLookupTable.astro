---
import { BRANDS } from '../lib/data-loader';

// Collect all models with brand and protocol
const allModels = BRANDS.flatMap(b => 
  b.models.map(m => ({
    brand: b.name,
    brandSlug: b.slug,
    model: m.model,
    protocol: m.protocol || 'HTTP',
    ip: m.ip,
    username: m.username,
    password: m.password
  }))
);

const brandNames = Array.from(new Set(BRANDS.map(b => b.name))).sort((a, b) => a.localeCompare(b));
---

<div class="w-full max-w-4xl mx-auto my-6" id="router-lookup-container">
  
  <!-- M3 Outlined Select Control -->
  <div class="mb-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <label for="brand-select" class="block text-xs font-bold uppercase tracking-wider text-md-on-surface-variant mb-1">
        Select Router Brand / Manufacturer:
      </label>
      <div class="relative">
        <select 
          id="brand-select" 
          class="w-full sm:w-80 pl-4 pr-10 py-3 bg-white border-2 border-md-outline-variant rounded-m3-md text-md-on-surface text-sm font-bold shadow-m3-1 focus:border-md-primary focus:ring-4 focus:ring-md-primary/10 outline-none cursor-pointer appearance-none transition-all"
        >
          <option value="ALL">-- All Brands ({allModels.length} Models) --</option>
          {brandNames.map(brand => (
            <option value={brand} selected={brand === '3WARE'}>
              {brand}
            </option>
          ))}
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-md-primary font-bold">
          ▼
        </div>
      </div>
    </div>

    <!-- Quick filter input -->
    <div class="w-full sm:w-auto">
      <label for="table-search-input" class="block text-xs font-bold uppercase tracking-wider text-md-on-surface-variant mb-1">
        Search Within Table:
      </label>
      <input 
        type="text" 
        id="table-search-input" 
        placeholder="Filter model, protocol, user..." 
        class="w-full sm:w-64 px-4 py-2.5 bg-white border-2 border-md-outline-variant rounded-m3-md text-xs font-medium text-md-on-surface focus:border-md-primary outline-none shadow-m3-1"
      />
    </div>
  </div>

  <!-- M3 Styled Table Matching Screenshot -->
  <div class="overflow-x-auto border-2 border-md-primary rounded-m3-lg shadow-m3-2 bg-white">
    <table class="w-full text-left border-collapse" id="models-table">
      <thead>
        <tr class="bg-md-primary text-md-on-primary text-sm font-bold border-b border-md-primary">
          <th class="py-3.5 px-4 border-r border-md-primary/30">Brand</th>
          <th class="py-3.5 px-4 border-r border-md-primary/30">Model</th>
          <th class="py-3.5 px-4 border-r border-md-primary/30">Protocol</th>
          <th class="py-3.5 px-4 border-r border-md-primary/30">Username</th>
          <th class="py-3.5 px-4">Password</th>
        </tr>
      </thead>
      <tbody id="table-body" class="divide-y divide-md-outline-variant/30 text-sm text-md-on-surface font-sans">
        <!-- Filled dynamically -->
      </tbody>
    </table>
  </div>

  <!-- Footer status bar -->
  <div class="flex flex-col sm:flex-row justify-between items-center mt-3 text-xs text-md-on-surface-variant gap-2">
    <span id="model-count-text" class="font-medium">Showing models for 3WARE</span>
    <span class="m3-chip m3-chip-tonal text-[11px] py-0.5 px-2.5">
      💡 Tip: Click copy button to copy password instantly
    </span>
  </div>
</div>

<script define:vars={{ allModels }}>
  const select = document.getElementById('brand-select');
  const searchInput = document.getElementById('table-search-input');
  const tbody = document.getElementById('table-body');
  const countText = document.getElementById('model-count-text');

  function renderTable() {
    const selectedBrand = select?.value || 'ALL';
    const searchQuery = searchInput?.value.toLowerCase().trim() || '';

    let filtered = allModels;
    if (selectedBrand && selectedBrand !== 'ALL') {
      filtered = allModels.filter(item => item.brand.toUpperCase() === selectedBrand.toUpperCase());
    }

    if (searchQuery) {
      filtered = filtered.filter(item => 
        item.brand.toLowerCase().includes(searchQuery) ||
        item.model.toLowerCase().includes(searchQuery) ||
        item.protocol.toLowerCase().includes(searchQuery) ||
        item.username.toLowerCase().includes(searchQuery) ||
        item.password.toLowerCase().includes(searchQuery)
      );
    }

    if (countText) {
      countText.innerText = selectedBrand === 'ALL' 
        ? `Showing ${filtered.length} models across all brands` 
        : `Showing ${filtered.length} model(s) for ${selectedBrand}`;
    }

    if (filtered.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="5" class="py-8 text-center text-md-on-surface-variant italic bg-md-surface-container-low">
            No matching router models found.
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = filtered.map((item, index) => {
      const bgClass = index % 2 === 0 ? 'bg-[#EBF5FB]' : 'bg-white';
      return `
        <tr class="${bgClass} hover:bg-md-primary-container/30 transition-colors">
          <td class="py-3 px-4 font-bold text-md-on-surface border-r border-md-outline-variant/30">${item.brand}</td>
          <td class="py-3 px-4 font-medium text-md-on-surface border-r border-md-outline-variant/30">${item.model}</td>
          <td class="py-3 px-4 font-semibold text-md-on-surface-variant border-r border-md-outline-variant/30">${item.protocol}</td>
          <td class="py-3 px-4 font-mono font-medium text-md-on-surface border-r border-md-outline-variant/30">${item.username}</td>
          <td class="py-3 px-4 font-mono font-bold text-md-on-surface flex items-center justify-between gap-3">
            <span>${item.password}</span>
            <button 
              type="button" 
              onclick="navigator.clipboard.writeText('${item.password}'); alert('Copied password: ${item.password}')"
              class="text-[11px] px-2.5 py-1 rounded-m3-full bg-white hover:bg-md-primary hover:text-white text-md-primary font-sans font-bold border border-md-primary/40 shadow-xs transition-all active:scale-95"
            >
              Copy
            </button>
          </td>
        </tr>
      `;
    }).join('');
  }

  // Initial render (3WARE)
  renderTable();

  select?.addEventListener('change', renderTable);
  searchInput?.addEventListener('input', renderTable);
</script>
