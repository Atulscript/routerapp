---
import type { Brand } from '../lib/types';

interface Props {
  data: Brand;
}

const { data } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Color mapping for brand initials to make each brand visually distinctive with Google pastel tones
const brandColors: Record<string, { bg: string; text: string }> = {
  'TP-Link': { bg: 'bg-[#00897b]', text: 'text-white' },
  'Netgear': { bg: 'bg-[#f57c00]', text: 'text-white' },
  'ASUS': { bg: 'bg-[#d93025]', text: 'text-white' },
  'D-Link': { bg: 'bg-[#1a73e8]', text: 'text-white' },
  'Cisco': { bg: 'bg-[#0d47a1]', text: 'text-white' },
  'Linksys': { bg: 'bg-[#5c6bc0]', text: 'text-white' },
  'Tenda': { bg: 'bg-[#e65100]', text: 'text-white' },
  'Huawei': { bg: 'bg-[#c2185b]', text: 'text-white' },
  'MikroTik': { bg: 'bg-[#37474f]', text: 'text-white' },
  'ZTE': { bg: 'bg-[#1565c0]', text: 'text-white' },
  'Ubiquiti': { bg: 'bg-[#0097a7]', text: 'text-white' },
  'Synology': { bg: 'bg-[#263238]', text: 'text-white' },
};

const brandStyle = brandColors[data.name] || { bg: 'bg-[#1a73e8]', text: 'text-white' };
---

<a 
  href={`${base}/${data.slug}`} 
  class="group g-card p-4 flex flex-col justify-between"
>
  <div>
    <div class="flex items-start justify-between gap-2 mb-3">
      <div class="flex items-center gap-2.5">
        <div class={`w-10 h-10 rounded-2xl ${brandStyle.bg} ${brandStyle.text} flex items-center justify-center font-bold text-xs font-mono shadow-xs group-hover:scale-105 transition-transform`}>
          {data.name.slice(0, 2).toUpperCase()}
        </div>
        <div>
          <h3 class="font-bold text-[#202124] dark:text-white text-sm group-hover:text-[#1a73e8] dark:group-hover:text-[#8ab4f8] transition-colors">
            {data.name}
          </h3>
          <span class="inline-flex items-center gap-1 text-[11px] text-[#5f6368] dark:text-[#9aa0a6]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#34a853]"></span>
            {data.models.length} model{data.models.length > 1 ? 's' : ''}
          </span>
        </div>
      </div>
      <span class="text-[11px] font-mono font-bold px-2.5 py-0.5 rounded-full bg-[#e8f0fe] dark:bg-[#1a3a60] text-[#1a73e8] dark:text-[#8ab4f8] border border-[#d2e3fc] dark:border-[#1a73e8] shadow-2xs">
        {data.defaultIp}
      </span>
    </div>

    <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] line-clamp-2 leading-relaxed mb-3">
      {data.description}
    </p>
  </div>

  <div class="pt-2.5 border-t border-[#e8eaed] dark:border-[#3c4043] flex items-center justify-between text-xs font-medium text-[#5f6368] dark:text-[#9aa0a6]">
    <span class="font-mono text-[11px]">Pass: <strong class="text-[#202124] dark:text-white bg-[#f1f3f4] dark:bg-[#303134] px-1.5 py-0.5 rounded border border-[#dadce0] dark:border-[#5f6368]">{data.defaultPass}</strong></span>
    <span class="text-[#1a73e8] dark:text-[#8ab4f8] font-bold flex items-center gap-0.5 text-xs group-hover:translate-x-0.5 transition-transform">
      Setup Guide →
    </span>
  </div>
</a>
