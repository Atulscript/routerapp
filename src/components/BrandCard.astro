---
import type { Brand } from '../lib/types';

interface Props {
  data: Brand;
}

const { data } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Color mapping for brand initials to make each brand visually distinctive
const brandColors: Record<string, { bg: string; text: string; ring: string }> = {
  'TP-Link': { bg: 'bg-teal-600', text: 'text-white', ring: 'ring-teal-100' },
  'Netgear': { bg: 'bg-amber-600', text: 'text-white', ring: 'ring-amber-100' },
  'ASUS': { bg: 'bg-red-600', text: 'text-white', ring: 'ring-red-100' },
  'D-Link': { bg: 'bg-sky-600', text: 'text-white', ring: 'ring-sky-100' },
  'Cisco': { bg: 'bg-blue-800', text: 'text-white', ring: 'ring-blue-100' },
  'Linksys': { bg: 'bg-indigo-600', text: 'text-white', ring: 'ring-indigo-100' },
  'Tenda': { bg: 'bg-orange-600', text: 'text-white', ring: 'ring-orange-100' },
  'Huawei': { bg: 'bg-rose-700', text: 'text-white', ring: 'ring-rose-100' },
  'MikroTik': { bg: 'bg-slate-800', text: 'text-white', ring: 'ring-slate-100' },
  'ZTE': { bg: 'bg-blue-600', text: 'text-white', ring: 'ring-blue-100' },
  'Ubiquiti': { bg: 'bg-cyan-700', text: 'text-white', ring: 'ring-cyan-100' },
  'Synology': { bg: 'bg-slate-900', text: 'text-white', ring: 'ring-slate-100' },
};

const brandStyle = brandColors[data.name] || { bg: 'bg-slate-800', text: 'text-white', ring: 'ring-slate-100' };
---

<a 
  href={`${base}/${data.slug}`} 
  class="group bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/90 dark:border-slate-800 p-4 shadow-card hover:shadow-card-hover hover:border-brand-400 dark:hover:border-brand-500 hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between"
>
  <div>
    <div class="flex items-start justify-between gap-2 mb-3">
      <div class="flex items-center gap-2.5">
        <div class={`w-10 h-10 rounded-xl ${brandStyle.bg} ${brandStyle.text} ring-4 ${brandStyle.ring} dark:ring-slate-800 flex items-center justify-center font-bold text-xs font-mono shadow-xs group-hover:scale-105 transition-transform`}>
          {data.name.slice(0, 2).toUpperCase()}
        </div>
        <div>
          <h3 class="font-extrabold text-slate-900 dark:text-white text-sm group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
            {data.name}
          </h3>
          <span class="inline-flex items-center gap-1 text-[11px] text-slate-500 dark:text-slate-400 font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-600 group-hover:bg-brand-500 transition-colors"></span>
            {data.models.length} model{data.models.length > 1 ? 's' : ''}
          </span>
        </div>
      </div>
      <span class="text-[11px] font-mono font-bold px-2 py-0.5 rounded-md bg-sky-50 dark:bg-sky-950/60 text-brand-700 dark:text-brand-300 border border-sky-200 dark:border-sky-800/80 shadow-2xs">
        {data.defaultIp}
      </span>
    </div>

    <p class="text-xs text-slate-600 dark:text-slate-300 line-clamp-2 leading-relaxed mb-3">
      {data.description}
    </p>
  </div>

  <div class="pt-2.5 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs font-medium text-slate-500 dark:text-slate-400">
    <span class="font-mono text-[11px]">Pass: <strong class="text-slate-800 dark:text-slate-200 bg-slate-50 dark:bg-slate-800 px-1.5 py-0.5 rounded border border-slate-200/80 dark:border-slate-700">{data.defaultPass}</strong></span>
    <span class="text-brand-600 dark:text-brand-400 font-bold flex items-center gap-0.5 text-xs group-hover:translate-x-0.5 transition-transform">
      Setup Guide →
    </span>
  </div>
</a>
