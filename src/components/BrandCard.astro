---
import type { Brand } from '../lib/types';

interface Props {
  data: Brand;
}

const { data } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<a 
  href={`${base}/${data.slug}`}
  class="bg-white rounded-xl p-3.5 sm:p-4 border border-slate-200/90 shadow-2xs hover:shadow-sm hover:border-sky-500 transition-all flex flex-col justify-between group cursor-pointer"
>
  <div>
    <div class="flex items-center justify-between mb-1.5">
      <h3 class="text-sm font-bold text-slate-900 group-hover:text-sky-600 transition-colors">
        {data.name}
      </h3>
      <span class="text-[10px] py-0.5 px-2 bg-slate-100 rounded-full text-slate-700 font-bold border border-slate-200">
        {data.models.length} Models
      </span>
    </div>

    <p class="text-xs text-slate-500 line-clamp-2 mb-3 leading-relaxed">
      {data.description}
    </p>
  </div>

  <div class="pt-2.5 border-t border-slate-100 flex items-center justify-between text-xs">
    <span class="font-mono text-slate-500 font-semibold text-[11px] truncate max-w-[130px]">
      {data.defaultIp}
    </span>
    <span class="font-bold text-sky-600 group-hover:translate-x-0.5 transition-transform flex items-center gap-0.5 text-xs">
      Logins →
    </span>
  </div>
</a>
