---
import type { Brand } from '../lib/types';

interface Props {
  data: Brand;
}

const { data } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<a 
  href={`${base}/${data.slug}`} 
  class="group bg-white rounded-xl border border-slate-200/80 p-3.5 sm:p-4 shadow-card hover:shadow-card-hover hover:border-slate-300 transition-all flex flex-col justify-between"
>
  <div>
    <div class="flex items-start justify-between gap-2 mb-2">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-lg bg-slate-900 text-white flex items-center justify-center font-bold text-xs font-mono group-hover:bg-brand-600 transition-colors shadow-2xs">
          {data.name.slice(0, 2).toUpperCase()}
        </div>
        <div>
          <h3 class="font-bold text-slate-900 text-sm group-hover:text-brand-600 transition-colors">
            {data.name}
          </h3>
          <span class="text-[11px] text-slate-500 font-mono font-medium">
            {data.models.length} model{data.models.length > 1 ? 's' : ''}
          </span>
        </div>
      </div>
      <span class="text-[11px] font-mono font-semibold px-2 py-0.5 rounded bg-slate-100 text-brand-700">
        {data.defaultIp}
      </span>
    </div>

    <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed mb-3">
      {data.description}
    </p>
  </div>

  <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] font-medium text-slate-500">
    <span>Pass: <strong class="text-slate-800 font-mono">{data.defaultPass}</strong></span>
    <span class="text-slate-900 group-hover:text-brand-600 font-semibold flex items-center gap-0.5">
      View Guide →
    </span>
  </div>
</a>
