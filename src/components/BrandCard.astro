---
import type { Brand } from '../lib/types';

interface Props {
  data: Brand;
}

const { data } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<a 
  href={`${base}/${data.slug}`}
  class="m3-card p-5 flex flex-col justify-between group hover:border-md-primary/60 transition-all cursor-pointer"
>
  <div>
    <div class="flex items-center justify-between mb-2.5">
      <h3 class="text-base font-bold text-md-on-surface group-hover:text-md-primary transition-colors">
        {data.name}
      </h3>
      <span class="m3-chip m3-chip-tonal text-[10px] py-0.5 px-2 bg-md-secondary-container text-md-on-secondary-container font-bold">
        {data.models.length} Models
      </span>
    </div>

    <p class="text-xs text-md-on-surface-variant line-clamp-2 mb-3.5 leading-relaxed font-normal">
      {data.description}
    </p>
  </div>

  <div class="pt-3 border-t border-md-surface-variant/50 flex items-center justify-between text-xs">
    <span class="font-mono text-md-on-surface-variant font-semibold truncate max-w-[140px]">
      {data.defaultIp}
    </span>
    <span class="font-bold text-md-primary group-hover:translate-x-0.5 transition-transform flex items-center gap-1">
      View Logins →
    </span>
  </div>
</a>
