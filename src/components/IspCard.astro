---
import type { Isp } from '../lib/types';

interface Props {
  data: Isp;
}

const { data } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<a 
  href={`${base}/${data.slug}`}
  class="bg-white rounded-xl p-3.5 sm:p-4 border border-slate-200/90 shadow-2xs hover:shadow-sm hover:border-emerald-500 transition-all flex flex-col justify-between group cursor-pointer"
>
  <div>
    <div class="flex items-center justify-between mb-1.5">
      <h3 class="text-sm font-bold text-slate-900 group-hover:text-emerald-700 transition-colors">
        {data.name}
      </h3>
      <span class="text-[10px] py-0.5 px-2 bg-emerald-50 text-emerald-800 rounded-full font-mono font-bold border border-emerald-200">
        {data.defaultIp}
      </span>
    </div>

    <p class="text-xs text-slate-500 line-clamp-2 mb-3 leading-relaxed">
      {data.description}
    </p>
  </div>

  <div class="pt-2.5 border-t border-slate-100 flex items-center justify-between text-xs">
    <span class="text-slate-500 font-mono text-[11px]">
      User: <strong class="text-slate-800">{data.defaultUser}</strong>
    </span>
    <span class="font-bold text-emerald-700 group-hover:translate-x-0.5 transition-transform flex items-center gap-0.5 text-xs">
      Setup →
    </span>
  </div>
</a>
