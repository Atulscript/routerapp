---
import type { Isp } from '../lib/types';
import BrandLogo from './BrandLogo.astro';

interface Props {
  data: Isp;
}

const { data } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ips = data.defaultIp.split(/\s*\/\s*/).filter(Boolean);
---

<a
  href={`${base}/${data.slug}`}
  class="group g-card p-4 flex flex-col justify-between"
>
  <div>
    <div class="flex items-center gap-3 mb-3">
      <BrandLogo slug={data.slug} name={data.name} class="group-hover:scale-105 transition-transform" />
      <div class="min-w-0 flex-1">
        <h3 class="font-bold text-ink text-sm truncate group-hover:text-[#1a73e8] dark:group-hover:text-[#8ab4f8] transition-colors" title={data.name}>
          {data.name}
        </h3>
        <span class="inline-flex items-center gap-1 whitespace-nowrap text-[11px] text-ink-muted font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-[#34a853]"></span>
          Fiber Broadband
        </span>
      </div>
    </div>

    <div class="flex flex-wrap gap-1.5 mb-3">
      {ips.map(ip => (
        <span class="max-w-full truncate whitespace-nowrap text-[11px] font-mono font-bold px-2.5 py-0.5 rounded-full border border-[#ceead6] dark:border-[#137333]/60 bg-[#e6f4ea] dark:bg-[#137333]/20 text-[#137333] dark:text-[#81c995] shadow-2xs">
          {ip}
        </span>
      ))}
    </div>

    <p class="text-sm text-ink-muted line-clamp-2 leading-relaxed mb-3">
      {data.description}
    </p>
  </div>

  <div class="pt-2.5 border-t border-line-subtle flex items-center justify-between gap-3 text-xs font-medium text-ink-muted">
    <span class="font-mono text-[11px] flex items-center gap-1 min-w-0">
      <span class="flex-shrink-0">User:</span>
      <strong class="truncate text-ink bg-surface-muted px-1.5 py-0.5 rounded border border-line" title={data.defaultUser}>{data.defaultUser || '(blank)'}</strong>
    </span>
    <span class="flex-shrink-0 w-7 h-7 rounded-full bg-accent-soft text-accent font-bold flex items-center justify-center text-sm group-hover:bg-[#1a73e8] group-hover:text-white dark:group-hover:bg-[#8ab4f8] dark:group-hover:text-[#202124] transition-colors" aria-hidden="true">
      →
    </span>
  </div>
</a>
