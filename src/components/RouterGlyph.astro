---
// Fallback mark used wherever a real logo or product photo is missing:
// a router body with Wi-Fi arcs, drawn in currentColor so it fits any tile.
interface Props {
  class?: string;
}
const { class: className = 'w-full h-full' } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <rect x="3" y="14" width="18" height="6.5" rx="2" />
  <path d="M7 17.2h.01M10 17.2h.01" />
  <path d="M12 14v-2.5" />
  <path d="M9.2 9.3a4 4 0 0 1 5.6 0" />
  <path d="M6.6 6.6a7.7 7.7 0 0 1 10.8 0" />
</svg>
