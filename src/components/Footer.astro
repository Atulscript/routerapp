---
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="bg-slate-100/90 text-slate-600 border-t border-slate-200/90 mt-16 transition-colors">
  
  <!-- Quick Direct Gateway Strip -->
  <div class="border-b border-slate-200/70 bg-white/60">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-2 text-xs">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span class="font-bold text-slate-800">Quick Gateway Test:</span>
      </div>
      <div class="flex flex-wrap items-center gap-2 font-mono text-[11px] font-semibold">
        <a href="http://192.168.1.1" target="_blank" rel="noopener noreferrer" class="px-2 py-0.5 rounded bg-slate-100 hover:bg-slate-200 text-slate-700 hover:text-brand-600 transition-colors">192.168.1.1 ↗</a>
        <a href="http://192.168.0.1" target="_blank" rel="noopener noreferrer" class="px-2 py-0.5 rounded bg-slate-100 hover:bg-slate-200 text-slate-700 hover:text-brand-600 transition-colors">192.168.0.1 ↗</a>
        <a href="http://192.168.2.1" target="_blank" rel="noopener noreferrer" class="px-2 py-0.5 rounded bg-slate-100 hover:bg-slate-200 text-slate-700 hover:text-brand-600 transition-colors">192.168.2.1 ↗</a>
        <a href="http://10.0.0.1" target="_blank" rel="noopener noreferrer" class="px-2 py-0.5 rounded bg-slate-100 hover:bg-slate-200 text-slate-700 hover:text-brand-600 transition-colors">10.0.0.1 ↗</a>
        <a href="http://192.168.29.1" target="_blank" rel="noopener noreferrer" class="px-2 py-0.5 rounded bg-slate-100 hover:bg-slate-200 text-slate-700 hover:text-brand-600 transition-colors">192.168.29.1 ↗</a>
      </div>
    </div>
  </div>

  <!-- Main 5-Column Navigation -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8">
      
      <!-- Col 1: Brand Info -->
      <div class="col-span-2 md:col-span-1 space-y-3">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-slate-900 text-white flex items-center justify-center font-bold text-xs shadow-2xs">
            <svg class="w-3.5 h-3.5 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12.55a11 11 0 0 1 14.08 0"></path>
              <path d="M1.42 9a16 16 0 0 1 21.16 0"></path>
              <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
              <line x1="12" y1="20" x2="12.01" y2="20"></line>
            </svg>
          </div>
          <span class="font-extrabold text-slate-900 text-base tracking-tight font-sans">
            19216811<span class="text-brand-600">.page</span>
          </span>
        </div>
        <p class="text-xs text-slate-500 leading-relaxed">
          Open directory for wireless router gateway IPs, factory credentials, and home network setup.
        </p>
        <div class="flex items-center gap-1.5 text-[11px] text-slate-500 font-mono pt-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span>RFC 1918 Private IPv4 Standard</span>
        </div>
      </div>

      <!-- Col 2: Gateway IPs -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-2.5">Gateways</h4>
        <ul class="space-y-1.5 text-xs text-slate-600">
          <li><a href={`${base}/`} class="hover:text-brand-600 transition-colors">192.168.1.1 Login</a></li>
          <li><a href={`${base}/192-168-0-1`} class="hover:text-brand-600 transition-colors">192.168.0.1 Admin</a></li>
          <li><a href={`${base}/192-168-2-1`} class="hover:text-brand-600 transition-colors">192.168.2.1 Belkin</a></li>
          <li><a href={`${base}/192-168-1-254`} class="hover:text-brand-600 transition-colors">192.168.1.254 Technicolor</a></li>
          <li><a href={`${base}/10-0-0-1`} class="hover:text-brand-600 transition-colors">10.0.0.1 Xfinity</a></li>
          <li><a href={`${base}/192-168-29-1`} class="hover:text-brand-600 transition-colors">192.168.29.1 Jio</a></li>
        </ul>
      </div>

      <!-- Col 3: Router Brands -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-2.5">Top Brands</h4>
        <ul class="space-y-1.5 text-xs text-slate-600">
          <li><a href={`${base}/tp-link`} class="hover:text-brand-600 transition-colors">TP-Link</a></li>
          <li><a href={`${base}/netgear`} class="hover:text-brand-600 transition-colors">Netgear</a></li>
          <li><a href={`${base}/asus`} class="hover:text-brand-600 transition-colors">ASUS RT</a></li>
          <li><a href={`${base}/d-link`} class="hover:text-brand-600 transition-colors">D-Link</a></li>
          <li><a href={`${base}/cisco`} class="hover:text-brand-600 transition-colors">Cisco</a></li>
          <li><a href={`${base}/linksys`} class="hover:text-brand-600 transition-colors">Linksys</a></li>
          <li><a href={`${base}/tenda`} class="hover:text-brand-600 transition-colors">Tenda</a></li>
        </ul>
      </div>

      <!-- Col 4: Fiber ISPs -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-2.5">Fiber ISPs</h4>
        <ul class="space-y-1.5 text-xs text-slate-600">
          <li><a href={`${base}/jio`} class="hover:text-brand-600 transition-colors">JioFiber</a></li>
          <li><a href={`${base}/airtel`} class="hover:text-brand-600 transition-colors">Airtel Xstream</a></li>
          <li><a href={`${base}/bsnl`} class="hover:text-brand-600 transition-colors">BSNL Fiber</a></li>
          <li><a href={`${base}/act-fibernet`} class="hover:text-brand-600 transition-colors">ACT Fibernet</a></li>
          <li><a href={`${base}/tata-play-fiber`} class="hover:text-brand-600 transition-colors">Tata Play Fiber</a></li>
        </ul>
      </div>

      <!-- Col 5: Tools & Directories -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-2.5">Tools</h4>
        <ul class="space-y-1.5 text-xs text-slate-600">
          <li><a href={`${base}/what-is-my-ip`} class="hover:text-brand-600 transition-colors">What is My IP?</a></li>
          <li><a href={`${base}/wifi-qr-generator`} class="hover:text-brand-600 transition-colors">WiFi QR Generator</a></li>
          <li><a href={`${base}/password-generator`} class="hover:text-brand-600 transition-colors">Password Generator</a></li>
          <li><a href={`${base}/default-passwords`} class="hover:text-brand-600 transition-colors">Default Passwords</a></li>
          <li><a href={`${base}/routers`} class="hover:text-brand-600 transition-colors">Hardware Database</a></li>
          <li><a href={`${base}/brands`} class="hover:text-brand-600 transition-colors">Brands Directory</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-slate-200 mt-10 pt-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
      <p>© {currentYear} 19216811.page · Open Router Reference Portal</p>
      <div class="flex items-center gap-4 text-[11px]">
        <a href={`${base}/brands`} class="hover:text-slate-900 transition-colors">All Brands</a>
        <a href={`${base}/ip-addresses`} class="hover:text-slate-900 transition-colors">All Gateways</a>
        <a href={`${base}/sitemap-index.xml`} class="hover:text-slate-900 transition-colors">XML Sitemap</a>
      </div>
    </div>
  </div>
</footer>
