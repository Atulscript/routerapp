---
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="bg-md-on-surface text-slate-400 border-t border-slate-800 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-14">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-8">
      
      <!-- Col 1: Brand Info -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-m3-md bg-md-primary flex items-center justify-center text-white font-bold text-lg shadow-m3-1 font-mono">
            📡
          </div>
          <span class="font-black text-white text-xl tracking-tight font-mono">19216811<span class="text-sky-400 font-sans font-black">.page</span></span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed max-w-sm">
          <strong>19216811.page</strong> is the comprehensive open directory and knowledgebase for wireless router gateway IP addresses (192.168.1.1, 192.168.0.1, 10.0.0.1), default hardware passwords, and network security guides.
        </p>
        <div class="flex items-center gap-2 text-xs text-slate-300 font-mono">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>RFC 1918 Private Network Knowledgebase</span>
        </div>
      </div>

      <!-- Col 2: Gateway IPs -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200 mb-3 font-sans">Gateway IPs</h4>
        <ul class="space-y-2 text-xs font-medium">
          <li><a href={`${base}/`} class="hover:text-sky-400 transition-colors">192.168.1.1 Login</a></li>
          <li><a href={`${base}/192-168-0-1`} class="hover:text-sky-400 transition-colors">192.168.0.1 Admin</a></li>
          <li><a href={`${base}/192-168-2-1`} class="hover:text-sky-400 transition-colors">192.168.2.1 Belkin</a></li>
          <li><a href={`${base}/192-168-1-254`} class="hover:text-sky-400 transition-colors">192.168.1.254 Technicolor</a></li>
          <li><a href={`${base}/10-0-0-1`} class="hover:text-sky-400 transition-colors">10.0.0.1 Xfinity</a></li>
          <li><a href={`${base}/192-168-29-1`} class="hover:text-sky-400 transition-colors">192.168.29.1 JioFiber</a></li>
        </ul>
      </div>

      <!-- Col 3: Router Brands -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200 mb-3 font-sans">Top Brands</h4>
        <ul class="space-y-2 text-xs font-medium">
          <li><a href={`${base}/tp-link`} class="hover:text-sky-400 transition-colors">TP-Link Passwords</a></li>
          <li><a href={`${base}/netgear`} class="hover:text-sky-400 transition-colors">Netgear Router Login</a></li>
          <li><a href={`${base}/asus`} class="hover:text-sky-400 transition-colors">ASUS RT Wireless</a></li>
          <li><a href={`${base}/d-link`} class="hover:text-sky-400 transition-colors">D-Link Settings</a></li>
          <li><a href={`${base}/cisco`} class="hover:text-sky-400 transition-colors">Cisco Small Business</a></li>
          <li><a href={`${base}/linksys`} class="hover:text-sky-400 transition-colors">Linksys Velop Mesh</a></li>
        </ul>
      </div>

      <!-- Col 4: Tools & Directories -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200 mb-3 font-sans">Tools & Directories</h4>
        <ul class="space-y-2 text-xs font-medium">
          <li><a href={`${base}/brands`} class="hover:text-sky-400 transition-colors">All Brands Directory</a></li>
          <li><a href={`${base}/ip-addresses`} class="hover:text-sky-400 transition-colors">All Gateway IPs</a></li>
          <li><a href={`${base}/routers`} class="hover:text-sky-400 transition-colors">Hardware Models List</a></li>
          <li><a href={`${base}/what-is-my-ip`} class="hover:text-sky-400 transition-colors">What is My IP?</a></li>
          <li><a href={`${base}/wifi-qr-generator`} class="hover:text-sky-400 transition-colors">WiFi QR Generator</a></li>
          <li><a href={`${base}/password-generator`} class="hover:text-sky-400 transition-colors">Password Generator</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-slate-800 mt-12 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {currentYear} 19216811.page. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <a href={`${base}/default-passwords`} class="hover:text-slate-300 transition-colors">Default Passwords</a>
        <a href={`${base}/sitemap-index.xml`} class="hover:text-slate-300 transition-colors">XML Sitemap</a>
      </div>
    </div>
  </div>
</footer>
