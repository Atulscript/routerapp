---
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="bg-slate-900 text-slate-400 border-t border-slate-800 mt-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Col 1 -->
      <div class="md:col-span-1">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-8 h-8 rounded-lg bg-brand-600 flex items-center justify-center text-white font-bold text-base">
            📡
          </div>
          <span class="font-bold text-white text-lg tracking-tight">Router<span class="text-brand-400">Guide</span></span>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed">
          The comprehensive directory of default router gateway IP addresses, admin credentials, and step-by-step setup guides.
        </p>
      </div>

      <!-- Col 2: Popular IPs -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200 mb-3">Popular Router IPs</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={`${base}/192-168-1-1`} class="hover:text-brand-400 transition-colors">192.168.1.1 Login</a></li>
          <li><a href={`${base}/192-168-0-1`} class="hover:text-brand-400 transition-colors">192.168.0.1 Login</a></li>
          <li><a href={`${base}/192-168-2-1`} class="hover:text-brand-400 transition-colors">192.168.2.1 Login</a></li>
          <li><a href={`${base}/192-168-1-254`} class="hover:text-brand-400 transition-colors">192.168.1.254 Login</a></li>
          <li><a href={`${base}/10-0-0-1`} class="hover:text-brand-400 transition-colors">10.0.0.1 Login</a></li>
        </ul>
      </div>

      <!-- Col 3: Popular Brands -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200 mb-3">Top Router Brands</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={`${base}/tp-link`} class="hover:text-brand-400 transition-colors">TP-Link Default Passwords</a></li>
          <li><a href={`${base}/netgear`} class="hover:text-brand-400 transition-colors">Netgear Router Login</a></li>
          <li><a href={`${base}/d-link`} class="hover:text-brand-400 transition-colors">D-Link Settings</a></li>
          <li><a href={`${base}/asus`} class="hover:text-brand-400 transition-colors">ASUS Router Admin</a></li>
          <li><a href={`${base}/linksys`} class="hover:text-brand-400 transition-colors">Linksys Velop & Setup</a></li>
        </ul>
      </div>

      <!-- Col 4: Tools & ISPs -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200 mb-3">Tools & ISPs</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={`${base}/default-passwords`} class="hover:text-brand-400 transition-colors">All Default Passwords</a></li>
          <li><a href={`${base}/what-is-my-ip`} class="hover:text-brand-400 transition-colors">What is My IP Address</a></li>
          <li><a href={`${base}/jio`} class="hover:text-brand-400 transition-colors">JioFiber Router Login (192.168.29.1)</a></li>
          <li><a href={`${base}/airtel`} class="hover:text-brand-400 transition-colors">Airtel Xstream Fiber Setup</a></li>
          <li><a href={`${base}/bsnl`} class="hover:text-brand-400 transition-colors">BSNL Bharat Fiber Login</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-slate-800 mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>© {currentYear} RouterGuide. All rights reserved.</p>
      <p class="text-slate-400">Educational reference directory for network hardware configuration.</p>
    </div>
  </div>
</footer>
