---
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="bg-slate-100/95 dark:bg-slate-950 text-slate-600 dark:text-slate-400 border-t border-slate-200/90 dark:border-slate-800 mt-16 transition-colors duration-200 font-sans">
  
  <!-- Quick Direct Gateway Strip with animated ping -->
  <div class="border-b border-slate-200/70 dark:border-slate-850 bg-white/70 dark:bg-slate-900/70 backdrop-blur-xs">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3 text-xs">
      <div class="flex items-center gap-2">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="font-bold text-slate-800 dark:text-slate-200">Quick Gateway Direct Access:</span>
      </div>
      <div class="flex flex-wrap items-center gap-2 font-mono text-[11px] font-semibold">
        <a href="http://192.168.1.1" target="_blank" rel="noopener noreferrer" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-brand-600 hover:text-white dark:hover:bg-brand-600 text-slate-700 dark:text-slate-300 transition-all shadow-2xs">192.168.1.1 ↗</a>
        <a href="http://192.168.0.1" target="_blank" rel="noopener noreferrer" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-brand-600 hover:text-white dark:hover:bg-brand-600 text-slate-700 dark:text-slate-300 transition-all shadow-2xs">192.168.0.1 ↗</a>
        <a href="http://192.168.2.1" target="_blank" rel="noopener noreferrer" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-brand-600 hover:text-white dark:hover:bg-brand-600 text-slate-700 dark:text-slate-300 transition-all shadow-2xs">192.168.2.1 ↗</a>
        <a href="http://10.0.0.1" target="_blank" rel="noopener noreferrer" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-brand-600 hover:text-white dark:hover:bg-brand-600 text-slate-700 dark:text-slate-300 transition-all shadow-2xs">10.0.0.1 ↗</a>
        <a href="http://192.168.29.1" target="_blank" rel="noopener noreferrer" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-brand-600 hover:text-white dark:hover:bg-brand-600 text-slate-700 dark:text-slate-300 transition-all shadow-2xs">192.168.29.1 ↗</a>
      </div>
    </div>
  </div>

  <!-- Main 5-Column Navigation -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8">
      
      <!-- Col 1: Brand Info -->
      <div class="col-span-2 md:col-span-1 space-y-3">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-slate-900 dark:bg-brand-600 text-white flex items-center justify-center font-bold text-xs shadow-xs">
            <svg class="w-4 h-4 text-sky-400 dark:text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="13" x2="3" y2="5"></line>
              <line x1="19" y1="13" x2="21" y2="5"></line>
              <line x1="12" y1="13" x2="12" y2="3"></line>
              <rect x="2" y="13" width="20" height="8" rx="2" fill="currentColor" fill-opacity="0.2"></rect>
              <circle cx="6" cy="17" r="0.75" fill="#10B981" stroke="none"></circle>
              <circle cx="9.5" cy="17" r="0.75" fill="#38BDF8" stroke="none"></circle>
              <circle cx="13" cy="17" r="0.75" fill="#38BDF8" stroke="none"></circle>
              <circle cx="16.5" cy="17" r="0.75" fill="#38BDF8" stroke="none"></circle>
            </svg>
          </div>
          <div class="flex flex-col text-left leading-none">
            <span class="font-black text-slate-900 dark:text-white text-base tracking-tight font-sans">
              19216811<span class="text-brand-600 dark:text-brand-400">.page</span>
            </span>
            <span class="text-[9px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest mt-0.5">
              Router Gateway
            </span>
          </div>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Open reference directory for wireless router gateways, default login credentials, and home network configuration.
        </p>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 text-[10px] text-slate-600 dark:text-slate-400 font-mono shadow-2xs">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span>RFC 1918 Private IPv4 Standard</span>
        </div>
      </div>

      <!-- Col 2: Gateway IPs -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-3 flex items-center gap-1.5">
          <span class="text-brand-600 dark:text-brand-400">🌐</span> Gateways
        </h4>
        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
          <li><a href={`${base}/`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all">192.168.1.1 Login</a></li>
          <li><a href={`${base}/192-168-0-1`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all">192.168.0.1 Admin</a></li>
          <li><a href={`${base}/192-168-2-1`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all">192.168.2.1 Belkin</a></li>
          <li><a href={`${base}/192-168-1-254`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all">192.168.1.254 AT&T</a></li>
          <li><a href={`${base}/10-0-0-1`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all">10.0.0.1 Xfinity</a></li>
          <li><a href={`${base}/192-168-29-1`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all">192.168.29.1 Jio</a></li>
        </ul>
      </div>

      <!-- Col 3: Router Brands -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-3 flex items-center gap-1.5">
          <span class="text-amber-600 dark:text-amber-400">🏷️</span> Top Brands
        </h4>
        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
          <li><a href={`${base}/tp-link`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all">TP-Link</a></li>
          <li><a href={`${base}/netgear`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all">Netgear</a></li>
          <li><a href={`${base}/asus`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all">ASUS RT</a></li>
          <li><a href={`${base}/d-link`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all">D-Link</a></li>
          <li><a href={`${base}/cisco`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all">Cisco</a></li>
          <li><a href={`${base}/linksys`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all">Linksys</a></li>
          <li><a href={`${base}/tenda`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all">Tenda</a></li>
        </ul>
      </div>

      <!-- Col 4: Fiber ISPs -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-3 flex items-center gap-1.5">
          <span class="text-emerald-600 dark:text-emerald-400">📶</span> Fiber ISPs
        </h4>
        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
          <li><a href={`${base}/jio`} class="hover:text-emerald-600 dark:hover:text-emerald-400 hover:translate-x-1 inline-flex transition-all">JioFiber</a></li>
          <li><a href={`${base}/airtel`} class="hover:text-red-600 dark:hover:text-red-400 hover:translate-x-1 inline-flex transition-all">Airtel Xstream</a></li>
          <li><a href={`${base}/att-fiber`} class="hover:text-sky-600 dark:hover:text-sky-400 hover:translate-x-1 inline-flex transition-all">AT&T Fiber</a></li>
          <li><a href={`${base}/xfinity`} class="hover:text-purple-600 dark:hover:text-purple-400 hover:translate-x-1 inline-flex transition-all">Xfinity Comcast</a></li>
          <li><a href={`${base}/verizon-fios`} class="hover:text-red-600 dark:hover:text-red-400 hover:translate-x-1 inline-flex transition-all">Verizon Fios</a></li>
        </ul>
      </div>

      <!-- Col 5: Legal, Tools & Compliance -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-3 flex items-center gap-1.5">
          <span class="text-indigo-600 dark:text-indigo-400">⚖️</span> Legal & Policy
        </h4>
        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
          <li><a href={`${base}/speed-test`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all">Internet Speed Test</a></li>
          <li><a href={`${base}/subnet-calculator`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all">CIDR Subnet Calculator</a></li>
          <li><a href={`${base}/dns-servers`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all">Public DNS Directory</a></li>
          <li><a href={`${base}/port-forwarding`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all">Port Forwarding Guide</a></li>
          <li><a href={`${base}/what-is-my-ip`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all">What Is My IP</a></li>
          <li><a href={`${base}/privacy-policy`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all">Privacy Policy</a></li>
          <li><a href={`${base}/terms-of-service`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all">Terms of Service</a></li>
          <li><a href={`${base}/about`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all">About Us</a></li>
          <li><a href={`${base}/contact`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all">Contact & Support</a></li>
          <li><a href={`${base}/disclaimer`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all">Disclaimer & DMCA</a></li>
          <li><a href={`${base}/tools`} class="hover:text-brand-600 dark:hover:text-brand-400 hover:translate-x-1 inline-flex transition-all font-semibold text-brand-700 dark:text-brand-400">All 8 Network Tools →</a></li>
        </ul>
      </div>

    </div>

    <!-- AdSense Non-Affiliation & Trust Disclaimer Strip -->
    <div class="border-t border-slate-200 dark:border-slate-800 mt-10 pt-6 text-[11px] text-slate-500 dark:text-slate-500 leading-relaxed text-center sm:text-left space-y-2">
      <p>
        <strong>Disclaimer:</strong> 19216811.page is an independent educational networking guide and reference portal. We are not affiliated with, authorized, or endorsed by any router hardware manufacturer or ISP (including TP-Link, Netgear, ASUS, D-Link, Cisco, Linksys, Jio, Airtel, BSNL, AT&T, Comcast Xfinity, Verizon). All brand names, logos, and trademarks are the property of their respective owners.
      </p>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-slate-200 dark:border-slate-800 mt-4 pt-4 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500 dark:text-slate-500">
      <p>© {currentYear} 19216811.page · Open Router Reference Portal</p>
      <div class="flex flex-wrap items-center gap-4 text-xs font-medium">
        <a href={`${base}/privacy-policy`} class="hover:text-slate-900 dark:hover:text-slate-200 transition-colors">Privacy Policy</a>
        <a href={`${base}/terms-of-service`} class="hover:text-slate-900 dark:hover:text-slate-200 transition-colors">Terms</a>
        <a href={`${base}/disclaimer`} class="hover:text-slate-900 dark:hover:text-slate-200 transition-colors">Disclaimer</a>
        <a href={`${base}/about`} class="hover:text-slate-900 dark:hover:text-slate-200 transition-colors">About</a>
        <a href={`${base}/contact`} class="hover:text-slate-900 dark:hover:text-slate-200 transition-colors">Contact</a>
        <a href={`${base}/sitemap-index.xml`} class="hover:text-slate-900 dark:hover:text-slate-200 transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
