---
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="bg-white dark:bg-[#202124] text-[#5f6368] dark:text-[#9aa0a6] border-t border-[#dadce0] dark:border-[#3c4043] mt-16 transition-colors duration-200 font-sans">
  
  <!-- Google 4-Color Top Accent Line -->
  <div class="h-1 w-full flex">
    <div class="h-full w-1/4 bg-[#4285f4]"></div>
    <div class="h-full w-1/4 bg-[#ea4335]"></div>
    <div class="h-full w-1/4 bg-[#fbbc05]"></div>
    <div class="h-full w-1/4 bg-[#34a853]"></div>
  </div>

  <!-- Quick Direct Gateway Access Chips -->
  <div class="border-b border-[#e8eaed] dark:border-[#3c4043] bg-[#f8fafd] dark:bg-[#292a2d]/60">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3.5 flex flex-wrap items-center justify-between gap-3 text-xs">
      <div class="flex items-center gap-2">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#34a853] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-[#34a853]"></span>
        </span>
        <span class="font-medium text-[#202124] dark:text-[#e8eaed]">Quick Gateway Direct Access:</span>
      </div>
      <div class="flex flex-wrap items-center gap-2 font-mono text-[11px] font-medium">
        <a href="http://192.168.1.1" target="_blank" rel="noopener noreferrer" class="px-3 py-1 rounded-full bg-white dark:bg-[#303134] hover:bg-[#e8f0fe] dark:hover:bg-[#1a3a60] text-[#1a73e8] dark:text-[#8ab4f8] border border-[#dadce0] dark:border-[#5f6368] transition-all shadow-2xs">192.168.1.1 ↗</a>
        <a href="http://192.168.0.1" target="_blank" rel="noopener noreferrer" class="px-3 py-1 rounded-full bg-white dark:bg-[#303134] hover:bg-[#e8f0fe] dark:hover:bg-[#1a3a60] text-[#1a73e8] dark:text-[#8ab4f8] border border-[#dadce0] dark:border-[#5f6368] transition-all shadow-2xs">192.168.0.1 ↗</a>
        <a href="http://192.168.2.1" target="_blank" rel="noopener noreferrer" class="px-3 py-1 rounded-full bg-white dark:bg-[#303134] hover:bg-[#e8f0fe] dark:hover:bg-[#1a3a60] text-[#1a73e8] dark:text-[#8ab4f8] border border-[#dadce0] dark:border-[#5f6368] transition-all shadow-2xs">192.168.2.1 ↗</a>
        <a href="http://10.0.0.1" target="_blank" rel="noopener noreferrer" class="px-3 py-1 rounded-full bg-white dark:bg-[#303134] hover:bg-[#e8f0fe] dark:hover:bg-[#1a3a60] text-[#1a73e8] dark:text-[#8ab4f8] border border-[#dadce0] dark:border-[#5f6368] transition-all shadow-2xs">10.0.0.1 ↗</a>
        <a href="http://192.168.29.1" target="_blank" rel="noopener noreferrer" class="px-3 py-1 rounded-full bg-white dark:bg-[#303134] hover:bg-[#e8f0fe] dark:hover:bg-[#1a3a60] text-[#1a73e8] dark:text-[#8ab4f8] border border-[#dadce0] dark:border-[#5f6368] transition-all shadow-2xs">192.168.29.1 ↗</a>
      </div>
    </div>
  </div>

  <!-- Main 5-Column Navigation -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8">
      
      <!-- Col 1: Brand Info -->
      <div class="col-span-2 md:col-span-1 space-y-3.5">
        <div class="flex items-center gap-2">
          <div class="flex items-center gap-1">
            <span class="w-2.5 h-2.5 rounded-full bg-[#4285f4]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#ea4335]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#fbbc05]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#34a853]"></span>
          </div>
          <span class="font-bold text-[#202124] dark:text-[#e8eaed] text-base tracking-tight font-sans">
            19216811<span class="text-[#1a73e8] dark:text-[#8ab4f8]">.page</span>
          </span>
        </div>
        <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed">
          The universal open knowledge base for wireless router gateways, factory default passwords, hardware specifications, and network tools.
        </p>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#f1f3f4] dark:bg-[#303134] border border-[#dadce0] dark:border-[#5f6368] text-[11px] text-[#3c4043] dark:text-[#bdc1c6]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#34a853]"></span>
          <span>RFC 1918 Private Network Standard</span>
        </div>
      </div>

      <!-- Col 2: Gateway IPs -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-[#202124] dark:text-[#e8eaed] mb-3 flex items-center gap-1.5">
          <span class="text-[#1a73e8] dark:text-[#8ab4f8]">🌐</span> Gateways
        </h4>
        <ul class="space-y-2 text-xs text-[#5f6368] dark:text-[#9aa0a6]">
          <li><a href={`${base}/`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">192.168.1.1 Login</a></li>
          <li><a href={`${base}/192-168-0-1`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">192.168.0.1 Admin</a></li>
          <li><a href={`${base}/192-168-2-1`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">192.168.2.1 Gateway</a></li>
          <li><a href={`${base}/192-168-1-254`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">192.168.1.254 Setup</a></li>
          <li><a href={`${base}/10-0-0-1`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">10.0.0.1 Xfinity</a></li>
          <li><a href={`${base}/192-168-29-1`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">192.168.29.1 JioFiber</a></li>
        </ul>
      </div>

      <!-- Col 3: Router Brands -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-[#202124] dark:text-[#e8eaed] mb-3 flex items-center gap-1.5">
          <span class="text-[#f9ab00]">🏷️</span> Top Brands
        </h4>
        <ul class="space-y-2 text-xs text-[#5f6368] dark:text-[#9aa0a6]">
          <li><a href={`${base}/tp-link`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">TP-Link</a></li>
          <li><a href={`${base}/netgear`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">Netgear</a></li>
          <li><a href={`${base}/asus`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">ASUS RT</a></li>
          <li><a href={`${base}/ubiquiti`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">Ubiquiti UniFi</a></li>
          <li><a href={`${base}/cisco`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">Cisco Meraki</a></li>
          <li><a href={`${base}/linksys`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">Linksys Velop</a></li>
          <li><a href={`${base}/mikrotik`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">MikroTik RouterOS</a></li>
        </ul>
      </div>

      <!-- Col 4: Fiber ISPs -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-[#202124] dark:text-[#e8eaed] mb-3 flex items-center gap-1.5">
          <span class="text-[#34a853]">📶</span> Fiber ISPs
        </h4>
        <ul class="space-y-2 text-xs text-[#5f6368] dark:text-[#9aa0a6]">
          <li><a href={`${base}/jio-fiber`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">JioFiber ONT</a></li>
          <li><a href={`${base}/airtel-xstream-fiber`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">Airtel Xstream</a></li>
          <li><a href={`${base}/bsnl-ftth`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">BSNL Bharat Fiber</a></li>
          <li><a href={`${base}/act-fibernet`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">ACT Fibernet</a></li>
          <li><a href={`${base}/excitel-broadband`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">Excitel FTTH</a></li>
          <li><a href={`${base}/tata-play-fiber`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">Tata Play Fiber</a></li>
        </ul>
      </div>

      <!-- Col 5: Tools & Legal -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-[#202124] dark:text-[#e8eaed] mb-3 flex items-center gap-1.5">
          <span class="text-[#ea4335]">🛠️</span> Tools & Info
        </h4>
        <ul class="space-y-2 text-xs text-[#5f6368] dark:text-[#9aa0a6]">
          <li><a href={`${base}/subnet-calculator`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">CIDR Subnet Calculator</a></li>
          <li><a href={`${base}/speed-test`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">Internet Speed Test</a></li>
          <li><a href={`${base}/what-is-my-ip`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">What Is My IP?</a></li>
          <li><a href={`${base}/wifi-qr-generator`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">Wi-Fi QR Generator</a></li>
          <li><a href={`${base}/privacy-policy`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">Privacy Policy</a></li>
          <li><a href={`${base}/terms-of-service`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">Terms of Service</a></li>
        </ul>
      </div>

    </div>
  </div>

  <!-- Bottom Legal & Disclaimer Bar -->
  <div class="border-t border-[#e8eaed] dark:border-[#3c4043] bg-[#f8fafd] dark:bg-[#202124] py-6">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-[#5f6368] dark:text-[#9aa0a6]">
      <div class="flex flex-col sm:flex-row items-center gap-3 text-center sm:text-left">
        <span>&copy; {currentYear} <strong>19216811.page</strong>. All rights reserved.</span>
        <span class="hidden sm:inline text-[#dadce0] dark:text-[#3c4043]">|</span>
        <span class="text-[11px]">Independent Technical Educational Resource.</span>
      </div>

      <div class="flex items-center gap-4 text-[11px]">
        <a href={`${base}/about`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">About Us</a>
        <a href={`${base}/contact`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">Contact</a>
        <a href={`${base}/disclaimer`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">Disclaimer</a>
        <a href={`${base}/sitemap-index.xml`} class="hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
