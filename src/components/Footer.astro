---
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="bg-slate-950 text-slate-400 border-t border-slate-800/80 mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-8">
      
      <!-- Col 1: Brand Info -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-white text-slate-950 flex items-center justify-center font-bold text-xs font-mono">
            IP
          </div>
          <span class="font-bold text-white text-lg tracking-tight font-sans">
            19216811<span class="text-brand-400">.page</span>
          </span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed max-w-sm">
          <strong>19216811.page</strong> is an open reference guide for default router gateway IP addresses (192.168.1.1, 192.168.0.1, 10.0.0.1), factory admin logins, and home network configuration.
        </p>
        <div class="flex items-center gap-2 text-xs text-slate-400 font-mono">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>RFC 1918 Private Network Standards</span>
        </div>
      </div>

      <!-- Col 2: Gateway IPs -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-white mb-2.5">Gateways</h4>
        <ul class="space-y-1.5 text-xs">
          <li><a href={`${base}/`} class="hover:text-white transition-colors">192.168.1.1 Login</a></li>
          <li><a href={`${base}/192-168-0-1`} class="hover:text-white transition-colors">192.168.0.1 Admin</a></li>
          <li><a href={`${base}/192-168-2-1`} class="hover:text-white transition-colors">192.168.2.1 Belkin</a></li>
          <li><a href={`${base}/192-168-1-254`} class="hover:text-white transition-colors">192.168.1.254 Technicolor</a></li>
          <li><a href={`${base}/10-0-0-1`} class="hover:text-white transition-colors">10.0.0.1 Xfinity</a></li>
        </ul>
      </div>

      <!-- Col 3: Router Brands -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-white mb-2.5">Top Brands</h4>
        <ul class="space-y-1.5 text-xs">
          <li><a href={`${base}/tp-link`} class="hover:text-white transition-colors">TP-Link</a></li>
          <li><a href={`${base}/netgear`} class="hover:text-white transition-colors">Netgear</a></li>
          <li><a href={`${base}/asus`} class="hover:text-white transition-colors">ASUS RT</a></li>
          <li><a href={`${base}/d-link`} class="hover:text-white transition-colors">D-Link</a></li>
          <li><a href={`${base}/cisco`} class="hover:text-white transition-colors">Cisco</a></li>
        </ul>
      </div>

      <!-- Col 4: Tools & Directories -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-white mb-2.5">Tools</h4>
        <ul class="space-y-1.5 text-xs">
          <li><a href={`${base}/what-is-my-ip`} class="hover:text-white transition-colors">What is My IP?</a></li>
          <li><a href={`${base}/wifi-qr-generator`} class="hover:text-white transition-colors">WiFi QR Generator</a></li>
          <li><a href={`${base}/password-generator`} class="hover:text-white transition-colors">Password Generator</a></li>
          <li><a href={`${base}/default-passwords`} class="hover:text-white transition-colors">Default Passwords</a></li>
          <li><a href={`${base}/routers`} class="hover:text-white transition-colors">Hardware Database</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-slate-800/80 mt-10 pt-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
      <p>© {currentYear} 19216811.page. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <a href={`${base}/brands`} class="hover:text-slate-300 transition-colors">Brands Directory</a>
        <a href={`${base}/sitemap-index.xml`} class="hover:text-slate-300 transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
