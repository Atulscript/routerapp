---
interface Props {
  slotId?: string;
  format?: 'leaderboard' | 'rectangle' | 'horizontal' | 'in-feed' | 'in-article';
  className?: string;
}

const { slotId = 'default-slot', format = 'horizontal', className = '' } = Astro.props;
const publisherId = "ca-pub-8700784373117801";

// Height is reserved up front so the page doesn't jump when the ad arrives (CLS).
const frame = {
  // Responsive 'auto' ads are usually ~280px tall on phones, so reserve that there
  leaderboard: 'max-w-[728px] min-h-[280px] sm:min-h-[90px]',
  horizontal: 'max-w-4xl min-h-[90px]',
  rectangle: 'max-w-[336px] min-h-[280px]',
  'in-article': 'min-h-[100px]',
  'in-feed': 'min-h-[100px]',
}[format];

const insAttrs = {
  leaderboard: { 'data-ad-format': 'auto', 'data-full-width-responsive': 'true', style: 'display:block' },
  horizontal: { 'data-ad-format': 'horizontal', 'data-full-width-responsive': 'true', style: 'display:block' },
  rectangle: { style: 'display:inline-block;width:336px;height:280px' },
  'in-article': { 'data-ad-layout': 'in-article', 'data-ad-format': 'fluid', style: 'display:block;text-align:center' },
  'in-feed': { 'data-ad-format': 'fluid', 'data-ad-layout-key': '-fb+5w+4e-db+86', style: 'display:block' },
}[format];
---

<aside class={`ad-slot my-2 w-full flex flex-col items-center ${className}`} data-format={format} aria-label="Advertisement">
  <span class="text-[11px] font-medium text-ink-muted mb-1 select-none">Advertisement</span>
  <div class={`w-full ${frame} mx-auto rounded-2xl bg-[#f1f3f4]/60 dark:bg-[#292a2d]/60 overflow-hidden flex items-center justify-center`}>
    <ins class="adsbygoogle w-full" data-ad-client={publisherId} data-ad-slot={slotId} {...insAttrs}></ins>
  </div>
</aside>

<script is:inline>
  try { (adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) {}
</script>
