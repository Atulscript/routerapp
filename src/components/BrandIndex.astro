---
import { getBrandGroups } from '../lib/brand-index';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const groups = getBrandGroups();
---

{/*
  Every brand as a compact link, ~120 bytes each instead of the ~2.5KB a full card costs.
  Search reads each link's own text, so there is no duplicated data-name attribute.
*/}
<div class="space-y-3" id="brand-index">
  {groups.map(({ letter, brands }) => (
    <section
      class="brand-group g-card-flat p-4 sm:p-5"
      data-letter={letter}
      style={`contain-intrinsic-size: auto ${120 + Math.ceil(brands.length / 4) * 34}px`}
    >
      <h3
        class="flex items-baseline gap-2.5 mb-3 pb-2 border-b border-[#e8eaed] dark:border-[#3c4043]"
        id={`letter-${letter === '0-9' ? '09' : letter}`}
      >
        <span class="text-lg font-extrabold text-[#1a73e8] dark:text-[#8ab4f8] font-mono">{letter}</span>
        <span class="text-[11px] font-semibold text-[#5f6368] dark:text-[#9aa0a6] group-count">
          {brands.length} brand{brands.length === 1 ? '' : 's'}
        </span>
      </h3>

      <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-4 gap-y-0.5">
        {brands.map(brand => (
          <li>
            <a
              href={`${base}/${brand.slug}`}
              class="brand-link block truncate py-1 text-sm text-[#3c4043] dark:text-[#bdc1c6] hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] hover:underline transition-colors"
              title={`${brand.name} — default IP ${brand.defaultIp}`}
            >
              {brand.name}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  /* Off-screen letter groups skip layout and paint entirely. The inline
     contain-intrinsic-size above keeps the scrollbar from jumping as they render. */
  .brand-group {
    content-visibility: auto;
  }
</style>
